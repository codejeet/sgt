_plan_request_latest_for_rig() {
  local rig="${1:-}" best_id="" best_ts=0 request_id meta_path ts
  while IFS='|' read -r found_id found_at found_agent; do
    ts="$(date -d "${found_at:-1970-01-01T00:00:00Z}" +%s 2>/dev/null || echo 0)"
    if (( ts >= best_ts )); then
      best_ts="$ts"
      best_id="$found_id|$found_agent"
    fi
  done < <(
    for request_id in $(_plan_request_ids); do
      meta_path="$(_plan_request_meta_path "$request_id")"
      (
        source "$meta_path"
        [[ "${RIG:-}" == "$rig" ]] || exit 0
        printf '%s|%s|%s\n' "${REQUEST_ID:-$request_id}" "${REQUESTED_AT:-}" "${REQUESTING_AGENT_ID:-}"
      )
    done
  )
  [[ -n "$best_id" ]] && echo "$best_id"
