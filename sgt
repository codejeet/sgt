      ISSUE=""
      source "$df" 2>/dev/null || true
      dname="$(basename "$df")"
      local dog_alive="dead"
      tmux has-session -t "$SESSION" 2>/dev/null && dog_alive="alive"
      dogs+=("{\"name\":$(_json_quote "$dname"),\"status\":$(_json_quote "$dog_alive"),\"issue\":$(_json_quote "$ISSUE")}")
    done
  fi

  local cf cname
  if [[ -d "$SGT_CONFIG/crew" ]]; then
    for cf in "$SGT_CONFIG/crew"/*; do
      [[ -f "$cf" ]] || continue
      local SESSION ROLE RIG
      SESSION=""
      ROLE=""
      RIG=""
      source "$cf" 2>/dev/null || true
      cname="$(basename "$cf")"
      local crew_alive="asleep"
      tmux has-session -t "$SESSION" 2>/dev/null && crew_alive="awake"
      crew+=("{\"name\":$(_json_quote "$cname"),\"status\":$(_json_quote "$crew_alive"),\"role\":$(_json_quote "$ROLE"),\"rig\":$(_json_quote "$RIG")}")
