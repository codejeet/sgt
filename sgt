_mayor_snapshot_resolve_counts() {
  local snapshot_raw="${1:-}" live_raw="${2:-}"
  local snapshot="$snapshot_raw" live="$live_raw"
  local chosen source status selection_reason

  [[ "$snapshot" =~ ^[0-9]+$ ]] || snapshot=-1
  [[ "$live" =~ ^[0-9]+$ ]] || live=-1

  # Deterministic precedence:
  # 1) If live is available and differs, live wins (stale snapshot).
  # 2) If live is unavailable, snapshot is kept.
  # 3) If both are available and equal, snapshot is accepted as in-sync.
  if [[ "$live" -lt 0 ]]; then
    chosen="$snapshot"
    source="snapshot"
    status="live-unavailable"
    selection_reason="live-count-unavailable-fell-back-to-snapshot"
  elif [[ "$snapshot" -lt 0 ]]; then
    chosen="$live"
    source="live"
    status="snapshot-invalid"
    selection_reason="snapshot-invalid-used-live"
  elif [[ "$snapshot" -eq "$live" ]]; then
    chosen="$snapshot"
    source="snapshot"
    status="in-sync"
    selection_reason="snapshot-matches-live"
  else
    chosen="$live"
    source="live"
    status="stale-snapshot"
    selection_reason="live-differs-from-snapshot"
  fi

  echo "${snapshot}|${live}|${chosen}|${source}|${status}|${selection_reason}"
}

