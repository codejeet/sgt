_refinery_merge_receipt_summary() {
  printf 'repo=%s pr=#%s issue=#%s expected_state=%s observed_state=%s merged_sha=%s branch_deleted=%s verified_at=%s outcome=%s retry=%s merge_key=%s' \
    "${_REFINERY_MERGE_RECEIPT_REPO:-unknown}" \
    "${_REFINERY_MERGE_RECEIPT_PR:-unknown}" \
    "${_REFINERY_MERGE_RECEIPT_ISSUE:-unknown}" \
