      printf "  %-16s %s%s%s\n" "" "$(_dim)" "last heartbeat: $president_hb_ts (${president_hb_age}s ago, ${president_hb_health}, stale>${president_hb_stale}s, phase=${president_hb_phase:-unknown}, trigger=${president_hb_trigger:-unknown})" "$(_reset)"
    elif [[ "$president_hb_state" == "missing" ]]; then
      printf "  %-16s %s%s%s\n" "" "$(_dim)" "last heartbeat: missing (health unknown, stale>${president_hb_stale}s)" "$(_reset)"
    else
