    [[ -z "$session" ]] && missing_fields="${missing_fields} SESSION"
    [[ -z "$repo" ]] && missing_fields="${missing_fields} REPO"
    [[ -z "$branch" ]] && missing_fields="${missing_fields} BRANCH"
    if [[ -n "$missing_fields" ]]; then
      polecats+=("{\"name\":$(_json_quote "$pname"),\"status\":$(_json_quote "unknown"),\"issue\":$(_json_quote "$issue"),\"warning\":$(_json_quote "metadata missing:${missing_fields} (possible race)")}")
      continue
    fi

