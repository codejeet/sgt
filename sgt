_refinery_merge_receipt_load() {
  local file="${1:-}"
  local KEY="" REPO="" PR="" ISSUE="" EXPECTED_STATE="" OBSERVED_STATE="" MERGED_SHA="" BRANCH_DELETED="" VERIFIED_AT="" OUTCOME="" RETRY_DECISION=""
  local missing=0
  _refinery_merge_receipt_clear_loaded
  [[ -n "$file" && -f "$file" ]] || return 1
  eval "$(grep -E '^(KEY|REPO|PR|ISSUE|EXPECTED_STATE|OBSERVED_STATE|MERGED_SHA|BRANCH_DELETED|VERIFIED_AT|OUTCOME|RETRY_DECISION)=' "$file" 2>/dev/null || true)"
  _REFINERY_MERGE_RECEIPT_FILE="$file"
  _REFINERY_MERGE_RECEIPT_KEY="${KEY:-}"
  _REFINERY_MERGE_RECEIPT_REPO="${REPO:-}"
  _REFINERY_MERGE_RECEIPT_PR="${PR:-}"
  _REFINERY_MERGE_RECEIPT_ISSUE="${ISSUE:-}"
  _REFINERY_MERGE_RECEIPT_EXPECTED_STATE="${EXPECTED_STATE:-}"
  _REFINERY_MERGE_RECEIPT_OBSERVED_STATE="${OBSERVED_STATE:-}"
  _REFINERY_MERGE_RECEIPT_MERGED_SHA="${MERGED_SHA:-}"
  _REFINERY_MERGE_RECEIPT_BRANCH_DELETED="${BRANCH_DELETED:-}"
  _REFINERY_MERGE_RECEIPT_VERIFIED_AT="${VERIFIED_AT:-}"
  _REFINERY_MERGE_RECEIPT_OUTCOME="${OUTCOME:-}"
  _REFINERY_MERGE_RECEIPT_RETRY_DECISION="${RETRY_DECISION:-}"
  [[ -n "${_REFINERY_MERGE_RECEIPT_KEY:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_REPO:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_PR:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_ISSUE:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_EXPECTED_STATE:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_OBSERVED_STATE:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_MERGED_SHA:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_BRANCH_DELETED:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_VERIFIED_AT:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_OUTCOME:-}" ]] || missing=1
  [[ -n "${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-}" ]] || missing=1
  if [[ "$missing" -ne 0 ]]; then
    _refinery_merge_receipt_clear_loaded
    return 2
  fi
  return 0
}

_refinery_merge_receipt_record() {
  local key="${1:-}" repo="${2:-}" pr="${3:-}" issue="${4:-}" expected_state="${5:-}" observed_state="${6:-}" merged_sha="${7:-}" branch_deleted="${8:-}" outcome="${9:-}" retry_decision="${10:-}"
  local dir file receipt_tmp now_iso existing_outcome load_rc
  _refinery_merge_receipt_clear_loaded
  [[ -n "$key" && -n "$repo" && -n "$pr" && -n "$issue" && -n "$expected_state" && -n "$observed_state" && -n "$merged_sha" && -n "$branch_deleted" && -n "$outcome" && -n "$retry_decision" ]] || return 1
  dir="$(_refinery_merge_receipts_dir)"
  file="$(_refinery_merge_receipt_file_by_key "$key")" || return 1
  mkdir -p "$dir" || return 1

  existing_outcome=""
  if [[ -f "$file" ]]; then
    _refinery_merge_receipt_load "$file"
    load_rc=$?
    if [[ "$load_rc" -eq 0 ]]; then
      existing_outcome="${_REFINERY_MERGE_RECEIPT_OUTCOME:-}"
      if [[ "$outcome" == "success" && "$existing_outcome" == "success" ]]; then
        return 2
      fi
    fi
  fi

  now_iso="$(date -Iseconds)"
  receipt_tmp="${file}.tmp.$$"
  cat > "$receipt_tmp" <<EOF
KEY=$(_escape_wake_value "$key")
REPO=$(_escape_wake_value "$repo")
PR=$(_escape_wake_value "$pr")
ISSUE=$(_escape_wake_value "$issue")
EXPECTED_STATE=$(_escape_wake_value "$expected_state")
OBSERVED_STATE=$(_escape_wake_value "$observed_state")
MERGED_SHA=$(_escape_wake_value "$merged_sha")
BRANCH_DELETED=$(_escape_wake_value "$branch_deleted")
VERIFIED_AT=$(_escape_wake_value "$now_iso")
OUTCOME=$(_escape_wake_value "$outcome")
RETRY_DECISION=$(_escape_wake_value "$retry_decision")
EOF
  mv "$receipt_tmp" "$file"
  _refinery_merge_receipt_load "$file" || return 1
  return 0
}

_refinery_branch_deleted_state() {
  local repo="${1:-}" branch="${2:-}"
  local owner_repo encoded_branch api_out api_rc
  [[ -n "$repo" && -n "$branch" ]] || {
    echo "unknown"
    return 0
  }
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  encoded_branch="${branch//\//%2F}"
  set +e
  api_out="$(gh api "repos/$owner_repo/branches/$encoded_branch" 2>&1 >/dev/null)"
  api_rc=$?
  set -e
  if [[ "$api_rc" -eq 0 ]]; then
    echo "false"
    return 0
  fi
  if printf '%s' "$api_out" | grep -qiE '404|not[[:space:]]+found'; then
    echo "true"
  else
    echo "unknown"
  fi
}

_refinery_post_merge_verify_and_receipt() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}" issue="${4:-}" branch="${5:-}" merge_key="${6:-}" fallback_head_sha="${7:-}"
  local pr_snapshot pr_state merged_sha issue_state branch_deleted expected_state observed_state outcome retry_decision
  local record_rc owner_repo
  [[ -n "$repo" && -n "$pr" && -n "$issue" && -n "$merge_key" ]] || return 1
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"

  pr_snapshot="$(gh pr view "$pr" --repo "$repo" --json state,mergeCommit --jq '.state + "|" + (.mergeCommit.oid // "")' 2>/dev/null || true)"
  pr_state="unknown"
  merged_sha="${fallback_head_sha:-none}"
  if [[ -n "$pr_snapshot" && "$pr_snapshot" == *"|"* ]]; then
    IFS='|' read -r pr_state merged_sha <<< "$pr_snapshot"
  fi
  [[ -n "$pr_state" ]] || pr_state="unknown"
  [[ -n "$merged_sha" ]] || merged_sha="${fallback_head_sha:-none}"

  issue_state="$(gh issue view "$issue" --repo "$repo" --json state --jq '.state // ""' 2>/dev/null || true)"
  [[ -n "$issue_state" ]] || issue_state="unknown"
  branch_deleted="$(_refinery_branch_deleted_state "$repo" "$branch")"
  [[ -n "$branch_deleted" ]] || branch_deleted="unknown"

  expected_state="pr_state=MERGED;issue_state=OPEN;branch_deleted=true"
  observed_state="pr_state=${pr_state:-unknown};issue_state=${issue_state:-unknown};branch_deleted=${branch_deleted:-unknown}"
  outcome="mismatch"
  retry_decision="retry-post-merge-revalidate"

  if [[ "$pr_state" == "MERGED" && "$branch_deleted" == "true" && -n "$merged_sha" && "$merged_sha" != "none" ]]; then
    # Accept CLOSED issues — GitHub auto-closes via "Closes #N" in PR body
    outcome="success"
    retry_decision="no-op"
  elif [[ "$pr_state" == "MERGED" && "$issue_state" != "OPEN" && "$branch_deleted" != "true" ]]; then
    retry_decision="no-op-manual-issue-state-drift"
  elif [[ "$pr_state" == "MERGED" && "$branch_deleted" == "unknown" ]]; then
    retry_decision="retry-post-merge-revalidate"
  elif [[ "$pr_state" == "MERGED" && "$branch_deleted" == "false" ]]; then
    retry_decision="retry-post-merge-revalidate"
  fi

  _refinery_merge_receipt_record "$merge_key" "$owner_repo" "$pr" "$issue" "$expected_state" "$observed_state" "${merged_sha:-none}" "${branch_deleted:-unknown}" "$outcome" "$retry_decision"
  record_rc=$?
  if [[ "$record_rc" -ne 0 ]]; then
    if [[ "$record_rc" -eq 2 ]]; then
      log_event "REFINERY_MERGE_RECEIPT replay reason=replayed-merge-key-existing-success retry=no-op $(_refinery_merge_receipt_summary)"
      return 0
    fi
    log_event "REFINERY_MERGE_RECEIPT non-success reason=receipt-write-failed retry=retry-post-merge-revalidate repo=$owner_repo pr=#$pr issue=#$issue merge_key=\"$(_escape_quotes "$merge_key")\""
    return 1
  fi

  if [[ "${_REFINERY_MERGE_RECEIPT_OUTCOME:-mismatch}" == "success" ]]; then
    log_event "REFINERY_MERGE_RECEIPT success $(_refinery_merge_receipt_summary)"
    return 0
  fi
  log_event "REFINERY_MERGE_RECEIPT non-success reason=post-merge-live-mismatch retry=${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-retry-post-merge-revalidate} $(_refinery_merge_receipt_summary)"
  return 1
}

_resling_issue_key() {
  local repo="${1:-}" issue="${2:-}"
  local owner_repo
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  echo "${owner_repo}|issue=${issue}"
}

_resling_issue_key_id() {
  local key="${1:-}"
  _refinery_merge_attempt_key_id "$key"
}

_refinery_conflict_evidence_file() {
  local repo="${1:-}" issue="${2:-}" key key_id
  key="$(_resling_issue_key "$repo" "$issue")"
  key_id="$(_resling_issue_key_id "$key")"
  echo "$SGT_CONFIG/refinery-conflicts/${key_id}.state"
}

_refinery_conflict_record() {
  local rig="${1:-}" repo="${2:-}" issue="${3:-}" source_pr="${4:-}" source_head_sha="${5:-}" attempt_key="${6:-}" queue_name="${7:-}" backend="${8:-}" source_event_key="${9:-}"
  local now_epoch now_iso evidence_file conflict_count existing_origin_pr existing_origin_head existing_origin_attempt existing_origin_ts
  local key
  [[ -n "$repo" && -n "$issue" ]] || return 1
  now_epoch="$(date +%s)"
  now_iso="$(date -Iseconds)"
  evidence_file="$(_refinery_conflict_evidence_file "$repo" "$issue")"
  mkdir -p "$SGT_CONFIG/refinery-conflicts" || return 1
  key="$(_resling_issue_key "$repo" "$issue")"

  if [[ ! -f "$evidence_file" ]]; then
    cat > "$evidence_file" <<EOF
KEY=$key
RIG=${rig:-unknown}
REPO=$repo
ISSUE=$issue
ORIGIN_PR=${source_pr:-unknown}
ORIGIN_HEAD_SHA=${source_head_sha:-unknown}
ORIGIN_ATTEMPT_KEY=${attempt_key:-unknown}
ORIGIN_TS=$now_epoch
ORIGIN_AT=$now_iso
CONFLICT_COUNT=0
STATUS=PENDING
SOURCE_EVENT=refinery-conflict
SOURCE_EVENT_KEY=${source_event_key:-unknown}
BACKEND=${backend:-$(_ai_backend_default)}
RESLING_DISPATCHED_POLECAT=
LAST_OUTCOME=
LAST_REASON=
EOF
  fi

  conflict_count=$(grep -E '^CONFLICT_COUNT=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)
  [[ "$conflict_count" =~ ^[0-9]+$ ]] || conflict_count=0
  conflict_count=$((conflict_count + 1))

  existing_origin_pr=$(grep -E '^ORIGIN_PR=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)
  existing_origin_head=$(grep -E '^ORIGIN_HEAD_SHA=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)
  existing_origin_attempt=$(grep -E '^ORIGIN_ATTEMPT_KEY=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)
  existing_origin_ts=$(grep -E '^ORIGIN_TS=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)

  if [[ -z "$existing_origin_pr" ]]; then
    _merge_queue_set_field "$evidence_file" "ORIGIN_PR" "${source_pr:-unknown}" || true
  fi
  if [[ -z "$existing_origin_head" ]]; then
    _merge_queue_set_field "$evidence_file" "ORIGIN_HEAD_SHA" "${source_head_sha:-unknown}" || true
  fi
  if [[ -z "$existing_origin_attempt" ]]; then
    _merge_queue_set_field "$evidence_file" "ORIGIN_ATTEMPT_KEY" "${attempt_key:-unknown}" || true
  fi
  if [[ ! "$existing_origin_ts" =~ ^[0-9]+$ ]]; then
    _merge_queue_set_field "$evidence_file" "ORIGIN_TS" "$now_epoch" || true
    _merge_queue_set_field "$evidence_file" "ORIGIN_AT" "$now_iso" || true
  fi

  _merge_queue_set_field "$evidence_file" "RIG" "${rig:-unknown}" || true
  _merge_queue_set_field "$evidence_file" "BACKEND" "${backend:-$(_ai_backend_default)}" || true
  _merge_queue_set_field "$evidence_file" "SOURCE_EVENT" "refinery-conflict" || true
  _merge_queue_set_field "$evidence_file" "SOURCE_EVENT_KEY" "${source_event_key:-unknown}" || true
  _merge_queue_set_field "$evidence_file" "LAST_PR" "${source_pr:-unknown}" || true
  _merge_queue_set_field "$evidence_file" "LAST_HEAD_SHA" "${source_head_sha:-unknown}" || true
  _merge_queue_set_field "$evidence_file" "LAST_ATTEMPT_KEY" "${attempt_key:-unknown}" || true
  _merge_queue_set_field "$evidence_file" "LAST_TS" "$now_epoch" || true
  _merge_queue_set_field "$evidence_file" "LAST_AT" "$now_iso" || true
  _merge_queue_set_field "$evidence_file" "CONFLICT_COUNT" "$conflict_count" || true
  _merge_queue_set_field "$evidence_file" "STATUS" "PENDING" || true
  _merge_queue_set_field "$evidence_file" "LAST_OUTCOME" "conflict-recorded" || true
  _merge_queue_set_field "$evidence_file" "LAST_REASON" "merge conflict detected" || true

  echo "$evidence_file"
}

_refinery_conflict_auto_resolve() {
  local rig="${1:-}" repo="${2:-}" issue="${3:-}" pr="${4:-}" head_sha="${5:-}" attempt_key="${6:-}" queue_name="${7:-}" backend="${8:-}" queue_file="${9:-}" reason_code="${10:-merge-conflict}"
  local conflict_evidence_file conflict_event_key
  conflict_event_key="refinery-conflict:${queue_name}:#${pr}"
  conflict_evidence_file="$(_refinery_conflict_record "$rig" "$repo" "$issue" "$pr" "$head_sha" "$attempt_key" "$queue_name" "$backend" "$conflict_event_key" || true)"
  echo "[refinery/$rig] PR #$pr has merge conflicts — requesting rework"
  if [[ -n "$conflict_evidence_file" ]]; then
    echo "[refinery/$rig] conflict evidence recorded for issue #$issue (pr=$pr head=${head_sha:-unknown} attempt_key=${attempt_key:-unknown})"
  fi
  log_event "REFINERY_CONFLICT pr=#$pr issue=#$issue head=${head_sha:-unknown} attempt_key=\"$(_escape_quotes "${attempt_key:-unknown}")\" reason_code=$reason_code evidence=\"$(_escape_quotes "${conflict_evidence_file:-none}")\""
  if [[ -n "$conflict_evidence_file" ]]; then
    log_event "REFINERY_CONFLICT_EVIDENCE_WRITTEN pr=#$pr issue=#$issue head=${head_sha:-unknown} attempt_key=\"$(_escape_quotes "${attempt_key:-unknown}")\" evidence=\"$(_escape_quotes "$conflict_evidence_file")\""
  fi
  if [[ -n "$attempt_key" && "$attempt_key" != "unknown" ]]; then
    local merge_attempt_recovery_action
    merge_attempt_recovery_action="already-cleared"
    if _refinery_merge_attempt_clear_by_key "$attempt_key"; then
      merge_attempt_recovery_action="cleared-stale-merge-attempt"
    fi
    log_event "REFINERY_MERGE_ATTEMPT_RECOVERY pr=#$pr issue=#$issue reason_code=conflict-auto-resolve action=$merge_attempt_recovery_action key=\"$(_escape_quotes "$attempt_key")\" queue=${queue_name:-unknown}"
  fi
  gh pr comment "$pr" --repo "$repo" \
    --body "[sgt-refinery] Merge conflict detected. Closing and re-dispatching." 2>/dev/null || true
  gh pr close "$pr" --repo "$repo" 2>/dev/null || true
  if [[ -n "$queue_file" ]]; then
    rm -f "$queue_file"
  fi
  if [[ "$issue" != "0" && -n "$issue" && -n "$conflict_evidence_file" ]]; then
    gh issue reopen "$issue" --repo "$repo" 2>/dev/null || true
    gh issue comment "$issue" --repo "$repo" \
      --body "[sgt-refinery] Merge conflict on PR #$pr. Re-dispatching." 2>/dev/null || true
    _refinery_conflict_resling_resume "$rig" "$conflict_evidence_file" || true
  fi
}

_resling_find_existing_issue_polecat() {
  local rig="${1:-}" repo="${2:-}" issue="${3:-}"
  local owner_repo f p_owner_repo p_issue p_rig
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  for f in "$SGT_POLECATS"/*; do
    [[ -f "$f" ]] || continue
    p_owner_repo=""
    p_issue=""
    p_rig=""
    eval "$(grep -E '^(REPO|ISSUE|RIG)=' "$f" 2>/dev/null || true)"
    p_owner_repo="$(_repo_owner_repo "${REPO:-}")"
    [[ -n "$p_owner_repo" ]] || p_owner_repo="${REPO:-}"
    p_issue="${ISSUE:-}"
    p_rig="${RIG:-}"
    [[ -n "$p_issue" && -n "$p_owner_repo" ]] || continue
    if [[ "$p_owner_repo" == "$owner_repo" && "$p_issue" == "$issue" && ( -z "$rig" || "$p_rig" == "$rig" ) ]]; then
      basename "$f"
      return 0
    fi
  done
  return 1
}

_resling_issue_claim_release() {
  local claim_file="${1:-}"
  [[ -n "$claim_file" ]] || claim_file="${_RESLING_ISSUE_CLAIM_FILE:-}"
  [[ -n "$claim_file" ]] || return 0
  rm -f "$claim_file" 2>/dev/null || true
  if [[ "${_RESLING_ISSUE_CLAIM_FILE:-}" == "$claim_file" ]]; then
    _RESLING_ISSUE_CLAIM_FILE=""
  fi
}

_resling_issue_claim_acquire() {
  local repo="${1:-}" issue="${2:-}" source_event="${3:-}" source_event_key="${4:-}" evidence_file="${5:-}"
  local key key_id key_dir key_file now_iso now_epoch existing_pid
  _RESLING_ISSUE_CLAIM_FILE=""
  key="$(_resling_issue_key "$repo" "$issue")"
  key_id="$(_resling_issue_key_id "$key")"
  key_dir="$SGT_CONFIG/resling-issue-claims"
  key_file="$key_dir/$key_id"
  now_iso="$(date -Iseconds)"
  now_epoch="$(date +%s)"
  mkdir -p "$key_dir" || return 1
  if ! ( set -o noclobber; : > "$key_file" ) 2>/dev/null; then
    existing_pid="$(awk -F= '$1=="OWNER_PID"{print $2; exit}' "$key_file" 2>/dev/null || true)"
    if [[ -n "$existing_pid" && "$existing_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$existing_pid" 2>/dev/null; then
      rm -f "$key_file" 2>/dev/null || true
      if ! ( set -o noclobber; : > "$key_file" ) 2>/dev/null; then
        return 1
      fi
    else
      return 1
    fi
  fi
  cat > "$key_file" <<EOF
KEY=$key
REPO=$repo
ISSUE=$issue
SOURCE_EVENT=${source_event:-unknown}
SOURCE_EVENT_KEY=${source_event_key:-unknown}
EVIDENCE=${evidence_file:-none}
OWNER_PID=$$
OWNER_STARTED_TS=$now_epoch
CLAIMED_AT=$now_iso
EOF
  _RESLING_ISSUE_CLAIM_FILE="$key_file"
  return 0
}

_refinery_conflict_resling_resume() {
  local rig="${1:-}" evidence_file="${2:-}"
  local issue repo source_pr source_event source_event_key backend issue_title evidence_rig evidence_status existing_polecat
  local dispatch_source_pr source_pr_state bypass_reason_code
  local claim_file last_reason
  [[ -n "$evidence_file" && -f "$evidence_file" ]] || return 1

  repo="$(grep -E '^REPO=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  issue="$(grep -E '^ISSUE=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  source_pr="$(grep -E '^ORIGIN_PR=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  source_event="$(grep -E '^SOURCE_EVENT=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  source_event_key="$(grep -E '^SOURCE_EVENT_KEY=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  backend="$(grep -E '^BACKEND=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  evidence_rig="$(grep -E '^RIG=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  evidence_status="$(grep -E '^STATUS=' "$evidence_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)"

  [[ -n "$repo" && -n "$issue" ]] || return 1
  [[ -n "$source_event" ]] || source_event="refinery-conflict"
  [[ -n "$source_event_key" ]] || source_event_key="refinery-conflict:issue-${issue}"
  [[ -n "$backend" ]] || backend="$(_ai_backend_default)"
  if [[ -n "$evidence_rig" && "$evidence_rig" != "$rig" ]]; then
    return 0
  fi

  if [[ "$evidence_status" == "RESLING_DISPATCHED" || "$evidence_status" == "SKIPPED_FINAL" || "$evidence_status" == "SKIPPED_STALE" || "$evidence_status" == "SKIPPED_UNAUTHORIZED" ]]; then
    return 0
  fi

  if existing_polecat=$(_resling_find_existing_issue_polecat "$rig" "$repo" "$issue"); then
    _merge_queue_set_field "$evidence_file" "STATUS" "RESLING_DISPATCHED" || true
    _merge_queue_set_field "$evidence_file" "RESLING_DISPATCHED_POLECAT" "$existing_polecat" || true
    _merge_queue_set_field "$evidence_file" "LAST_OUTCOME" "dedupe-existing-polecat" || true
    _merge_queue_set_field "$evidence_file" "LAST_REASON" "active polecat already exists for issue" || true
    echo "[refinery/$rig] conflict replay dedupe for issue #$issue — active polecat=$existing_polecat"
    log_event "REFINERY_CONFLICT_RESLING_DEDUPE issue=#$issue repo=$(_repo_owner_repo "$repo") reason_code=active-polecat-existing polecat=$existing_polecat evidence=\"$(_escape_quotes "$evidence_file")\""
    return 0
  fi

  if ! _resling_issue_claim_acquire "$repo" "$issue" "$source_event" "$source_event_key" "$evidence_file"; then
    echo "[refinery/$rig] conflict replay dedupe for issue #$issue — reason_code=active-resling-claim"
    log_event "REFINERY_CONFLICT_RESLING_DEDUPE issue=#$issue repo=$(_repo_owner_repo "$repo") reason_code=active-resling-claim source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" evidence=\"$(_escape_quotes "$evidence_file")\""
    return 0
  fi
  claim_file="${_RESLING_ISSUE_CLAIM_FILE:-}"
  _merge_queue_set_field "$evidence_file" "STATUS" "RESLING_IN_PROGRESS" || true
  _merge_queue_set_field "$evidence_file" "RESLING_CLAIM_FILE" "$claim_file" || true
  _merge_queue_set_field "$evidence_file" "RESLING_STARTED_AT" "$(date -Iseconds)" || true

  issue_title="$(gh issue view "$issue" --repo "$repo" --json title --jq '.title' 2>/dev/null || true)"
  if [[ -z "$issue_title" ]]; then
    last_reason="unable to query issue title during conflict replay"
    _merge_queue_set_field "$evidence_file" "STATUS" "PENDING" || true
    _merge_queue_set_field "$evidence_file" "LAST_OUTCOME" "resume-error" || true
    _merge_queue_set_field "$evidence_file" "LAST_REASON" "$last_reason" || true
    log_event "REFINERY_CONFLICT_RESLING_RESUME_ERROR issue=#$issue repo=$(_repo_owner_repo "$repo") reason=\"$(_escape_quotes "$last_reason")\" evidence=\"$(_escape_quotes "$evidence_file")\""
    _resling_issue_claim_release "$claim_file"
    return 1
  fi

  dispatch_source_pr="$source_pr"
  source_pr_state=""
  bypass_reason_code=""
  if [[ -n "$source_pr" && "$source_pr" != "0" ]]; then
    source_pr_state="$(gh pr view "$source_pr" --repo "$repo" --json state --jq '.state // ""' 2>/dev/null || true)"
    if [[ "$source_pr_state" == "CLOSED" ]]; then
      dispatch_source_pr=""
      bypass_reason_code="source-pr-closed-dispatch-by-issue-id"
      _merge_queue_set_field "$evidence_file" "SOURCE_PR_STATE_AT_REPLAY" "$source_pr_state" || true
      _merge_queue_set_field "$evidence_file" "RESLING_SOURCE_PR_BYPASS" "true" || true
      _merge_queue_set_field "$evidence_file" "RESLING_SOURCE_PR_BYPASS_REASON_CODE" "$bypass_reason_code" || true
      echo "[refinery/$rig] conflict replay source PR #$source_pr is $source_pr_state — re-dispatching by issue id"
      log_event "REFINERY_CONFLICT_RESLING_SOURCE_PR_BYPASS issue=#$issue repo=$(_repo_owner_repo "$repo") source_pr=#$source_pr source_pr_state=$source_pr_state reason_code=$bypass_reason_code evidence=\"$(_escape_quotes "$evidence_file")\""
    fi
  fi

  _RESLING_LAST_POLECAT=""
  if _resling_existing_issue "$rig" "$issue" "$issue_title" "$repo" "$backend" "$dispatch_source_pr" "$source_event" "$source_event_key"; then
    _merge_queue_set_field "$evidence_file" "STATUS" "RESLING_DISPATCHED" || true
    _merge_queue_set_field "$evidence_file" "RESLING_DISPATCHED_POLECAT" "${_RESLING_LAST_POLECAT:-unknown}" || true
    _merge_queue_set_field "$evidence_file" "RESLING_COMPLETED_AT" "$(date -Iseconds)" || true
    _merge_queue_set_field "$evidence_file" "LAST_OUTCOME" "resling-dispatched" || true
    _merge_queue_set_field "$evidence_file" "LAST_REASON" "resling dispatched from conflict evidence" || true
    log_event "REFINERY_CONFLICT_RESLING_RESUMED issue=#$issue repo=$(_repo_owner_repo "$repo") source_pr=${dispatch_source_pr:-none} polecat=${_RESLING_LAST_POLECAT:-unknown} source_pr_state=${source_pr_state:-unknown} evidence=\"$(_escape_quotes "$evidence_file")\""
  else
    local stale_reason=""
    local skip_status="PENDING"
    local skip_reason="resling flow skipped by guardrail"
    local skip_outcome="resling-skipped"
    if existing_polecat=$(_resling_find_existing_issue_polecat "$rig" "$repo" "$issue"); then
      skip_status="RESLING_DISPATCHED"
      skip_outcome="dedupe-existing-polecat"
      skip_reason="active polecat already exists for issue"
      _merge_queue_set_field "$evidence_file" "RESLING_DISPATCHED_POLECAT" "$existing_polecat" || true
    elif ! _has_sgt_authorized "$repo" "$issue"; then
      skip_status="SKIPPED_UNAUTHORIZED"
      skip_reason="issue lacks sgt-authorized label"
    elif ! stale_reason=$(_resling_pre_dispatch_revalidate "$rig" "$repo" "$issue" "$source_pr"); then
      skip_status="SKIPPED_STALE"
      skip_reason="$stale_reason"
    fi
    _merge_queue_set_field "$evidence_file" "STATUS" "$skip_status" || true
    _merge_queue_set_field "$evidence_file" "LAST_OUTCOME" "$skip_outcome" || true
    _merge_queue_set_field "$evidence_file" "LAST_REASON" "$skip_reason" || true
    log_event "REFINERY_CONFLICT_RESLING_SKIPPED issue=#$issue repo=$(_repo_owner_repo "$repo") status=$skip_status reason=\"$(_escape_quotes "$skip_reason")\" evidence=\"$(_escape_quotes "$evidence_file")\""
  fi

  _resling_issue_claim_release "$claim_file"
  return 0
}

_refinery_conflict_replay_pending() {
  local rig="${1:-}" evidence_dir="${SGT_CONFIG}/refinery-conflicts" evidence_file
  [[ -d "$evidence_dir" ]] || return 0
  for evidence_file in "$evidence_dir"/*.state; do
    [[ -f "$evidence_file" ]] || continue
    _refinery_conflict_resling_resume "$rig" "$evidence_file" || true
  done
}

_refinery_merge_retry_max_attempts() {
  local raw="${SGT_REFINERY_MERGE_MAX_ATTEMPTS:-3}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=3
  (( raw < 1 )) && raw=1
  echo "$raw"
}

_refinery_merge_retry_base_ms() {
  local raw="${SGT_REFINERY_MERGE_RETRY_BASE_MS:-1000}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=1000
  echo "$raw"
}

_refinery_merge_retry_jitter_ms() {
  local raw="${SGT_REFINERY_MERGE_RETRY_JITTER_MS:-400}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=400
  echo "$raw"
}

_refinery_merge_retry_delay_secs() {
  local attempt="${1:-1}"
  local base_ms jitter_ms scaled_base jitter_ms_actual total_ms
  [[ "$attempt" =~ ^[0-9]+$ ]] || attempt=1
  (( attempt < 1 )) && attempt=1
  base_ms="$(_refinery_merge_retry_base_ms)"
  jitter_ms="$(_refinery_merge_retry_jitter_ms)"
  scaled_base=$((base_ms * attempt))
  jitter_ms_actual=0
  if (( jitter_ms > 0 )); then
    jitter_ms_actual=$((RANDOM % (jitter_ms + 1)))
  fi
  total_ms=$((scaled_base + jitter_ms_actual))
  printf '%d.%03d' "$((total_ms / 1000))" "$((total_ms % 1000))"
}

_refinery_unclear_retry_max_attempts() {
  local raw="${SGT_REFINERY_REVIEW_UNCLEAR_MAX_RETRIES:-5}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=5
  (( raw < 1 )) && raw=1
  echo "$raw"
}

_refinery_unclear_retry_base_secs() {
  local raw="${SGT_REFINERY_REVIEW_UNCLEAR_BACKOFF_BASE_SECS:-30}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=30
  echo "$raw"
}

_refinery_unclear_retry_max_backoff_secs() {
  local raw="${SGT_REFINERY_REVIEW_UNCLEAR_BACKOFF_MAX_SECS:-600}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=600
  (( raw < 0 )) && raw=0
  echo "$raw"
}

_refinery_unclear_retry_jitter_secs() {
  local raw="${SGT_REFINERY_REVIEW_UNCLEAR_JITTER_SECS:-15}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=15
  echo "$raw"
}

_refinery_unclear_retry_delay_secs() {
  local attempt="${1:-1}"
  local base_secs max_secs jitter_secs exponent base_delay jitter_delay total_delay
  [[ "$attempt" =~ ^[0-9]+$ ]] || attempt=1
  (( attempt < 1 )) && attempt=1
  base_secs="$(_refinery_unclear_retry_base_secs)"
  max_secs="$(_refinery_unclear_retry_max_backoff_secs)"
  jitter_secs="$(_refinery_unclear_retry_jitter_secs)"
  exponent=$((attempt - 1))
  if (( exponent > 20 )); then
    exponent=20
  fi
  base_delay=$((base_secs * (2 ** exponent)))
  if (( max_secs > 0 && base_delay > max_secs )); then
    base_delay="$max_secs"
  fi
  jitter_delay=0
  if (( jitter_secs > 0 )); then
    jitter_delay=$((RANDOM % (jitter_secs + 1)))
  fi
  total_delay=$((base_delay + jitter_delay))
  if (( max_secs > 0 && total_delay > max_secs )); then
    total_delay="$max_secs"
  fi
  echo "$total_delay"
}

_refinery_checks_class() {
  local checks_raw="${1:-}" lc
  lc="$(printf '%s' "$checks_raw" | tr '[:upper:]' '[:lower:]')"
  if [[ -z "$lc" ]]; then
    echo "unknown"
    return 0
  fi
  if [[ "$lc" =~ fail|failed|error|timed[[:space:]-]*out|cancelled|canceled|startup_failure ]]; then
    echo "failing"
    return 0
  fi
  if [[ "$lc" =~ queued|in[[:space:]-]*progress|pending|requested|expected|waiting ]]; then
    echo "pending"
    return 0
  fi
  if [[ "$lc" =~ no[[:space:]]+checks|no[[:space:]]+status[[:space:]]+checks ]]; then
    echo "missing"
    return 0
  fi
  if [[ "$lc" =~ pass|successful|all[[:space:]]+checks[[:space:]]+pass|all[[:space:]]+checks[[:space:]]+were[[:space:]]+successful ]]; then
    echo "green"
    return 0
  fi
  echo "unknown"
}

_refinery_unclear_class_explicit_error_gate() {
  local klass="${1:-}"
  case "$klass" in
    invalid-multiple-verdicts)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

_refinery_review_contract_classify() {
  local review_output="${1:-}" review_rc="${2:-0}"
  local approve_count reject_count
  approve_count=$(printf '%s\n' "$review_output" | grep -Ec '^[[:space:]]*VERDICT:[[:space:]]*APPROVE([[:space:]]|$)' || true)
  reject_count=$(printf '%s\n' "$review_output" | grep -Ec '^[[:space:]]*VERDICT:[[:space:]]*REJECT([[:space:]]|$)' || true)

  if (( review_rc == 124 )); then
    echo "review-timeout|review command timed out"
    return 0
  fi
  if [[ -z "${review_output//[[:space:]]/}" ]]; then
    echo "empty-output|review output empty"
    return 0
  fi
  if (( approve_count == 1 && reject_count == 0 )); then
    echo "approve|approved"
    return 0
  fi
  if (( reject_count == 1 && approve_count == 0 )); then
    echo "reject|rejected"
    return 0
  fi
  if (( approve_count > 0 && reject_count > 0 )); then
    echo "invalid-multiple-verdicts|review output has conflicting verdicts"
    return 0
  fi
  echo "missing-structured-verdict|review output missing explicit structured verdict"
}

_refinery_merge_error_class() {
  local raw="${1:-}" lc
  lc="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  if [[ "$lc" =~ secondary[[:space:]-]*rate[[:space:]-]*limit|abuse[[:space:]]+detection ]]; then
    echo "secondary-rate-limit"
  elif [[ "$lc" =~ timed?[[:space:]-]*out|timeout|deadline[[:space:]]+exceeded ]]; then
    echo "timeout"
  elif [[ "$lc" =~ (^|[^0-9])5[0-9][0-9]([^0-9]|$)|http[[:space:]]*5[0-9][0-9]|server[[:space:]]+error|bad[[:space:]]+gateway|service[[:space:]]+unavailable|gateway[[:space:]]+timeout ]]; then
    echo "http-5xx"
  elif [[ "$lc" =~ connection[[:space:]]+reset|connection[[:space:]]+refused|network[[:space:]]+is[[:space:]]+unreachable|temporary[[:space:]]+failure|no[[:space:]]+such[[:space:]]+host|tls|eof|i/o[[:space:]]+timeout|context[[:space:]]+canceled ]]; then
    echo "network"
  elif [[ "$lc" =~ merge[[:space:]-]*conflict|not[[:space:]]+mergeable|conflicting[[:space:]]+files|cannot[[:space:]]+be[[:space:]]+merged ]]; then
    echo "merge-conflict"
  else
    echo "non-transient"
  fi
}

_refinery_merge_error_is_conflict() {
  local raw="${1:-}" klass
  klass="$(_refinery_merge_error_class "$raw")"
  [[ "$klass" == "merge-conflict" ]]
}

_refinery_merge_error_is_transient() {
  local klass="${1:-}"
  case "$klass" in
    timeout|network|http-5xx|secondary-rate-limit) return 0 ;;
    *) return 1 ;;
  esac
}

_refinery_merge_error_requires_auto_retry_reason() {
  local raw="${1:-}" lc
  lc="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  if [[ "$lc" =~ requires?[[:space:]-]*auto[[:space:]-]*merge|auto[[:space:]-]*merge[[:space:]]+is[[:space:]]+required|must[[:space:]]+use[[:space:]-]*auto[[:space:]-]*merge|branch[[:space:]]+policy[^[:cntrl:]]*auto[[:space:]-]*merge|enable[[:space:]]+pull[[:space:]]+request[[:space:]-]*auto[[:space:]-]*merge|enablepullrequestautomerge ]]; then
    echo "branch-policy-requires-auto-merge"
    return 0
  fi
  return 1
}

_refinery_revalidate_pr_open_head() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}" expected_head_sha="${4:-}" queue_file="${5:-}"
  local canonical_repo live_snapshot live_state live_head_sha resolve_meta resolve_code resolve_reason
  if ! canonical_repo="$(_resolve_rig_repo_canonical "refinery-open-pr-revalidate" "$rig" "$repo" "1")"; then
    resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_repo")"
    IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
    echo "${resolve_reason:-unable to resolve rig repo}"
    return 1
  fi
  live_snapshot=$(gh pr view "$pr" --repo "$canonical_repo" --json state,headRefOid --jq '.state + "|" + (.headRefOid // "")' 2>/dev/null || true)
  if [[ -z "$live_snapshot" || "$live_snapshot" != *"|"* ]]; then
    echo "unable to query live PR state"
    return 1
  fi
  IFS='|' read -r live_state live_head_sha <<< "$live_snapshot"
  if [[ "$live_state" != "OPEN" ]]; then
    echo "pr state drifted to ${live_state:-unknown}"
    return 1
  fi
  if [[ -n "$expected_head_sha" && "$live_head_sha" != "$expected_head_sha" ]]; then
    if [[ -n "$queue_file" ]]; then
      _merge_queue_set_head_sha "$queue_file" "$live_head_sha" || true
    fi
    echo "head sha drifted expected=${expected_head_sha:-unknown} live=${live_head_sha:-unknown}"
    return 1
  fi
  echo "$live_head_sha"
}

_refinery_premerge_revalidate_reviewed_head() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}" reviewed_head_sha="${4:-}" queue_file="${5:-}"
  local canonical_repo live_snapshot live_state live_head_sha resolve_meta resolve_code resolve_reason
  if ! canonical_repo="$(_resolve_rig_repo_canonical "refinery-open-pr-reviewed-head-revalidate" "$rig" "$repo" "1")"; then
    resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_repo")"
    IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
    echo "${resolve_reason:-unable to resolve rig repo}"
    return 1
  fi
  live_snapshot=$(gh pr view "$pr" --repo "$canonical_repo" --json state,headRefOid --jq '.state + "|" + (.headRefOid // "")' 2>/dev/null || true)
  if [[ -z "$live_snapshot" || "$live_snapshot" != *"|"* ]]; then
    echo "unable to query live PR state"
    return 1
  fi
  IFS='|' read -r live_state live_head_sha <<< "$live_snapshot"
  if [[ "$live_state" != "OPEN" ]]; then
    echo "pr state drifted to ${live_state:-unknown}"
    return 1
  fi
  if [[ -z "$reviewed_head_sha" ]]; then
    echo "missing reviewed head sha"
    return 1
  fi
  if [[ "$live_head_sha" != "$reviewed_head_sha" ]]; then
    if [[ -n "$queue_file" ]]; then
      _merge_queue_set_head_sha "$queue_file" "$live_head_sha" || true
    fi
