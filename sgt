_mayor_notify_classify_receipt() {
  local send_rc="${1:-1}" details="${2:-}" details_one_line details_lower json_delivered="" json_delivery_status="" json_delivery_error=""
  _MAYOR_NOTIFY_CLASSIFY_OUTCOME="transport-failure"
  _MAYOR_NOTIFY_CLASSIFY_REASON="transport-command-failed"
  _MAYOR_NOTIFY_CLASSIFY_MATCHER="transport-command-failed"
  details_one_line="$(_one_line "$details")"
  details_lower="$(printf '%s' "$details_one_line" | tr '[:upper:]' '[:lower:]')"
  json_delivered="$(_mayor_notify_receipt_json_bool "$details_one_line" "delivered" 2>/dev/null || true)"
  json_delivery_status="$(_mayor_notify_receipt_json_string "$details_one_line" "deliveryStatus" 2>/dev/null || true)"
  json_delivery_error="$(_mayor_notify_receipt_json_string "$details_one_line" "deliveryError" 2>/dev/null || true)"

  if [[ "$send_rc" -eq 0 ]]; then
    if [[ "$details_lower" =~ stale[[:space:]_-]*ack|ack[[:space:]_-]*stale|mismatched[[:space:]_-]*ack ]]; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="stale-ack"
      _MAYOR_NOTIFY_CLASSIFY_REASON="stale-ack"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="stale-ack-pattern"
    elif [[ "$json_delivered" == "false" && "$json_delivery_status" == "not-delivered" ]]; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="missing-ack"
      _MAYOR_NOTIFY_CLASSIFY_REASON="missing-ack"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="json-not-delivered"
    elif [[ "$json_delivered" == "true" ]]; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="json-delivered-true"
    elif [[ "$json_delivery_status" == "delivered" ]]; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="json-delivery-status"
    elif [[ "$json_delivery_status" == "not-delivered" || -n "$json_delivery_error" ]]; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="missing-ack"
      _MAYOR_NOTIFY_CLASSIFY_REASON="missing-ack"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="json-delivery-error"
    elif [[ "$details_lower" =~ (^|[^[:alnum:]_])ack[[:space:]]*=[[:space:]]*(delivered|ok|true|1)([^[:alnum:]_]|$) ]]; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="ack-assignment"
    elif [[ "$details_lower" =~ (^|[^[:alnum:]_])message_id([^[:alnum:]_]|$)|(^|[^[:alnum:]_])delivery_id([^[:alnum:]_]|$)|(^|[^[:alnum:]_])receipt([^[:alnum:]_]|$)|(^|[^[:alnum:]_])delivered([^[:alnum:]_]|$) ]]; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="receipt-identifier"
    elif _mayor_notify_receipt_has_token "$details_lower" "ack"; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="ack-token"
    elif _mayor_notify_receipt_has_token "$details_lower" "copy"; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="copy-token"
    elif _mayor_notify_receipt_has_token "$details_lower" "received"; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="received-token"
    elif _mayor_notify_receipt_has_token "$details_lower" "roger"; then
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="roger-token"
    else
      _MAYOR_NOTIFY_CLASSIFY_OUTCOME="delivered"
      _MAYOR_NOTIFY_CLASSIFY_REASON="ack-verified"
      _MAYOR_NOTIFY_CLASSIFY_MATCHER="transport-exit-zero"
    fi
    return 0
  fi

  if _mayor_notify_is_transient_failure "$details_one_line"; then
    _MAYOR_NOTIFY_CLASSIFY_OUTCOME="transport-failure"
    _MAYOR_NOTIFY_CLASSIFY_REASON="transport-transient-failure"
    _MAYOR_NOTIFY_CLASSIFY_MATCHER="transient-transport-pattern"
  else
    _MAYOR_NOTIFY_CLASSIFY_OUTCOME="transport-failure"
    _MAYOR_NOTIFY_CLASSIFY_REASON="transport-hard-failure"
    _MAYOR_NOTIFY_CLASSIFY_MATCHER="hard-transport-pattern"
  fi
}

_mayor_dispatch_trigger_key() {
  local reason="${1:-}" pr repo merged_head owner_repo
  if [[ "$reason" =~ ^merged:pr#([0-9]+):# ]]; then
    pr="${BASH_REMATCH[1]}"
  else
    return 1
  fi
  repo="$(_wake_field "$reason" "repo")"
  merged_head="$(_wake_field "$reason" "merged_head")"
  [[ -n "$repo" && -n "$merged_head" ]] || return 1
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  echo "${owner_repo}|pr=${pr}|merged_head=${merged_head}"
}

_mayor_dispatch_trigger_key_id() {
  local key="${1:-}"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$key" | sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$key" | shasum -a 256 | awk '{print $1}'
  else
    printf '%s' "$key" | tr -c '[:alnum:]_.-' '_'
  fi
}

_mayor_dispatch_trigger_claim() {
  local reason="${1:-}" key key_id key_dir key_file
  _MAYOR_DISPATCH_TRIGGER_KEY=""
  _MAYOR_DISPATCH_TRIGGER_FILE=""
  key="$(_mayor_dispatch_trigger_key "$reason" || true)"
  [[ -n "$key" ]] || return 2
  key_id="$(_mayor_dispatch_trigger_key_id "$key")"
  key_dir="$(_mayor_scope_dir)/mayor-dispatch-triggers"
  key_file="$key_dir/$key_id"
  mkdir -p "$key_dir" || return 2
  _MAYOR_DISPATCH_TRIGGER_KEY="$key"
  _MAYOR_DISPATCH_TRIGGER_FILE="$key_file"
  if ! ( set -o noclobber; : > "$key_file" ) 2>/dev/null; then
    return 1
  fi
  cat > "$key_file" <<EOF
KEY=$key
REASON=$reason
CLAIMED_AT=$(date -Iseconds)
EOF
  return 0
}

_mayor_dispatch_attempts_dir() {
  echo "$(_mayor_scope_dir)/mayor-dispatch-attempts"
}

_mayor_dispatch_verify_timeout_secs() {
  local raw="${SGT_MAYOR_DISPATCH_VERIFY_TIMEOUT_SECS:-120}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw="120"
  echo "$raw"
}

_mayor_dispatch_attempt_key() {
  local repo="${1:-}" issue="${2:-}" trigger_key="${3:-}"
  local owner_repo
  [[ -n "$repo" && -n "$issue" && -n "$trigger_key" ]] || return 1
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  echo "${owner_repo}|issue=${issue}|trigger=${trigger_key}"
}

_mayor_dispatch_attempt_claim() {
  local repo="${1:-}" issue="${2:-}" trigger_key="${3:-}" trigger_reason="${4:-}"
  local rig="${5:-}" issue_url="${6:-}" polecat="${7:-}" session="${8:-}" status="${9:-PENDING}"
  local key key_id dir file now_iso now_ts timeout_secs deadline_ts
  _MAYOR_DISPATCH_ATTEMPT_KEY=""
  _MAYOR_DISPATCH_ATTEMPT_FILE=""
  key="$(_mayor_dispatch_attempt_key "$repo" "$issue" "$trigger_key" || true)"
  [[ -n "$key" ]] || return 2
  key_id="$(_mayor_dispatch_trigger_key_id "$key")"
  dir="$(_mayor_dispatch_attempts_dir)"
  file="$dir/$key_id.state"
  mkdir -p "$dir" || return 2
  _MAYOR_DISPATCH_ATTEMPT_KEY="$key"
  _MAYOR_DISPATCH_ATTEMPT_FILE="$file"
  if ! ( set -o noclobber; : > "$file" ) 2>/dev/null; then
    return 1
  fi
  now_iso="$(date -Iseconds)"
  now_ts="$(date +%s)"
  timeout_secs="$(_mayor_dispatch_verify_timeout_secs)"
  deadline_ts=$((now_ts + timeout_secs))
  cat > "$file" <<EOF
KEY=$key
REPO=$repo
ISSUE=$issue
RIG=$rig
ISSUE_URL=$issue_url
TRIGGER_KEY=$trigger_key
TRIGGER_REASON=$trigger_reason
DISPATCHED_POLECAT=$polecat
DISPATCHED_SESSION=$session
VERIFY_TIMEOUT_SECS=$timeout_secs
VERIFY_STARTED_TS=$now_ts
VERIFY_STARTED_AT=$now_iso
VERIFY_DEADLINE_TS=$deadline_ts
VERIFY_STATUS=$status
VERIFY_REASON=awaiting-active-polecat
RETRY_COUNT=0
RETRY_STATUS=none
LAST_UPDATED_AT=$now_iso
EOF
  return 0
}

_mayor_dispatch_attempt_mark() {
  local file="${1:-}" status="${2:-}" reason="${3:-}" deadline_ts="${4:-}"
  [[ -n "$file" && -f "$file" && -n "$status" ]] || return 1
  _merge_queue_set_field "$file" "VERIFY_STATUS" "$status" || return 1
  _merge_queue_set_field "$file" "VERIFY_REASON" "$reason" || return 1
  if [[ -n "$deadline_ts" ]]; then
    _merge_queue_set_field "$file" "VERIFY_DEADLINE_TS" "$deadline_ts" || return 1
  fi
  _merge_queue_set_field "$file" "LAST_UPDATED_AT" "$(date -Iseconds)" || return 1
}

_mayor_dispatch_attempt_active_signal() {
  local repo="${1:-}" issue="${2:-}" rig="${3:-}" session="${4:-}"
  local existing_polecat
  if existing_polecat="$(_resling_find_existing_issue_polecat "$rig" "$repo" "$issue" 2>/dev/null || true)" && [[ -n "$existing_polecat" ]]; then
    echo "active-polecat|$existing_polecat"
    return 0
  fi
  if [[ -n "$session" ]] && tmux has-session -t "$session" 2>/dev/null; then
    echo "active-session|$session"
    return 0
  fi
  echo "inactive|none"
  return 1
}

_mayor_dispatch_attempt_retry_once() {
  local file="${1:-}"
  local repo="" issue="" rig="" trigger_key="" retry_count="" session="" verify_timeout="" issue_title=""
  local now_ts now_iso deadline_ts
  [[ -n "$file" && -f "$file" ]] || return 1
  eval "$(grep -E '^(REPO|ISSUE|RIG|TRIGGER_KEY|RETRY_COUNT|DISPATCHED_SESSION|VERIFY_TIMEOUT_SECS)=' "$file" 2>/dev/null || true)"
  repo="${REPO:-}"
  issue="${ISSUE:-}"
  rig="${RIG:-}"
  trigger_key="${TRIGGER_KEY:-}"
  retry_count="${RETRY_COUNT:-0}"
  session="${DISPATCHED_SESSION:-}"
  verify_timeout="${VERIFY_TIMEOUT_SECS:-$(_mayor_dispatch_verify_timeout_secs)}"
  [[ "$retry_count" =~ ^[0-9]+$ ]] || retry_count=0
  [[ "$verify_timeout" =~ ^[0-9]+$ ]] || verify_timeout="$(_mayor_dispatch_verify_timeout_secs)"
  if (( retry_count >= 1 )); then
    _mayor_dispatch_attempt_mark "$file" "FAILED_TIMEOUT" "retry-budget-exhausted" || true
    log_event "MAYOR_DISPATCH_VERIFY_FAIL reason=retry-budget-exhausted issue=#${issue:-unknown} trigger_key=\"$(_escape_quotes "$trigger_key")\" record=\"$(_escape_quotes "$file")\""
    return 1
  fi
  now_ts="$(date +%s)"
  now_iso="$(date -Iseconds)"
  _merge_queue_set_field "$file" "RETRY_COUNT" "1" || true
  _merge_queue_set_field "$file" "RETRY_STATUS" "in-progress" || true
  _merge_queue_set_field "$file" "RETRY_STARTED_TS" "$now_ts" || true
  _merge_queue_set_field "$file" "RETRY_STARTED_AT" "$now_iso" || true
  _merge_queue_set_field "$file" "LAST_UPDATED_AT" "$now_iso" || true

  issue_title="$(gh issue view "$issue" --repo "$repo" --json title --jq '.title // ""' 2>/dev/null || true)"
  if [[ -z "$issue_title" ]]; then
    _merge_queue_set_field "$file" "RETRY_STATUS" "failed-title-lookup" || true
    _mayor_dispatch_attempt_mark "$file" "FAILED_TIMEOUT" "retry-title-lookup-failed" || true
    log_event "MAYOR_DISPATCH_VERIFY_FAIL reason=retry-title-lookup-failed issue=#${issue:-unknown} repo=\"$(_escape_quotes "$repo")\" trigger_key=\"$(_escape_quotes "$trigger_key")\""
    return 1
  fi

  if _resling_existing_issue "$rig" "$issue" "$issue_title" "$repo" "$(_ai_backend_default)" "" "mayor-dispatch-verify-timeout" "${trigger_key:-mayor-dispatch-verify-timeout}"; then
    deadline_ts=$((now_ts + verify_timeout))
    _merge_queue_set_field "$file" "DISPATCHED_POLECAT" "${_RESLING_LAST_POLECAT:-}" || true
    if [[ -n "${_RESLING_LAST_POLECAT:-}" ]]; then
      _merge_queue_set_field "$file" "DISPATCHED_SESSION" "sgt-${_RESLING_LAST_POLECAT}" || true
    fi
    _merge_queue_set_field "$file" "RETRY_STATUS" "dispatched" || true
    _merge_queue_set_field "$file" "RETRY_COMPLETED_AT" "$(date -Iseconds)" || true
    _mayor_dispatch_attempt_mark "$file" "RETRY_PENDING" "retry-dispatched-awaiting-active-polecat" "$deadline_ts" || true
    log_event "MAYOR_DISPATCH_VERIFY_RETRY issue=#${issue:-unknown} repo=\"$(_escape_quotes "$repo")\" trigger_key=\"$(_escape_quotes "$trigger_key")\" retry_count=1 status=dispatched"
    return 0
  fi

  if _mayor_dispatch_attempt_active_signal "$repo" "$issue" "$rig" "$session" >/dev/null; then
    _merge_queue_set_field "$file" "RETRY_STATUS" "deduped-active" || true
    _mayor_dispatch_attempt_mark "$file" "VERIFIED" "active-work-exists-after-retry-guard" || true
    log_event "MAYOR_DISPATCH_VERIFY_SUCCESS issue=#${issue:-unknown} repo=\"$(_escape_quotes "$repo")\" trigger_key=\"$(_escape_quotes "$trigger_key")\" reason=active-work-exists-after-retry-guard"
    return 0
  fi

  _merge_queue_set_field "$file" "RETRY_STATUS" "failed-dispatch" || true
  _mayor_dispatch_attempt_mark "$file" "FAILED_TIMEOUT" "retry-dispatch-failed" || true
  log_event "MAYOR_DISPATCH_VERIFY_FAIL reason=retry-dispatch-failed issue=#${issue:-unknown} repo=\"$(_escape_quotes "$repo")\" trigger_key=\"$(_escape_quotes "$trigger_key")\""
  return 1
}

_mayor_dispatch_verify_replay() {
  local dir file repo issue rig trigger_key verify_status verify_deadline session retry_count now_ts timeout_reason signal_type signal_value
  dir="$(_mayor_dispatch_attempts_dir)"
  [[ -d "$dir" ]] || return 0
  now_ts="$(date +%s)"
  for file in "$dir"/*.state; do
    [[ -f "$file" ]] || continue
    repo=""
    issue=""
    rig=""
    trigger_key=""
    verify_status=""
    verify_deadline=""
    session=""
    retry_count=""
    eval "$(grep -E '^(REPO|ISSUE|RIG|TRIGGER_KEY|VERIFY_STATUS|VERIFY_DEADLINE_TS|DISPATCHED_SESSION|RETRY_COUNT)=' "$file" 2>/dev/null || true)"
    repo="${REPO:-}"
    issue="${ISSUE:-}"
    rig="${RIG:-}"
    trigger_key="${TRIGGER_KEY:-}"
    verify_status="${VERIFY_STATUS:-PENDING}"
    verify_deadline="${VERIFY_DEADLINE_TS:-0}"
    session="${DISPATCHED_SESSION:-}"
    retry_count="${RETRY_COUNT:-0}"
    [[ "$retry_count" =~ ^[0-9]+$ ]] || retry_count=0
    [[ "$verify_deadline" =~ ^[0-9]+$ ]] || verify_deadline=0

    case "$verify_status" in
      VERIFIED|FAILED_TIMEOUT|SKIPPED)
        continue
        ;;
    esac

    if [[ -z "$repo" || -z "$issue" || -z "$trigger_key" ]]; then
      _mayor_dispatch_attempt_mark "$file" "SKIPPED" "invalid-record-missing-required-fields" || true
      log_event "MAYOR_DISPATCH_VERIFY_SKIP reason=invalid-record-missing-required-fields record=\"$(_escape_quotes "$file")\""
      continue
    fi

    local signal_line=""
    if signal_line="$(_mayor_dispatch_attempt_active_signal "$repo" "$issue" "$rig" "$session" 2>/dev/null)"; then
      IFS='|' read -r signal_type signal_value <<< "$signal_line"
      _mayor_dispatch_attempt_mark "$file" "VERIFIED" "$signal_type:${signal_value:-unknown}" || true
      log_event "MAYOR_DISPATCH_VERIFY_SUCCESS issue=#$issue repo=\"$(_escape_quotes "$repo")\" trigger_key=\"$(_escape_quotes "$trigger_key")\" signal=$signal_type value=\"$(_escape_quotes "$signal_value")\""
      _mayor_record_decision "MAYOR DISPATCH VERIFY success issue=#$issue trigger_key=$trigger_key signal=$signal_type value=${signal_value:-unknown}" "dispatch-verify-success" "$SGT_ROOT" || true
      continue
    fi

    if (( verify_deadline > 0 && now_ts < verify_deadline )); then
      continue
    fi

    timeout_reason="verify-timeout-no-active-work"
    log_event "MAYOR_DISPATCH_VERIFY_TIMEOUT issue=#$issue repo=\"$(_escape_quotes "$repo")\" trigger_key=\"$(_escape_quotes "$trigger_key")\" retry_count=$retry_count reason=$timeout_reason"
    _mayor_record_decision "MAYOR DISPATCH VERIFY timeout issue=#$issue trigger_key=$trigger_key retry_count=$retry_count reason=$timeout_reason" "dispatch-verify-timeout" "$SGT_ROOT" || true
    _mayor_dispatch_attempt_retry_once "$file" || true
  done
}

_mayor_reconcile_triggered_by_transition() {
  local wake_reason="${1:-}"
  shift || true
  local event_reason
  if [[ "$wake_reason" == "periodic" ]]; then
    return 1
  fi
  for event_reason in "$@"; do
    if [[ "$event_reason" == merged:* || "$event_reason" == dog-approved:* ]]; then
      return 0
    fi
  done
  return 1
}

_mayor_stale_polecat_fence_dir() {
  echo "$SGT_CONFIG/mayor-stale-polecat-fence"
}

_mayor_stale_polecat_fence_key() {
  local repo="${1:-}" issue="${2:-}" branch="${3:-}" polecat="${4:-}"
  local owner_repo
  owner_repo="$(_repo_owner_repo "$repo")"
  echo "${owner_repo}|issue=${issue}|branch=${branch}|polecat=${polecat}"
}

_mayor_stale_polecat_pr_snapshot() {
  local rig="${1:-}" repo="${2:-}" branch="${3:-}"
  local canonical_repo snapshot resolve_meta resolve_code resolve_reason
  if ! canonical_repo="$(_resolve_rig_repo_canonical "mayor-stale-polecat-open-pr" "$rig" "$repo" "1")"; then
    resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_repo")"
    IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
    echo "ERROR|${resolve_code:-unknown}|${resolve_reason:-unable to resolve rig repo}"
    return 1
  fi
  snapshot=$(
    gh pr list --repo "$canonical_repo" --head "$branch" --state all \
      --json number,state \
      --jq 'if length == 0 then "0|" else ((.[0].number|tostring) + "|" + (.[0].state // "")) end' 2>/dev/null || true
  )
  if [[ -z "$snapshot" || "$snapshot" != *"|"* ]]; then
    echo "ERROR|live-query-failed|unable to query live PR state"
    return 1
  fi
  echo "$snapshot"
}

_cleanup_failed_polecat_dispatch() {
  local pfile="${1:-}" pname="${2:-}" rig="${3:-}" branch="${4:-}" session="${5:-}" worktree="${6:-}"
  local rpath=""

  if [[ -n "$session" ]] && tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session" 2>/dev/null || true
  fi

  if [[ -n "$rig" ]]; then
    rpath="$(rig_path "$rig" 2>/dev/null || true)"
  fi

  if [[ -n "$worktree" && -d "$worktree" ]]; then
    if [[ -n "$rpath" ]]; then
      git -C "$rpath" worktree remove --force "$worktree" 2>/dev/null || rm -rf "$worktree" 2>/dev/null || true
    else
      rm -rf "$worktree" 2>/dev/null || true
    fi
  fi

  rm -f "$pfile" 2>/dev/null || true

  if [[ -n "$rpath" && -n "$branch" ]]; then
    git -C "$rpath" branch -D "$branch" 2>/dev/null || true
  fi
}

_mayor_cleanup_stale_polecat() {
  local pfile="${1:-}" pname="${2:-}" rig="${3:-}" repo="${4:-}" issue="${5:-}" branch="${6:-}" session="${7:-}" worktree="${8:-}" reason_code="${9:-}" issue_state="${10:-}" pr_number="${11:-}" pr_state="${12:-}"
  local owner_repo key key_id fence_dir cleanup_marker decision_marker action
  local -a action_parts=()

  owner_repo="$(_repo_owner_repo "$repo")"
  key="$(_mayor_stale_polecat_fence_key "$repo" "$issue" "$branch" "$pname")"
  key_id="$(_mayor_dispatch_trigger_key_id "$key")"
  fence_dir="$(_mayor_stale_polecat_fence_dir)"
  mkdir -p "$fence_dir" || return 1
  cleanup_marker="$fence_dir/${key_id}.cleanup"
  decision_marker="$fence_dir/${key_id}.decision"

  if [[ -f "$cleanup_marker" ]]; then
    action="cleanup-already-applied"
    rm -f "$pfile" 2>/dev/null || true
  else
    if [[ -n "$session" ]] && tmux has-session -t "$session" 2>/dev/null; then
      tmux kill-session -t "$session" 2>/dev/null || true
      action_parts+=("killed-session")
    else
      action_parts+=("session-not-running")
    fi

    if [[ -n "$worktree" && -d "$worktree" ]]; then
      local rpath
      rpath=""
      if [[ -n "$rig" ]]; then
        rpath="$(rig_path "$rig" 2>/dev/null || true)"
      fi
      if [[ -n "$rpath" ]]; then
        git -C "$rpath" worktree remove --force "$worktree" 2>/dev/null || rm -rf "$worktree" 2>/dev/null || true
      else
        rm -rf "$worktree" 2>/dev/null || true
      fi
      action_parts+=("removed-worktree")
    else
      action_parts+=("worktree-missing")
    fi

    if rm -f "$pfile" 2>/dev/null || [[ ! -f "$pfile" ]]; then
      action_parts+=("removed-state")
    else
      action_parts+=("state-remove-failed")
      action="$(IFS=+; echo "${action_parts[*]}")"
      return 1
    fi

    action="$(IFS=+; echo "${action_parts[*]}")"
    cat > "$cleanup_marker" <<EOF
KEY=$key
POLECAT=$pname
REASON_CODE=$reason_code
ACTION=$action
UPDATED_AT=$(date -Iseconds)
EOF
  fi

  if [[ ! -f "$decision_marker" ]]; then
    _mayor_record_decision "MAYOR POLECAT CLEANUP reason_code=$reason_code polecat=$pname repo=$owner_repo issue=#${issue:-unknown} pr=#${pr_number:-unknown} branch=\"$(_escape_quotes "$branch")\" issue_state=${issue_state:-unknown} pr_state=${pr_state:-unknown} action=$action" "stale-polecat-cleanup" "$SGT_ROOT" || true
    log_event "MAYOR_POLECAT_CLEANUP reason_code=$reason_code polecat=$pname repo=$owner_repo issue=#${issue:-unknown} pr=#${pr_number:-unknown} branch=\"$(_escape_quotes "$branch")\" issue_state=${issue_state:-unknown} pr_state=${pr_state:-unknown} action=$action"
    cat > "$decision_marker" <<EOF
KEY=$key
POLECAT=$pname
REASON_CODE=$reason_code
ACTION=$action
UPDATED_AT=$(date -Iseconds)
EOF
  fi

  printf 'CLEANED|%s|%s|%s|%s|%s\n' "$pname" "$reason_code" "$action" "${issue:-}" "${pr_number:-}"
}

_mayor_reconcile_stale_polecats() {
  local pfile pname snapshot rig repo issue branch session worktree status canonical_repo resolve_meta resolve_code resolve_reason
  for pfile in "$SGT_POLECATS"/*; do
    [[ -f "$pfile" ]] || continue
    pname="$(basename "$pfile")"
    snapshot="$(
      (
        source "$pfile"
        printf '%s|%s|%s|%s|%s|%s|%s\n' "${RIG:-}" "${REPO:-}" "${ISSUE:-}" "${BRANCH:-}" "${SESSION:-}" "${WORKTREE:-}" "${STATUS:-}"
      ) 2>/dev/null
    )"
    IFS='|' read -r rig repo issue branch session worktree status <<< "$snapshot"
    [[ -n "$branch" ]] || continue
    if [[ -n "$session" ]] && tmux has-session -t "$session" 2>/dev/null; then
      continue
    fi
    if ! canonical_repo="$(_resolve_rig_repo_canonical "mayor-stale-polecat-open-issue" "$rig" "$repo" "1")"; then
      resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_repo")"
      IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
      echo "[mayor] stale polecat skip $pname — ${resolve_reason:-unable to resolve rig repo} (reason_code=${resolve_code:-unknown})" >&2
      continue
    fi

    local issue_state pr_snapshot pr_number pr_state reason_code
    issue_state=""
    if [[ "$issue" =~ ^[0-9]+$ && "$issue" != "0" ]]; then
      issue_state=$(gh issue view "$issue" --repo "$canonical_repo" --json state --jq '.state // ""' 2>/dev/null || true)
    fi

    if ! pr_snapshot="$(_mayor_stale_polecat_pr_snapshot "$rig" "$canonical_repo" "$branch")"; then
      echo "[mayor] stale polecat skip $pname — ${pr_snapshot#ERROR|}" >&2
      continue
    fi
    IFS='|' read -r pr_number pr_state <<< "$pr_snapshot"
    reason_code=""
    if [[ "$issue_state" == "CLOSED" ]]; then
      reason_code="stale-issue-closed"
    elif [[ "$pr_state" == "MERGED" ]]; then
      reason_code="stale-pr-merged"
    elif [[ "$pr_state" == "CLOSED" ]]; then
      reason_code="stale-pr-closed"
    elif [[ "$pr_number" == "0" && "$issue_state" == "OPEN" ]]; then
      reason_code="stale-no-pr-dead-session"
    fi
    [[ -n "$reason_code" ]] || continue

    _mayor_cleanup_stale_polecat "$pfile" "$pname" "$rig" "$repo" "$issue" "$branch" "$session" "$worktree" "$reason_code" "$issue_state" "$pr_number" "$pr_state"
  done
}

