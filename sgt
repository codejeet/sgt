}

_sgt_exec_path() {
  if [[ -n "${SGT_EXEC_PATH:-}" ]]; then
    printf '%s\n' "$SGT_EXEC_PATH"
    return 0
  fi

  local command_path=""
  if command_path="$(command -v sgt 2>/dev/null)" && [[ "$command_path" == */* ]]; then
    local command_dir=""
    if command_dir="$(cd "$(dirname "$command_path")" 2>/dev/null && pwd -P)"; then
      printf '%s/%s\n' "$command_dir" "$(basename "$command_path")"
      return 0
    fi
    printf '%s\n' "$command_path"
    return 0
  fi

  local source_path="${BASH_SOURCE[0]:-$0}"
  local resolved=""
  if [[ "$source_path" == */* ]]; then
    if resolved="$(cd "$(dirname "$source_path")" 2>/dev/null && pwd -P)"; then
      printf '%s/%s\n' "$resolved" "$(basename "$source_path")"
      return 0
    fi
  fi

  if command -v sgt >/dev/null 2>&1; then
    command -v sgt
    return 0
  fi

  printf '%s\n' "$source_path"
}

