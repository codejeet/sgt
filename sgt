    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
      "$blocker_id" "$rig" "$title" "$requester" "$created_at" "$disposition" "$evidence_file" \
      "$open_prs" "$open_authorized" "$open_polecats" "$pending_plan_requests"
  done < <(_acceptance_blocker_list_active)
}

_plan_state_snapshot() {
  local rig="${1:-}" plan_file="${2:-}" state_file
  state_file="$(_plan_state_path "$rig")"
  mkdir -p "$(dirname "$state_file")"
  python3 - "$rig" "$plan_file" "$state_file" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

rig, plan_file, state_file = sys.argv[1:4]
DELIM = "\x1f"
with open(plan_file, "r", encoding="utf-8") as fh:
    plan = json.load(fh)

state = {}
if os.path.exists(state_file):
    try:
        with open(state_file, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except Exception:
        state = {}

tasks_state = state.get("tasks")
if not isinstance(tasks_state, dict):
    tasks_state = {}

completion_state = state.get("completion")
if not isinstance(completion_state, dict):
    completion_state = {}

max_in_flight = 1
policy = plan.get("policy")
if isinstance(policy, dict):
    value = policy.get("max_in_flight", 1)
    if isinstance(value, int) and value > 0:
        max_in_flight = value

tasks = plan.get("tasks")
if not isinstance(tasks, list):
    raise SystemExit("plan tasks must be a list")

completion_condition = plan.get("completion_condition")
if completion_condition is None:
    completion_condition = ""
elif not isinstance(completion_condition, str):
    completion_condition = str(completion_condition)
completion_condition = completion_condition.strip()

acceptance = plan.get("acceptance")
if not isinstance(acceptance, dict):
    acceptance = {}

allowed_completion_status = {"pending", "completed", "verified", "blocked", "waived"}
plan_completion_status = str(acceptance.get("status") or "").strip().lower()
state_completion_status = str(completion_state.get("status") or "").strip().lower()
if plan_completion_status in allowed_completion_status:
    completion_status = plan_completion_status
elif state_completion_status in allowed_completion_status:
    completion_status = state_completion_status
elif completion_condition or acceptance:
    completion_status = "pending"
else:
    completion_status = "not_declared"

def one_line(value):
    return str(value or "").replace("\t", " ").replace("\n", " ").strip()

normalized = {}
for task in tasks:
    if not isinstance(task, dict):
        continue
    task_id = str(task.get("id", "")).strip()
    if not task_id:
        continue
    current = tasks_state.get(task_id)
    if not isinstance(current, dict):
        current = {}
    current.setdefault("status", "pending")
    normalized[task_id] = current

doc = {
    "version": 1,
    "rig": rig,
    "plan_file": plan_file,
    "updated_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    "policy": {"max_in_flight": max_in_flight},
    "tasks": normalized,
}

completion_details = one_line(acceptance.get("details") or completion_state.get("details"))
blocked_reason = one_line(acceptance.get("blocked_reason") or completion_state.get("blocked_reason"))
if completion_status != "blocked":
    blocked_reason = ""

completion_doc = {
    "declared": bool(completion_condition or acceptance),
    "condition": completion_condition,
    "status": completion_status,
    "acceptance": acceptance,
    "details": completion_details,
    "blocked_reason": blocked_reason,
    "rollup": str(completion_state.get("rollup") or "").strip() or (
        "not_declared" if not (completion_condition or acceptance) else "pending"
    ),
}
timestamp_field = {
    "completed": "completed_at",
    "verified": "verified_at",
    "blocked": "blocked_at",
    "waived": "waived_at",
}.get(completion_status)
if timestamp_field:
    value = acceptance.get(timestamp_field) or completion_state.get(timestamp_field)
    if value:
        completion_doc[timestamp_field] = str(value)
updated_at = completion_state.get("updated_at")
if updated_at:
    completion_doc["updated_at"] = str(updated_at)
doc["completion"] = completion_doc

tmp = state_file + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(doc, fh, ensure_ascii=True, indent=2, sort_keys=True)
os.replace(tmp, state_file)

print(
    DELIM.join(
        [
            "CONFIG",
            str(max_in_flight),
            completion_status,
            completion_doc["rollup"],
            one_line(completion_condition),
            json.dumps(acceptance, ensure_ascii=True, sort_keys=True),
            completion_doc["details"],
            completion_doc["blocked_reason"],
        ]
    )
)
for task in tasks:
    if not isinstance(task, dict):
        continue
    task_id = str(task.get("id", "")).strip()
    if not task_id:
        continue
    title = one_line(task.get("title") or task.get("task") or task_id)
    task_text = one_line(task.get("task") or task.get("title") or task_id)
    deps = task.get("depends_on") or []
    if not isinstance(deps, list):
        deps = []
    deps = [str(dep).strip() for dep in deps if str(dep).strip()]
    labels = task.get("labels") or []
    if not isinstance(labels, list):
      labels = []
    backend = str(task.get("backend") or "").strip()
    state_entry = normalized.get(task_id, {})
    status = str(state_entry.get("status") or "pending").strip()
    issue_number = str(state_entry.get("issue_number") or "").strip()
    issue_url = str(state_entry.get("issue_url") or "").strip()
    print(
        DELIM.join([
            "TASK",
            task_id,
            title,
            task_text,
            ",".join(deps),
            status,
            issue_number,
            issue_url,
            ",".join(str(label).strip() for label in labels if str(label).strip()),
            backend,
        ])
    )
PY
}

_plan_state_update_task() {
  local rig="${1:-}" task_id="${2:-}" status="${3:-}" issue_number="${4:-}" issue_url="${5:-}"
  local state_file
  state_file="$(_plan_state_path "$rig")"
  mkdir -p "$(dirname "$state_file")"
  python3 - "$state_file" "$task_id" "$status" "$issue_number" "$issue_url" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

state_file, task_id, status, issue_number, issue_url = sys.argv[1:6]
doc = {}
if os.path.exists(state_file):
    with open(state_file, "r", encoding="utf-8") as fh:
        doc = json.load(fh)
tasks = doc.setdefault("tasks", {})
entry = tasks.setdefault(task_id, {})
entry["status"] = status
if issue_number:
    entry["issue_number"] = issue_number
if issue_url:
    entry["issue_url"] = issue_url
now = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
entry["updated_at"] = now
if status in ("dispatched", "in_progress") and "dispatched_at" not in entry:
    entry["dispatched_at"] = now
if status == "completed":
    entry["completed_at"] = now
doc["updated_at"] = now
tmp = state_file + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(doc, fh, ensure_ascii=True, indent=2, sort_keys=True)
os.replace(tmp, state_file)
PY
}

_plan_state_update_completion() {
  local rig="${1:-}" condition="${2:-}" acceptance_json="${3:-{}}" status="${4:-not_declared}" rollup="${5:-not_declared}" details="${6:-}" blocked_reason="${7:-}"
  local state_file
  state_file="$(_plan_state_path "$rig")"
  mkdir -p "$(dirname "$state_file")"
  python3 - "$state_file" "$condition" "$acceptance_json" "$status" "$rollup" "$details" "$blocked_reason" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

state_file, condition, acceptance_json, status, rollup, details, blocked_reason = sys.argv[1:8]
doc = {}
if os.path.exists(state_file):
    with open(state_file, "r", encoding="utf-8") as fh:
        doc = json.load(fh)
completion = doc.setdefault("completion", {})
previous_status = str(completion.get("status") or "").strip().lower()
previous_acceptance = completion.get("acceptance")
if not isinstance(previous_acceptance, dict):
    previous_acceptance = {}
try:
    acceptance = json.loads(acceptance_json or "{}")
    if not isinstance(acceptance, dict):
        acceptance = dict(previous_acceptance)
except Exception:
    acceptance = dict(previous_acceptance)
now = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
completion["declared"] = bool(condition.strip() or acceptance)
completion["condition"] = condition.strip()
completion["acceptance"] = acceptance
completion["status"] = status
completion["rollup"] = rollup
completion["details"] = details.strip()
completion["blocked_reason"] = blocked_reason.strip()
completion["updated_at"] = now
if status == "verified":
    completion.setdefault("verified_at", acceptance.get("verified_at") or now)
elif previous_status == "verified":
    completion.pop("verified_at", None)
if status == "blocked":
    completion.setdefault("blocked_at", acceptance.get("blocked_at") or now)
elif previous_status == "blocked":
    completion.pop("blocked_at", None)
if status == "waived":
    completion.setdefault("waived_at", acceptance.get("waived_at") or now)
elif previous_status == "waived":
    completion.pop("waived_at", None)
doc["updated_at"] = now
tmp = state_file + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(doc, fh, ensure_ascii=True, indent=2, sort_keys=True)
os.replace(tmp, state_file)
PY
}

_plan_sync_state_and_labels() {
  local rig="${1:-}" plan_file="${2:-}" repo="${3:-}"
  [[ -n "$rig" && -n "$plan_file" && -n "$repo" ]] || return 1
  local -a labels=("plan")
  local record_type c1 c8
  while IFS=$'\x1f' read -r record_type c1 _ _ _ _ _ _ c8 _; do
    [[ -n "$record_type" ]] || continue
    case "$record_type" in
      TASK)
        labels+=("plan-$c1")
        IFS=',' read -r -a extra_labels <<< "$c8"
        local label
        for label in "${extra_labels[@]}"; do
          [[ -n "$label" ]] || continue
          labels+=("$label")
        done
        ;;
    esac
  done < <(_plan_state_snapshot "$rig" "$plan_file")
  _ensure_labels_exist "$repo" "${labels[@]}"
}

_plan_find_merged_closing_pr() {
  local repo="${1:-}" issue_number="${2:-}"
  [[ -n "$repo" && "$issue_number" =~ ^[0-9]+$ ]] || return 1
  local owner_repo pr_json
  owner_repo="$(_repo_owner_repo "$repo")"
  pr_json="$(gh pr list --repo "$repo" --state merged --limit 100 --json number,body,mergedAt 2>/dev/null || true)"
  [[ -n "$pr_json" ]] || return 1
  python3 - "$issue_number" "$owner_repo" "$pr_json" <<'PY'
import json
import re
import sys

issue_number = sys.argv[1].strip()
owner_repo = sys.argv[2].strip().lower()
try:
    pulls = json.loads(sys.argv[3])
except Exception:
    raise SystemExit(1)

if not isinstance(pulls, list):
    raise SystemExit(1)

pattern = re.compile(
    r"(?im)\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s*:?\s+(?:"
    + re.escape(owner_repo)
    + r"#|#)(\d+)\b"
)
best = None
for pr in pulls:
    if not isinstance(pr, dict):
        continue
    body = str(pr.get("body") or "")
    if issue_number not in pattern.findall(body):
        continue
    number = str(pr.get("number") or "").strip()
    if not number:
        continue
    merged_at = str(pr.get("mergedAt") or "").strip()
    sort_key = (merged_at, number)
    if best is None or sort_key > best[0]:
        best = (sort_key, number, merged_at)

if best is None:
    raise SystemExit(1)

print(f"{best[1]}|{best[2]}")
PY
}

_plan_tick_run() {
  local rig="${1:-}" tick_source="${2:-manual}"
  local plan_file repo snapshot_line
  plan_file="$(_plan_file_path "$rig")"
  [[ -f "$plan_file" ]] || die "plan file not found for rig '$rig': $plan_file"
  repo="$(rig_repo "$rig")"

  local max_in_flight=1
  local plan_completion_status="not_declared" plan_completion_rollup="not_declared" plan_completion_condition="" plan_acceptance_json="{}" plan_completion_details="" plan_completion_blocked_reason=""
  local -a task_ids=()
  local -A task_title=() task_text=() task_deps=() task_status=() task_issue=() task_issue_url=() task_labels=() task_backend=()
  while IFS=$'\x1f' read -r record_type c1 c2 c3 c4 c5 c6 c7 c8 c9; do
    [[ -n "$record_type" ]] || continue
    case "$record_type" in
      CONFIG)
        max_in_flight="$c1"
        plan_completion_status="${c2:-not_declared}"
        plan_completion_rollup="${c3:-not_declared}"
        plan_completion_condition="${c4:-}"
        plan_acceptance_json="${c5:-{}}"
        plan_completion_details="${c6:-}"
        plan_completion_blocked_reason="${c7:-}"
        ;;
      TASK)
        task_ids+=("$c1")
        task_title["$c1"]="$c2"
        task_text["$c1"]="$c3"
        task_deps["$c1"]="$c4"
        task_status["$c1"]="$c5"
        task_issue["$c1"]="$c6"
        task_issue_url["$c1"]="$c7"
        task_labels["$c1"]="$c8"
        task_backend["$c1"]="$c9"
        ;;
    esac
  done < <(_plan_state_snapshot "$rig" "$plan_file")

  if ! _plan_sync_state_and_labels "$rig" "$plan_file" "$repo"; then
    local sync_reason sync_blocker_id
    sync_reason="failed to sync plan labels/state on repo $repo"
    sync_blocker_id="$(_plan_blocker_record "$rig" "__plan__" "Plan sync" "plan-sync-failed" "$sync_reason" "$tick_source" 2>/dev/null || true)"
    log_event "PLAN_MOVEMENT_BLOCKER rig=$rig task=__plan__ blocker_id=${sync_blocker_id:-unavailable} reason_code=plan-sync-failed source=$tick_source reason=\"$(_escape_quotes "$sync_reason")\""
    if [[ "$tick_source" == "mayor" ]]; then
      _mayor_record_decision "PLAN MOVEMENT BLOCKER rig=$rig task=__plan__ blocker_id=${sync_blocker_id:-unavailable} reason_code=plan-sync-failed retry=next-mayor-cycle reason=\"$(_escape_quotes "$sync_reason")\"" "plan-movement-blocker" "$SGT_ROOT" || true
    fi
  else
    _plan_blocker_resolve "$rig" "__plan__" || true
  fi

  local inflight=0 completed=0 total="${#task_ids[@]}" dispatched_count=0 dispatch_failures=0 pending_ready=0 pending_blocked=0 last_failure_reason_code="" last_failure_detail=""
  local task_id issue_number issue_state active_polecat merged_pr_snapshot merged_pr_number merged_pr_merged_at
  local -A merged_closing_pr_cache=()
  for task_id in "${task_ids[@]}"; do
    issue_number="${task_issue[$task_id]}"
    if [[ -n "$issue_number" ]]; then
      issue_state="$(gh issue view "$issue_number" --repo "$repo" --json state --jq '.state // ""' 2>/dev/null || true)"
      if [[ "$issue_state" == "CLOSED" && "${task_status[$task_id]}" != "completed" ]]; then
        _plan_state_update_task "$rig" "$task_id" "completed" "$issue_number" "${task_issue_url[$task_id]}"
        task_status["$task_id"]="completed"
      elif [[ "$issue_state" == "OPEN" ]]; then
        active_polecat="$(_resling_find_existing_issue_polecat "$rig" "$repo" "$issue_number" 2>/dev/null || true)"
        merged_pr_snapshot=""
        if [[ -z "$active_polecat" ]]; then
          if [[ -v "merged_closing_pr_cache[$issue_number]" ]]; then
            merged_pr_snapshot="${merged_closing_pr_cache[$issue_number]}"
          else
            merged_pr_snapshot="$(_plan_find_merged_closing_pr "$repo" "$issue_number" 2>/dev/null || true)"
            merged_closing_pr_cache["$issue_number"]="$merged_pr_snapshot"
          fi
        fi
        if [[ -n "$merged_pr_snapshot" ]]; then
          IFS='|' read -r merged_pr_number merged_pr_merged_at <<< "$merged_pr_snapshot"
          if [[ "${task_status[$task_id]}" != "completed" ]]; then
            _plan_state_update_task "$rig" "$task_id" "completed" "$issue_number" "${task_issue_url[$task_id]}"
            task_status["$task_id"]="completed"
            log_event "PLAN_TASK_RECONCILED_MERGED_PR rig=$rig task=$task_id issue=#$issue_number pr=#${merged_pr_number:-unknown} merged_at=${merged_pr_merged_at:-unknown} source=$tick_source"
          fi
        elif [[ -n "$active_polecat" && "${task_status[$task_id]}" != "in_progress" ]]; then
          _plan_state_update_task "$rig" "$task_id" "in_progress" "$issue_number" "${task_issue_url[$task_id]}"
          task_status["$task_id"]="in_progress"
        elif [[ -z "$active_polecat" && "${task_status[$task_id]}" == "pending" ]]; then
          _plan_state_update_task "$rig" "$task_id" "dispatched" "$issue_number" "${task_issue_url[$task_id]}"
          task_status["$task_id"]="dispatched"
        fi
      fi
    fi
    case "${task_status[$task_id]}" in
      completed) completed=$((completed + 1)) ;;
      dispatched|in_progress) inflight=$((inflight + 1)) ;;
    esac
  done

  local dispatch_budget=$((max_in_flight - inflight))
  (( dispatch_budget < 0 )) && dispatch_budget=0
  if _mayor_rig_manually_hibernated "$rig"; then
    dispatch_budget=0
    log_event "PLAN_TICK_SKIP_DISPATCH rig=$rig source=$tick_source reason_code=manual-hibernation"
  fi
  local deps_ok dep_id label sling_out blocker_id failure_reason_code sling_log
  for task_id in "${task_ids[@]}"; do
    [[ "$dispatch_budget" -gt 0 ]] || break
    [[ "${task_status[$task_id]}" == "pending" ]] || continue
    deps_ok="true"
    IFS=',' read -r -a dep_ids <<< "${task_deps[$task_id]}"
    for dep_id in "${dep_ids[@]}"; do
      [[ -n "$dep_id" ]] || continue
      if [[ "${task_status[$dep_id]:-pending}" != "completed" ]]; then
        deps_ok="false"
        break
      fi
    done
    [[ "$deps_ok" == "true" ]] || continue

    _SGT_LAST_SLING_ISSUE_NUMBER=""
    _SGT_LAST_SLING_ISSUE_URL=""
    _SGT_LAST_SLING_POLECAT=""
    local -a sling_args=("$rig" "${task_text[$task_id]}" --label plan --label "plan-$task_id")
    IFS=',' read -r -a task_label_list <<< "${task_labels[$task_id]}"
    for label in "${task_label_list[@]}"; do
      [[ -n "$label" ]] || continue
      sling_args+=(--label "$label")
    done
    if [[ -n "${task_backend[$task_id]}" ]]; then
      sling_args+=(--backend "${task_backend[$task_id]}")
    fi
    sling_log="$(mktemp)"
    sling_out=""
    if cmd_sling "${sling_args[@]}" >"$sling_log" 2>&1; then
      sling_out="$(cat "$sling_log" 2>/dev/null || true)"
      rm -f "$sling_log"
      :
    else
      sling_out="$(cat "$sling_log" 2>/dev/null || true)"
      rm -f "$sling_log"
      if grep -qi 'failed to ensure labels' <<< "$sling_out"; then
        failure_reason_code="label-ensure-failed"
      elif grep -qi 'failed to create issue' <<< "$sling_out"; then
        failure_reason_code="issue-create-failed"
      else
        failure_reason_code="dispatch-failed"
      fi
      blocker_id="$(_plan_blocker_record "$rig" "$task_id" "${task_title[$task_id]}" "$failure_reason_code" "$(_one_line "$sling_out")" "$tick_source" 2>/dev/null || true)"
      log_event "PLAN_MOVEMENT_BLOCKER rig=$rig task=$task_id blocker_id=${blocker_id:-unavailable} reason_code=$failure_reason_code source=$tick_source reason=\"$(_escape_quotes "$(_one_line "$sling_out")")\""
      if [[ "$tick_source" == "mayor" ]]; then
        _mayor_record_decision "PLAN MOVEMENT BLOCKER rig=$rig task=$task_id blocker_id=${blocker_id:-unavailable} reason_code=$failure_reason_code retry=next-mayor-cycle reason=\"$(_escape_quotes "$(_one_line "$sling_out")")\"" "plan-movement-blocker" "$SGT_ROOT" || true
      fi
      dispatch_failures=$((dispatch_failures + 1))
      last_failure_reason_code="$failure_reason_code"
      last_failure_detail="$(_one_line "$sling_out")"
      continue
    fi
    if [[ -n "${_SGT_LAST_SLING_ISSUE_NUMBER:-}" ]]; then
      _plan_state_update_task "$rig" "$task_id" "dispatched" "${_SGT_LAST_SLING_ISSUE_NUMBER:-}" "${_SGT_LAST_SLING_ISSUE_URL:-}"
      task_status["$task_id"]="dispatched"
      task_issue["$task_id"]="${_SGT_LAST_SLING_ISSUE_NUMBER:-}"
      dispatched_count=$((dispatched_count + 1))
      dispatch_budget=$((dispatch_budget - 1))
      _plan_blocker_resolve "$rig" "$task_id" || true
      _plan_notify_requester "$rig" "rig=$rig task=$task_id dispatched issue=#${_SGT_LAST_SLING_ISSUE_NUMBER:-unknown} title=\"${task_title[$task_id]}\""
    fi
  done

  if [[ "$total" -eq 0 ]]; then
    inflight=0
  fi

  for task_id in "${task_ids[@]}"; do
    [[ "${task_status[$task_id]}" == "pending" ]] || continue
    deps_ok="true"
    IFS=',' read -r -a dep_ids <<< "${task_deps[$task_id]}"
    for dep_id in "${dep_ids[@]}"; do
      [[ -n "$dep_id" ]] || continue
      if [[ "${task_status[$dep_id]:-pending}" != "completed" ]]; then
        deps_ok="false"
        break
      fi
    done
    if [[ "$deps_ok" == "true" ]]; then
      pending_ready=$((pending_ready + 1))
    else
      pending_blocked=$((pending_blocked + 1))
    fi
  done

  case "$plan_completion_status" in
    completed)
      plan_completion_rollup="acceptance-completed"
      ;;
    verified)
      plan_completion_rollup="acceptance-verified"
      ;;
    waived)
      plan_completion_rollup="acceptance-waived"
      ;;
    blocked)
      plan_completion_rollup="blocked-pending-external"
      ;;
    pending)
      if [[ "$total" -gt 0 && "$completed" -eq "$total" && "$inflight" -eq 0 ]]; then
        plan_completion_rollup="tasks-exhausted-awaiting-acceptance"
      elif [[ "$total" -eq 0 ]]; then
        plan_completion_rollup="pending"
      else
        plan_completion_rollup="tasks-in-progress"
      fi
      ;;
    *)
      plan_completion_rollup="not_declared"
      ;;
  esac

  _plan_state_update_completion \
    "$rig" \
    "$plan_completion_condition" \
    "$plan_acceptance_json" \
    "$plan_completion_status" \
    "$plan_completion_rollup" \
    "$plan_completion_details" \
    "$plan_completion_blocked_reason"

  printf 'PLAN_TICK|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
    "$rig" \
    "$total" \
    "$completed" \
    "$inflight" \
    "$dispatched_count" \
    "$tick_source" \
    "$plan_completion_rollup" \
    "$plan_completion_status" \
    "$plan_completion_condition" \
    "$plan_completion_details" \
    "$plan_completion_blocked_reason" \
    "$dispatch_failures" \
    "$pending_ready" \
    "$pending_blocked" \
    "$last_failure_reason_code"
}

cmd_create_plan() {
  local rig="${1:-}" explicit_agent="" prompt_file="" prompt="" prompt_source="argv"
  [[ -n "$rig" ]] || die "usage: sgt create plan <rig> <prompt...> [--file <path>] [--agent <openclaw-id>]"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --file) prompt_file="${2:-}"; prompt_source="file"; shift 2 ;;
      --agent) explicit_agent="${2:-}"; shift 2 ;;
      *) break ;;
    esac
  done
  ensure_init
  ensure_rig "$rig"
  if [[ -n "$prompt_file" && "$#" -gt 0 ]]; then
    die "use either prompt args or --file <path>, not both"
  fi
  if [[ "$#" -eq 1 && "${1:-}" == "-" ]]; then
    prompt_source="stdin"
  fi
  prompt="$(_read_prompt_input "$prompt_file" "$@")"
  prompt="$(printf '%s' "$prompt" | sed 's/[[:space:]]*$//')"
  [[ -n "$prompt" ]] || die "no plan prompt provided"

  local requester request_id
  requester="$(_resolve_requesting_openclaw_agent_id "$explicit_agent")"
  # Persist --agent as per-rig notify_agent default
  if [[ -n "$explicit_agent" ]]; then
    _rig_notify_agent_write "$rig" "$explicit_agent" || true
    log_event "RIG_NOTIFY_AGENT_SET rig=$rig agent=$explicit_agent source=create-plan"
  fi
  _ensure_context_file "$rig" >/dev/null
  request_id="$(_plan_request_write "$rig" "$prompt" "$requester" "$prompt_source")"
  _context_append_plan_request "$rig" "$request_id" "$requester" "$prompt"
  if [[ -n "${OPENAI_API_KEY:-}" ]] && [[ -n "$(_context_python_bin)" ]]; then
    _context_index_build "$rig" >/dev/null 2>&1 || true
  fi
  _wake_mayor "create-plan:${rig}:${request_id}"
  log_event "CREATE_PLAN rig=$rig request_id=$request_id requester=$requester source=$prompt_source"
  info "plan request recorded: $request_id"
  info "context updated: $(_context_file_path "$rig")"
  info "mayor notified: create-plan:${rig}:${request_id}"
}

cmd_config_notify() {
  local rig="${1:-}" agent_id="${2:-}"
  [[ -n "$rig" ]] || die "usage: sgt config notify <rig> <agent-id>"
  [[ -n "$agent_id" ]] || {
    # Read mode: show current notify_agent for this rig
    ensure_init
    ensure_rig "$rig"
    local current
    current="$(_rig_notify_agent_read "$rig" 2>/dev/null || true)"
    if [[ -n "$current" ]]; then
      info "rig $rig notify_agent: $current"
    else
      local global_agent
      global_agent="$(_openclaw_sender_route "$rig" | cut -d'|' -f1)"
      info "rig $rig notify_agent: (none — effective: $global_agent)"
    fi
    return 0
  }
  ensure_init
  ensure_rig "$rig"
  _rig_notify_agent_write "$rig" "$agent_id" || die "failed to write rig config for $rig"
  log_event "RIG_NOTIFY_AGENT_SET rig=$rig agent=$agent_id source=config-notify"
  info "rig $rig notify_agent set to: $agent_id"
}

cmd_create_blocker() {
