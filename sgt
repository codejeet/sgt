      ;;
    *)
      return 1
      ;;
  esac
}

_peek_session_output() {
  local target="${1:-}" session="${2:-}"
  local pane_output=""

  pane_output="$(tmux capture-pane -t "$session" -p -S -200 2>/dev/null || true)"
  case "$target" in
    president|mayor|mayor/*)
      if [[ -z "${pane_output//[$' \t\r\n']/}" ]]; then
        local mayor_log=""
        mayor_log="$(_peek_mayor_log_file_for_target "$target" || true)"
        if [[ -n "$mayor_log" && -f "$mayor_log" ]]; then
          tail -n 200 "$mayor_log"
          return 0
        fi
      fi
