  for f in "$SGT_POLECATS"/*; do
    [[ -f "$f" ]] || continue
    pname="$(basename "$f")"

    local SESSION RIG REPO BRANCH ISSUE WORKTREE
    SESSION=""
    RIG=""
    REPO=""
    BRANCH=""
    ISSUE="?"
    WORKTREE=""
    if ! source "$f" 2>/dev/null; then
      polecats+=("{\"name\":$(_json_quote "$pname"),\"status\":$(_json_quote "unknown"),\"issue\":$(_json_quote "?"),\"warning\":$(_json_quote "metadata unreadable (possibly mid-write race)")}")
