  [[ "$raw" =~ ^[0-9]+$ ]] || raw=900
  echo "$raw"
}

_mayor_ci_check_stale_secs() {
  local raw="${SGT_MAYOR_CI_CHECK_STALE_SECS:-900}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=900
  echo "$raw"
}

_mayor_ci_check_dedupe_secs() {
  local raw="${SGT_MAYOR_CI_CHECK_DEDUPE_SECS:-900}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=900
  echo "$raw"
}

_mayor_ci_check_watchdog_key() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}" check_name="${4:-}"
  [[ -n "$rig" && -n "$repo" && -n "$pr" && -n "$check_name" ]] || return 1
  printf '%s|%s|%s|%s' "$rig" "$repo" "$pr" "$(_escape_wake_value "$check_name")"
}

_mayor_ci_check_watchdog_state_read() {
  local key="${1:-}"
  [[ -n "$key" ]] || {
    echo "|"
    return 0
  }
  [[ -f "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE" ]] || {
    echo "|"
    return 0
  }
  local row observed_since last_notified
  row=$(awk -F'\t' -v key="$key" '$1==key {print; exit}' "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE" 2>/dev/null || true)
  if [[ -z "$row" ]]; then
    echo "|"
    return 0
  fi
  IFS=$'\t' read -r _ observed_since last_notified <<< "$row"
  echo "${observed_since}|${last_notified}"
}

_mayor_ci_check_watchdog_state_upsert() {
  local key="${1:-}" observed_since="${2:-}" last_notified="${3:-}"
  [[ -n "$key" ]] || return 1
  local state_tmp
  state_tmp="$(mktemp)"
  if [[ -f "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE" ]]; then
    awk -F'\t' -v key="$key" '$1!=key {print $0}' "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE" > "$state_tmp" 2>/dev/null || true
  fi
  printf '%s\t%s\t%s\n' "$key" "${observed_since:-}" "${last_notified:-}" >> "$state_tmp"
  mv "$state_tmp" "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE"
}

_mayor_reset_ci_check_watchdog() {
  local key="${1:-}"
  [[ -n "$key" ]] || return 0
  [[ -f "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE" ]] || return 0
  local state_tmp
  state_tmp="$(mktemp)"
  awk -F'\t' -v key="$key" '$1!=key {print $0}' "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE" > "$state_tmp" 2>/dev/null || true
  mv "$state_tmp" "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE"
}

_mayor_ci_check_watchdog_reset_pr_recovered() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}"
  shift 3 || true
  [[ -n "$rig" && -n "$repo" && -n "$pr" ]] || return 0
  [[ -f "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE" ]] || return 0

  local prefix key
  prefix="${rig}|${repo}|${pr}|"
  local -A keep=()
  for key in "$@"; do
    [[ -n "$key" ]] || continue
    keep["$key"]=1
  done

  local state_tmp
  state_tmp="$(mktemp)"
  while IFS=$'\t' read -r key observed_since last_notified; do
    [[ -n "$key" ]] || continue
    if [[ "$key" == "$prefix"* && -z "${keep[$key]+x}" ]]; then
      continue
    fi
    printf '%s\t%s\t%s\n' "$key" "${observed_since:-}" "${last_notified:-}" >> "$state_tmp"
  done < "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE"
  mv "$state_tmp" "$SGT_MAYOR_CI_CHECK_WATCHDOG_STATE"
}

_mayor_should_notify_ci_check_watchdog() {
  local key="${1:-}"
  [[ -n "$key" ]] || return 1

  local now dedupe_secs observed_since last_notified
  now="$(date +%s)"
  dedupe_secs="$(_mayor_ci_check_dedupe_secs)"
  IFS='|' read -r observed_since last_notified <<< "$(_mayor_ci_check_watchdog_state_read "$key")"

  if [[ "$dedupe_secs" -gt 0 && "$last_notified" =~ ^[0-9]+$ ]]; then
    local age=$((now - last_notified))
    if [[ "$age" -lt 0 ]]; then
      age=0
    fi
    if [[ "$age" -lt "$dedupe_secs" ]]; then
      return 1
    fi
  fi

  _mayor_ci_check_watchdog_state_upsert "$key" "$observed_since" "$now" || return 1
  return 0
}

_mayor_ci_check_watchdog_collect_stale_for_pr() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}" now_epoch="${4:-$(date +%s)}" threshold="${5:-$(_mayor_ci_check_stale_secs)}"
  [[ -n "$rig" && -n "$repo" && -n "$pr" ]] || return 0
  [[ "$now_epoch" =~ ^[0-9]+$ ]] || now_epoch="$(date +%s)"
  [[ "$threshold" =~ ^[0-9]+$ ]] || threshold=0

  local -a active_keys=()
  local line check_name check_state started_epoch check_url key prev_observed prev_notified observed_epoch elapsed
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    IFS='|' read -r check_name check_state started_epoch check_url <<< "$line"
    [[ -n "$check_name" ]] || continue
    [[ "$check_state" == "QUEUED" || "$check_state" == "IN_PROGRESS" ]] || continue

    key="$(_mayor_ci_check_watchdog_key "$rig" "$repo" "$pr" "$check_name")" || continue
    IFS='|' read -r prev_observed prev_notified <<< "$(_mayor_ci_check_watchdog_state_read "$key")"

    if [[ "$started_epoch" =~ ^[0-9]+$ && "$started_epoch" -gt 0 ]]; then
      observed_epoch="$started_epoch"
    elif [[ "$prev_observed" =~ ^[0-9]+$ && "$prev_observed" -gt 0 ]]; then
      observed_epoch="$prev_observed"
    else
      observed_epoch="$now_epoch"
    fi

    elapsed=$((now_epoch - observed_epoch))
    if [[ "$elapsed" -lt 0 ]]; then
      elapsed=0
    fi

    _mayor_ci_check_watchdog_state_upsert "$key" "$observed_epoch" "$prev_notified" || true
    active_keys+=("$key")

    if [[ "$elapsed" -ge "$threshold" ]]; then
      printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$rig" "$repo" "$pr" "$(_escape_wake_value "$check_name")" "$check_state" \
        "$observed_epoch" "$elapsed" "$threshold" "${check_url:-}" "$key"
    fi
  done

  _mayor_ci_check_watchdog_reset_pr_recovered "$rig" "$repo" "$pr" "${active_keys[@]}"
}

_mayor_ci_check_watchdog_collect_stale() {
  local now_epoch="${1:-$(date +%s)}" threshold="${2:-$(_mayor_ci_check_stale_secs)}"
  [[ "$now_epoch" =~ ^[0-9]+$ ]] || now_epoch="$(date +%s)"
  [[ "$threshold" =~ ^[0-9]+$ ]] || threshold=0
  [[ -d "$SGT_RIGS" ]] || return 0

  local rig_file rig repo pr checks_tsv check_line check_name check_state started_at check_url started_epoch pending_tmp
  for rig_file in "$SGT_RIGS"/*; do
    [[ -f "$rig_file" ]] || continue
    rig="$(basename "$rig_file")"
    repo="$(cat "$rig_file" 2>/dev/null || true)"
    [[ -n "$repo" ]] || continue

    while IFS= read -r pr; do
      [[ "$pr" =~ ^[0-9]+$ ]] || continue
      pending_tmp="$(mktemp)"
      if ! checks_tsv="$(gh pr checks "$pr" --repo "$repo" --required --json name,state,startedAt,link --jq '.[] | select(.state=="QUEUED" or .state=="IN_PROGRESS") | [.name, .state, (.startedAt // ""), (.link // "")] | @tsv' 2>/dev/null)"; then
        rm -f "$pending_tmp"
        continue
      fi
      if [[ -n "$checks_tsv" ]]; then
        while IFS= read -r check_line; do
          [[ -n "$check_line" ]] || continue
          IFS=$'\t' read -r check_name check_state started_at check_url <<< "$check_line"
          [[ "$check_state" == "QUEUED" || "$check_state" == "IN_PROGRESS" ]] || continue
          started_epoch=""
          if [[ -n "$started_at" ]]; then
            started_epoch="$(date -d "$started_at" +%s 2>/dev/null || true)"
          fi
          if [[ ! "$started_epoch" =~ ^[0-9]+$ ]]; then
            started_epoch=""
          fi
          printf '%s|%s|%s|%s\n' \
            "$(_escape_wake_value "$check_name")" \
            "$check_state" \
            "$started_epoch" \
            "${check_url:-$(_repo_pr_url "$repo" "$pr")}" >> "$pending_tmp"
        done <<< "$checks_tsv"
      fi
      while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        echo "$line"
      done < <(_mayor_ci_check_watchdog_collect_stale_for_pr "$rig" "$repo" "$pr" "$now_epoch" "$threshold" < "$pending_tmp")
      rm -f "$pending_tmp"
    done < <(gh pr list --repo "$repo" --state open --json number --jq '.[].number' 2>/dev/null || true)
  done
}

_mayor_review_watchdog_signature() {
  local state="${1:-}" unclear_since="${2:-}" head_sha="${3:-}"
  printf 'state=%s|since=%s|head=%s' "${state:-unknown}" "${unclear_since:-0}" "${head_sha:-unknown}"
}

_mayor_should_notify_review_watchdog() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}" state="${4:-}" unclear_since="${5:-}" head_sha="${6:-}"
  [[ -n "$rig" && -n "$repo" && -n "$pr" && -n "$state" ]] || return 1

  local key signature now prev_line prev_signature state_tmp
  key="${rig}|${repo}|${pr}"
  signature="$(_mayor_review_watchdog_signature "$state" "$unclear_since" "$head_sha")"
  now="$(date +%s)"
  prev_signature=""

  if [[ -f "$SGT_MAYOR_REVIEW_WATCHDOG_STATE" ]]; then
    prev_line=$(awk -F'\t' -v key="$key" '$1==key {print; exit}' "$SGT_MAYOR_REVIEW_WATCHDOG_STATE" 2>/dev/null || true)
    if [[ -n "$prev_line" ]]; then
      IFS=$'\t' read -r _ prev_signature _ <<< "$prev_line"
    fi
  fi

  if [[ "$prev_signature" == "$signature" ]]; then
    return 1
  fi

  state_tmp="$(mktemp)"
  if [[ -f "$SGT_MAYOR_REVIEW_WATCHDOG_STATE" ]]; then
    awk -F'\t' -v key="$key" '$1!=key {print $0}' "$SGT_MAYOR_REVIEW_WATCHDOG_STATE" > "$state_tmp" 2>/dev/null || true
  fi
  printf '%s\t%s\t%s\n' "$key" "$signature" "$now" >> "$state_tmp"
  mv "$state_tmp" "$SGT_MAYOR_REVIEW_WATCHDOG_STATE"
  return 0
}

_mayor_review_watchdog_collect_stale() {
  local now_epoch="${1:-$(date +%s)}"
  local threshold="${2:-$(_mayor_review_unclear_stale_secs)}"
  local merge_dir="$SGT_CONFIG/merge-queue"
  [[ "$threshold" =~ ^[0-9]+$ ]] || threshold=0
  [[ "$now_epoch" =~ ^[0-9]+$ ]] || now_epoch="$(date +%s)"
  [[ -d "$merge_dir" ]] || return 0

  local f mqname mq_rig mq_pr mq_repo mq_issue mq_head_sha mq_review_state mq_review_unclear_since age
  for f in "$merge_dir"/*; do
    [[ -f "$f" ]] || continue
    mqname="$(basename "$f")"
    mq_pr=""
    mq_rig=""
    mq_repo=""
    mq_issue=""
    mq_head_sha=""
    mq_review_state=""
    mq_review_unclear_since=""
    while IFS='=' read -r k v; do
      case "$k" in
        RIG|PR|REPO|ISSUE|HEAD_SHA|REVIEW_STATE|REVIEW_UNCLEAR_SINCE)
          printf -v "$k" '%s' "$v"
          ;;
      esac
    done < <(grep -E '^(RIG|PR|REPO|ISSUE|HEAD_SHA|REVIEW_STATE|REVIEW_UNCLEAR_SINCE)=' "$f")
    mq_rig="${RIG:-}"
    mq_pr="${PR:-}"
    mq_repo="${REPO:-}"
    mq_issue="${ISSUE:-0}"
    mq_head_sha="${HEAD_SHA:-}"
    mq_review_state="${REVIEW_STATE:-REVIEW_PENDING}"
    mq_review_unclear_since="${REVIEW_UNCLEAR_SINCE:-}"
    [[ "$mq_review_state" == "REVIEW_UNCLEAR" ]] || continue
    [[ "$mq_review_unclear_since" =~ ^[0-9]+$ ]] || continue
    age=$((now_epoch - mq_review_unclear_since))
    if [[ "$age" -lt 0 ]]; then
      age=0
    fi
    if [[ "$age" -ge "$threshold" ]]; then
      printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "${mqname:-unknown}" "${mq_rig:-unknown}" "${mq_pr:-}" "${mq_repo:-}" "${mq_issue:-0}" \
        "${mq_review_state}" "${mq_review_unclear_since}" "${age}" "${mq_head_sha:-}" "${threshold}"
    fi
  done
}

_mayor_review_watchdog_status_snapshot() {
  local threshold now_epoch line count oldest_age age
  threshold="$(_mayor_review_unclear_stale_secs)"
  now_epoch="$(date +%s)"
  count=0
  oldest_age=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    IFS='|' read -r _ _ _ _ _ _ _ age _ _ <<< "$line"
    [[ "$age" =~ ^[0-9]+$ ]] || age=0
    count=$((count + 1))
    if [[ "$age" -gt "$oldest_age" ]]; then
      oldest_age="$age"
    fi
  done < <(_mayor_review_watchdog_collect_stale "$now_epoch" "$threshold")
  printf '%s|%s|%s\n' "$count" "$oldest_age" "$threshold"
}

_mayor_pre_dispatch_revalidate() {
  local repo="${1:-}" rig="${2:-}"
  local canonical_repo owner_repo owner name snapshot open_prs open_authorized open_polecats queue_count parallel_budget parallel_in_flight resolve_meta resolve_code resolve_reason
  local snapshot_file snapshot_state snapshot_open_prs snapshot_open_authorized snapshot_open_polecats snapshot_queue_count
  local mismatch_categories mismatch_reason mismatch_suffix
  _MAYOR_PRE_DISPATCH_REASON_CODE=""
  _MAYOR_PRE_DISPATCH_REASON=""
  _MAYOR_PRE_DISPATCH_MISMATCH_CATEGORIES=""
  _MAYOR_PRE_DISPATCH_SNAPSHOT_SUMMARY=""
  _MAYOR_PRE_DISPATCH_LIVE_SUMMARY=""
  if ! canonical_repo="$(_resolve_rig_repo_canonical "mayor-pre-dispatch-revalidate" "$rig" "$repo" "1")"; then
    resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_repo")"
    IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
    _MAYOR_PRE_DISPATCH_REASON_CODE="${resolve_code:-repo-resolve-failed}"
    _MAYOR_PRE_DISPATCH_REASON="revalidation failed: ${resolve_reason:-unable to resolve rig repo}"
    echo "$_MAYOR_PRE_DISPATCH_REASON"
    return 1
  fi

  owner_repo="$(_repo_owner_repo "$canonical_repo")"
  owner="${owner_repo%%/*}"
  name="${owner_repo#*/}"

  if [[ -z "$owner" || -z "$name" || "$owner" == "$name" ]]; then
    _MAYOR_PRE_DISPATCH_REASON_CODE="invalid-repo"
    _MAYOR_PRE_DISPATCH_REASON="revalidation failed: invalid repo '$repo'"
    echo "$_MAYOR_PRE_DISPATCH_REASON"
    return 1
  fi

  snapshot=$(
    gh api graphql \
      -f query='query($owner:String!, $name:String!) {
        repository(owner:$owner, name:$name) {
          openPullRequests: pullRequests(states: OPEN) { totalCount }
          openAuthorizedIssues: issues(states: OPEN, labels: ["sgt-authorized"]) { totalCount }
        }
      }' \
      -F owner="$owner" \
      -F name="$name" \
      --jq '.data.repository | "\(.openPullRequests.totalCount)|\(.openAuthorizedIssues.totalCount)"' \
      2>/dev/null || true
  )

  if [[ -z "$snapshot" || "$snapshot" != *"|"* ]]; then
    _MAYOR_PRE_DISPATCH_REASON_CODE="live-query-failed"
    _MAYOR_PRE_DISPATCH_REASON="revalidation failed: unable to query live state"
    echo "$_MAYOR_PRE_DISPATCH_REASON"
    return 1
  fi

  IFS='|' read -r open_prs open_authorized <<< "$snapshot"
  [[ "$open_prs" =~ ^[0-9]+$ ]] || open_prs=-1
  [[ "$open_authorized" =~ ^[0-9]+$ ]] || open_authorized=-1

  if [[ "$open_prs" -lt 0 || "$open_authorized" -lt 0 ]]; then
    _MAYOR_PRE_DISPATCH_REASON_CODE="invalid-live-counts"
    _MAYOR_PRE_DISPATCH_REASON="revalidation failed: invalid live state counts open_prs=$open_prs open_authorized_issues=$open_authorized"
    echo "$_MAYOR_PRE_DISPATCH_REASON"
    return 1
  fi

  open_polecats="$(_active_polecat_count "$rig")"
  [[ "$open_polecats" =~ ^[0-9]+$ ]] || open_polecats=-1
  if [[ "$open_polecats" -lt 0 ]]; then
    _MAYOR_PRE_DISPATCH_REASON_CODE="polecat-count-failed"
    _MAYOR_PRE_DISPATCH_REASON="revalidation failed: unable to count active polecats for rig=${rig:-all}"
    echo "$_MAYOR_PRE_DISPATCH_REASON"
    return 1
  fi
  queue_count="$(_mayor_merge_queue_count_for_rig "$rig")"
  [[ "$queue_count" =~ ^[0-9]+$ ]] || queue_count=-1
  _MAYOR_PRE_DISPATCH_LIVE_SUMMARY="open_prs=$open_prs open_authorized_issues=$open_authorized open_polecats=$open_polecats merge_queue_items=$queue_count"

  snapshot_file="${SGT_MAYOR_DISPATCH_SNAPSHOT_FILE:-}"
  if [[ -n "$snapshot_file" && -f "$snapshot_file" ]]; then
    snapshot_state="$(awk -F '\t' -v target_rig="$rig" -v target_repo="$canonical_repo" '
      function owner_repo(raw, val) {
        val = raw
        gsub(/^https:\/\/github.com\//, "", val)
        return val
      }
      {
        if ($1 != target_rig) next
        if (owner_repo($2) != owner_repo(target_repo)) next
        print $3 "|" $4 "|" $5 "|" $6
        exit
      }
    ' "$snapshot_file" 2>/dev/null || true)"
    if [[ -n "$snapshot_state" && "$snapshot_state" == *"|"* ]]; then
      IFS='|' read -r snapshot_open_prs snapshot_open_authorized snapshot_open_polecats snapshot_queue_count <<< "$snapshot_state"
      [[ "$snapshot_open_prs" =~ ^[0-9]+$ ]] || snapshot_open_prs=-1
      [[ "$snapshot_open_authorized" =~ ^[0-9]+$ ]] || snapshot_open_authorized=-1
      [[ "$snapshot_open_polecats" =~ ^[0-9]+$ ]] || snapshot_open_polecats=-1
      [[ "$snapshot_queue_count" =~ ^[0-9]+$ ]] || snapshot_queue_count=-1
      _MAYOR_PRE_DISPATCH_SNAPSHOT_SUMMARY="open_prs=$snapshot_open_prs open_authorized_issues=$snapshot_open_authorized open_polecats=$snapshot_open_polecats merge_queue_items=$snapshot_queue_count"

      mismatch_categories=()
      if [[ "$snapshot_open_prs" -ge 0 && "$snapshot_open_prs" -ne "$open_prs" ]]; then
        mismatch_categories+=("pr-state")
      fi
      if [[ "$snapshot_open_polecats" -ge 0 && "$snapshot_open_polecats" -ne "$open_polecats" ]]; then
        mismatch_categories+=("polecat-liveness")
      fi
      if [[ "$snapshot_open_authorized" -ge 0 && "$snapshot_open_authorized" -ne "$open_authorized" ]]; then
        mismatch_categories+=("queue-contents")
      fi
      if [[ "$snapshot_queue_count" -ge 0 && "$snapshot_queue_count" -ne "$queue_count" ]]; then
        mismatch_categories+=("queue-contents")
      fi

      if [[ "${#mismatch_categories[@]}" -gt 0 ]]; then
        _MAYOR_PRE_DISPATCH_MISMATCH_CATEGORIES="$(printf '%s\n' "${mismatch_categories[@]}" | awk '!seen[$0]++' | paste -sd ',' -)"
        _MAYOR_PRE_DISPATCH_REASON_CODE="consistency-mismatch"
        mismatch_reason="consistency revalidation mismatch categories=${_MAYOR_PRE_DISPATCH_MISMATCH_CATEGORIES}"
        mismatch_suffix=""
        if [[ "${SGT_MAYOR_DISPATCH_REVALIDATE:-0}" == "1" ]]; then
          mismatch_suffix="; no-op, retry next mayor cycle after revalidation"
        fi
        _MAYOR_PRE_DISPATCH_REASON="${mismatch_reason}${mismatch_suffix}"
        echo "$_MAYOR_PRE_DISPATCH_REASON"
        return 1
      fi
    fi
  fi

  parallel_budget="$(_mayor_dispatch_parallel_budget)"
  parallel_in_flight="$open_authorized"
  if [[ "$open_polecats" -gt "$parallel_in_flight" ]]; then
    parallel_in_flight="$open_polecats"
  fi
  if [[ "$parallel_budget" -gt 0 && "$parallel_in_flight" -ge "$parallel_budget" ]]; then
    _MAYOR_PRE_DISPATCH_REASON_CODE="parallel-budget-exhausted"
    _MAYOR_PRE_DISPATCH_REASON="parallel dispatch budget exhausted: open_prs=$open_prs open_authorized_issues=$open_authorized open_polecats=$open_polecats parallel_in_flight=$parallel_in_flight budget=$parallel_budget"
    echo "$_MAYOR_PRE_DISPATCH_REASON"
    return 1
  fi

  return 0
}

_pr_head_sha() {
  local repo="${1:-}" pr="${2:-}"
  [[ -n "$repo" && -n "$pr" ]] || return 1
  gh pr view "$pr" --repo "$repo" --json headRefOid --jq '.headRefOid // ""' 2>/dev/null || true
}

_merge_queue_set_field() {
  local queue_file="${1:-}" field="${2:-}" value="${3:-}"
  local safe_value tmp_file line replaced
  [[ -n "$queue_file" && -f "$queue_file" && -n "$field" ]] || return 1

  # These queue files are `source`d, so values must be shell-safe.
  # Use %q quoting to preserve spaces/newlines without executing anything.
  safe_value=$(printf '%q' "${value}")
  tmp_file="${queue_file}.tmp.$$"
  replaced=0
  : > "$tmp_file" || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "${field}="* ]]; then
      if [[ "$replaced" -eq 0 ]]; then
        printf '%s=%s\n' "$field" "$safe_value" >> "$tmp_file" || return 1
        replaced=1
      fi
      continue
    fi
    printf '%s\n' "$line" >> "$tmp_file" || return 1
  done < "$queue_file"
  if [[ "$replaced" -eq 0 ]]; then
    printf '%s=%s\n' "$field" "$safe_value" >> "$tmp_file" || return 1
  fi
  mv "$tmp_file" "$queue_file" || return 1
}

_merge_queue_set_head_sha() {
  local queue_file="${1:-}" head_sha="${2:-}"
  _merge_queue_set_field "$queue_file" "HEAD_SHA" "$head_sha"
}

_merge_queue_reset_unclear_retry_state() {
  local queue_file="${1:-}"
  [[ -n "$queue_file" && -f "$queue_file" ]] || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_RETRY_COUNT" "0" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_NEXT_RETRY_AT" "0" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_LAST_REASON" "" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_LAST_CLASS" "" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_ESCALATED" "0" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_ESCALATED_AT" "" || return 1
}

_merge_queue_mark_review_state() {
  local queue_file="${1:-}" review_state="${2:-}"
  [[ -n "$queue_file" && -f "$queue_file" && -n "$review_state" ]] || return 1
  local now review_unclear_since
  now="$(date +%s)"
  review_unclear_since=""
  if [[ "$review_state" == "REVIEW_UNCLEAR" ]]; then
    review_unclear_since=$(grep -E '^REVIEW_UNCLEAR_SINCE=' "$queue_file" 2>/dev/null | tail -1 | cut -d= -f2- || true)
    if [[ ! "$review_unclear_since" =~ ^[0-9]+$ ]]; then
      review_unclear_since="$now"
    fi
  else
    _merge_queue_reset_unclear_retry_state "$queue_file" || return 1
  fi
  _merge_queue_set_field "$queue_file" "REVIEW_STATE" "$review_state" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UPDATED_AT" "$now" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_SINCE" "$review_unclear_since" || return 1
}

_merge_queue_mark_review_ready() {
  local queue_file="${1:-}" reviewed_head_sha="${2:-}"
  [[ -n "$queue_file" && -f "$queue_file" && -n "$reviewed_head_sha" ]] || return 1
  local now
  now="$(date +%s)"
  _merge_queue_set_field "$queue_file" "REVIEW_STATE" "REVIEW_APPROVED" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UPDATED_AT" "$now" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_UNCLEAR_SINCE" "" || return 1
  _merge_queue_set_field "$queue_file" "REVIEWED_HEAD_SHA" "$reviewed_head_sha" || return 1
  _merge_queue_set_field "$queue_file" "REVIEWED_AT" "$now" || return 1
  _merge_queue_reset_unclear_retry_state "$queue_file" || return 1
}

_merge_queue_reset_review_ready_evidence() {
  local queue_file="${1:-}"
  [[ -n "$queue_file" && -f "$queue_file" ]] || return 1
  _merge_queue_set_field "$queue_file" "REVIEWED_HEAD_SHA" "" || return 1
  _merge_queue_set_field "$queue_file" "REVIEWED_AT" "" || return 1
}

_merge_queue_mark_review_pending_resync() {
  local queue_file="${1:-}" reason_code="${2:-resync}"
  [[ -n "$queue_file" && -f "$queue_file" ]] || return 1
  _merge_queue_mark_review_state "$queue_file" "REVIEW_PENDING" || return 1
  _merge_queue_reset_review_ready_evidence "$queue_file" || return 1
  _merge_queue_set_field "$queue_file" "REVIEW_RESYNC_REASON_CODE" "$reason_code" || return 1
}

_merge_queue_repo_pr_key() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}"
  local owner_repo
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  echo "rig=${rig}|${owner_repo}|pr=${pr}"
}

_merge_queue_canonical_name() {
  local rig="${1:-}" pr="${2:-}"
  echo "${rig}-pr${pr}"
}

_merge_queue_find_by_repo_pr() {
  local rig="${1:-}" repo="${2:-}" pr="${3:-}"
  local key merge_dir f q_repo q_pr q_rig q_key q_name
  key="$(_merge_queue_repo_pr_key "$rig" "$repo" "$pr")"
  merge_dir="$SGT_CONFIG/merge-queue"
  [[ -d "$merge_dir" ]] || return 1
  for f in "$merge_dir"/*; do
    [[ -f "$f" ]] || continue
    q_rig=""
    q_repo=""
    q_pr=""
    eval "$(grep -E '^(RIG|REPO|PR)=' "$f" 2>/dev/null || true)"
    q_rig="${RIG:-}"
    q_repo="${REPO:-}"
    q_pr="${PR:-}"
    if [[ -z "$q_rig" ]]; then
      q_name="$(basename "$f")"
      if [[ "$q_name" =~ ^(.+)-pr[0-9]+$ ]]; then
        q_rig="${BASH_REMATCH[1]}"
      fi
    fi
    [[ -n "$q_repo" && -n "$q_pr" ]] || continue
    q_key="$(_merge_queue_repo_pr_key "$q_rig" "$q_repo" "$q_pr")"
    if [[ "$q_key" == "$key" ]]; then
      echo "$f"
      return 0
    fi
  done
  return 1
}

_merge_queue_enqueue_polecat() {
  local rig="${1:-}" repo="${2:-}" branch="${3:-}" issue="${4:-}" pr="${5:-}" head_sha="${6:-}"
  local auto_merge="${7:-true}" backend="${8:-$(_ai_backend_default)}" polecat="${9:-}" source="${10:-unknown}"
  [[ -n "$rig" && -n "$repo" && -n "$pr" ]] || return 1

  local merge_dir queue_key owner_repo queue_name queue_file existing_file existing_name reason reason_code
  merge_dir="$SGT_CONFIG/merge-queue"
  mkdir -p "$merge_dir"

  queue_key="$(_merge_queue_repo_pr_key "$rig" "$repo" "$pr")"
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  queue_name="$(_merge_queue_canonical_name "$rig" "$pr")"
  queue_file="$merge_dir/$queue_name"

  existing_file="$(_merge_queue_find_by_repo_pr "$rig" "$repo" "$pr" || true)"
  if [[ -n "$existing_file" ]]; then
    existing_name="$(basename "$existing_file")"
    reason_code="duplicate-queue-key"
    reason="duplicate queue key (repo+pr) already queued"
    echo "[merge-queue/$rig] duplicate queue skipped — reason_code=$reason_code reason=\"$reason\" key=$queue_key existing=$existing_name incoming=$queue_name source=$source"
    log_event "MERGE_QUEUE_DUPLICATE_SKIP rig=$rig repo=$owner_repo pr=#$pr reason_code=$reason_code reason=\"$(_escape_quotes "$reason")\" key=\"$(_escape_quotes "$queue_key")\" existing=$existing_name incoming=$queue_name source=$source"
    return 1
  fi

  cat > "$queue_file" <<MQSTATE
POLECAT=${polecat:-$queue_name}
RIG=$rig
REPO=$repo
BRANCH=$branch
ISSUE=${issue:-0}
PR=$pr
HEAD_SHA=$head_sha
AUTO_MERGE=$auto_merge
BACKEND=$backend
TYPE=polecat
REVIEW_STATE=REVIEW_PENDING
REVIEW_UPDATED_AT=$(date +%s)
REVIEW_UNCLEAR_SINCE=
REVIEW_UNCLEAR_RETRY_COUNT=0
REVIEW_UNCLEAR_NEXT_RETRY_AT=0
REVIEW_UNCLEAR_LAST_REASON=
REVIEW_UNCLEAR_LAST_CLASS=
REVIEW_UNCLEAR_ESCALATED=0
REVIEW_UNCLEAR_ESCALATED_AT=
REVIEWED_HEAD_SHA=
REVIEWED_AT=
QUEUED=$(date -Iseconds)
MQSTATE
  return 0
}

_merge_queue_cleanup_terminal_for_mismatch() {
  local rig="${1:-}" queue_file="${2:-}" queue_name="${3:-}" mq_rig="${4:-}" mq_repo="${5:-}" mq_pr="${6:-}"
  local reason_code="${7:-repo-mismatch}" reason="${8:-repo mismatch}"
  local owner_repo pr_state
  [[ -n "$queue_file" && -f "$queue_file" && -n "$mq_repo" && -n "$mq_pr" ]] || return 1
  owner_repo="$(_repo_owner_repo "$mq_repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$mq_repo"
  pr_state="$(gh pr view "$mq_pr" --repo "$mq_repo" --json state --jq '.state' 2>/dev/null || true)"
  if [[ "$pr_state" == "MERGED" || "$pr_state" == "CLOSED" ]]; then
    rm -f "$queue_file"
    echo "[refinery/$rig] queue item $queue_name stale terminal PR (#$mq_pr state=$pr_state) with rig mismatch — cleaned"
    log_event "REFINERY_QUEUE_CLEAN_STALE_TERMINAL queue=$queue_name rig=$rig queue_rig=${mq_rig:-unknown} repo=$owner_repo pr=#$mq_pr pr_state=$pr_state reason_code=$reason_code reason=\"$(_escape_quotes "$reason")\""
    return 0
  fi
  return 1
}

_refinery_merge_attempt_key() {
  local repo="${1:-}" pr="${2:-}" head_sha="${3:-}"
  local owner_repo
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  echo "${owner_repo}|pr=${pr}|head=${head_sha:-unknown}"
}

_refinery_merge_attempt_key_id() {
  local key="${1:-}"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$key" | sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$key" | shasum -a 256 | awk '{print $1}'
  else
    printf '%s' "$key" | tr -c '[:alnum:]_.-' '_'
  fi
}

_refinery_merge_attempt_claim() {
  local repo="${1:-}" pr="${2:-}" head_sha="${3:-}" queue_name="${4:-}"
  local key key_id key_dir key_file
  _REFINERY_MERGE_ATTEMPT_KEY=""
  _REFINERY_MERGE_ATTEMPT_FILE=""
  key="$(_refinery_merge_attempt_key "$repo" "$pr" "$head_sha")"
  key_id="$(_refinery_merge_attempt_key_id "$key")"
  key_dir="$SGT_CONFIG/refinery-merge-attempts"
  key_file="$key_dir/$key_id"
  mkdir -p "$key_dir" || return 1
  _REFINERY_MERGE_ATTEMPT_KEY="$key"
  _REFINERY_MERGE_ATTEMPT_FILE="$key_file"
  if ! ( set -o noclobber; : > "$key_file" ) 2>/dev/null; then
    return 1
  fi
  cat > "$key_file" <<EOF
KEY=$key
REPO=$repo
PR=$pr
HEAD_SHA=${head_sha:-unknown}
QUEUE=${queue_name:-unknown}
CLAIMED_AT=$(date -Iseconds)
EOF
  return 0
}

_refinery_merge_attempt_release() {
  local key_file="${1:-}"
  [[ -n "$key_file" ]] || key_file="${_REFINERY_MERGE_ATTEMPT_FILE:-}"
  [[ -n "$key_file" ]] || return 0
  rm -f "$key_file" 2>/dev/null || true
}

_refinery_merge_attempt_file_by_key() {
  local key="${1:-}" key_id
  [[ -n "$key" ]] || return 1
  key_id="$(_refinery_merge_attempt_key_id "$key")"
  printf '%s/%s\n' "$SGT_CONFIG/refinery-merge-attempts" "$key_id"
}

_refinery_merge_attempt_clear_by_key() {
  local key="${1:-}"
  local key_file
  [[ -n "$key" ]] || return 1
  key_file="$(_refinery_merge_attempt_file_by_key "$key" || true)"
  [[ -n "$key_file" ]] || return 1
  if [[ -f "$key_file" ]]; then
    rm -f "$key_file" 2>/dev/null || true
    return 0
  fi
  return 1
}

_refinery_merge_receipts_dir() {
  echo "$SGT_CONFIG/refinery-merge-receipts"
}

_refinery_merge_receipt_file_by_key() {
  local key="${1:-}" key_id
  [[ -n "$key" ]] || return 1
  key_id="$(_refinery_merge_attempt_key_id "$key")"
  printf '%s/%s.state\n' "$(_refinery_merge_receipts_dir)" "$key_id"
}

_refinery_merge_receipt_clear_loaded() {
  _REFINERY_MERGE_RECEIPT_FILE=""
  _REFINERY_MERGE_RECEIPT_KEY=""
  _REFINERY_MERGE_RECEIPT_REPO=""
  _REFINERY_MERGE_RECEIPT_PR=""
  _REFINERY_MERGE_RECEIPT_ISSUE=""
  _REFINERY_MERGE_RECEIPT_EXPECTED_STATE=""
  _REFINERY_MERGE_RECEIPT_OBSERVED_STATE=""
  _REFINERY_MERGE_RECEIPT_MERGED_SHA=""
  _REFINERY_MERGE_RECEIPT_BRANCH_DELETED=""
  _REFINERY_MERGE_RECEIPT_VERIFIED_AT=""
  _REFINERY_MERGE_RECEIPT_OUTCOME=""
  _REFINERY_MERGE_RECEIPT_RETRY_DECISION=""
