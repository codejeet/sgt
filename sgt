pen\":$(_json_quote "$notify_alert_fail_open")},\"prompt_budget\":{\"timestamp\":$(_json_quote "$budget_ts"),\"age_seconds\":$(_json_quote "$budget_age"),\"measured_at\":$(_json_quote "$budget_measured_at"),\"estimated_tokens\":$(_json_quote "$budget_tokens"),\"char_count\":$(_json_quote "$budget_chars"),\"threshold\":$(_json_quote "$budget_threshold"),\"over_budget\":$(_json_quote "$budget_over"),\"source_path\":$(_json_quote "$budget_source")},\"auto_refresh\":{\"timestamp\":$(_json_quote "$refresh_ts"),\"age_seconds\":$(_json_quote "$refresh_age"),\"refreshed_at\":$(_json_quote "$refresh_at"),\"trigger\":$(_json_quote "$refresh_trigger"),\"estimated_tokens\":$(_json_quote "$refresh_tokens"),\"char_count\":$(_json_quote "$refresh_chars"),\"threshold\":$(_json_quote "$refresh_threshold"),\"handoff_path\":$(_json_quote "$refresh_handoff"),\"handoff_token\":$(_json_quote "$refresh_token"),\"status\":$(_json_quote "$refresh_status")},\"review_watchdog\":{\"count\":$(_json_quote "$review_watch_count"),\"oldest_seconds\":$(_json_quote "$review_watch_oldest"),\"threshold_seconds\":$(_json_quote "$review_watch_threshold")}}")
