}

_context_index_path() {
  local rig="${1:-}"
  echo "$(_context_store_dir "$rig")/index.json"
}

_context_embedding_model() {
  local model="${SGT_CONTEXT_EMBED_MODEL:-text-embedding-3-small}"
  echo "$model"
}

_context_python_bin() {
  command -v python3 2>/dev/null || command -v python 2>/dev/null || true
}

_require_context_python() {
  local py_bin
  py_bin="$(_context_python_bin)"
  [[ -n "$py_bin" ]] || die "python is required for 'sgt context' embeddings/indexing"
  echo "$py_bin"
}

_require_context_api_key() {
  [[ -n "${OPENAI_API_KEY:-}" ]] || die "OPENAI_API_KEY is required for 'sgt context index' and 'sgt context search'"
}

_ensure_context_file() {
  local rig="${1:-}" context_file today
  context_file="$(_context_file_path "$rig")"
  [[ -n "$context_file" ]] || return 1
  mkdir -p "$(dirname "$context_file")"
  if [[ -f "$context_file" ]]; then
    echo "$context_file"
    return 0
  fi
  today="$(date +%F)"
  cat > "$context_file" <<EOF
# SGT Project Context — $rig

Shared durable context for agents working on this rig.

Use this file for project-wide memory that should survive across polecats, dogs, and crew.

Useful commands:
- sgt context add $rig "<note>" — append a durable note
- sgt context search $rig "<query>" — semantic search over prior context
- sgt context index $rig — rebuild the embedding index

## Notes

## $today
EOF
  echo "$context_file"
}

_context_write_note() {
  local rig="${1:-}" note="${2:-}" context_file today now_iso
  context_file="$(_ensure_context_file "$rig")"
  note="${note//$'\r'/ }"
  note="${note//$'\n'/ }"
  note="$(printf '%s' "$note" | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
  [[ -n "$note" ]] || die "usage: sgt context add <rig> <note>"
  today="$(date +%F)"
  now_iso="$(date -Iseconds)"
  if ! grep -qx "## $today" "$context_file"; then
    printf '\n## %s\n' "$today" >> "$context_file"
  fi
  printf -- '- %s — %s\n' "$now_iso" "$note" >> "$context_file"
  echo "$context_file"
}

_context_index_build() {
  local rig="${1:-}" context_file index_path py_bin model api_key
  context_file="$(_ensure_context_file "$rig")"
  index_path="$(_context_index_path "$rig")"
  py_bin="$(_require_context_python)"
  _require_context_api_key
  mkdir -p "$(dirname "$index_path")"
  model="$(_context_embedding_model)"
  api_key="${OPENAI_API_KEY:-}"
  "$py_bin" - "$rig" "$context_file" "$index_path" "$model" "$api_key" <<'PY'
import json
import math
import os
import sys
import tempfile
import urllib.error
import urllib.request

rig, context_path, index_path, model, api_key = sys.argv[1:6]
BATCH_SIZE = 512

def _http_error_message(exc):
    body = ""
    try:
        raw = exc.read()
    except Exception:
        raw = b""
    if raw:
        try:
            body = raw.decode("utf-8", errors="replace").strip()
        except Exception:
            body = repr(raw)
    base = f"embeddings request failed with HTTP {exc.code}"
    if body:
        return f"{base}: {body}"
    return base

def embed(texts):
    payload = json.dumps({"model": model, "input": texts}).encode("utf-8")
    req = urllib.request.Request(
        "https://api.openai.com/v1/embeddings",
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            body = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raise SystemExit(_http_error_message(exc))
    data = body.get("data")
    if not isinstance(data, list) or len(data) != len(texts):
        raise SystemExit("unexpected embeddings response shape")
    return [item.get("embedding") for item in data]

entries = []
current_date = ""
with open(context_path, "r", encoding="utf-8") as fh:
    for lineno, raw in enumerate(fh, start=1):
        line = raw.rstrip("\n")
        if line.startswith("## "):
            current_date = line[3:].strip()
            continue
        if not line.startswith("- "):
            continue
        text = line[2:].strip()
        if not text:
            continue
        entries.append(
            {
                "id": f"line-{lineno}",
                "line": lineno,
                "date": current_date,
                "text": text,
            }
        )

texts = [entry["text"] for entry in entries]
embeddings = []
for start in range(0, len(texts), BATCH_SIZE):
    embeddings.extend(embed(texts[start:start + BATCH_SIZE]))
for entry, embedding in zip(entries, embeddings):
    entry["embedding"] = embedding

doc = {
    "version": 1,
    "rig": rig,
    "model": model,
    "source_path": context_path,
    "source_mtime": int(os.path.getmtime(context_path)),
    "indexed_at": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    "entries": entries,
}

index_dir = os.path.dirname(index_path) or "."
tmp_fd, tmp_path = tempfile.mkstemp(prefix=".index.", suffix=".json.tmp", dir=index_dir)
try:
    with os.fdopen(tmp_fd, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, ensure_ascii=True)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp_path, index_path)
finally:
    try:
        os.unlink(tmp_path)
    except FileNotFoundError:
        pass
print(index_path)
PY
}

_context_index_is_fresh() {
  local rig="${1:-}" context_file index_path
  context_file="$(_ensure_context_file "$rig")"
  index_path="$(_context_index_path "$rig")"
  [[ -f "$index_path" ]] || return 1
  [[ "$index_path" -nt "$context_file" ]]
}

_context_search_run() {
  local rig="${1:-}" query="${2:-}" index_path py_bin model api_key context_file search_rc retrying err_file
  [[ -n "$query" ]] || die "usage: sgt context search <rig> <query>"
  context_file="$(_ensure_context_file "$rig")"
  if ! _context_index_is_fresh "$rig"; then
    _context_index_build "$rig" >/dev/null
  fi
  index_path="$(_context_index_path "$rig")"
  py_bin="$(_require_context_python)"
  _require_context_api_key
  model="$(_context_embedding_model)"
  api_key="${OPENAI_API_KEY:-}"
  retrying=0
  err_file="$(mktemp)"
  while true; do
    set +e
    "$py_bin" - "$rig" "$index_path" "$model" "$api_key" "$query" 2>"$err_file" <<'PY'
import json
import math
import sys
import urllib.error
import urllib.request

rig, index_path, model, api_key, query = sys.argv[1:6]

def _http_error_message(exc):
    body = ""
    try:
        raw = exc.read()
    except Exception:
        raw = b""
    if raw:
        try:
            body = raw.decode("utf-8", errors="replace").strip()
        except Exception:
            body = repr(raw)
    base = f"embeddings request failed with HTTP {exc.code}"
    if body:
        return f"{base}: {body}"
    return base

try:
    with open(index_path, "r", encoding="utf-8") as fh:
        index = json.load(fh)
except (OSError, json.JSONDecodeError) as exc:
    print(f"malformed context index at {index_path}: {exc}", file=sys.stderr)
    raise SystemExit(86)

entries = index.get("entries") or []
if not entries:
    print(f"no indexed context entries for rig '{rig}'")
    raise SystemExit(0)

payload = json.dumps({"model": model, "input": query}).encode("utf-8")
req = urllib.request.Request(
    "https://api.openai.com/v1/embeddings",
    data=payload,
    headers={
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}",
    },
    method="POST",
)
try:
    with urllib.request.urlopen(req, timeout=60) as resp:
        body = json.loads(resp.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    raise SystemExit(_http_error_message(exc))
query_embedding = (body.get("data") or [{}])[0].get("embedding")
if not query_embedding:
    raise SystemExit("unexpected embeddings response shape")

def cosine(a, b):
    dot = sum(x * y for x, y in zip(a, b))
    na = math.sqrt(sum(x * x for x in a))
    nb = math.sqrt(sum(y * y for y in b))
    if na == 0.0 or nb == 0.0:
        return -1.0
    return dot / (na * nb)

ranked = []
for entry in entries:
    emb = entry.get("embedding")
    if not emb:
      continue
    ranked.append((cosine(query_embedding, emb), entry))

ranked.sort(key=lambda item: item[0], reverse=True)
top = ranked[:5]
if not top:
    print(f"no indexed context entries for rig '{rig}'")
    raise SystemExit(0)

for score, entry in top:
    date = entry.get("date") or "undated"
    line = entry.get("line") or "?"
    text = entry.get("text") or ""
    print(f"{score:.3f}\t{date}\tline {line}\t{text}")
PY
    search_rc=$?
    set -e
    if [[ "$search_rc" -eq 0 ]]; then
      cat "$err_file" >&2
      rm -f "$err_file"
      return 0
    fi
    if [[ "$search_rc" -eq 86 ]] && [[ "$retrying" -eq 0 ]]; then
      retrying=1
      warn "context index for rig '$rig' was malformed; rebuilding"
      _context_index_build "$rig" >/dev/null || die "failed to rebuild malformed context index for rig '$rig'"
      continue
    fi
    if [[ "$search_rc" -eq 86 ]]; then
      rm -f "$err_file"
      die "context index for rig '$rig' is malformed and rebuild did not recover it"
    fi
    cat "$err_file" >&2
    rm -f "$err_file"
    return "$search_rc"
  done
}

cmd_context() {
  local sub="${1:-}"
  shift 2>/dev/null || true
  case "$sub" in
    ""|help|--help|-h)
      cat <<EOF
Usage: sgt context <command> [args]

Commands:
  path <rig>             Print the repo-local shared memory path
  add <rig> <note>       Append a durable note to SGT_CONTEXT.md
  index <rig>            Rebuild the embedding index for SGT_CONTEXT.md
  search <rig> <query>   Semantic search over shared memory
EOF
      ;;
    path)
      local rig="${1:-}"
      [[ -n "$rig" ]] || die "usage: sgt context path <rig>"
      ensure_init
      ensure_rig "$rig"
      _ensure_context_file "$rig"
      ;;
    add)
      local rig="${1:-}" note="${2:-}"
      [[ -n "$rig" ]] || die "usage: sgt context add <rig> <note>"
      [[ -n "$note" ]] || die "usage: sgt context add <rig> <note>"
      ensure_init
      ensure_rig "$rig"
      _context_write_note "$rig" "$note" >/dev/null
      if [[ -n "${OPENAI_API_KEY:-}" ]] && [[ -n "$(_context_python_bin)" ]]; then
        if ! _context_index_build "$rig" >/dev/null; then
          warn "opportunistic context reindex failed for rig '$rig'; run 'sgt context index $rig' to refresh embeddings"
        fi
      fi
      info "added shared context note to $(_context_file_path "$rig")"
      ;;
    index)
      local rig="${1:-}"
      [[ -n "$rig" ]] || die "usage: sgt context index <rig>"
      ensure_init
      ensure_rig "$rig"
      _context_index_build "$rig"
      ;;
    search)
      local rig="${1:-}" query="${2:-}"
      [[ -n "$rig" ]] || die "usage: sgt context search <rig> <query>"
      [[ -n "$query" ]] || die "usage: sgt context search <rig> <query>"
      ensure_init
      ensure_rig "$rig"
      _context_search_run "$rig" "$query"
      ;;
    *)
      die "unknown context command: $sub (try: help, path, add, index, search)"
      ;;
  esac
}

_openclaw_sender_route() {
  local rig="${1:-}" notify_out="" agent="" channel="" to="" reply_to=""
  # Fallback chain: rig-specific notify_agent > global default > 'main'
  if [[ -n "$rig" ]]; then
    agent="$(_rig_notify_agent_read "$rig" 2>/dev/null || true)"
  fi
  notify_out="$(_openclaw_notify_config_read || true)"
  if [[ -n "$notify_out" ]]; then
    local fields=()
    while IFS= read -r line; do fields+=("$line"); done <<< "$notify_out"
    [[ -n "$agent" ]] || agent="${fields[0]:-}"
    channel="${fields[1]:-}"
    to="${fields[2]:-}"
    reply_to="${fields[3]:-}"
  fi
  [[ -n "$agent" ]] || agent="main"
  [[ -n "$channel" ]] || channel="last"
  echo "${agent}|${channel}|${to}|${reply_to}"
}

_resolve_requesting_openclaw_agent_id() {
  local explicit="${1:-}" env_agent="" notify_to=""
  if [[ -n "$explicit" ]]; then
    echo "$explicit"
    return 0
  fi
  env_agent="${SGT_OPENCLAW_AGENT_ID:-${OPENCLAW_AGENT_ID:-}}"
  if [[ -n "$env_agent" ]]; then
    echo "$env_agent"
    return 0
  fi
  IFS='|' read -r _ _ notify_to _ <<< "$(_openclaw_sender_route)"
  if [[ -n "$notify_to" ]]; then
    echo "$notify_to"
    return 0
  fi
  echo "rigger"
}

_openclaw_notify_target() {
  local target="${1:-}" message="${2:-}" prefix="${3:-[SGT]}"
  local sender_agent channel reply_to configured_to
  [[ -n "$target" && -n "$message" ]] || return 1
  command -v openclaw &>/dev/null || return 1
  IFS='|' read -r sender_agent channel configured_to reply_to <<< "$(_openclaw_sender_route)"
  local -a cmd=(openclaw agent --agent "$sender_agent" --deliver --message "$prefix $message" --channel "$channel" --to "$target")
  [[ -n "$reply_to" ]] && cmd+=(--reply-to "$reply_to")
  "${cmd[@]}" &>/dev/null &
  disown 2>/dev/null
  log_event "OPENCLAW_NOTIFY_TARGET agent=$sender_agent channel=$channel to=$target reply_to=$reply_to message=$message"
}

