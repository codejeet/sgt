_mayor_trigger_auto_refresh() {
  local estimated_tokens="${1:-0}" char_count="${2:-0}" threshold="${3:-$(_mayor_auto_refresh_threshold_tokens)}" trigger="${4:-budget-exceeded}" prompt_file="${5:-}"
  local scope_rig="${SGT_MAYOR_SCOPE_RIG:-}" handoff_token handoff_dir handoff_file status_snapshot now_epoch now_iso was_running
  now_epoch="$(date +%s)"
  now_iso="$(date -Iseconds)"
  was_running="true"

  handoff_token="$(_mayor_refresh_token)"
  handoff_dir="$(_mayor_refresh_handoffs_dir)/$handoff_token"
  handoff_file="$handoff_dir/handoff.md"
  mkdir -p "$handoff_dir"

  status_snapshot="$(cmd_status 2>&1 || true)"
  _mayor_scope_apply "$scope_rig"
  _mayor_refresh_archive_transients "$handoff_dir" >/dev/null || true
  _mayor_refresh_write_handoff "$handoff_file" "$handoff_token" "$was_running" "$status_snapshot"
  cat >> "$handoff_file" <<EOF

## Auto-Refresh Trigger
- trigger: $trigger
- estimated_tokens: $estimated_tokens
- estimated_chars: $char_count
- threshold_tokens: $threshold
- prompt_file: ${prompt_file:-unknown}
EOF
  _mayor_auto_refresh_state_write "$now_epoch" "$now_iso" "$trigger" "$estimated_tokens" "$char_count" "$threshold" "$handoff_file" "$handoff_token" "scheduled"
  log_event "MAYOR_AUTO_REFRESH_TRIGGERED scope=${scope_rig:-shared} trigger=$trigger estimated_tokens=$estimated_tokens threshold=$threshold char_count=$char_count handoff=\"$(_escape_quotes "$handoff_file")\""
  _mayor_record_decision "MAYOR AUTO REFRESH trigger=$trigger estimated_tokens=$estimated_tokens threshold=$threshold char_count=$char_count handoff=\"$handoff_file\"" "auto-refresh-threshold" "$SGT_ROOT" || true
  _mayor_schedule_auto_refresh_resume "$scope_rig"
  printf '%s\n' "$handoff_file"
}

_mayor_prompt_budget_guard() {
  local prompt_file="${1:-}" trigger="${2:-ai-cycle}"
  local estimated_tokens char_count threshold over_budget measured_at now_epoch cooldown_secs
  local refresh_ts refresh_at refresh_trigger refresh_tokens refresh_chars refresh_threshold refresh_handoff refresh_token refresh_status
  local age cooldown_remaining handoff_file

  IFS='|' read -r estimated_tokens char_count <<< "$(_mayor_prompt_budget_measure_file "$prompt_file")"
  threshold="$(_mayor_auto_refresh_threshold_tokens)"
  measured_at="$(date -Iseconds)"
  now_epoch="$(date +%s)"
  over_budget="false"
  if [[ "$estimated_tokens" =~ ^[0-9]+$ && "$threshold" =~ ^[0-9]+$ ]] && (( estimated_tokens > threshold )); then
    over_budget="true"
  fi
  _mayor_prompt_budget_state_write "$now_epoch" "$measured_at" "$estimated_tokens" "$char_count" "$threshold" "$over_budget" "$prompt_file"
  log_event "MAYOR_PROMPT_BUDGET scope=${SGT_MAYOR_SCOPE_RIG:-shared} estimated_tokens=$estimated_tokens threshold=$threshold char_count=$char_count over_budget=$over_budget prompt=\"$(_escape_quotes "$prompt_file")\""

  if [[ "$over_budget" != "true" ]]; then
    printf 'ok|%s|%s|%s|0|\n' "$estimated_tokens" "$char_count" "$threshold"
    return 0
  fi

  cooldown_secs="$(_mayor_auto_refresh_cooldown_secs)"
  IFS='|' read -r refresh_ts refresh_at refresh_trigger refresh_tokens refresh_chars refresh_threshold refresh_handoff refresh_token refresh_status <<< "$(_mayor_auto_refresh_state_read)"
  cooldown_remaining=0
  if [[ "$cooldown_secs" =~ ^[0-9]+$ && "$cooldown_secs" -gt 0 && "$refresh_ts" =~ ^[0-9]+$ ]]; then
    age=$((now_epoch - refresh_ts))
    (( age < 0 )) && age=0
    if (( age < cooldown_secs )); then
      cooldown_remaining=$((cooldown_secs - age))
      log_event "MAYOR_AUTO_REFRESH_SKIPPED scope=${SGT_MAYOR_SCOPE_RIG:-shared} reason=cooldown-active estimated_tokens=$estimated_tokens threshold=$threshold char_count=$char_count remaining=${cooldown_remaining}s previous_handoff=\"$(_escape_quotes "$refresh_handoff")\""
      _mayor_record_decision "MAYOR AUTO REFRESH SKIP reason=cooldown-active estimated_tokens=$estimated_tokens threshold=$threshold char_count=$char_count remaining=${cooldown_remaining}s" "auto-refresh-cooldown" "$SGT_ROOT" || true
      printf 'cooldown|%s|%s|%s|%s|%s\n' "$estimated_tokens" "$char_count" "$threshold" "$cooldown_remaining" "$refresh_handoff"
      return 2
    fi
  fi

  handoff_file="$(_mayor_trigger_auto_refresh "$estimated_tokens" "$char_count" "$threshold" "$trigger" "$prompt_file")"
  printf 'refresh|%s|%s|%s|0|%s\n' "$estimated_tokens" "$char_count" "$threshold" "$handoff_file"
  return 1
}

_mayor_wait_for_start() {
  local session="${1:-sgt-mayor}" attempt="${2:-}" timeout_secs="${3:-$(_mayor_start_validation_timeout_secs)}"
  local waited=0

  while (( waited < timeout_secs )); do
    if _mayor_start_receipt_matches "$attempt"; then
      if tmux has-session -t "$session" 2>/dev/null; then
        return 0
      fi
    fi
    if ! tmux has-session -t "$session" 2>/dev/null; then
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done

  if _mayor_start_receipt_matches "$attempt" && tmux has-session -t "$session" 2>/dev/null; then
    return 0
  fi
  return 1
}

_rfc3339_utc_now() {
  local ts
  ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true)"
  if [[ "$ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
    echo "$ts"
    return 0
  fi
  echo "1970-01-01T00:00:00Z"
  return 1
}

_mayor_decision_log_append() {
  local entry="${1:-}"
  local workspace="${2:-$SGT_ROOT}"
  local context="${3:-cycle}"
  local log_file="$(_mayor_scope_dir)/mayor-decisions.log"
  local py_bin payload py_out
  local ts sanitized_entry placeholder_replacement placeholder_count ts_fallback
  ts="$(_rfc3339_utc_now)"
  ts_fallback=0
  if [[ $? -ne 0 ]]; then
    ts_fallback=1
  fi
  _MAYOR_DECISION_LOG_LAST_ERROR=""

  if ! mkdir -p "$(dirname "$log_file")" 2>/dev/null; then
    _MAYOR_DECISION_LOG_LAST_ERROR="failed to create $(dirname "$log_file")"
    return 1
  fi

  py_bin="$(command -v python3 || command -v python || true)"
  if [[ -z "$py_bin" ]]; then
    _MAYOR_DECISION_LOG_LAST_ERROR="python command not found"
    return 1
  fi

  sanitized_entry="$entry"
  placeholder_count=0
  placeholder_replacement="[$ts]"
  if [[ "$ts_fallback" -eq 1 ]]; then
    placeholder_replacement="[timestamp-error]"
  fi
  while [[ "$sanitized_entry" == *"[]"* ]]; do
    sanitized_entry="${sanitized_entry/"[]"/"$placeholder_replacement"}"
    placeholder_count=$((placeholder_count + 1))
  done
  if [[ "$placeholder_count" -gt 0 ]]; then
    log_event "MAYOR_DECISION_LOG_TIMESTAMP_SANITIZED context=$context workspace=\"$(_escape_quotes "$workspace")\" placeholders=$placeholder_count replacement=\"$(_escape_quotes "$placeholder_replacement")\""
  fi
  if [[ "$ts_fallback" -eq 1 ]]; then
    log_event "MAYOR_DECISION_LOG_TIMESTAMP_FALLBACK context=$context workspace=\"$(_escape_quotes "$workspace")\" timestamp=$ts"
  fi

  payload="$(printf '[%s] workspace=%s\n%s\n' "$ts" "$workspace" "$sanitized_entry")"
  if ! py_out="$(
    SGT_MAYOR_DECISION_LOG_APPEND_PAYLOAD="$payload" \
      "$py_bin" - "$log_file" 2>&1 <<'PY'
import fcntl
import os
import sys

path = sys.argv[1]
payload = os.environ.get("SGT_MAYOR_DECISION_LOG_APPEND_PAYLOAD", "").encode("utf-8")
if payload and not payload.endswith(b"\n"):
    payload += b"\n"
fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
try:
    fcntl.flock(fd, fcntl.LOCK_EX)
    start = os.lseek(fd, 0, os.SEEK_END)
    try:
        offset = 0
        while offset < len(payload):
            wrote = os.write(fd, payload[offset:])
            if wrote <= 0:
                raise RuntimeError("short write")
            offset += wrote
        os.fsync(fd)
    except Exception as err:
        # Keep entries all-or-nothing: never leave torn/truncated append payloads.
        rollback_err = None
        try:
            os.ftruncate(fd, start)
            os.fsync(fd)
        except Exception as rollback_exc:
            rollback_err = rollback_exc
        if rollback_err is not None:
            raise RuntimeError(f"{err}; rollback failed: {rollback_err}") from err
        raise
finally:
    os.close(fd)
PY
  )"; then
    py_out="$(_one_line "${py_out:-append failed}")"
    _MAYOR_DECISION_LOG_LAST_ERROR="failed to append+fsync $log_file ($py_out)"
    return 1
  fi
}

_mayor_record_decision() {
  local entry="${1:-}"
  local context="${2:-cycle}"
  local workspace="${3:-$SGT_ROOT}"
  if _mayor_decision_log_append "$entry" "$workspace" "$context"; then
    _mayor_decision_log_failure_state_clear
    return 0
  fi
  local err now cooldown prev_ts prev_context prev_workspace prev_error age notify_status warn_line
  err="$(_escape_quotes "${_MAYOR_DECISION_LOG_LAST_ERROR:-unknown}")"
  now="$(date +%s)"
  cooldown="$(_decision_log_alert_cooldown_secs)"
  IFS='|' read -r prev_ts prev_context prev_workspace prev_error <<< "$(_mayor_decision_log_failure_state_read)"
  age=0
  if [[ "$prev_ts" =~ ^[0-9]+$ ]]; then
    age=$((now - prev_ts))
    if [[ "$age" -lt 0 ]]; then
      age=0
    fi
  fi
  _mayor_decision_log_failure_state_write "$now" "$context" "$workspace" "${_MAYOR_DECISION_LOG_LAST_ERROR:-unknown}"

  if [[ ! "$prev_ts" =~ ^[0-9]+$ || "$cooldown" -eq 0 || "$age" -ge "$cooldown" ]]; then
    if _mayor_notify_rigger "mayor warning: decision-log write failed context=$context error=${_MAYOR_DECISION_LOG_LAST_ERROR:-unknown}"; then
      notify_status="sent"
    else
      notify_status="unavailable"
    fi
  else
    notify_status="suppressed"
  fi

  warn_line="MAYOR_DECISION_LOG_WRITE_FAILED context=$context workspace=\"$(_escape_quotes "$workspace")\" error=\"$err\" notify=$notify_status cooldown=${cooldown}s"
  echo "[mayor] warning: $warn_line"
  log_event "$warn_line"
  return 1
}

_repo_owner_repo() {
  local repo="${1:-}"
  repo="${repo#https://github.com/}"
  repo="${repo#http://github.com/}"
  echo "$repo"
}

_repo_owner_repo_strict() {
  local repo="${1:-}"
  repo="${repo#https://github.com/}"
  repo="${repo#http://github.com/}"
  repo="${repo%/}"
  if [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    echo "$repo"
    return 0
  fi
  return 1
}

_repo_owner_repo_url() {
  local owner_repo="${1:-}"
  [[ -n "$owner_repo" ]] || return 1
  echo "https://github.com/$owner_repo"
}

_rig_repo_resolve_error() {
  local context="${1:-unknown}" rig="${2:-}" observed_repo="${3:-}" canonical_repo="${4:-}" reason_code="${5:-unknown}" reason="${6:-unknown}"
  _RIG_REPO_RESOLVE_REASON_CODE="$reason_code"
  _RIG_REPO_RESOLVE_REASON="$reason"
  if declare -F log_event >/dev/null; then
    log_event "RIG_REPO_RESOLVE_ERROR context=$context rig=${rig:-unknown} observed_repo=\"$(_escape_quotes "${observed_repo:-}")\" canonical_repo=\"$(_escape_quotes "${canonical_repo:-}")\" reason_code=$reason_code reason=\"$(_escape_quotes "$reason")\""
  fi
  echo "ERROR|$reason_code|$reason"
  return 1
}

_rig_repo_resolve_error_unpack() {
  local payload="${1:-}" code reason
  if [[ "$payload" == ERROR\|* ]]; then
    IFS='|' read -r _ code reason <<< "$payload"
    echo "${code:-unknown}|${reason:-unable to resolve rig repo}"
    return 0
  fi
  echo "unknown|unable to resolve rig repo"
}

_resolve_rig_repo_canonical() {
  local context="${1:-unknown}" rig="${2:-}" observed_repo="${3:-}" require_observed="${4:-0}"
  local canonical_repo canonical_owner_repo observed_owner_repo
  _RIG_REPO_RESOLVE_REASON_CODE=""
  _RIG_REPO_RESOLVE_REASON=""

  if [[ -z "$rig" ]]; then
    if [[ -z "$observed_repo" ]]; then
      _rig_repo_resolve_error "$context" "$rig" "$observed_repo" "" "missing-rig-and-repo" "missing rig and repo"
      return 1
    fi
    if ! observed_owner_repo="$(_repo_owner_repo_strict "$observed_repo")"; then
      _rig_repo_resolve_error "$context" "$rig" "$observed_repo" "" "invalid-repo" "invalid repo '$observed_repo'"
      return 1
    fi
    _repo_owner_repo_url "$observed_owner_repo"
    return 0
  fi

  if [[ ! -f "$SGT_RIGS/$rig" ]]; then
    _rig_repo_resolve_error "$context" "$rig" "$observed_repo" "" "unknown-rig" "rig '$rig' not found"
    return 1
  fi

  canonical_repo="$(rig_repo "$rig" 2>/dev/null || true)"
  if ! canonical_owner_repo="$(_repo_owner_repo_strict "$canonical_repo")"; then
    _rig_repo_resolve_error "$context" "$rig" "$observed_repo" "$canonical_repo" "invalid-rig-repo" "rig '$rig' has invalid configured repo '$canonical_repo'"
    return 1
  fi
  canonical_repo="$(_repo_owner_repo_url "$canonical_owner_repo")"

  if [[ -z "$observed_repo" ]]; then
    if [[ "$require_observed" == "1" ]]; then
      _rig_repo_resolve_error "$context" "$rig" "$observed_repo" "$canonical_repo" "missing-repo" "missing repo for rig '$rig'"
      return 1
    fi
    echo "$canonical_repo"
    return 0
  fi

  if ! observed_owner_repo="$(_repo_owner_repo_strict "$observed_repo")"; then
    _rig_repo_resolve_error "$context" "$rig" "$observed_repo" "$canonical_repo" "invalid-repo" "invalid repo '$observed_repo'"
    return 1
  fi

  if [[ "$observed_owner_repo" != "$canonical_owner_repo" ]]; then
    _rig_repo_resolve_error "$context" "$rig" "$observed_repo" "$canonical_repo" "repo-mismatch" "repo mismatch for rig '$rig': observed='$observed_owner_repo' canonical='$canonical_owner_repo'"
    return 1
  fi

  echo "$canonical_repo"
}

_repo_pr_url() {
  local repo="${1:-}" pr="${2:-}"
  local owner_repo
  owner_repo="$(_repo_owner_repo "$repo")"
  if [[ -z "$owner_repo" || -z "$pr" ]]; then
    echo ""
    return 0
  fi
  echo "https://github.com/$owner_repo/pull/$pr"
}

_repo_issue_url() {
  local repo="${1:-}" issue="${2:-}"
  local owner_repo
  owner_repo="$(_repo_owner_repo "$repo")"
  if [[ -z "$owner_repo" || -z "$issue" || "$issue" == "0" ]]; then
    echo ""
    return 0
  fi
  echo "https://github.com/$owner_repo/issues/$issue"
}

_one_line() {
  local value="${1:-}"
  printf '%s' "$value" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

_escape_quotes() {
  local value
  value="$(_one_line "$1")"
  value="${value//\"/\\\"}"
  echo "$value"
}

_escape_wake_value() {
  local value
  value="$(_one_line "$1")"
  value="${value//|//}"
  echo "$value"
}

_wake_field() {
  local reason="${1:-}" key="${2:-}"
  local part
  IFS='|' read -r -a parts <<< "$reason"
  for part in "${parts[@]}"; do
    if [[ "$part" == "$key="* ]]; then
      echo "${part#${key}=}"
      return 0
    fi
  done
  echo ""
}

_dedupe_wake_reasons() {
  local -A seen=()
  local reason
  for reason in "$@"; do
    [[ -n "$reason" ]] || continue
    if [[ -z "${seen[$reason]+x}" ]]; then
      seen["$reason"]=1
      echo "$reason"
    fi
  done
}

_wake_requires_dispatch_decision() {
  local reason="${1:-}"
  [[ "$reason" == merged:* || "$reason" == dog-approved:* ]]
}

_mayor_rig_activity_enabled() {
  [[ "${SGT_MAYOR_RIG_ACTIVITY:-1}" == "1" ]]
}

_mayor_rig_auto_hibernate_secs() {
  local raw="${SGT_MAYOR_RIG_AUTO_HIBERNATE_SECS:-0}"
  [[ "$raw" =~ ^[0-9]+$ ]] || raw=0
  printf '%s\n' "$raw"
}

_mayor_rig_activity_file() {
  local rig="${1:-}"
  printf '%s/%s.state\n' "$SGT_MAYOR_RIG_ACTIVITY_DIR" "$rig"
}

_mayor_rig_activity_state_read() {
  local rig="${1:-}" state_file state last_reason changed_at changed_epoch hibernation_mode last_meaningful_at last_meaningful_epoch last_meaningful_reason last_wake_at last_wake_reason
  state_file="$(_mayor_rig_activity_file "$rig")"
  state=""
  last_reason=""
  changed_at=""
  changed_epoch=""
  hibernation_mode=""
  last_meaningful_at=""
  last_meaningful_epoch=""
  last_meaningful_reason=""
  last_wake_at=""
  last_wake_reason=""
  if [[ -f "$state_file" ]]; then
    while IFS='=' read -r k v; do
      case "$k" in
        STATE) state="$v" ;;
        LAST_REASON) last_reason="$v" ;;
        CHANGED_AT) changed_at="$v" ;;
        CHANGED_EPOCH) changed_epoch="$v" ;;
        HIBERNATION_MODE) hibernation_mode="$v" ;;
        LAST_MEANINGFUL_AT) last_meaningful_at="$v" ;;
        LAST_MEANINGFUL_EPOCH) last_meaningful_epoch="$v" ;;
        LAST_MEANINGFUL_REASON) last_meaningful_reason="$v" ;;
        LAST_WAKE_AT) last_wake_at="$v" ;;
        LAST_WAKE_REASON) last_wake_reason="$v" ;;
      esac
    done < "$state_file"
  fi
  printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
    "${state:-unknown}" \
    "${last_reason:-}" \
    "${changed_at:-}" \
    "${changed_epoch:-}" \
    "${hibernation_mode:-none}" \
    "${last_meaningful_at:-}" \
    "${last_meaningful_epoch:-}" \
    "${last_meaningful_reason:-}" \
    "${last_wake_at:-}" \
    "${last_wake_reason:-}"
}

_mayor_rig_activity_state_write() {
  local rig="${1:-}" state="${2:-idle}" last_reason="${3:-}" hibernation_mode="${4:-none}" last_meaningful_at="${5:-}" last_meaningful_epoch="${6:-}" last_meaningful_reason="${7:-}" last_wake_at="${8:-}" last_wake_reason="${9:-}"
  local state_file state_tmp now_epoch now_iso previous changed_at changed_epoch previous_state previous_hibernation
  mkdir -p "$SGT_MAYOR_RIG_ACTIVITY_DIR"
  state_file="$(_mayor_rig_activity_file "$rig")"
  now_epoch="$(date +%s)"
  now_iso="$(date -Iseconds)"
  previous="$(_mayor_rig_activity_state_read "$rig")"
  IFS='|' read -r previous_state _ changed_at changed_epoch previous_hibernation _ _ _ _previous_wake_at _previous_wake_reason <<< "$previous"
  if [[ "$previous_state" != "$state" || "$previous_hibernation" != "$hibernation_mode" ]]; then
    changed_at="$now_iso"
    changed_epoch="$now_epoch"
  fi
  [[ -n "$changed_at" ]] || changed_at="$now_iso"
  [[ "$changed_epoch" =~ ^[0-9]+$ ]] || changed_epoch="$now_epoch"
  state_tmp="${state_file}.tmp.$$"
  cat > "$state_tmp" <<EOF
STATE=$state
LAST_REASON=$(_escape_wake_value "$last_reason")
CHANGED_AT=$changed_at
CHANGED_EPOCH=$changed_epoch
HIBERNATION_MODE=$hibernation_mode
LAST_MEANINGFUL_AT=$last_meaningful_at
LAST_MEANINGFUL_EPOCH=$last_meaningful_epoch
LAST_MEANINGFUL_REASON=$(_escape_wake_value "$last_meaningful_reason")
LAST_WAKE_AT=$last_wake_at
LAST_WAKE_REASON=$(_escape_wake_value "$last_wake_reason")
EOF
  mv "$state_tmp" "$state_file"
}

_mayor_wake_reason_rig() {
  local reason="${1:-}" rig=""
  if [[ -n "$reason" ]]; then
    rig="$(_wake_field "$reason" "rig")"
  fi
  if [[ -n "$rig" ]]; then
    printf '%s\n' "$rig"
    return 0
  fi
  if [[ "$reason" =~ ^merged:pr#[0-9]+:#[0-9]+:([^|]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [[ "$reason" =~ ^dog-approved:[^:]+:#[0-9]+:([^|]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [[ "$reason" =~ ^orphan-pr:#[0-9]+:(.+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [[ "$reason" =~ ^acceptance-blocker:([^:]+): ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [[ "$reason" =~ ^stalled-unreplaced:([^:]+): ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [[ "$reason" =~ ^backend-limit:([^:]+): ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    printf '%s\n' ""
  fi
}

_mayor_wake_reason_is_meaningful() {
  local reason="${1:-}"
  case "$reason" in
    ""|periodic)
      return 1
      ;;
    * )
      return 0
      ;;
  esac
}

_mayor_wake_reason_targets_rig() {
  local reason="${1:-}" rig="${2:-}"
  [[ -n "$rig" ]] || return 1
  [[ "$(_mayor_wake_reason_rig "$reason")" == "$rig" ]]
}

_mayor_rig_activity_snapshot() {
  local rig="${1:-}" repo open_prs open_authorized active_polecats merge_queue pending_plan_requests plan_rollup plan_status actionable state reason
  repo="$(rig_repo "$rig" 2>/dev/null || true)"
  open_prs=0
  open_authorized=0
  if [[ -n "$repo" ]]; then
    open_prs="$(gh pr list --repo "$repo" --state open --json number --jq 'length' 2>/dev/null || true)"
    open_authorized="$(gh issue list --repo "$repo" --state open --label "sgt-authorized" --json number --jq 'length' 2>/dev/null || true)"
  fi
  [[ "$open_prs" =~ ^[0-9]+$ ]] || open_prs=0
  [[ "$open_authorized" =~ ^[0-9]+$ ]] || open_authorized=0
  active_polecats="$(_active_polecat_count "$rig" 2>/dev/null || true)"
  [[ "$active_polecats" =~ ^[0-9]+$ ]] || active_polecats=0
  merge_queue="$(_merge_queue_count_for_rig "$rig" 2>/dev/null || true)"
  [[ "$merge_queue" =~ ^[0-9]+$ ]] || merge_queue=0
  pending_plan_requests=0
  while IFS='|' read -r request_id request_rig _request_status _requested_at _requester _prompt_file; do
    [[ -n "$request_id" ]] || continue
    [[ "$request_rig" == "$rig" ]] || continue
    pending_plan_requests=$((pending_plan_requests + 1))
  done < <(_plan_request_list_pending)
  plan_rollup="not_declared"
  plan_status="not_declared"
  if [[ -f "$(_plan_state_path "$rig")" ]]; then
    local plan_snapshot
    plan_snapshot="$(python3 - "$(_plan_state_path "$rig")" <<'PY'
import json
import sys

state = {}
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        state = json.load(fh)
except Exception:
    state = {}

completion = state.get("completion") or {}
print(f"{completion.get('rollup', 'not_declared')}|{completion.get('status', 'not_declared')}")
PY
)"
    if [[ "$plan_snapshot" == *"|"* ]]; then
      IFS='|' read -r plan_rollup plan_status <<< "$plan_snapshot"
    fi
  fi
  actionable=0
  if (( open_prs > 0 || open_authorized > 0 || active_polecats > 0 || merge_queue > 0 || pending_plan_requests > 0 )); then
    actionable=1
  fi
  state="idle"
  reason="no actionable work"
  if (( actionable > 0 )); then
    state="active"
    reason="open_issues=${open_authorized} open_prs=${open_prs} active_polecats=${active_polecats} merge_queue=${merge_queue} pending_plan_requests=${pending_plan_requests}"
  elif [[ "$plan_rollup" == "blocked-pending-external" ]]; then
    reason="blocked pending external condition"
  fi
  printf '%s|%s|%s|%s|%s|%s|%s|%s\n' \
    "$state" \
    "$reason" \
    "$open_authorized" \
    "$open_prs" \
    "$active_polecats" \
    "$merge_queue" \
    "$pending_plan_requests" \
    "${plan_rollup}|${plan_status}"
}

_mayor_rig_activity_refresh() {
  local rig="${1:-}" wake_reason="${2:-periodic}" force_event="${3:-0}"
  local snapshot snapshot_state snapshot_reason open_authorized open_prs active_polecats merge_queue pending_plan_requests plan_rollup plan_status
  local prior prior_state prior_reason prior_changed_at prior_changed_epoch prior_mode prior_meaningful_at prior_meaningful_epoch prior_meaningful_reason prior_wake_at prior_wake_reason
  local state hibernation_mode last_reason last_meaningful_at last_meaningful_epoch last_meaningful_reason last_wake_at last_wake_reason now_iso now_epoch auto_hibernate_secs idle_age
  local prior_hibernated=0 current_hibernated=0
  _mayor_rig_activity_enabled || return 0
  snapshot="$(_mayor_rig_activity_snapshot "$rig")"
  IFS='|' read -r snapshot_state snapshot_reason open_authorized open_prs active_polecats merge_queue pending_plan_requests plan_rollup plan_status <<< "$snapshot"
  prior="$(_mayor_rig_activity_state_read "$rig")"
  IFS='|' read -r prior_state prior_reason prior_changed_at prior_changed_epoch prior_mode prior_meaningful_at prior_meaningful_epoch prior_meaningful_reason prior_wake_at prior_wake_reason <<< "$prior"
  state="$snapshot_state"
  hibernation_mode="${prior_mode:-none}"
  last_reason="$snapshot_reason"
  last_meaningful_at="${prior_meaningful_at:-}"
  last_meaningful_epoch="${prior_meaningful_epoch:-}"
  last_meaningful_reason="${prior_meaningful_reason:-}"
  last_wake_at="${prior_wake_at:-}"
  last_wake_reason="${prior_wake_reason:-}"
  now_iso="$(date -Iseconds)"
  now_epoch="$(date +%s)"
  if [[ "$force_event" == "1" ]] && _mayor_wake_reason_is_meaningful "$wake_reason"; then
    last_wake_at="$now_iso"
    last_wake_reason="$wake_reason"
  fi
  if [[ "$snapshot_state" == "active" ]]; then
    last_meaningful_at="$now_iso"
    last_meaningful_epoch="$now_epoch"
    last_meaningful_reason="$snapshot_reason"
  fi
  if [[ "$prior_mode" == "manual" ]]; then
    state="hibernated"
    last_reason="${prior_reason:-manual hibernation}"
    hibernation_mode="manual"
  elif [[ "$snapshot_state" == "active" ]]; then
    hibernation_mode="none"
  fi
  auto_hibernate_secs="$(_mayor_rig_auto_hibernate_secs)"
  if [[ "$snapshot_state" != "active" && "$prior_mode" != "manual" && "$auto_hibernate_secs" -gt 0 ]]; then
    if [[ "$last_meaningful_epoch" =~ ^[0-9]+$ ]]; then
      idle_age=$((now_epoch - last_meaningful_epoch))
    else
      idle_age="$auto_hibernate_secs"
    fi
    if (( idle_age >= auto_hibernate_secs )); then
      state="hibernated"
      hibernation_mode="auto"
      last_reason="auto-hibernated: ${snapshot_reason} idle_seconds=${idle_age}"
    fi
  elif [[ "$snapshot_state" != "active" && "$prior_mode" == "auto" ]]; then
    state="hibernated"
    hibernation_mode="auto"
    last_reason="${prior_reason:-auto-hibernated}"
  fi
  _mayor_rig_activity_state_write "$rig" "$state" "$last_reason" "$hibernation_mode" "$last_meaningful_at" "$last_meaningful_epoch" "$last_meaningful_reason" "$last_wake_at" "$last_wake_reason"
  if [[ "$prior_state" == "hibernated" && "${prior_mode:-none}" != "none" ]]; then
    prior_hibernated=1
  fi
  if [[ "$state" == "hibernated" && "${hibernation_mode:-none}" != "none" ]]; then
    current_hibernated=1
  fi
  if (( current_hibernated == 1 && prior_hibernated == 0 )); then
    _rig_hibernation_sync_agents "$rig" "hibernate" "$last_reason" || true
  elif (( current_hibernated == 0 && prior_hibernated == 1 )); then
    _rig_hibernation_sync_agents "$rig" "unhibernate" "$last_reason" || true
  fi
}

_mayor_rig_hibernated() {
  local rig="${1:-}" state _reason _changed_at _changed_epoch mode _meaningful_at _meaningful_epoch _meaningful_reason _wake_rest
  _mayor_rig_activity_enabled || return 1
  IFS='|' read -r state _reason _changed_at _changed_epoch mode _meaningful_at _meaningful_epoch _meaningful_reason _wake_at _wake_reason <<< "$(_mayor_rig_activity_state_read "$rig")"
  [[ "$state" == "hibernated" && "$mode" != "none" ]]
}

_mayor_rig_hibernation_mode() {
  local rig="${1:-}" state _reason _changed_at _changed_epoch mode _meaningful_at _meaningful_epoch _meaningful_reason _wake_at _wake_reason
  _mayor_rig_activity_enabled || return 1
  IFS='|' read -r state _reason _changed_at _changed_epoch mode _meaningful_at _meaningful_epoch _meaningful_reason _wake_at _wake_reason <<< "$(_mayor_rig_activity_state_read "$rig")"
  if [[ "$state" == "hibernated" && -n "$mode" && "$mode" != "none" ]]; then
    printf '%s\n' "$mode"
    return 0
  fi
  return 1
}

_mayor_rig_manually_hibernated() {
  local rig="${1:-}" mode=""
  mode="$(_mayor_rig_hibernation_mode "$rig" 2>/dev/null || true)"
  [[ "$mode" == "manual" ]]
}

_rig_hibernation_sync_agents() {
  local rig="${1:-}" action="${2:-}" reason="${3:-}"
  local witness_session refinery_session changed=0
  [[ -n "$rig" && -n "$action" ]] || return 1
  witness_session="sgt-witness-${rig}"
  refinery_session="sgt-refinery-${rig}"
  case "$action" in
    hibernate)
      if tmux has-session -t "$witness_session" 2>/dev/null; then
        cmd_witness_stop "$rig" >/dev/null 2>&1 || true
        changed=1
      fi
      if tmux has-session -t "$refinery_session" 2>/dev/null; then
        cmd_refinery_stop "$rig" >/dev/null 2>&1 || true
        changed=1
      fi
      ;;
    unhibernate)
      if ! tmux has-session -t "$refinery_session" 2>/dev/null; then
        cmd_refinery_start "$rig" >/dev/null 2>&1 || true
        changed=1
      fi
      if ! tmux has-session -t "$witness_session" 2>/dev/null; then
        cmd_witness_start "$rig" >/dev/null 2>&1 || true
        changed=1
      fi
      ;;
    *)
      return 1
      ;;
  esac
  if (( changed > 0 )); then
    log_event "RIG_HIBERNATION_AGENT_SYNC rig=$rig action=$action reason=\"$(_escape_quotes "${reason:-unspecified}")\""
  fi
  return 0
}

_mayor_rig_activity_ensure_state() {
  local rig="${1:-}" state _reason _changed_at _changed_epoch _mode _meaningful_at _meaningful_epoch _meaningful_reason _wake_at _wake_reason
  _mayor_rig_activity_enabled || return 0
  IFS='|' read -r state _reason _changed_at _changed_epoch _mode _meaningful_at _meaningful_epoch _meaningful_reason _wake_at _wake_reason <<< "$(_mayor_rig_activity_state_read "$rig")"
  if [[ "$state" == "unknown" ]]; then
    _mayor_rig_activity_refresh "$rig" "periodic" "0" || true
  fi
}

_mayor_rig_set_manual_hibernation() {
  local rig="${1:-}" mode="${2:-hibernate}" reason="${3:-}"
  local prior state last_reason changed_at changed_epoch prior_mode last_meaningful_at last_meaningful_epoch last_meaningful_reason last_wake_at last_wake_reason
  prior="$(_mayor_rig_activity_state_read "$rig")"
  IFS='|' read -r state last_reason changed_at changed_epoch prior_mode last_meaningful_at last_meaningful_epoch last_meaningful_reason last_wake_at last_wake_reason <<< "$prior"
  case "$mode" in
    hibernate)
      _mayor_rig_activity_state_write \
        "$rig" \
        "hibernated" \
        "${reason:-manual hibernation}" \
        "manual" \
        "$last_meaningful_at" \
        "$last_meaningful_epoch" \
        "$last_meaningful_reason" \
        "$last_wake_at" \
        "$last_wake_reason"
      _rig_hibernation_sync_agents "$rig" "hibernate" "${reason:-manual hibernation}" || true
      ;;
    unhibernate)
      _mayor_rig_activity_state_write \
        "$rig" \
        "idle" \
        "${reason:-manual unhibernate}" \
        "none" \
        "$last_meaningful_at" \
        "$last_meaningful_epoch" \
        "$last_meaningful_reason" \
        "$last_wake_at" \
        "$last_wake_reason"
      _rig_hibernation_sync_agents "$rig" "unhibernate" "${reason:-manual unhibernate}" || true
      ;;
  esac
}

_mayor_rig_maybe_unhibernate_for_event() {
  local rig="${1:-}" event_reason="${2:-}"
  [[ -n "$rig" ]] || return 1
  if [[ "$(_mayor_rig_hibernation_mode "$rig" 2>/dev/null || true)" == "auto" ]] && _mayor_wake_reason_is_meaningful "$event_reason"; then
    _mayor_rig_set_manual_hibernation "$rig" "unhibernate" "auto-wake: $event_reason"
    log_event "MAYOR_RIG_UNHIBERNATE rig=$rig mode=event reason=\"$(_escape_quotes "$event_reason")\""
    return 0
  fi
  return 1
}

