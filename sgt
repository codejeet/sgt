# ─── Witness (per-rig polecat lifecycle manager) ──────────────────────
#
# The Witness monitors polecats for a single rig:
# - Detects stalled/zombie polecats (session dead, no PR)
# - Detects completed polecats (session dead, PR open)
# - Auto-sweeps completed polecats
# - Signals Refinery when PRs are ready for merge
# - Respawns stalled polecats (re-slings the issue)
# - Runs as a bash loop in tmux, no AI needed

_witness_pr_meta() {
  local repo="${1:-}" branch="${2:-}"
  [[ -n "$repo" && -n "$branch" ]] || return 0
  gh pr list --repo "$repo" --head "$branch" --state all --json number,state \
    --jq 'if length == 0 then "" else "\(.[0].number // "")\t\(.[0].state // "")" end' 2>/dev/null || true
}

_polecat_output_log_path() {
  local output_log="${1:-}" worktree="${2:-}"
  if [[ -n "$output_log" ]]; then
    printf '%s\n' "$output_log"
  elif [[ -n "$worktree" ]]; then
    printf '%s/.sgt-agent-output.log\n' "$worktree"
  else
    printf '%s\n' ""
  fi
}

_witness_dead_polecat_backend_limit() {
  local backend="${1:-}" output_log="${2:-}" worktree="${3:-}"
  local log_path match_text
  [[ "$backend" == "codex" ]] || return 1
  log_path="$(_polecat_output_log_path "$output_log" "$worktree")"
  [[ -n "$log_path" && -f "$log_path" ]] || return 1
  match_text="You've hit your usage limit"
  if head -c 16384 "$log_path" 2>/dev/null | grep -a -F -q "$match_text"; then
    printf '%s|%s|%s\n' "codex_usage_limit" "$backend" "$match_text"
    return 0
  fi
  return 1
}

_polecat_quiet_output_stale_secs() {
  local secs="${SGT_POLECAT_QUIET_OUTPUT_STALE_SECS:-900}"
  [[ "$secs" =~ ^[0-9]+$ && "$secs" -gt 0 ]] || secs=900
  echo "$secs"
}

_polecat_stall_secs() {
  local secs="${SGT_POLECAT_STALL_SECS:-1800}"
  [[ "$secs" =~ ^[0-9]+$ && "$secs" -gt 0 ]] || secs=1800
  echo "$secs"
}

_polecat_busy_child_min_age_secs() {
  local secs="${SGT_POLECAT_BUSY_CHILD_MIN_AGE_SECS:-120}"
  [[ "$secs" =~ ^[0-9]+$ && "$secs" -gt 0 ]] || secs=120
  echo "$secs"
}

_polecat_busy_child_min_cpu_pct() {
  local pct="${SGT_POLECAT_BUSY_CHILD_MIN_CPU_PCT:-5}"
  if [[ ! "$pct" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    pct=5
  fi
  echo "$pct"
}

_polecat_output_age_seconds() {
  local output_log="${1:-}" now_epoch="${2:-$(date +%s)}"
  local mtime=""
  [[ -n "$output_log" && -f "$output_log" ]] || {
    echo "-1"
    return 0
  }
  mtime="$(stat -c %Y "$output_log" 2>/dev/null || stat -f %m "$output_log" 2>/dev/null || true)"
  if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
    echo "-1"
    return 0
  fi
  echo $(( now_epoch - mtime ))
}

_polecat_created_age_seconds() {
  local created_at="${1:-}" now_epoch="${2:-$(date +%s)}"
  local created_epoch
  created_epoch=$(date -d "$created_at" +%s 2>/dev/null || echo "-1")
  if [[ ! "$created_epoch" =~ ^-?[0-9]+$ || "$created_epoch" -lt 0 ]]; then
    echo "-1"
    return 0
  fi
  echo $(( now_epoch - created_epoch ))
}

_polecat_session_root_pid() {
  local session="${1:-}"
  [[ -n "$session" ]] || return 1
  tmux display-message -p -t "$session" '#{pane_pid}' 2>/dev/null || true
}

_polecat_find_busy_child() {
  local root_pid="${1:-}" min_age="${2:-$(_polecat_busy_child_min_age_secs)}" min_cpu="${3:-$(_polecat_busy_child_min_cpu_pct)}"
  [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
  ps -eo pid=,ppid=,etimes=,pcpu=,stat=,comm=,args= 2>/dev/null | awk \
    -v root="$root_pid" \
    -v min_age="$min_age" \
    -v min_cpu="$min_cpu" '
      function ignored(comm) {
        return comm ~ /^(bash|sh|dash|zsh|fish|tmux|tee|cat|sleep|timeout|env|stdbuf)$/;
      }
      {
        pid=$1;
        ppid=$2;
        etimes=$3;
        pcpu=$4 + 0;
        stat=$5;
        comm=$6;
        args="";
        for (i = 7; i <= NF; i++) {
          args = args (i == 7 ? "" : " ") $i;
        }
        parent[pid] = ppid;
        row[pid] = pid "|" ppid "|" etimes "|" pcpu "|" stat "|" comm "|" args;
      }
      END {
        active[root] = 1;
        changed = 1;
        while (changed) {
          changed = 0;
          for (pid in parent) {
            if (active[parent[pid]] && !active[pid]) {
              active[pid] = 1;
              changed = 1;
            }
          }
        }
        best = "";
        best_cpu = -1;
        best_age = -1;
        for (pid in active) {
          if (pid == root) {
            continue;
          }
          split(row[pid], f, "|");
          etimes = f[3] + 0;
          pcpu = f[4] + 0;
          stat = f[5];
          comm = f[6];
          if (ignored(comm) || etimes < min_age) {
            continue;
          }
          if (pcpu >= min_cpu || stat ~ /^[RD]/) {
            if (pcpu > best_cpu || (pcpu == best_cpu && etimes > best_age)) {
              best = row[pid];
              best_cpu = pcpu;
              best_age = etimes;
            }
          }
        }
        if (best != "") {
          print best;
        }
      }
    '
}

_polecat_runtime_classify() {
  local session="${1:-}" created_at="${2:-}" output_log="${3:-}"
  local now_epoch quiet_secs stall_secs output_age created_age root_pid busy_child min_age min_cpu
  local busy_pid busy_ppid busy_etimes busy_cpu busy_stat busy_comm busy_args
  now_epoch=$(date +%s)
  quiet_secs="$(_polecat_quiet_output_stale_secs)"
  stall_secs="$(_polecat_stall_secs)"
  min_age="$(_polecat_busy_child_min_age_secs)"
  min_cpu="$(_polecat_busy_child_min_cpu_pct)"
  output_age="$(_polecat_output_age_seconds "$output_log" "$now_epoch")"
  created_age="$(_polecat_created_age_seconds "$created_at" "$now_epoch")"

  if [[ "$output_age" =~ ^[0-9]+$ ]] && [[ "$output_age" -le "$quiet_secs" ]]; then
    printf 'active-output|recent-output|terminal output refreshed %ss ago|%s|||\n' "$output_age" "$output_age"
    return 0
  fi

  root_pid="$(_polecat_session_root_pid "$session")"
  if busy_child="$(_polecat_find_busy_child "$root_pid" "$min_age" "$min_cpu")" && [[ -n "$busy_child" ]]; then
    IFS='|' read -r busy_pid busy_ppid busy_etimes busy_cpu busy_stat busy_comm busy_args <<< "$busy_child"
    printf 'busy-long-running|substantive-child-running|quiet output but substantive child %s pid=%s cpu=%s age=%ss state=%s|%s|%s|%s|%s\n' \
      "${busy_comm:-process}" \
      "${busy_pid:-unknown}" \
      "${busy_cpu:-0}" \
      "${busy_etimes:-0}" \
      "${busy_stat:-unknown}" \
      "${output_age:--1}" \
      "${busy_pid:-}" \
      "${busy_comm:-}" \
      "${busy_args:-}"
    return 0
  fi

  if [[ "$output_age" =~ ^[0-9]+$ ]]; then
    if [[ "$output_age" -lt "$stall_secs" ]]; then
      printf 'stale-but-allowed|quiet-within-stall-budget|quiet output for %ss with no substantive child yet; below %ss stall threshold|%s|||\n' \
        "$output_age" "$stall_secs" "$output_age"
      return 0
    fi
    if [[ "$created_age" =~ ^[0-9]+$ ]] && [[ "$created_age" -lt "$stall_secs" ]]; then
      printf 'stale-but-allowed|young-session|quiet output for %ss, but session age is only %ss (stall threshold %ss)|%s|||\n' \
        "$output_age" "$created_age" "$stall_secs" "$output_age"
      return 0
    fi
    printf 'stalled|no-substantive-child|quiet output for %ss with no substantive child process detected|%s|||\n' "$output_age" "$output_age"
    return 0
  fi

  if [[ "$created_age" =~ ^[0-9]+$ ]] && [[ "$created_age" -lt "$stall_secs" ]]; then
    printf 'stale-but-allowed|output-log-missing|session age %ss, output log missing, and no substantive child detected yet|%s|||\n' "$created_age" "$output_age"
    return 0
  fi

  printf 'stalled|output-log-missing|output log missing and no substantive child process detected|%s|||\n' "$output_age"
}

_witness_loop() {
  local rig="$1"
  local repo
  repo="$(rig_repo "$rig")"
  local owner_repo="${repo#https://github.com/}"
  local cycle=0

  log_event "WITNESS_START rig=$rig"
  echo "[witness/$rig] started — monitoring polecats"

  while true; do
    cycle=$((cycle + 1))
    _write_agent_heartbeat "witness" "$rig" "$cycle" || true
    local now
    now=$(date +%s)

    for f in "$SGT_POLECATS"/${rig}-*; do
      [[ -f "$f" ]] || continue
      local pname
      pname="$(basename "$f")"

      # Source in subshell to avoid polluting
      local p_session p_branch p_issue p_worktree p_created p_repo p_auto_merge p_output_log
      local p_runtime_classification p_runtime_reason_code p_runtime_summary p_runtime_output_age p_runtime_busy_pid p_runtime_busy_comm
      eval "$(grep -E '^(SESSION|BRANCH|ISSUE|WORKTREE|CREATED|REPO|AUTO_MERGE|BACKEND|OUTPUT_LOG|RUNTIME_CLASSIFICATION|RUNTIME_REASON_CODE|RUNTIME_SUMMARY|RUNTIME_OUTPUT_AGE_SECS|RUNTIME_BUSY_PID|RUNTIME_BUSY_COMM)=' "$f")"
      p_session="$SESSION"
      p_branch="$BRANCH"
      p_issue="$ISSUE"
      p_worktree="$WORKTREE"
      p_created="$CREATED"
      p_repo="$REPO"
      p_auto_merge="${AUTO_MERGE:-false}"
      p_output_log="${OUTPUT_LOG:-}"
      p_runtime_classification="${RUNTIME_CLASSIFICATION:-}"
      p_runtime_reason_code="${RUNTIME_REASON_CODE:-}"
      p_runtime_summary="${RUNTIME_SUMMARY:-}"
      p_runtime_output_age="${RUNTIME_OUTPUT_AGE_SECS:-}"
      p_runtime_busy_pid="${RUNTIME_BUSY_PID:-}"
      p_runtime_busy_comm="${RUNTIME_BUSY_COMM:-}"

      local alive=false
      tmux has-session -t "$p_session" 2>/dev/null && alive=true

      if $alive; then
        # Check if Claude Code is idle (finished but tmux still alive)
        local pane_output
        pane_output=$(tmux capture-pane -t "$p_session" -p 2>/dev/null || true)
        # Detect: [SGT] exit marker OR Claude Code idle at ❯ with no recent activity
        local is_idle=false
        if echo "$pane_output" | grep -qE '^\[SGT\] polecat exited'; then
          is_idle=true
        elif echo "$pane_output" | grep -qP '\x{276f}'; then
          # Check if a PR was already opened (work is done)
          local pr_meta has_pr
          pr_meta="$(_witness_pr_meta "$p_repo" "$p_branch")"
          IFS=$'\t' read -r has_pr _ <<< "$pr_meta"
          if [[ -n "$has_pr" ]]; then
            is_idle=true
          fi
        fi
        if $is_idle; then
          echo "[witness/$rig] $pname Claude Code finished (idle/exited) — treating as complete"
          log_event "WITNESS_IDLE_DETECTED $pname"
          # Kill the tmux session so the dead-session handler below picks it up
          tmux kill-session -t "$p_session" 2>/dev/null || true
          alive=false
        fi

        if $alive; then
          # Polecat is running — check if it's been running too long (>30 min)
          local created_ts
          created_ts=$(date -d "$p_created" +%s 2>/dev/null || echo "0")
          local age=$(( now - created_ts ))
          if [[ "$age" -gt 1800 ]]; then
            echo "[witness/$rig] $pname has been running for $((age/60))m — still alive"
            log_event "WITNESS_LONG_RUNNING $pname age=${age}s"
          fi

          local pr_meta pr_number pr_state runtime_meta runtime_classification runtime_reason runtime_summary runtime_output_age runtime_busy_pid runtime_busy_comm runtime_busy_args runtime_changed
          pr_meta="$(_witness_pr_meta "$p_repo" "$p_branch")"
          IFS=$'\t' read -r pr_number pr_state <<< "$pr_meta"
          runtime_meta="$(_polecat_runtime_classify "$p_session" "$p_created" "$p_output_log")"
          IFS='|' read -r runtime_classification runtime_reason runtime_summary runtime_output_age runtime_busy_pid runtime_busy_comm runtime_busy_args <<< "$runtime_meta"
          runtime_changed=false
          if [[ "$runtime_classification" != "$p_runtime_classification" || "$runtime_reason" != "$p_runtime_reason_code" || "$runtime_summary" != "$p_runtime_summary" || "$runtime_output_age" != "$p_runtime_output_age" || "$runtime_busy_pid" != "$p_runtime_busy_pid" || "$runtime_busy_comm" != "$p_runtime_busy_comm" ]]; then
            runtime_changed=true
            _merge_queue_set_field "$f" "RUNTIME_CLASSIFICATION" "$runtime_classification" || true
            _merge_queue_set_field "$f" "RUNTIME_REASON_CODE" "$runtime_reason" || true
            _merge_queue_set_field "$f" "RUNTIME_SUMMARY" "$runtime_summary" || true
            _merge_queue_set_field "$f" "RUNTIME_OUTPUT_AGE_SECS" "$runtime_output_age" || true
            _merge_queue_set_field "$f" "RUNTIME_BUSY_PID" "$runtime_busy_pid" || true
            _merge_queue_set_field "$f" "RUNTIME_BUSY_COMM" "$runtime_busy_comm" || true
          fi
          if $runtime_changed; then
            log_event "WITNESS_RUNTIME_CLASSIFICATION polecat=$pname rig=$rig issue=#$p_issue classification=$runtime_classification reason_code=$runtime_reason output_age=${runtime_output_age:-unknown}s busy_pid=${runtime_busy_pid:-none} busy_comm=$(_escape_quotes "${runtime_busy_comm:-none}") summary=\"$(_escape_quotes "${runtime_summary:-}")\""
          fi

          if [[ -z "$pr_number" && "$runtime_classification" == "stalled" ]]; then
            echo "[witness/$rig] $pname is STALLED (alive session, no PR, no substantive child process)"
            log_event "WITNESS_STALLED $pname issue=#$p_issue reason_code=$runtime_reason output_age=${runtime_output_age:-unknown}s mode=alive-session"
            _wake_refinery "$rig" "stalled:$pname:#$p_issue:$runtime_reason"

            gh issue comment "$p_issue" --repo "$p_repo" \
              --body "[sgt-witness] Polecat \`$pname\` was classified as truly stalled while still alive: quiet output with no substantive child process detected. Cleaning up and re-slinging." 2>/dev/null || true

            tmux kill-session -t "$p_session" 2>/dev/null || true
            if [[ -d "$p_worktree" ]]; then
              local rpath
              rpath="$(rig_path "$rig")"
              git -C "$rpath" worktree remove --force "$p_worktree" 2>/dev/null || rm -rf "$p_worktree"
            fi
            git -C "$(rig_path "$rig")" push origin --delete "$p_branch" 2>/dev/null || true
            rm -f "$f"

            local issue_title
            issue_title=$(gh issue view "$p_issue" --repo "$p_repo" --json title --jq '.title' 2>/dev/null || true)
            if [[ -n "$issue_title" ]]; then
              if _mayor_rig_manually_hibernated "$rig"; then
                echo "[witness/$rig] rig manually hibernated — leaving stalled issue #$p_issue parked"
                log_event "WITNESS_RESLING_SKIP $pname rig=$rig issue=#$p_issue reason_code=manual-hibernation"
                continue
              fi
              echo "[witness/$rig] re-slinging issue #$p_issue: $issue_title"
              log_event "WITNESS_RESLING $pname issue=#$p_issue reason_code=$runtime_reason"
              if ! _resling_existing_issue "$rig" "$p_issue" "$issue_title" "$p_repo" "$(_ai_backend_default)" "" "witness-stalled" "witness-stalled:$pname:#$p_issue"; then
                echo "[witness/$rig] re-sling failed for issue #$p_issue — recording durable follow-up"
                _witness_record_stalled_followup "$rig" "$p_repo" "$p_issue" "$issue_title" "$pname" "witness-stalled-resling-failed"
              fi
            else
              echo "[witness/$rig] unable to reload issue #$p_issue title after stall — recording durable follow-up"
              _witness_record_stalled_followup "$rig" "$p_repo" "$p_issue" "" "$pname" "witness-stalled-issue-title-unavailable"
            fi
            continue
          fi
        fi
      fi

      if ! $alive; then
        # Polecat session is dead — check what happened
        local pr_meta pr_state pr_number
        pr_meta="$(_witness_pr_meta "$p_repo" "$p_branch")"
        IFS=$'\t' read -r pr_number pr_state <<< "$pr_meta"

        if [[ "$pr_state" == "OPEN" ]]; then
          # PR is open — send to merge queue for refinery (refinery reviews + merges)
          echo "[witness/$rig] $pname completed — PR #$pr_number OPEN, queuing for refinery"
          log_event "WITNESS_PR_READY $pname pr=#$pr_number"

          local pr_head_sha
          pr_head_sha="$(_pr_head_sha "$p_repo" "$pr_number")"
          if _merge_queue_enqueue_polecat "$rig" "$p_repo" "$p_branch" "$p_issue" "$pr_number" "$pr_head_sha" "$p_auto_merge" "${BACKEND:-$(_ai_backend_default)}" "$pname" "witness-pr-ready"; then
            _wake_refinery "$rig" "pr-ready:$pname:#$pr_number"
          fi

          # Clean up polecat worktree + state
          if [[ -d "$p_worktree" ]]; then
            local rpath
            rpath="$(rig_path "$rig")"
            git -C "$rpath" worktree remove --force "$p_worktree" 2>/dev/null || rm -rf "$p_worktree"
          fi
          rm -f "$f"

        elif [[ "$pr_state" == "MERGED" ]]; then
          # Already merged — just clean up
          echo "[witness/$rig] $pname already merged — cleaning up"
          log_event "WITNESS_MERGED $pname"
          if [[ -d "$p_worktree" ]]; then
            local rpath
            rpath="$(rig_path "$rig")"
            git -C "$rpath" worktree remove --force "$p_worktree" 2>/dev/null || rm -rf "$p_worktree"
          fi
          git -C "$(rig_path "$rig")" push origin --delete "$p_branch" 2>/dev/null || true
          rm -f "$f"

        else
          local backend_limit_meta backend_limit_reason backend_limit_name backend_limit_match
          if backend_limit_meta="$(_witness_dead_polecat_backend_limit "${BACKEND:-}" "$p_output_log" "$p_worktree")"; then
            IFS='|' read -r backend_limit_reason backend_limit_name backend_limit_match <<< "$backend_limit_meta"
            echo "[witness/$rig] $pname hit backend limit ($backend_limit_reason) — blocking issue #$p_issue"
            log_event "WITNESS_BACKEND_LIMIT $pname issue=#$p_issue backend=$backend_limit_name reason_code=$backend_limit_reason match=\"$(_escape_quotes "$backend_limit_match")\""
            _wake_refinery "$rig" "backend-limit:$pname:#$p_issue:$backend_limit_reason"

            if [[ -d "$p_worktree" ]]; then
              local rpath
              rpath="$(rig_path "$rig")"
              git -C "$rpath" worktree remove --force "$p_worktree" 2>/dev/null || rm -rf "$p_worktree"
            fi
            git -C "$(rig_path "$rig")" push origin --delete "$p_branch" 2>/dev/null || true
            rm -f "$f"

            local issue_title
            issue_title=$(gh issue view "$p_issue" --repo "$p_repo" --json title --jq '.title' 2>/dev/null || true)
            _witness_record_backend_limit_followup "$rig" "$p_repo" "$p_issue" "$issue_title" "$pname" "${backend_limit_name:-${BACKEND:-unknown}}" "$backend_limit_reason" "$backend_limit_match"
            continue
          fi

          # Dead with no PR — stalled/zombie
          echo "[witness/$rig] $pname is STALLED (dead, no PR)"
          log_event "WITNESS_STALLED $pname issue=#$p_issue"
          _wake_refinery "$rig" "stalled:$pname:#$p_issue"

          # Comment on the issue about the stall
          gh issue comment "$p_issue" --repo "$p_repo" \
            --body "[sgt-witness] Polecat \`$pname\` stalled — session died without opening a PR. Cleaning up and re-slinging." 2>/dev/null || true

          # Clean up the dead polecat
          if [[ -d "$p_worktree" ]]; then
            local rpath
            rpath="$(rig_path "$rig")"
            git -C "$rpath" worktree remove --force "$p_worktree" 2>/dev/null || rm -rf "$p_worktree"
          fi
          git -C "$(rig_path "$rig")" push origin --delete "$p_branch" 2>/dev/null || true
          rm -f "$f"

          # Re-sling: get the issue title and re-dispatch
          local issue_title
          issue_title=$(gh issue view "$p_issue" --repo "$p_repo" --json title --jq '.title' 2>/dev/null || true)
          if [[ -n "$issue_title" ]]; then
            if _mayor_rig_manually_hibernated "$rig"; then
              echo "[witness/$rig] rig manually hibernated — leaving stalled issue #$p_issue parked"
              log_event "WITNESS_RESLING_SKIP $pname rig=$rig issue=#$p_issue reason_code=manual-hibernation"
              continue
            fi
            echo "[witness/$rig] re-slinging issue #$p_issue: $issue_title"
            log_event "WITNESS_RESLING $pname issue=#$p_issue"

            # Re-sling with a new polecat (reuse existing issue — don't create a new one)
            if ! _resling_existing_issue "$rig" "$p_issue" "$issue_title" "$p_repo" "$(_ai_backend_default)" "" "witness-stalled" "witness-stalled:$pname:#$p_issue"; then
              echo "[witness/$rig] re-sling failed for issue #$p_issue — recording durable follow-up"
              _witness_record_stalled_followup "$rig" "$p_repo" "$p_issue" "$issue_title" "$pname" "witness-stalled-resling-failed"
            fi
          else
            echo "[witness/$rig] unable to reload issue #$p_issue title after stall — recording durable follow-up"
            _witness_record_stalled_followup "$rig" "$p_repo" "$p_issue" "" "$pname" "witness-stalled-issue-title-unavailable"
          fi
        fi
      fi
    done

    # ── Orphaned PR scan ──
    # Catch PRs on sgt/* branches that have no polecat state file
    # (e.g., polecat completed and was swept before witness could queue it)
    local orphan_prs
    orphan_prs=$(gh pr list --repo "$repo" --json number,headRefName,state \
      --jq '.[] | select(.headRefName | startswith("sgt/")) | "\(.number) \(.headRefName)"' 2>/dev/null || true)

    if [[ -n "$orphan_prs" ]]; then
      while IFS=' ' read -r pr_num pr_branch; do
        [[ -n "$pr_num" ]] || continue

        # Check if any polecat state file references this branch
        local tracked=false
        for pf in "$SGT_POLECATS"/${rig}-*; do
          [[ -f "$pf" ]] || continue
          if grep -q "BRANCH=$pr_branch" "$pf" 2>/dev/null; then
            tracked=true
            break
          fi
        done

        # Check if already in merge queue
        if [[ "$tracked" == "false" ]]; then
          for mqf in "$SGT_CONFIG/merge-queue"/*; do
            [[ -f "$mqf" ]] || continue
            local mqf_rig="" mqf_name=""
            mqf_rig=$(grep -E '^RIG=' "$mqf" 2>/dev/null | tail -1 | cut -d= -f2- || true)
            if [[ -n "$mqf_rig" && "$mqf_rig" != "$rig" ]]; then
              continue
            fi
            if [[ -z "$mqf_rig" ]]; then
              mqf_name="$(basename "$mqf")"
              [[ "$mqf_name" == "${rig}-"* ]] || continue
            fi
            if grep -Fq "BRANCH=$pr_branch" "$mqf" 2>/dev/null; then
              tracked=true
              break
            fi
          done
        fi

        if [[ "$tracked" == "false" ]]; then
          local orphan_pname="${pr_branch#sgt/}"
          local orphan_issue
          orphan_issue=$(gh pr view "$pr_num" --repo "$repo" --json body --jq '.body' 2>/dev/null | grep -oP 'Closes #\K[0-9]+' || true)

          # Security gate: only queue if linked issue has sgt-authorized label
          if [[ -z "$orphan_issue" || "$orphan_issue" == "0" ]]; then
            echo "[witness/$rig] orphaned PR #$pr_num has no linked issue — skipping (unauthorized)"
            log_event "WITNESS_ORPHAN_SKIP_NO_ISSUE pr=#$pr_num branch=$pr_branch"
            continue
          fi

          if ! _has_sgt_authorized "$repo" "$orphan_issue"; then
            echo "[witness/$rig] orphaned PR #$pr_num linked issue #$orphan_issue lacks sgt-authorized label — skipping"
            log_event "WITNESS_ORPHAN_SKIP_UNAUTHORIZED pr=#$pr_num issue=#$orphan_issue"
            continue
          fi

          echo "[witness/$rig] orphaned PR #$pr_num on branch $pr_branch — queuing for refinery"
          log_event "WITNESS_ORPHAN_PR pr=#$pr_num branch=$pr_branch"

          local orphan_head_sha
          orphan_head_sha="$(_pr_head_sha "$repo" "$pr_num")"
          if _merge_queue_enqueue_polecat "$rig" "$repo" "$pr_branch" "${orphan_issue:-0}" "$pr_num" "$orphan_head_sha" "true" "$(_ai_backend_default)" "$orphan_pname" "witness-orphan-pr"; then
            _wake_refinery "$rig" "orphan-pr:$orphan_pname:#$pr_num"
          fi
        fi
      done <<< "$orphan_prs"
    fi

    sleep 30
  done
}

# Re-sling an existing issue (don't create a new one)
_resling_existing_issue() {
  local rig="$1" issue_number="$2" task="$3" repo="$4"
  local backend="${5:-$(_ai_backend_default)}"
  local source_pr="${6:-}"
  local source_event="${7:-unknown}"
  local source_event_key="${8:-$source_event}"
  local canonical_repo resolve_meta resolve_code resolve_reason
  source_event_key="$(_wake_trigger_key "$source_event_key")"
  [[ -n "$source_event_key" ]] || source_event_key="${source_event:-unknown}"
  if _mayor_rig_manually_hibernated "$rig"; then
    echo "[resling] rig $rig is manually hibernated — skipping issue #$issue_number"
    log_event "RESLING_SKIP_HIBERNATED issue=#$issue_number rig=$rig mode=manual source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\""
    return 1
  fi

  if ! canonical_repo="$(_resolve_rig_repo_canonical "resling-dispatch" "$rig" "$repo" "1")"; then
    resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_repo")"
    IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
    echo "[resling] stale event ($source_event) for issue #$issue_number — skipping: ${resolve_reason:-unable to resolve rig repo}"
    log_event "RESLING_SKIP_STALE issue=#$issue_number rig=$rig source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" source_pr=${source_pr:-none} skip_reason=\"$(_escape_quotes "${resolve_reason:-unable to resolve rig repo}")\""
    return 1
  fi
  repo="$canonical_repo"

  local stale_reason=""
  if ! stale_reason=$(_resling_pre_dispatch_revalidate "$rig" "$repo" "$issue_number" "$source_pr"); then
    echo "[resling] stale event ($source_event) for issue #$issue_number — skipping: $stale_reason"
    log_event "RESLING_SKIP_STALE issue=#$issue_number rig=$rig source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" source_pr=${source_pr:-none} skip_reason=\"$(_escape_quotes "$stale_reason")\""
    return 1
  fi

  # Security gate: verify issue has sgt-authorized label
  if ! _has_sgt_authorized "$repo" "$issue_number"; then
    echo "[resling] issue #$issue_number lacks sgt-authorized label — skipping"
    log_event "RESLING_SKIP_UNAUTHORIZED issue=#$issue_number rig=$rig source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" skip_reason=\"issue lacks sgt-authorized\""
    return 1
  fi

  local backend_limited_reason=""
  if backend_limited_reason="$(_issue_backend_dispatch_limited_reason "$repo" "$issue_number" 2>/dev/null || true)" && [[ -n "$backend_limited_reason" ]]; then
    echo "[resling] issue #$issue_number is backend-limited — skipping"
    log_event "RESLING_SKIP_BACKEND_LIMIT issue=#$issue_number rig=$rig source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" source_pr=${source_pr:-none} reason_code=$backend_limited_reason"
    return 1
  fi

  local existing_issue_polecat=""
  if existing_issue_polecat=$(_resling_find_existing_issue_polecat "$rig" "$repo" "$issue_number"); then
    echo "[resling] issue #$issue_number already has active polecat $existing_issue_polecat — skipping duplicate re-sling"
    log_event "RESLING_SKIP_DUPLICATE_ACTIVE issue=#$issue_number rig=$rig source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" source_pr=${source_pr:-none} existing_polecat=$existing_issue_polecat skip_reason=\"active polecat already exists for issue\""
    return 1
  fi

  local rpath pname branch session_name
  _RESLING_LAST_POLECAT=""
  rpath="$(rig_path "$rig")"
  pname="$(polecat_name "$rig")"
  branch="sgt/${pname}"
  session_name="sgt-${pname}"

  git -C "$rpath" fetch origin 2>/dev/null || true
  local default_branch
  default_branch=$(git -C "$rpath" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")

  local worktree="$SGT_ROOT/polecats/$pname"
  mkdir -p "$SGT_ROOT/polecats"
  git -C "$rpath" worktree add -b "$branch" "$worktree" "origin/$default_branch" 2>/dev/null \
    || git -C "$rpath" worktree add -b "$branch" "$worktree" "$default_branch"

  _ensure_context_file "$rig" >/dev/null
  if [[ -f "$rpath/CLAUDE.md" ]]; then
    cp "$rpath/CLAUDE.md" "$worktree/CLAUDE.md"
  fi
  if [[ -f "$rpath/SGT_CONTEXT.md" ]]; then
    cp "$rpath/SGT_CONTEXT.md" "$worktree/SGT_CONTEXT.md"
  fi
  _write_polecat_claude_md "$worktree" "$rig" "$issue_number" "$task" "$repo" "$pname" "$branch" "$default_branch" "false"

  local final_gate_reason=""
  if ! final_gate_reason=$(_resling_pre_dispatch_revalidate "$rig" "$repo" "$issue_number" "$source_pr"); then
    echo "[resling] dispatch-instant gate ($source_event) for issue #$issue_number — skipping: $final_gate_reason"
    log_event "RESLING_SKIP_FINAL_GATE issue=#$issue_number rig=$rig source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" source_pr=${source_pr:-none} skip_reason=\"$(_escape_quotes "$final_gate_reason")\""
    git -C "$rpath" worktree remove --force "$worktree" 2>/dev/null || rm -rf "$worktree"
    git -C "$rpath" branch -D "$branch" 2>/dev/null || true
    return 1
  fi

  cat > "$SGT_POLECATS/$pname" <<PSTATE
RIG=$rig
REPO=$repo
ISSUE=$issue_number
ISSUE_URL=https://github.com/${repo#https://github.com/}/issues/$issue_number
BRANCH=$branch
WORKTREE=$worktree
OUTPUT_LOG=$worktree/.sgt-agent-output.log
SESSION=$session_name
DEFAULT_BRANCH=$default_branch
AUTO_MERGE=false
BACKEND=$backend
CREATED=$(date -Iseconds)
STATUS=running
PSTATE

  local polecat_prompt polecat_prompt_file
  polecat_prompt="$(_build_polecat_runtime_prompt "$rig" "$issue_number" "$task" "$branch" "$rpath")"
  _write_polecat_runtime_prompt_file "$worktree" "$polecat_prompt"
  polecat_prompt_file="./$(basename "$(_polecat_runtime_prompt_file "$worktree")")"
  local tmux_error dispatch_reason_code
  if ! tmux_error="$(
    tmux new-session -d -s "$session_name" -c "$worktree" \
      "$( _ai_session_cmd_from_file "$backend" "$polecat_prompt_file" "./.sgt-agent-output.log" ); rc=\$?; echo '[SGT] polecat exited'; sgt _wake-refinery '${rig}' 'polecat-done:${pname}:#${issue_number}' 2>/dev/null; exit \$rc" \
      2>&1
  )"; then
    dispatch_reason_code="tmux-new-session-failed"
    if [[ "${tmux_error,,}" == *"command too long"* ]]; then
      dispatch_reason_code="command-too-long"
    fi
    _cleanup_failed_polecat_dispatch "$SGT_POLECATS/$pname" "$pname" "$rig" "$branch" "$session_name" "$worktree"
    log_event "RESLING_SPAWN_FAILED polecat=$pname rig=$rig issue=#$issue_number branch=$branch source_event=$source_event source_event_key=\"$(_escape_quotes "$source_event_key")\" reason_code=$dispatch_reason_code detail=\"$(_escape_quotes "${tmux_error:-tmux new-session returned non-zero exit status}")\""
    echo "[resling] dispatch failed ($source_event) for issue #$issue_number — ${tmux_error:-tmux new-session returned non-zero exit status}" >&2
    return 1
  fi

  # Auto-accept Claude Code workspace trust dialog if it appears
  if [[ "$backend" == "claude" ]]; then
    ( sleep 3 && tmux send-keys -t "$session_name" Enter 2>/dev/null || true ) &
  fi

  _RESLING_LAST_POLECAT="$pname"
  log_event "RESLING $pname rig=$rig issue=#$issue_number branch=$branch"
}

cmd_witness_start() {
  local rig="${1:-}"
  [[ -n "$rig" ]] || die "usage: sgt witness start <rig>"
  ensure_init
  ensure_rig "$rig"

  local session="sgt-witness-${rig}"
  if tmux has-session -t "$session" 2>/dev/null; then
    info "witness/$rig already running"
    return
  fi

  tmux new-session -d -s "$session" \
    "SGT_ROOT='$SGT_ROOT' sgt _witness '$rig'"

  log_event "WITNESS_SPAWN rig=$rig"
  info "witness/$rig started (session: $session)"
}

cmd_witness_stop() {
  local rig="${1:-}"
  [[ -n "$rig" ]] || die "usage: sgt witness stop <rig>"

  local session="sgt-witness-${rig}"
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
    log_event "WITNESS_STOP rig=$rig"
    info "witness/$rig stopped"
  else
    info "witness/$rig not running"
  fi
}

# ─── Refinery (per-rig review + merge processor) ─────────────────────
#
# The Refinery is the quality gate for all worker output:
# - Workers (polecats/dogs) notify the refinery when done
# - Refinery reviews PR diffs (polecats) or issue comments (dogs) via AI
# - On PASS: merges PR / closes issue, notifies mayor
# - On REJECT: closes PR / reopens issue, dispatches second iteration with feedback
# - No mayor involvement on rejections — refinery handles rework autonomously

# AI review: check PR diff against issue spec
_refinery_review_pr() {
  local repo="$1" pr="$2" issue="$3" rig="$4" backend="$5"
  local owner_repo pr_url issue_url
  _REFINERY_REVIEW_UNCLEAR_REASON=""
  _REFINERY_REVIEW_UNCLEAR_CLASS=""
  owner_repo="$(_repo_owner_repo "$repo")"
  pr_url="$(_repo_pr_url "$repo" "$pr")"
  issue_url="$(_repo_issue_url "$repo" "$issue")"

  echo "[refinery/$rig] reviewing PR #$pr..."

  local diff
  diff=$(gh pr diff "$pr" --repo "$repo" 2>/dev/null || true)
  if [[ -z "$diff" ]]; then
    echo "[refinery/$rig] PR #$pr — no diff, skipping review"
    return 0  # treat as pass (merged/closed already)
  fi

  local issue_title="" issue_body=""
  if [[ "$issue" != "0" && -n "$issue" ]]; then
    issue_title=$(gh issue view "$issue" --repo "$repo" --json title --jq '.title' 2>/dev/null || true)
    issue_body=$(gh issue view "$issue" --repo "$repo" --json body --jq '.body' 2>/dev/null || true)
  fi

  local pr_title pr_body pr_title_field
  pr_title=$(gh pr view "$pr" --repo "$repo" --json title --jq '.title' 2>/dev/null || true)
  pr_body=$(gh pr view "$pr" --repo "$repo" --json body --jq '.body' 2>/dev/null || true)
  pr_title_field="$(_escape_quotes "$pr_title")"

  # Truncate diff if too large
  local diff_truncated="$diff"
  local diff_lines
  diff_lines=$(echo "$diff" | wc -l)
  if [[ "$diff_lines" -gt 500 ]]; then
    diff_truncated="$(echo "$diff" | head -500)"
    diff_truncated+=$'\n\n[... truncated, '"$diff_lines"' total lines ...]'
  fi

  local review_dir="$SGT_CONFIG/refinery-review"
  mkdir -p "$review_dir"

  cat > "$review_dir/review-prompt.md" <<REVIEWMD
# PR Review

Review this PR for completeness. Does it implement what the issue requested?

## Issue #$issue
**Title:** $issue_title
**Description:** $issue_body

## PR #$pr
**Title:** $pr_title
**Body:** $pr_body

## Diff
\`\`\`diff
$diff_truncated
\`\`\`

## Verdict

End with exactly one of:
- VERDICT: APPROVE — if complete and functional
- VERDICT: REJECT — if incomplete, stub, or doesn't match spec

If rejecting, explain what's missing in 2-3 sentences before the verdict.
REVIEWMD

  local review_output review_cmd_rc review_contract review_class review_reason
  review_output=""
  review_cmd_rc=0
  if review_output=$(timeout 180 bash -c "_ai_promptfile '$backend' '$review_dir' '$review_dir/review-prompt.md'" 2>/dev/null); then
    review_cmd_rc=0
  else
    review_cmd_rc=$?
  fi
  review_contract="$(_refinery_review_contract_classify "$review_output" "$review_cmd_rc")"
  review_class="${review_contract%%|*}"
  review_reason="${review_contract#*|}"

  if [[ "$review_class" == "approve" ]]; then
    echo "[refinery/$rig] PR #$pr APPROVED"
    log_event "REFINERY_REVIEW_APPROVED pr=#$pr"
    _notify_openclaw "[SGT Refinery] review approved rig=$rig repo=$owner_repo pr=#$pr title=\"$pr_title_field\" issue=#$issue pr_url=$pr_url issue_url=$issue_url" "$rig"
    gh pr comment "$pr" --repo "$repo" \
      --body "[sgt-refinery] **APPROVED** — reviewed and cleared for merge." 2>/dev/null || true
    return 0
  elif [[ "$review_class" == "reject" ]]; then
    local reject_reason
    reject_reason=$(echo "$review_output" | grep -B5 "VERDICT: REJECT" | grep -v "VERDICT:" | tail -3)
    echo "[refinery/$rig] PR #$pr REJECTED: $reject_reason"
    log_event "REFINERY_REVIEW_REJECTED pr=#$pr reason=$reject_reason"
    local reject_summary
    reject_summary=$(echo "$reject_reason" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g' | cut -c1-160)
    _notify_openclaw "[SGT Refinery] review rejected rig=$rig pr=#$pr issue=#$issue reason=$reject_summary" "$rig"

    gh pr comment "$pr" --repo "$repo" \
      --body "[sgt-refinery] **REJECTED** — Implementation incomplete.

**Feedback:** $reject_reason

Closing PR and dispatching rework." 2>/dev/null || true
    # Return 1 = rejected, caller handles rework
    REFINERY_REJECT_REASON="$reject_reason"
    return 1
  else
    _REFINERY_REVIEW_UNCLEAR_REASON="$review_reason"
    _REFINERY_REVIEW_UNCLEAR_CLASS="$review_class"
    echo "[refinery/$rig] PR #$pr — review inconclusive, marking REVIEW_UNCLEAR"
    log_event "REFINERY_REVIEW_UNCLEAR pr=#$pr class=$review_class reason=\"$(_escape_quotes "$review_reason")\" review_rc=$review_cmd_rc"
    return 2
  fi
}

# AI review: check dog output quality against issue spec
_refinery_review_dog() {
  local repo="$1" issue="$2" rig="$3" dname="$4" backend="$5"

  echo "[refinery/$rig] reviewing dog $dname output on issue #$issue..."

  local issue_title issue_body
  issue_title=$(gh issue view "$issue" --repo "$repo" --json title --jq '.title' 2>/dev/null || true)
  issue_body=$(gh issue view "$issue" --repo "$repo" --json body --jq '.body' 2>/dev/null || true)

  # Get the dog's posted comments
  local comments
  comments=$(gh issue view "$issue" --repo "$repo" --json comments \
    --jq '[.comments[] | select(.author.login != "github-actions[bot]")] | .[-3:] | .[].body' 2>/dev/null || true)

  if [[ -z "$comments" ]]; then
    echo "[refinery/$rig] dog $dname — no comments posted, treating as incomplete"
    REFINERY_REJECT_REASON="Dog posted no findings to the issue."
    return 1
  fi

  # Truncate if too large
  local comments_truncated="$comments"
  local comment_lines
  comment_lines=$(echo "$comments" | wc -l)
  if [[ "$comment_lines" -gt 300 ]]; then
    comments_truncated="$(echo "$comments" | head -300)"
    comments_truncated+=$'\n\n[... truncated ...]'
  fi

  local review_dir="$SGT_CONFIG/refinery-review"
  mkdir -p "$review_dir"

  cat > "$review_dir/dog-review-prompt.md" <<REVIEWMD
# Dog Output Review

Review whether this research/analysis task was completed thoroughly.

## Task (Issue #$issue)
**Title:** $issue_title
**Description:** $issue_body

## Dog Output (issue comments)
$comments_truncated

## Verdict

End with exactly one of:
- VERDICT: APPROVE — if research is thorough and addresses the task
- VERDICT: REJECT — if output is thin, off-topic, or missing key deliverables

If rejecting, explain what's missing in 2-3 sentences before the verdict.
REVIEWMD

  local review_output
  review_output=$(timeout 180 bash -c "_ai_promptfile '$backend' '$review_dir' '$review_dir/dog-review-prompt.md'" 2>/dev/null || true)

  if echo "$review_output" | grep -q "VERDICT: APPROVE"; then
    echo "[refinery/$rig] dog $dname APPROVED"
    log_event "REFINERY_DOG_APPROVED dog=$dname issue=#$issue"
    gh issue comment "$issue" --repo "$repo" \
      --body "[sgt-refinery] **APPROVED** — research output reviewed and accepted." 2>/dev/null || true
    return 0
  elif echo "$review_output" | grep -q "VERDICT: REJECT"; then
    local reject_reason
    reject_reason=$(echo "$review_output" | grep -B5 "VERDICT: REJECT" | grep -v "VERDICT:" | tail -3)
    echo "[refinery/$rig] dog $dname REJECTED: $reject_reason"
    log_event "REFINERY_DOG_REJECTED dog=$dname issue=#$issue reason=$reject_reason"
    gh issue comment "$issue" --repo "$repo" \
      --body "[sgt-refinery] **REJECTED** — Research output insufficient.

**Feedback:** $reject_reason

Dispatching second iteration." 2>/dev/null || true
    REFINERY_REJECT_REASON="$reject_reason"
    return 1
  else
    echo "[refinery/$rig] dog $dname — review inconclusive, treating as APPROVE"
    log_event "REFINERY_DOG_REVIEW_UNCLEAR dog=$dname issue=#$issue"
    return 0
  fi
}

_refinery_ci_self_heal_dir() {
  echo "$SGT_CONFIG/refinery-ci-selfheal"
}

_refinery_ci_self_heal_key() {
  local repo="${1:-}" pr="${2:-}" head_sha="${3:-}" check_sig="${4:-}"
  local owner_repo
  owner_repo="$(_repo_owner_repo "$repo")"
  [[ -n "$owner_repo" ]] || owner_repo="$repo"
  printf '%s' "${owner_repo}|pr=${pr}|head=${head_sha:-unknown}|sig=${check_sig:-unknown}"
}

_refinery_ci_self_heal_key_id() {
  local key="${1:-}"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$key" | sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$key" | shasum -a 256 | awk '{print $1}'
  else
    printf '%s' "$key" | tr -c '[:alnum:]_.-' '_'
  fi
}

_refinery_ci_self_heal_maybe_spawn() {
  # Spawn a CI-fix polecat *on the same branch* for merge-queue PRs with failing checks.
  # This is intentionally conservative: one spawn per (repo, pr, head_sha, failure signature).
  local rig="${1:-}" repo="${2:-}" pr="${3:-}" branch="${4:-}" issue="${5:-0}" polecat="${6:-}" check_status="${7:-}"
  [[ -n "$rig" && -n "$repo" && -n "$pr" && -n "$branch" ]] || return 1
  [[ -n "$issue" && "$issue" != "0" ]] || return 0

  local head_sha
  head_sha="$(_pr_head_sha "$repo" "$pr")"
  [[ -n "$head_sha" ]] || head_sha="unknown"

  # Signature: first matching failure line (keeps dedupe stable, avoids huge logs)
  local sig
  sig=$(printf '%s\n' "$check_status" | grep -iE 'E[0-9]{3,4}|ruff|pytest|FAIL|ERROR' | head -n 1 | tr -d '\r' | head -c 160)
  [[ -n "$sig" ]] || sig="ci-failure"

  local key key_id dir marker
  key="$(_refinery_ci_self_heal_key "$repo" "$pr" "$head_sha" "$sig")"
  key_id="$(_refinery_ci_self_heal_key_id "$key")"
  dir="$(_refinery_ci_self_heal_dir)"
  mkdir -p "$dir"
  marker="$dir/$key_id.state"

  if [[ -f "$marker" ]]; then
    return 0
  fi

  # If there is already an *active* polecat for this issue, don't spawn another.
  # Note: merge-queue may still reference the original polecat even after it finished;
  # we only suppress when that polecat is currently tracked as running.
  local existing
  existing="$(_resling_find_existing_issue_polecat "$rig" "$repo" "$issue" 2>/dev/null || true)"
  if [[ -n "$existing" && -f "$SGT_POLECATS/$existing" ]]; then
    echo "[refinery/$rig] CI failing on PR #$pr — self-heal suppressed (active polecat=$existing)"
    return 0
  fi

  # Claim
  cat > "$marker" <<STATE
REPO=$repo
PR=$pr
ISSUE=$issue
BRANCH=$branch
HEAD_SHA=$head_sha
SIG=$sig
CLAIMED_AT=$(date -Iseconds)
STATE

  local fix_polecat fix_session worktree rpath
  fix_polecat="${polecat:-${rig}-pr${pr}}-cifix"
  fix_session="sgt-${rig}-${fix_polecat}"
  worktree="$SGT_ROOT/polecats/$fix_polecat"
  rpath="$(rig_path "$rig")"

  echo "[refinery/$rig] CI failing on PR #$pr — spawning self-heal polecat=$fix_polecat (issue #$issue)"
  log_event "REFINERY_CI_SELF_HEAL_SPAWN rig=$rig repo=$(_repo_owner_repo "$repo") pr=#$pr issue=#$issue head=$head_sha polecat=$fix_polecat sig=\"$(_escape_quotes "$sig")\""
  _notify_openclaw "[SGT Refinery] CI self-heal: rig=$rig pr=#$pr issue=#$issue spawning polecat=$fix_polecat branch=$branch head=$head_sha sig=\"$(_escape_quotes "$sig")\"" "$rig"

  # Create worktree on the existing branch
  git -C "$rpath" fetch origin 2>/dev/null || true
  mkdir -p "$SGT_ROOT/polecats"
  git -C "$rpath" worktree add -f "$worktree" "$branch" 2>/dev/null || git -C "$rpath" worktree add -f "$worktree" "origin/$branch" 2>/dev/null || true

  _ensure_context_file "$rig" >/dev/null
  # Write CLAUDE.md with strict tasking
  cat > "$worktree/CLAUDE.md" <<MD
# CI Self-Heal Task (SGT)

You are fixing CI for an existing PR.

Read `SGT_CONTEXT.md` before you start. If you need prior rig memory, use:
- `sgt context search $rig "<query>"`
- `sgt context add $rig "<note>"`

- Repo: $repo
- Rig: $rig
- PR: #$pr
- Issue: #$issue
- Branch (must push fixes here): $branch
- Head SHA: $head_sha

Constraints:
- Do not change product scope.
- Fix only what is required to get CI green.
- Before exit, add a durable context note if you learned something future agents should keep.
- Commit, push to the same branch ($branch). Do not open a new PR.

Failure signature:
$sig
MD
  if [[ -f "$rpath/SGT_CONTEXT.md" ]]; then
    cp "$rpath/SGT_CONTEXT.md" "$worktree/SGT_CONTEXT.md"
  fi

  # Save polecat state so `sgt status` shows it.
  mkdir -p "$SGT_POLECATS"
  cat > "$SGT_POLECATS/$fix_polecat" <<PSTATE
RIG=$rig
REPO=$repo
ISSUE=$issue
ISSUE_URL=$(_repo_issue_url "$repo" "$issue")
BRANCH=$branch
WORKTREE=$worktree
SESSION=$fix_session
DEFAULT_BRANCH=$branch
AUTO_MERGE=false
BACKEND=$(_ai_backend_default)
CREATED=$(date -Iseconds)
STATUS=running
TYPE=ci-fix
PR=$pr
HEAD_SHA=$head_sha
SIG=$sig
PSTATE

  tmux new-session -d -s "$fix_session" -c "$worktree" \
    "$( _ai_cmd "$(_ai_backend_default)" "Read CLAUDE.md and SGT_CONTEXT.md in this directory before you start. Search shared rig context first with 'sgt context search ${rig} \"<query>\"' for any questions, unknowns, or prior decisions instead of guessing. Fix CI for PR #$pr on branch $branch. Before you finish, add any durable project context you learned with 'sgt context add ${rig} \"<note>\"'. When done, commit and push to the same branch. Do not open a new PR." ); echo '[SGT] ci-fix polecat exited'; sgt _wake-refinery '${rig}' 'ci-fix-done:${fix_polecat}:#${issue}' 2>/dev/null"

  # Auto-accept Claude Code workspace trust dialog if it appears
  if [[ "$(_ai_backend_default)" == "claude" ]]; then
    ( sleep 3 && tmux send-keys -t "$fix_session" Enter 2>/dev/null || true ) &
  fi

  return 0
}

_refinery_loop() {
  local rig="$1"
  local repo
  repo="$(rig_repo "$rig")"
  local cycle=0

  log_event "REFINERY_START rig=$rig"

  # Set up FIFO for event-driven wake
  local fifo="$SGT_CONFIG/refinery-${rig}.fifo"
  [[ -p "$fifo" ]] || mkfifo "$fifo"
  exec 4<>"$fifo"
  echo "[refinery/$rig] started — event-driven (fallback every 30s)"

  while true; do
    cycle=$((cycle + 1))
    _write_agent_heartbeat "refinery" "$rig" "$cycle" || true
    # Block on FIFO with timeout — wakes on event OR periodic scan
    local wake_reason=""
    read -t 30 -u 4 wake_reason 2>/dev/null || true
    if [[ -n "$wake_reason" ]]; then
      echo "[refinery/$rig] woken: $wake_reason"
      # Drain queued events
      local extra=""
      while read -t 0.1 -u 4 extra 2>/dev/null; do :; done
    fi

    local merge_dir="$SGT_CONFIG/merge-queue"
    mkdir -p "$merge_dir"
    _refinery_conflict_replay_pending "$rig" || true

    # ── Process PR queue (polecats) ──
    for f in "$merge_dir"/*; do
      [[ -f "$f" ]] || continue
      local mqname
      mqname="$(basename "$f")"

      local mq_rig="" mq_pr="" mq_repo="" mq_branch="" mq_issue="" mq_polecat="" mq_auto_merge="" mq_type="" mq_backend="" mq_head_sha=""
      local mq_review_state="" mq_review_updated_at="" mq_review_unclear_since="" mq_reviewed_head_sha="" mq_reviewed_at=""
      local mq_unclear_retry_count="" mq_unclear_next_retry_at="" mq_unclear_escalated="" mq_unclear_escalated_at=""
      local mq_unclear_last_reason="" mq_unclear_last_class=""
      while IFS='=' read -r k v; do
        case "$k" in
          RIG|PR|REPO|BRANCH|ISSUE|POLECAT|AUTO_MERGE|TYPE|BACKEND|HEAD_SHA|REVIEW_STATE|REVIEW_UPDATED_AT|REVIEW_UNCLEAR_SINCE|REVIEW_UNCLEAR_RETRY_COUNT|REVIEW_UNCLEAR_NEXT_RETRY_AT|REVIEW_UNCLEAR_LAST_REASON|REVIEW_UNCLEAR_LAST_CLASS|REVIEW_UNCLEAR_ESCALATED|REVIEW_UNCLEAR_ESCALATED_AT|REVIEWED_HEAD_SHA|REVIEWED_AT)
            printf -v "$k" '%s' "$v"
            ;;
        esac
      done < <(grep -E '^(RIG|PR|REPO|BRANCH|ISSUE|POLECAT|AUTO_MERGE|TYPE|BACKEND|HEAD_SHA|REVIEW_STATE|REVIEW_UPDATED_AT|REVIEW_UNCLEAR_SINCE|REVIEW_UNCLEAR_RETRY_COUNT|REVIEW_UNCLEAR_NEXT_RETRY_AT|REVIEW_UNCLEAR_LAST_REASON|REVIEW_UNCLEAR_LAST_CLASS|REVIEW_UNCLEAR_ESCALATED|REVIEW_UNCLEAR_ESCALATED_AT|REVIEWED_HEAD_SHA|REVIEWED_AT)=' "$f")
      mq_rig="${RIG:-}"
      if [[ -n "$mq_rig" && "$mq_rig" != "$rig" ]]; then
        if [[ "$mqname" == "${rig}-"* ]]; then
          _merge_queue_cleanup_terminal_for_mismatch "$rig" "$f" "$mqname" "$mq_rig" "${REPO:-}" "${PR:-}" "rig-mismatch" "queue file belongs to different rig" || true
        fi
        continue
      fi
      mq_pr="${PR:-}"
      mq_repo="${REPO:-$repo}"
      mq_branch="${BRANCH:-}"
      mq_issue="${ISSUE:-0}"
      mq_polecat="${POLECAT:-$mqname}"
      mq_auto_merge="${AUTO_MERGE:-false}"
      mq_type="${TYPE:-polecat}"
      mq_backend="${BACKEND:-$(_ai_backend_default)}"
      mq_head_sha="${HEAD_SHA:-}"
      mq_review_state="${REVIEW_STATE:-REVIEW_PENDING}"
      mq_review_updated_at="${REVIEW_UPDATED_AT:-}"
      mq_review_unclear_since="${REVIEW_UNCLEAR_SINCE:-}"
      mq_unclear_retry_count="${REVIEW_UNCLEAR_RETRY_COUNT:-0}"
      mq_unclear_next_retry_at="${REVIEW_UNCLEAR_NEXT_RETRY_AT:-0}"
      mq_unclear_last_reason="${REVIEW_UNCLEAR_LAST_REASON:-}"
      mq_unclear_last_class="${REVIEW_UNCLEAR_LAST_CLASS:-}"
      mq_unclear_escalated="${REVIEW_UNCLEAR_ESCALATED:-0}"
      mq_unclear_escalated_at="${REVIEW_UNCLEAR_ESCALATED_AT:-}"
      mq_reviewed_head_sha="${REVIEWED_HEAD_SHA:-}"
      mq_reviewed_at="${REVIEWED_AT:-}"

      [[ "$mq_unclear_retry_count" =~ ^[0-9]+$ ]] || mq_unclear_retry_count=0
      [[ "$mq_unclear_next_retry_at" =~ ^[0-9]+$ ]] || mq_unclear_next_retry_at=0
      [[ "$mq_unclear_escalated" =~ ^[01]$ ]] || mq_unclear_escalated=0

      local canonical_mq_repo resolve_meta resolve_code resolve_reason
      if ! canonical_mq_repo="$(_resolve_rig_repo_canonical "refinery-queue-open-pr-open-issue-checks" "$rig" "$mq_repo" "1")"; then
        resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_mq_repo")"
        IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
        if [[ "${resolve_code:-}" == "repo-mismatch" ]]; then
          _merge_queue_cleanup_terminal_for_mismatch "$rig" "$f" "$mqname" "$mq_rig" "$mq_repo" "$mq_pr" "$resolve_code" "${resolve_reason:-repo mismatch}" || true
        fi
        echo "[refinery/$rig] queue item $mqname skipped — ${resolve_reason:-unable to resolve rig repo} (reason_code=${resolve_code:-unknown})"
        log_event "REFINERY_QUEUE_SKIP_REPO_RESOLVE queue=$mqname rig=$rig reason_code=${resolve_code:-unknown} reason=\"$(_escape_quotes "${resolve_reason:-unable to resolve rig repo}")\""
        continue
      fi
      mq_repo="$canonical_mq_repo"

      echo "[refinery/$rig] processing $mq_type: PR #$mq_pr ($mq_branch)"
      local mq_owner_repo mq_pr_title mq_pr_title_field mq_pr_url mq_issue_url mq_wake_title
      mq_owner_repo="$(_repo_owner_repo "$mq_repo")"
      mq_pr_title=$(gh pr view "$mq_pr" --repo "$mq_repo" --json title --jq '.title' 2>/dev/null || true)
      mq_pr_title_field="$(_escape_quotes "$mq_pr_title")"
      mq_pr_url="$(_repo_pr_url "$mq_repo" "$mq_pr")"
      mq_issue_url="$(_repo_issue_url "$mq_repo" "$mq_issue")"
      mq_wake_title="$(_escape_wake_value "$mq_pr_title")"

      # Security gate: verify linked issue has sgt-authorized label
      if [[ -n "$mq_issue" && "$mq_issue" != "0" ]]; then
        if ! _has_sgt_authorized "$mq_repo" "$mq_issue"; then
          echo "[refinery/$rig] PR #$mq_pr linked issue #$mq_issue lacks sgt-authorized — skipping"
          log_event "REFINERY_SKIP_UNAUTHORIZED pr=#$mq_pr issue=#$mq_issue"
          rm -f "$f"
          continue
        fi
      else
        echo "[refinery/$rig] PR #$mq_pr has no linked issue — skipping (unauthorized)"
        log_event "REFINERY_SKIP_NO_ISSUE pr=#$mq_pr"
        rm -f "$f"
        continue
      fi

      # Check PR state
      local pr_state
      pr_state=$(gh pr view "$mq_pr" --repo "$mq_repo" --json state --jq '.state' 2>/dev/null || true)

      if [[ "$pr_state" == "MERGED" ]]; then
        echo "[refinery/$rig] PR #$mq_pr already merged — cleaning up"
        git -C "$(rig_path "$rig")" push origin --delete "$mq_branch" 2>/dev/null || true
        rm -f "$f"
        log_event "REFINERY_ALREADY_MERGED pr=#$mq_pr"
        continue
      fi

      if [[ "$pr_state" == "CLOSED" ]]; then
        local closed_merge_key closed_recovery_action
        closed_merge_key=""
        if [[ -n "$mq_head_sha" ]]; then
          closed_merge_key="$(_refinery_merge_attempt_key "$mq_repo" "$mq_pr" "$mq_head_sha")"
          closed_recovery_action="already-cleared"
          if _refinery_merge_attempt_clear_by_key "$closed_merge_key"; then
            closed_recovery_action="cleared-stale-merge-attempt"
          fi
          log_event "REFINERY_MERGE_ATTEMPT_RECOVERY pr=#$mq_pr issue=#$mq_issue reason_code=pr-closed action=$closed_recovery_action key=\"$(_escape_quotes "$closed_merge_key")\" queue=$mqname"
        fi
        echo "[refinery/$rig] PR #$mq_pr was closed — removing from queue"
        rm -f "$f"
        log_event "REFINERY_CLOSED pr=#$mq_pr"
        continue
      fi

      if [[ "$pr_state" != "OPEN" ]]; then
        echo "[refinery/$rig] PR #$mq_pr state unknown: $pr_state — skipping"
        continue
      fi

      # Check CI
      local check_status check_class
      check_status=$(gh pr checks "$mq_pr" --repo "$mq_repo" 2>&1 || true)
      check_class="$(_refinery_checks_class "$check_status")"
      if [[ "$check_class" == "failing" ]]; then
        _refinery_ci_self_heal_maybe_spawn "$rig" "$mq_repo" "$mq_pr" "$mq_branch" "$mq_issue" "$mq_polecat" "$check_status" || true
        echo "[refinery/$rig] PR #$mq_pr — CI failing, waiting..."
        continue
      fi

      if [[ -z "$mq_head_sha" ]]; then
        mq_head_sha="$(_pr_head_sha "$mq_repo" "$mq_pr")"
        if [[ -n "$mq_head_sha" ]]; then
          _merge_queue_set_head_sha "$f" "$mq_head_sha" || true
        fi
      fi

      if [[ "$mq_review_state" == "REVIEW_APPROVED" && -z "$mq_reviewed_head_sha" ]]; then
        local blocked_reason_code blocked_reason
        blocked_reason_code="missing-reviewed-head-sha"
        blocked_reason="review-approved candidate missing reviewed_head_sha"
        echo "[refinery/$rig] PR #$mq_pr merge blocked — reason_code=$blocked_reason_code reason=\"$blocked_reason\" queue=$mqname action=reset-review-pending"
        log_event "REFINERY_MERGE_BLOCKED_MISSING_REVIEW_SHA pr=#$mq_pr issue=#$mq_issue queue=$mqname review_state=$mq_review_state reason=\"$(_escape_quotes "$blocked_reason")\" action=reset-review-pending"
        _merge_queue_mark_review_state "$f" "REVIEW_PENDING" || true
        _merge_queue_set_field "$f" "REVIEWED_AT" "" || true
        continue
      fi

      local pr_mergeable pr_is_draft pr_merge_state pr_merge_snapshot
      local deterministic_fallback_eligible deterministic_fallback_reason_code deterministic_fallback_reason
      pr_mergeable=""
      pr_is_draft=""
      pr_merge_state=""
      pr_merge_snapshot="$(gh pr view "$mq_pr" --repo "$mq_repo" --json mergeable,isDraft,mergeStateStatus --jq '(.mergeable // "") + "|" + ((.isDraft // false)|tostring) + "|" + (.mergeStateStatus // "")' 2>/dev/null || true)"
      if [[ "$pr_merge_snapshot" == *"|"* ]]; then
        IFS='|' read -r pr_mergeable pr_is_draft pr_merge_state <<< "$pr_merge_snapshot"
      fi
      if [[ -z "$pr_mergeable" ]]; then
        pr_mergeable="$(gh pr view "$mq_pr" --repo "$mq_repo" --json mergeable --jq '.mergeable // ""' 2>/dev/null || true)"
      fi
      if [[ -z "$pr_is_draft" ]]; then
        pr_is_draft="$(gh pr view "$mq_pr" --repo "$mq_repo" --json isDraft --jq 'if .isDraft then "true" else "false" end' 2>/dev/null || true)"
      fi
      if [[ -z "$pr_merge_state" ]]; then
        pr_merge_state="$(gh pr view "$mq_pr" --repo "$mq_repo" --json mergeStateStatus --jq '.mergeStateStatus // ""' 2>/dev/null || true)"
      fi
      deterministic_fallback_eligible=0
      deterministic_fallback_reason_code="unknown"
      deterministic_fallback_reason="deterministic fallback eligibility unknown"
      if [[ "$pr_state" != "OPEN" ]]; then
        deterministic_fallback_reason_code="pr-not-open"
        deterministic_fallback_reason="pr state is not OPEN (state=${pr_state:-unknown})"
      elif [[ "$pr_is_draft" == "true" ]]; then
        deterministic_fallback_reason_code="draft-pr"
        deterministic_fallback_reason="pr is draft"
      elif [[ "$pr_merge_state" != "CLEAN" ]]; then
        deterministic_fallback_reason_code="merge-state-not-clean"
        deterministic_fallback_reason="pr merge_state is not CLEAN (state=${pr_merge_state:-unknown})"
      elif [[ "$check_class" != "green" && "$check_class" != "missing" ]]; then
        deterministic_fallback_reason_code="checks-not-ready"
        deterministic_fallback_reason="required checks are not successful/missing (class=${check_class:-unknown})"
      else
        deterministic_fallback_eligible=1
        deterministic_fallback_reason_code="deterministic-merge-ready"
        deterministic_fallback_reason="open, non-draft, merge_state=CLEAN, checks green-or-missing"
      fi

      if [[ "$mq_review_state" != "REVIEW_APPROVED" && "$deterministic_fallback_eligible" == "1" ]]; then
        if [[ -z "$mq_head_sha" ]]; then
          mq_head_sha="$(_pr_head_sha "$mq_repo" "$mq_pr")"
          if [[ -n "$mq_head_sha" ]]; then
            _merge_queue_set_head_sha "$f" "$mq_head_sha" || true
          fi
        fi
        if [[ -z "$mq_head_sha" ]]; then
          echo "[refinery/$rig] PR #$mq_pr deterministic fallback guard failed — missing head SHA"
          log_event "REFINERY_DETERMINISTIC_FALLBACK pr=#$mq_pr issue=#$mq_issue eligible=0 reason_code=missing-head-sha review_state=$mq_review_state check_class=${check_class:-unknown} merge_state=${pr_merge_state:-unknown} draft=${pr_is_draft:-unknown}"
          continue
        fi
        echo "[refinery/$rig] PR #$mq_pr deterministic fallback gate passed — skipping AI review (review_state=$mq_review_state checks=${check_class:-unknown} merge_state=${pr_merge_state:-unknown})"
        log_event "REFINERY_DETERMINISTIC_FALLBACK pr=#$mq_pr issue=#$mq_issue eligible=1 reason_code=$deterministic_fallback_reason_code review_state=$mq_review_state check_class=${check_class:-unknown} merge_state=${pr_merge_state:-unknown} draft=${pr_is_draft:-unknown} reason=\"$(_escape_quotes "$deterministic_fallback_reason")\""
        if ! _merge_queue_mark_review_ready "$f" "$mq_head_sha"; then
          echo "[refinery/$rig] PR #$mq_pr deterministic fallback guard failed — unable to persist review-ready evidence"
          log_event "REFINERY_DETERMINISTIC_FALLBACK pr=#$mq_pr issue=#$mq_issue eligible=0 reason_code=fallback-persist-failed review_state=$mq_review_state check_class=${check_class:-unknown} merge_state=${pr_merge_state:-unknown} draft=${pr_is_draft:-unknown}"
          continue
        fi
        mq_review_state="REVIEW_APPROVED"
        mq_reviewed_head_sha="$mq_head_sha"
        mq_reviewed_at="$(date +%s)"
      fi

      if [[ "$mq_review_state" == "REVIEW_UNCLEAR" ]]; then
        local now_epoch_unclear_retry max_unclear_retry_attempts
        now_epoch_unclear_retry="$(date +%s)"
        max_unclear_retry_attempts="$(_refinery_unclear_retry_max_attempts)"
        if (( mq_unclear_retry_count < max_unclear_retry_attempts && mq_unclear_next_retry_at > now_epoch_unclear_retry )); then
          local wait_s
          wait_s=$((mq_unclear_next_retry_at - now_epoch_unclear_retry))
          echo "[refinery/$rig] PR #$mq_pr REVIEW_UNCLEAR backoff active — retry in ${wait_s}s (attempt=${mq_unclear_retry_count} class=${mq_unclear_last_class:-unknown})"
          log_event "REFINERY_REVIEW_UNCLEAR_BACKOFF pr=#$mq_pr issue=#$mq_issue attempt=$mq_unclear_retry_count wait_s=$wait_s next_retry_at=$mq_unclear_next_retry_at class=${mq_unclear_last_class:-unknown} reason=\"$(_escape_quotes "${mq_unclear_last_reason:-unknown}")\""
          continue
        fi
      fi

      local claimed_attempt_file=""
      local claimed_attempt_key=""
      if ! _refinery_merge_attempt_claim "$mq_repo" "$mq_pr" "$mq_head_sha" "$mqname"; then
        local duplicate_key duplicate_reason duplicate_reason_code
        local duplicate_receipt_file duplicate_receipt_rc
        local duplicate_live_snapshot duplicate_live_state duplicate_live_mergeable duplicate_recovery_reason duplicate_recovery_action
        duplicate_key="${_REFINERY_MERGE_ATTEMPT_KEY:-unknown}"
        duplicate_reason_code="duplicate-merge-attempt-key"
        duplicate_reason="duplicate merge-attempt key (repo+pr+head) already processed"
        duplicate_live_state=""
        duplicate_live_mergeable=""
        duplicate_live_snapshot="$(gh pr view "$mq_pr" --repo "$mq_repo" --json state,mergeable --jq '.state + "|" + (.mergeable // "")' 2>/dev/null || true)"
        if [[ "$duplicate_live_snapshot" == *"|"* ]]; then
          IFS='|' read -r duplicate_live_state duplicate_live_mergeable <<< "$duplicate_live_snapshot"
        fi
        if [[ "$duplicate_live_mergeable" == "CONFLICTING" ]]; then
          duplicate_recovery_reason="duplicate-merge-attempt-stale-conflict"
          duplicate_recovery_action="already-cleared"
          if _refinery_merge_attempt_clear_by_key "$duplicate_key"; then
            duplicate_recovery_action="cleared-stale-merge-attempt"
          fi
          log_event "REFINERY_DUPLICATE_RECOVERY pr=#$mq_pr issue=#$mq_issue reason_code=$duplicate_recovery_reason action=$duplicate_recovery_action key=\"$(_escape_quotes "$duplicate_key")\" queue=$mqname live_state=${duplicate_live_state:-unknown} live_mergeable=${duplicate_live_mergeable:-unknown}"
          _refinery_conflict_auto_resolve "$rig" "$mq_repo" "$mq_issue" "$mq_pr" "$mq_head_sha" "$duplicate_key" "$mqname" "$mq_backend" "$f" "$duplicate_recovery_reason"
          continue
        fi
        if [[ "$duplicate_live_state" == "CLOSED" || "$duplicate_live_state" == "MERGED" ]]; then
          duplicate_recovery_reason="duplicate-merge-attempt-terminal-pr-state"
          duplicate_recovery_action="already-cleared"
          if _refinery_merge_attempt_clear_by_key "$duplicate_key"; then
            duplicate_recovery_action="cleared-stale-merge-attempt"
          fi
          log_event "REFINERY_DUPLICATE_RECOVERY pr=#$mq_pr issue=#$mq_issue reason_code=$duplicate_recovery_reason action=$duplicate_recovery_action key=\"$(_escape_quotes "$duplicate_key")\" queue=$mqname live_state=${duplicate_live_state:-unknown} live_mergeable=${duplicate_live_mergeable:-unknown}"
          rm -f "$f"
          continue
        fi
        duplicate_receipt_file="$(_refinery_merge_receipt_file_by_key "$duplicate_key" || true)"
        if [[ -n "$duplicate_receipt_file" && -f "$duplicate_receipt_file" ]]; then
          set +e
          _refinery_merge_receipt_load "$duplicate_receipt_file"
          duplicate_receipt_rc=$?
          set -e
          if [[ "$duplicate_receipt_rc" -eq 0 ]]; then
            if [[ "${_REFINERY_MERGE_RECEIPT_OUTCOME:-}" == "success" ]]; then
              echo "[refinery/$rig] PR #$mq_pr duplicate merge key already verified — no-op"
              log_event "REFINERY_DUPLICATE_SKIP pr=#$mq_pr issue=#$mq_issue reason_code=duplicate-merge-verified-success reason=\"duplicate merge key already has success receipt\" key=\"$(_escape_quotes "$duplicate_key")\" queue=$mqname"
              rm -f "$f"
              continue
            fi
            if [[ "${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-}" == retry-* ]]; then
              echo "[refinery/$rig] PR #$mq_pr replaying post-merge verification receipt fence (retry=${_REFINERY_MERGE_RECEIPT_RETRY_DECISION})"
              if _refinery_post_merge_verify_and_receipt "$rig" "$mq_repo" "$mq_pr" "$mq_issue" "$mq_branch" "$duplicate_key" "$mq_head_sha"; then
                local verified_merged_sha
                verified_merged_sha="${_REFINERY_MERGE_RECEIPT_MERGED_SHA:-$mq_head_sha}"
                echo "[refinery/$rig] PR #$mq_pr merged successfully"
                log_event "REFINERY_MERGED pr=#$mq_pr issue=#$mq_issue"
                _notify_openclaw "[SGT Refinery] merged rig=$rig repo=$mq_owner_repo pr=#$mq_pr title=\"$mq_pr_title_field\" issue=#$mq_issue pr_url=$mq_pr_url issue_url=$mq_issue_url" "$rig" "$rig" "$rig"
                _wake_mayor "merged:pr#$mq_pr:#$mq_issue:$rig|repo=$mq_owner_repo|title=$mq_wake_title|pr_url=$mq_pr_url|issue_url=$mq_issue_url|merged_head=$(_escape_wake_value "$verified_merged_sha")"
                rm -f "$f"
              else
                echo "[refinery/$rig] PR #$mq_pr post-merge verification mismatch — retry=${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-retry-post-merge-revalidate}"
              fi
              continue
            fi
            echo "[refinery/$rig] PR #$mq_pr duplicate merge key has non-retry receipt — no-op (retry=${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-no-op})"
            log_event "REFINERY_DUPLICATE_SKIP pr=#$mq_pr issue=#$mq_issue reason_code=duplicate-merge-receipt-noop reason=\"duplicate merge key has non-retry receipt\" retry=${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-no-op} key=\"$(_escape_quotes "$duplicate_key")\" queue=$mqname"
            rm -f "$f"
            continue
          fi
          if [[ "$duplicate_receipt_rc" -eq 2 ]]; then
            echo "[refinery/$rig] PR #$mq_pr recovering partial merge receipt write — replaying post-merge verification"
            log_event "REFINERY_MERGE_RECEIPT non-success reason=partial-receipt-write retry=retry-post-merge-revalidate repo=$mq_owner_repo pr=#$mq_pr issue=#$mq_issue merge_key=\"$(_escape_quotes "$duplicate_key")\""
            if _refinery_post_merge_verify_and_receipt "$rig" "$mq_repo" "$mq_pr" "$mq_issue" "$mq_branch" "$duplicate_key" "$mq_head_sha"; then
              local verified_merged_sha
              verified_merged_sha="${_REFINERY_MERGE_RECEIPT_MERGED_SHA:-$mq_head_sha}"
              echo "[refinery/$rig] PR #$mq_pr merged successfully"
              log_event "REFINERY_MERGED pr=#$mq_pr issue=#$mq_issue"
              _notify_openclaw "[SGT Refinery] merged rig=$rig repo=$mq_owner_repo pr=#$mq_pr title=\"$mq_pr_title_field\" issue=#$mq_issue pr_url=$mq_pr_url issue_url=$mq_issue_url" "$rig" "$rig"
              _wake_mayor "merged:pr#$mq_pr:#$mq_issue:$rig|repo=$mq_owner_repo|title=$mq_wake_title|pr_url=$mq_pr_url|issue_url=$mq_issue_url|merged_head=$(_escape_wake_value "$verified_merged_sha")"
              rm -f "$f"
            else
              echo "[refinery/$rig] PR #$mq_pr post-merge verification mismatch — retry=${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-retry-post-merge-revalidate}"
            fi
            continue
          fi
        fi
        echo "[refinery/$rig] PR #$mq_pr duplicate merge skipped — reason_code=$duplicate_reason_code reason=\"$duplicate_reason\" key=$duplicate_key"
        log_event "REFINERY_DUPLICATE_SKIP pr=#$mq_pr issue=#$mq_issue reason_code=$duplicate_reason_code reason=\"$(_escape_quotes "$duplicate_reason")\" key=\"$(_escape_quotes "$duplicate_key")\" queue=$mqname"
        rm -f "$f"
        continue
      fi
      claimed_attempt_file="${_REFINERY_MERGE_ATTEMPT_FILE:-}"
      claimed_attempt_key="${_REFINERY_MERGE_ATTEMPT_KEY:-}"

      # Check mergeability
      if [[ "$pr_mergeable" == "CONFLICTING" ]]; then
        _refinery_conflict_auto_resolve "$rig" "$mq_repo" "$mq_issue" "$mq_pr" "$mq_head_sha" "$claimed_attempt_key" "$mqname" "$mq_backend" "$f" "pre-fallback-mergeable-conflicting"
        continue
      fi

      if [[ "$mq_review_state" == "REVIEW_UNCLEAR" ]]; then
        local max_unclear_retry_attempts fallback_eligible fallback_reason_code fallback_reason
        max_unclear_retry_attempts="$(_refinery_unclear_retry_max_attempts)"
        if (( mq_unclear_retry_count >= max_unclear_retry_attempts )); then
          fallback_eligible=1
          fallback_reason_code="fallback-auto-approved"
          fallback_reason="unclear saturated and default-merge policy allows controlled merge path"
          if [[ "$check_class" != "green" && "$check_class" != "missing" ]]; then
            fallback_eligible=0
            fallback_reason_code="checks-not-green"
            fallback_reason="required checks are not successful/missing (class=$check_class)"
          elif [[ "$pr_mergeable" != "MERGEABLE" ]]; then
            fallback_eligible=0
            fallback_reason_code="mergeable-not-ready"
            fallback_reason="pr mergeable state not MERGEABLE (state=${pr_mergeable:-unknown})"
          elif _refinery_unclear_class_explicit_error_gate "${mq_unclear_last_class:-}"; then
            fallback_eligible=0
            fallback_reason_code="explicit-error-gate"
            fallback_reason="unclear class requires manual intervention (class=${mq_unclear_last_class:-unknown})"
          fi

          if [[ "$fallback_eligible" == "1" ]]; then
            echo "[refinery/$rig] PR #$mq_pr REVIEW_UNCLEAR saturated — fallback gate passed (attempts=${mq_unclear_retry_count}/${max_unclear_retry_attempts} class=${mq_unclear_last_class:-unknown})"
            log_event "REFINERY_REVIEW_UNCLEAR_FALLBACK_DECISION pr=#$mq_pr issue=#$mq_issue attempts=$mq_unclear_retry_count/$max_unclear_retry_attempts eligible=1 reason_code=$fallback_reason_code check_class=$check_class mergeable=${pr_mergeable:-unknown} unclear_class=${mq_unclear_last_class:-unknown} unclear_reason=\"$(_escape_quotes "${mq_unclear_last_reason:-unknown}")\""
            if ! _merge_queue_mark_review_ready "$f" "$mq_head_sha"; then
              echo "[refinery/$rig] PR #$mq_pr fallback guard failed — unable to persist review-ready evidence"
              log_event "REFINERY_REVIEW_UNCLEAR_FALLBACK_DECISION pr=#$mq_pr issue=#$mq_issue attempts=$mq_unclear_retry_count/$max_unclear_retry_attempts eligible=0 reason_code=fallback-persist-failed check_class=$check_class mergeable=${pr_mergeable:-unknown} unclear_class=${mq_unclear_last_class:-unknown}"
              _refinery_merge_attempt_release "$claimed_attempt_file"
              continue
            fi
            mq_review_state="REVIEW_APPROVED"
            mq_reviewed_head_sha="$mq_head_sha"
            mq_reviewed_at="$(date +%s)"
          else
            echo "[refinery/$rig] PR #$mq_pr REVIEW_UNCLEAR saturated — awaiting manual intervention (attempts=${mq_unclear_retry_count}/${max_unclear_retry_attempts} reason_code=$fallback_reason_code)"
            log_event "REFINERY_REVIEW_UNCLEAR_CAP_HOLD pr=#$mq_pr issue=#$mq_issue attempts=$mq_unclear_retry_count/$max_unclear_retry_attempts escalated=$mq_unclear_escalated reason_code=$fallback_reason_code check_class=$check_class mergeable=${pr_mergeable:-unknown} unclear_class=${mq_unclear_last_class:-unknown} reason=\"$(_escape_quotes "$fallback_reason")\""
            _refinery_merge_attempt_release "$claimed_attempt_file"
            continue
          fi
        fi
      fi

      # === AI REVIEW ===
      REFINERY_REJECT_REASON=""
      local review_rc
      review_rc=0
      if [[ "$mq_review_state" == "REVIEW_APPROVED" && -n "$mq_reviewed_head_sha" ]]; then
        echo "[refinery/$rig] PR #$mq_pr review-ready evidence restored from queue (reviewed_head=${mq_reviewed_head_sha:-unknown} reviewed_at=${mq_reviewed_at:-unknown})"
      else
        set +e
        _refinery_review_pr "$mq_repo" "$mq_pr" "$mq_issue" "$rig" "$mq_backend"
        review_rc=$?
        set -e
      fi
      if [[ "$review_rc" -eq 0 ]]; then
        local reviewed_head_sha reviewed_head_reason="" premerge_live_head premerge_reason=""
        if [[ -z "$mq_reviewed_head_sha" ]]; then
          # Capture reviewed head SHA at review-ready time and persist durably before merge.
          if ! reviewed_head_sha=$(_refinery_revalidate_pr_open_head "$rig" "$mq_repo" "$mq_pr" "" "$f"); then
            reviewed_head_reason="$reviewed_head_sha"
          fi
          if [[ -n "$reviewed_head_reason" ]]; then
            echo "[refinery/$rig] PR #$mq_pr pre-merge revalidation failed — skipping ($reviewed_head_reason)"
            log_event "REFINERY_PREMERGE_SKIP pr=#$mq_pr reason_code=reviewed-head-capture-failed reason=\"$(_escape_quotes "$reviewed_head_reason")\""
            _refinery_merge_attempt_release "$claimed_attempt_file"
            continue
          fi
          mq_reviewed_head_sha="$reviewed_head_sha"
          if ! _merge_queue_mark_review_ready "$f" "$mq_reviewed_head_sha"; then
            local review_evidence_reason
            review_evidence_reason="failed to persist review-ready evidence to merge candidate record"
            echo "[refinery/$rig] PR #$mq_pr merge blocked — reason_code=missing-reviewed-head-sha reason=\"$review_evidence_reason\" queue=$mqname"
            log_event "REFINERY_MERGE_BLOCKED_MISSING_REVIEW_SHA pr=#$mq_pr issue=#$mq_issue queue=$mqname review_state=REVIEW_APPROVED reason=\"$(_escape_quotes "$review_evidence_reason")\" action=release-merge-attempt"
            _refinery_merge_attempt_release "$claimed_attempt_file"
            continue
          fi
        fi
        if [[ -z "$mq_reviewed_head_sha" ]]; then
          local blocked_reason
          blocked_reason="merge candidate missing reviewed_head_sha before merge attempt"
          echo "[refinery/$rig] PR #$mq_pr merge blocked — reason_code=missing-reviewed-head-sha reason=\"$blocked_reason\" queue=$mqname"
          log_event "REFINERY_MERGE_BLOCKED_MISSING_REVIEW_SHA pr=#$mq_pr issue=#$mq_issue queue=$mqname review_state=$mq_review_state reason=\"$(_escape_quotes "$blocked_reason")\" action=release-merge-attempt"
          _refinery_merge_attempt_release "$claimed_attempt_file"
          continue
        fi

        if ! premerge_live_head=$(_refinery_premerge_revalidate_reviewed_head "$rig" "$mq_repo" "$mq_pr" "$mq_reviewed_head_sha" "$f"); then
          premerge_reason="$premerge_live_head"
        fi
        if [[ -n "$premerge_reason" ]]; then
          if [[ "$premerge_reason" =~ ^stale-reviewed-head[[:space:]]+reviewed=([^[:space:]]+)[[:space:]]+live=([^[:space:]]+) ]]; then
            local reviewed_from_reason live_from_reason
            reviewed_from_reason="${BASH_REMATCH[1]}"
            live_from_reason="${BASH_REMATCH[2]}"
            echo "[refinery/$rig] PR #$mq_pr pre-merge stale-head guard — skipping (reviewed=$reviewed_from_reason live=$live_from_reason)"
            log_event "REFINERY_PREMERGE_SKIP pr=#$mq_pr reason_code=stale-reviewed-head reviewed_head=$reviewed_from_reason live_head=$live_from_reason reason=\"$(_escape_quotes "$premerge_reason")\" action=resync-review-pending"
            _merge_queue_mark_review_pending_resync "$f" "stale-reviewed-head" || true
          else
            echo "[refinery/$rig] PR #$mq_pr pre-merge revalidation failed — skipping ($premerge_reason)"
            log_event "REFINERY_PREMERGE_SKIP pr=#$mq_pr reason_code=premerge-revalidation-failed reason=\"$(_escape_quotes "$premerge_reason")\""
          fi
          _refinery_merge_attempt_release "$claimed_attempt_file"
          continue
        fi

        local premerge_mergeable
        premerge_mergeable=$(gh pr view "$mq_pr" --repo "$mq_repo" --json mergeable --jq '.mergeable' 2>/dev/null || true)
        if [[ "$premerge_mergeable" == "CONFLICTING" ]]; then
          _refinery_conflict_auto_resolve "$rig" "$mq_repo" "$mq_issue" "$mq_pr" "$premerge_live_head" "$claimed_attempt_key" "$mqname" "$mq_backend" "$f" "premerge-mergeable-conflicting"
          continue
        fi
        if [[ "$premerge_mergeable" != "MERGEABLE" ]]; then
          echo "[refinery/$rig] PR #$mq_pr pre-merge mergeability guard — resyncing (state=${premerge_mergeable:-unknown})"
          log_event "REFINERY_PREMERGE_SKIP pr=#$mq_pr reason_code=mergeable-not-ready mergeable=${premerge_mergeable:-unknown} action=resync-review-pending"
          _merge_queue_mark_review_pending_resync "$f" "mergeable-not-ready" || true
          _refinery_merge_attempt_release "$claimed_attempt_file"
          continue
        fi

        # APPROVED — merge (bounded retry for transient errors).
        local merge_attempt max_attempts merge_result merge_error_class merge_success=false
        local merge_error_transient=false merge_skip_reason="" merge_expected_head_sha
        local merge_auto_retry_attempted=false merge_auto_retry_reason=""
        max_attempts="$(_refinery_merge_retry_max_attempts)"
        merge_expected_head_sha="$premerge_live_head"
        merge_attempt=1
        merge_error_class="non-transient"
        echo "[refinery/$rig] merging PR #$mq_pr (max attempts=$max_attempts)..."
        while (( merge_attempt <= max_attempts )); do
          if merge_result=$(gh pr merge "$mq_pr" --repo "$mq_repo" --squash --delete-branch 2>&1); then
            merge_success=true
            break
          fi

          if [[ "$merge_auto_retry_attempted" != "true" ]] && merge_auto_retry_reason="$(_refinery_merge_error_requires_auto_retry_reason "$merge_result")"; then
            local auto_retry_live_head
            merge_auto_retry_attempted=true
            if ! auto_retry_live_head=$(_refinery_revalidate_pr_open_head "$rig" "$mq_repo" "$mq_pr" "$merge_expected_head_sha" "$f"); then
              merge_skip_reason="$auto_retry_live_head"
              echo "[refinery/$rig] PR #$mq_pr auto-merge retry skipped — $merge_skip_reason"
              log_event "REFINERY_MERGE_RETRY_AUTO repo=$mq_owner_repo pr=#$mq_pr reason=$merge_auto_retry_reason outcome=skipped final_reason=\"$(_escape_quotes "$merge_skip_reason")\""
              break
            fi
            merge_expected_head_sha="$auto_retry_live_head"

            echo "[refinery/$rig] PR #$mq_pr merge failed due to branch policy requiring auto-merge — retrying once with --auto"
            if merge_result=$(gh pr merge "$mq_pr" --repo "$mq_repo" --squash --delete-branch --auto 2>&1); then
              merge_success=true
              log_event "REFINERY_MERGE_RETRY_AUTO repo=$mq_owner_repo pr=#$mq_pr reason=$merge_auto_retry_reason outcome=success"
              break
            fi

            merge_error_class="$(_refinery_merge_error_class "$merge_result")"
            if _refinery_merge_error_is_transient "$merge_error_class"; then
              merge_error_transient=true
            else
              merge_error_transient=false
            fi
            log_event "REFINERY_MERGE_RETRY_AUTO repo=$mq_owner_repo pr=#$mq_pr reason=$merge_auto_retry_reason outcome=failed final_class=$merge_error_class final_error=\"$(_escape_quotes "$merge_result")\""
            break
          fi

          merge_error_class="$(_refinery_merge_error_class "$merge_result")"
          if _refinery_merge_error_is_transient "$merge_error_class"; then
            merge_error_transient=true
          else
            merge_error_transient=false
          fi
          if [[ "$merge_error_transient" != "true" || "$merge_attempt" -ge "$max_attempts" ]]; then
            break
          fi

          local retry_delay_s retry_live_head
          if ! retry_live_head=$(_refinery_revalidate_pr_open_head "$rig" "$mq_repo" "$mq_pr" "$merge_expected_head_sha" "$f"); then
            merge_skip_reason="$retry_live_head"
            echo "[refinery/$rig] PR #$mq_pr merge retry skipped — $merge_skip_reason"
            log_event "REFINERY_MERGE_RETRY_SKIP pr=#$mq_pr attempt=$merge_attempt/$max_attempts reason=\"$(_escape_quotes "$merge_skip_reason")\""
            break
          fi
          merge_expected_head_sha="$retry_live_head"

          retry_delay_s="$(_refinery_merge_retry_delay_secs "$merge_attempt")"
          echo "[refinery/$rig] PR #$mq_pr merge transient failure class=$merge_error_class attempt=$merge_attempt/$max_attempts — retrying in ${retry_delay_s}s"
          log_event "REFINERY_MERGE_RETRY pr=#$mq_pr attempt=$merge_attempt/$max_attempts class=$merge_error_class delay_s=$retry_delay_s"
          sleep "$retry_delay_s"
          merge_attempt=$((merge_attempt + 1))
        done

        if [[ "$merge_skip_reason" != "" ]]; then
          continue
        fi

        if [[ "$merge_success" == "true" ]]; then
          if _refinery_post_merge_verify_and_receipt "$rig" "$mq_repo" "$mq_pr" "$mq_issue" "$mq_branch" "$claimed_attempt_key" "$merge_expected_head_sha"; then
            local verified_merged_sha
            verified_merged_sha="${_REFINERY_MERGE_RECEIPT_MERGED_SHA:-$merge_expected_head_sha}"
            merge_expected_head_sha="$verified_merged_sha"
            echo "[refinery/$rig] PR #$mq_pr merged successfully"
            log_event "REFINERY_MERGED pr=#$mq_pr issue=#$mq_issue"
            _notify_openclaw "[SGT Refinery] merged rig=$rig repo=$mq_owner_repo pr=#$mq_pr title=\"$mq_pr_title_field\" issue=#$mq_issue pr_url=$mq_pr_url issue_url=$mq_issue_url" "$rig"
            _wake_mayor "merged:pr#$mq_pr:#$mq_issue:$rig|repo=$mq_owner_repo|title=$mq_wake_title|pr_url=$mq_pr_url|issue_url=$mq_issue_url|merged_head=$(_escape_wake_value "$merge_expected_head_sha")"
            rm -f "$f"
          else
            echo "[refinery/$rig] PR #$mq_pr post-merge verification mismatch — retry=${_REFINERY_MERGE_RECEIPT_RETRY_DECISION:-retry-post-merge-revalidate}"
          fi
        else
          if _refinery_merge_error_is_conflict "$merge_result"; then
            _refinery_conflict_auto_resolve "$rig" "$mq_repo" "$mq_issue" "$mq_pr" "$merge_expected_head_sha" "$claimed_attempt_key" "$mqname" "$mq_backend" "$f" "merge-command-conflict"
            continue
          fi
          echo "[refinery/$rig] merge failed: $merge_result"
          log_event "REFINERY_MERGE_FAILED pr=#$mq_pr attempt=$merge_attempt/$max_attempts class=$merge_error_class transient=$merge_error_transient error=\"$(_escape_quotes "$merge_result")\""
          _notify_openclaw "[SGT Refinery] merge failed rig=$rig repo=$mq_owner_repo pr=#$mq_pr issue=#$mq_issue attempts=$merge_attempt/$max_attempts error_class=$merge_error_class transient=$merge_error_transient pr_url=$mq_pr_url issue_url=$mq_issue_url" "$rig"
          gh pr comment "$mq_pr" --repo "$mq_repo" \
            --body "[sgt-refinery] Auto-merge failed after ${merge_attempt}/${max_attempts} attempt(s) (class=${merge_error_class}, transient=${merge_error_transient}): \`$merge_result\`" 2>/dev/null || true
        fi
      elif [[ "$review_rc" -eq 2 ]]; then
        local unclear_since unclear_age now_epoch unclear_reason unclear_class
        local unclear_retry_count unclear_retry_max unclear_delay_s unclear_next_retry_at
        local unclear_escalated_at next_action_hint
        _merge_queue_mark_review_state "$f" "REVIEW_UNCLEAR" || true
        unclear_since=$(grep -E '^REVIEW_UNCLEAR_SINCE=' "$f" 2>/dev/null | tail -1 | cut -d= -f2- || true)
        now_epoch="$(date +%s)"
        unclear_reason="${_REFINERY_REVIEW_UNCLEAR_REASON:-review inconclusive}"
        unclear_class="${_REFINERY_REVIEW_UNCLEAR_CLASS:-unknown}"
        unclear_retry_count=$((mq_unclear_retry_count + 1))
        unclear_retry_max="$(_refinery_unclear_retry_max_attempts)"
        unclear_age=0
        if [[ "$unclear_since" =~ ^[0-9]+$ ]]; then
          unclear_age=$((now_epoch - unclear_since))
          if [[ "$unclear_age" -lt 0 ]]; then
            unclear_age=0
          fi
        fi

        _merge_queue_set_field "$f" "REVIEW_UNCLEAR_RETRY_COUNT" "$unclear_retry_count" || true
        _merge_queue_set_field "$f" "REVIEW_UNCLEAR_LAST_REASON" "$unclear_reason" || true
        _merge_queue_set_field "$f" "REVIEW_UNCLEAR_LAST_CLASS" "$unclear_class" || true
        if (( unclear_retry_count >= unclear_retry_max )); then
          _merge_queue_set_field "$f" "REVIEW_UNCLEAR_NEXT_RETRY_AT" "0" || true
          next_action_hint="inspect reviewer contract/output class=$unclear_class and intervene on PR #$mq_pr or issue #$mq_issue before requeueing"
          if [[ "$mq_unclear_escalated" != "1" ]]; then
            unclear_escalated_at="$(date -Iseconds)"
            _merge_queue_set_field "$f" "REVIEW_UNCLEAR_ESCALATED" "1" || true
            _merge_queue_set_field "$f" "REVIEW_UNCLEAR_ESCALATED_AT" "$unclear_escalated_at" || true
            echo "[refinery/$rig] PR #$mq_pr REVIEW_UNCLEAR retry cap reached — escalating once (attempts=${unclear_retry_count}/${unclear_retry_max} class=$unclear_class)"
            log_event "REFINERY_REVIEW_UNCLEAR_ESCALATED pr=#$mq_pr issue=#$mq_issue attempts=$unclear_retry_count/$unclear_retry_max class=$unclear_class reason=\"$(_escape_quotes "$unclear_reason")\" next_action_hint=\"$(_escape_quotes "$next_action_hint")\""
            _notify_openclaw "[SGT Refinery] unclear-review saturated rig=$rig repo=$mq_owner_repo pr=#$mq_pr issue=#$mq_issue attempts=$unclear_retry_count/$unclear_retry_max class=$unclear_class last_reason=\"$(_escape_quotes "$unclear_reason")\" next_action=\"$(_escape_quotes "$next_action_hint")\" pr_url=$mq_pr_url issue_url=$mq_issue_url" "$rig"
          else
            echo "[refinery/$rig] PR #$mq_pr REVIEW_UNCLEAR retry cap already escalated — holding"
            log_event "REFINERY_REVIEW_UNCLEAR_ESCALATION_DEDUPE pr=#$mq_pr issue=#$mq_issue attempts=$unclear_retry_count/$unclear_retry_max class=$unclear_class reason=\"$(_escape_quotes "$unclear_reason")\""
          fi
        else
          unclear_delay_s="$(_refinery_unclear_retry_delay_secs "$unclear_retry_count")"
          unclear_next_retry_at=$((now_epoch + unclear_delay_s))
          _merge_queue_set_field "$f" "REVIEW_UNCLEAR_NEXT_RETRY_AT" "$unclear_next_retry_at" || true
          echo "[refinery/$rig] PR #$mq_pr held in REVIEW_UNCLEAR (age=${unclear_age}s attempt=${unclear_retry_count}/${unclear_retry_max} retry_in=${unclear_delay_s}s class=$unclear_class)"
          log_event "REFINERY_REVIEW_UNCLEAR_PENDING pr=#$mq_pr issue=#$mq_issue age=${unclear_age}s attempt=$unclear_retry_count/$unclear_retry_max retry_in=${unclear_delay_s}s next_retry_at=$unclear_next_retry_at class=$unclear_class reason=\"$(_escape_quotes "$unclear_reason")\""
        fi
        _refinery_merge_attempt_release "$claimed_attempt_file"
        continue
      else
        _merge_queue_mark_review_state "$f" "REVIEW_REJECTED" || true
        # REJECTED — close PR, re-dispatch with feedback
        echo "[refinery/$rig] PR #$mq_pr rejected — dispatching rework"
        gh pr close "$mq_pr" --repo "$mq_repo" 2>/dev/null || true
        rm -f "$f"

        if [[ "$mq_issue" != "0" && -n "$mq_issue" ]]; then
          gh issue reopen "$mq_issue" --repo "$mq_repo" 2>/dev/null || true
          gh issue comment "$mq_issue" --repo "$mq_repo" \
            --body "[sgt-refinery] Previous attempt rejected. Feedback:

$REFINERY_REJECT_REASON

Please address the feedback in the next iteration." 2>/dev/null || true
          local issue_title_resling
          issue_title_resling=$(gh issue view "$mq_issue" --repo "$mq_repo" --json title --jq '.title' 2>/dev/null || true)
          if [[ -n "$issue_title_resling" ]]; then
            echo "[refinery/$rig] re-slinging issue #$mq_issue"
            _resling_existing_issue "$rig" "$mq_issue" "$issue_title_resling" "$mq_repo" "$mq_backend" "$mq_pr" "refinery-reject" "refinery-reject:$mqname:#$mq_pr"
          fi
        fi
      fi
    done

    # ── Process dog queue (check for completed dogs) ──
    if [[ -d "$SGT_CONFIG/dogs" ]]; then
      for df in "$SGT_CONFIG/dogs"/*; do
        [[ -f "$df" ]] || continue
        local dname
        dname="$(basename "$df")"

        local d_session="" d_repo="" d_issue="" d_rig=""
        eval "$(grep -E '^(SESSION|REPO|ISSUE|RIG|BACKEND)=' "$df")"
        d_session="${SESSION:-}"
        d_repo="${REPO:-$repo}"
        d_issue="${ISSUE:-0}"
        d_rig="${RIG:-$rig}"
        local d_backend="${BACKEND:-$(_ai_backend_default)}"
        local d_owner_repo d_issue_title d_issue_url d_wake_title
        d_owner_repo="$(_repo_owner_repo "$d_repo")"
        d_issue_title=$(gh issue view "$d_issue" --repo "$d_repo" --json title --jq '.title' 2>/dev/null || true)
        d_issue_url="$(_repo_issue_url "$d_repo" "$d_issue")"
        d_wake_title="$(_escape_wake_value "$d_issue_title")"

        # Only process dogs for this rig
        [[ "$d_rig" == "$rig" ]] || continue

        # Check if dog is still alive
        if tmux has-session -t "$d_session" 2>/dev/null; then
          continue  # Still running
        fi

        echo "[refinery/$rig] dog $dname finished — reviewing output"

        # Security gate: verify dog's issue has sgt-authorized label
        if ! _has_sgt_authorized "$d_repo" "$d_issue"; then
          echo "[refinery/$rig] dog $dname issue #$d_issue lacks sgt-authorized — skipping"
          log_event "REFINERY_DOG_SKIP_UNAUTHORIZED dog=$dname issue=#$d_issue"
          rm -f "$df"
          continue
        fi

        REFINERY_REJECT_REASON=""
        if _refinery_review_dog "$d_repo" "$d_issue" "$rig" "$dname" "$d_backend"; then
          # APPROVED — close issue, notify mayor
          gh issue close "$d_issue" --repo "$d_repo" 2>/dev/null || true
          echo "[refinery/$rig] dog $dname approved and issue #$d_issue closed"
          log_event "REFINERY_DOG_COMPLETE dog=$dname issue=#$d_issue"
          _wake_mayor "dog-approved:$dname:#$d_issue:$rig|repo=$d_owner_repo|title=$d_wake_title|issue_url=$d_issue_url"
          # Clean up dog state + workspace
          local d_ws=""
          d_ws=$(grep '^WORKSPACE=' "$df" 2>/dev/null | cut -d= -f2)
          [[ -d "$d_ws" ]] && rm -rf "$d_ws"
          rm -f "$df"
        else
          # REJECTED — re-dispatch dog with feedback
          echo "[refinery/$rig] dog $dname rejected — dispatching second iteration"
          log_event "REFINERY_DOG_REWORK dog=$dname issue=#$d_issue"

          # Clean up old dog
          local d_ws=""
          d_ws=$(grep '^WORKSPACE=' "$df" 2>/dev/null | cut -d= -f2)
          [[ -d "$d_ws" ]] && rm -rf "$d_ws"
          rm -f "$df"

          # Re-dispatch dog on same issue
          local issue_title_dog
          issue_title_dog=$(gh issue view "$d_issue" --repo "$d_repo" --json title --jq '.title' 2>/dev/null || true)
          issue_title_dog="${issue_title_dog#\[Dog\] }"
          if [[ -n "$issue_title_dog" ]]; then
            local new_dname="dog-$(head -c4 /dev/urandom | xxd -p)"
            local new_session="sgt-${new_dname}"
            local dog_workspace="$SGT_ROOT/dogs/$new_dname"
            mkdir -p "$dog_workspace"
            _ensure_context_file "$rig" >/dev/null

            cat > "$dog_workspace/CLAUDE.md" <<DOGMD
# Dog Task — $new_dname (REWORK)

You are a research/analysis agent. A previous attempt was insufficient.

## Task
$issue_title_dog

## Previous Feedback
$REFINERY_REJECT_REASON

## Instructions
1. Read `SGT_CONTEXT.md` and the previous comments on issue #$d_issue for context
2. Use `sgt context search $rig "<query>"` if prior rig memory would help
3. Address the feedback above
4. Post improved findings as a comment on issue #$d_issue:
   \`gh issue comment $d_issue --repo $d_repo --body "<your findings>"\`
5. If you learned durable project context, append it with `sgt context add $rig "<note>"`
6. Do NOT close the issue — the refinery will review again
7. Exit
DOGMD
            if [[ -f "$(rig_path "$rig")/SGT_CONTEXT.md" ]]; then
              cp "$(rig_path "$rig")/SGT_CONTEXT.md" "$dog_workspace/SGT_CONTEXT.md"
            fi

            mkdir -p "$SGT_CONFIG/dogs"
            cat > "$SGT_CONFIG/dogs/$new_dname" <<DSTATE
RIG=$rig
REPO=$d_repo
ISSUE=$d_issue
SESSION=$new_session
WORKSPACE=$dog_workspace
CREATED=$(date -Iseconds)
STATUS=running
REWORK=true
DSTATE

            tmux new-session -d -s "$new_session" -c "$dog_workspace" \
              "$( _ai_cmd "$(_ai_backend_default)" "Read CLAUDE.md and SGT_CONTEXT.md before you start. Search shared rig context first with 'sgt context search ${rig} \"<query>\"' for any questions, unknowns, or prior decisions instead of guessing. This is a REWORK — previous attempt was rejected. Address the feedback and post improved findings. Before you finish, add any durable project context you learned with 'sgt context add ${rig} \"<note>\"'." ); echo '[SGT] dog exited'; sgt _wake-refinery '${rig}' 'dog-done:${new_dname}:#${d_issue}' 2>/dev/null"
            # Auto-accept Claude Code workspace trust dialog if it appears
            if [[ "$(_ai_backend_default)" == "claude" ]]; then
              ( sleep 3 && tmux send-keys -t "$new_session" Enter 2>/dev/null || true ) &
            fi
            echo "[refinery/$rig] re-dispatched dog $new_dname for issue #$d_issue"
            log_event "REFINERY_DOG_REWORK_DISPATCHED dog=$new_dname issue=#$d_issue"
          fi
        fi
      done
    fi
  done
}

cmd_refinery_start() {
  local rig="${1:-}"
  [[ -n "$rig" ]] || die "usage: sgt refinery start <rig>"
  ensure_init
  ensure_rig "$rig"

  local session="sgt-refinery-${rig}"
  if tmux has-session -t "$session" 2>/dev/null; then
    info "refinery/$rig already running"
    return
  fi

  mkdir -p "$SGT_CONFIG/merge-queue"
  local fifo="$SGT_CONFIG/refinery-${rig}.fifo"
  [[ -p "$fifo" ]] || mkfifo "$fifo"

  tmux new-session -d -s "$session" \
    "SGT_ROOT='$SGT_ROOT' sgt _refinery '$rig'"

  log_event "REFINERY_SPAWN rig=$rig"
  info "refinery/$rig started (session: $session)"
}

cmd_refinery_stop() {
  local rig="${1:-}"
  [[ -n "$rig" ]] || die "usage: sgt refinery stop <rig>"

  local session="sgt-refinery-${rig}"
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
    log_event "REFINERY_STOP rig=$rig"
    info "refinery/$rig stopped"
  else
    info "refinery/$rig not running"
  fi
}

_president_intervention_allowed() {
  local rig="${1:-}" reason="${2:-}" action="${3:-}" cooldown_secs now_epoch prior_ts prior_reason prior_action
  cooldown_secs="${SGT_PRESIDENT_INTERVENTION_COOLDOWN_SECS:-600}"
  [[ "$cooldown_secs" =~ ^[0-9]+$ ]] || cooldown_secs=600
  if (( cooldown_secs <= 0 )); then
    return 0
  fi
  IFS='|' read -r prior_ts prior_reason prior_action <<< "$(_president_intervention_state_read "$rig")"
  [[ "$prior_ts" =~ ^[0-9]+$ ]] || return 0
  now_epoch="$(date +%s)"
  if [[ "$prior_reason" == "$reason" && "$prior_action" == "$action" && $((now_epoch - prior_ts)) -lt "$cooldown_secs" ]]; then
    return 1
  fi
  return 0
}

_president_supervise_rig_mayor() {
  local rig="${1:-}" cycle_reason="${2:-periodic}"
  local mayor_session mayor_hb_age mayor_hb_ts mayor_hb_state mayor_hb_pid mayor_hb_phase mayor_hb_cycle mayor_hb_trigger mayor_hb_stale mayor_hb_health
  local snapshot snapshot_state snapshot_reason open_authorized open_prs active_polecats merge_queue pending_plan_requests plan_rollup plan_status
  local activity changed_at changed_epoch mode meaningful_at meaningful_epoch meaningful_reason wake_at wake_reason
  local now_epoch action reason detail last_meaningful_age

  [[ -n "$rig" ]] || return 1
  now_epoch="$(date +%s)"
  _mayor_scope_apply "$rig"
  mayor_session="off"
  tmux has-session -t "$(_mayor_scope_session_name "$rig")" 2>/dev/null && mayor_session="on"
  mayor_hb_stale="$(_mayor_heartbeat_stale_secs)"
  IFS='|' read -r mayor_hb_age mayor_hb_ts mayor_hb_state mayor_hb_pid mayor_hb_phase mayor_hb_cycle mayor_hb_trigger <<< "$(_mayor_heartbeat_snapshot)"
  mayor_hb_health="$(_mayor_heartbeat_health "$mayor_hb_age" "$mayor_hb_stale")"
  snapshot="$(_mayor_rig_activity_snapshot "$rig")"
  IFS='|' read -r snapshot_state snapshot_reason open_authorized open_prs active_polecats merge_queue pending_plan_requests plan_rollup plan_status <<< "$snapshot"
  IFS='|' read -r activity snapshot_reason changed_at changed_epoch mode meaningful_at meaningful_epoch meaningful_reason wake_at wake_reason <<< "$(_mayor_rig_activity_state_read "$rig")"

  action=""
  reason=""
  detail=""
  last_meaningful_age=""
  if [[ "$mayor_session" != "on" ]]; then
    action="start"
    reason="mayor-session-missing"
    detail="session=off"
  elif [[ "$mayor_hb_state" != "ok" ]]; then
    action="refresh"
    reason="mayor-heartbeat-${mayor_hb_state:-invalid}"
    detail="heartbeat_state=${mayor_hb_state:-unknown}"
  elif [[ "$mayor_hb_age" =~ ^[0-9]+$ && "$mayor_hb_age" -gt "$mayor_hb_stale" ]]; then
    action="refresh"
    reason="mayor-heartbeat-stale"
    detail="heartbeat_age=${mayor_hb_age}s threshold=${mayor_hb_stale}s"
  elif [[ "$open_authorized" =~ ^[0-9]+$ && "$open_prs" =~ ^[0-9]+$ && "$active_polecats" =~ ^[0-9]+$ && "$merge_queue" =~ ^[0-9]+$ ]] \
    && (( open_authorized > 0 )) && (( open_prs == 0 )) && (( active_polecats == 0 )) && (( merge_queue == 0 )); then
    if [[ "$meaningful_epoch" =~ ^[0-9]+$ ]]; then
      last_meaningful_age=$((now_epoch - meaningful_epoch))
      (( last_meaningful_age < 0 )) && last_meaningful_age=0
    fi
    if [[ ! "$last_meaningful_age" =~ ^[0-9]+$ || "$last_meaningful_age" -gt "${SGT_PRESIDENT_INTERVENTION_STALE_SECS:-900}" ]]; then
      action="refresh"
      reason="actionable-no-forward-motion"
      detail="open_issues=${open_authorized} open_prs=${open_prs} active_polecats=${active_polecats} merge_queue=${merge_queue} last_meaningful_age=${last_meaningful_age:-unknown}s"
    else
      action="wake"
      reason="actionable-rig-recheck"
      detail="open_issues=${open_authorized} active_polecats=${active_polecats} merge_queue=${merge_queue}"
    fi
  fi

  if [[ -z "$action" ]]; then
    _mayor_scope_apply ""
    return 1
  fi

  if ! _president_intervention_allowed "$rig" "$reason" "$action"; then
    _mayor_scope_apply ""
    return 1
  fi

  case "$action" in
    start)
      cmd_mayor_start "$rig" >/dev/null
      ;;
    refresh)
      cmd_mayor_refresh "$rig" >/dev/null
      ;;
    wake)
      cmd_wake_mayor "president:${rig}:${reason}" >/dev/null
      ;;
    *)
      _mayor_scope_apply ""
      return 1
      ;;
  esac
  _president_intervention_state_write "$rig" "$reason" "$action"
  log_event "PRESIDENT_INTERVENTION rig=$rig action=$action reason=$reason detail=\"$(_escape_quotes "$detail")\" cycle_trigger=\"$(_escape_quotes "$cycle_reason")\""
  echo "[president] intervened on mayor/$rig — action=$action reason=$reason detail=$detail"
  _mayor_scope_apply ""
  return 0
}

_president_exit_receipt() {
  local exit_code="${1:-0}" signal="${2:-EXIT}" reason_code unexpected
  if [[ "$signal" == "TERM" || "$signal" == "INT" ]]; then
    reason_code="signal-${signal,,}"
    unexpected="false"
  elif [[ "$exit_code" -eq 0 ]]; then
    reason_code="clean-exit"
    unexpected="false"
  else
    reason_code="nonzero-exit"
    unexpected="true"
  fi
  _president_exit_state_write "$reason_code" "$exit_code" "$signal" "$unexpected"
  log_event "PRESIDENT_STOP reason_code=$reason_code exit_code=$exit_code signal=$signal unexpected=$unexpected"
}

_wake_president() {
  local reason="${1:-manual}"
  local fifo
  fifo="$(_president_fifo)"
  [[ -p "$fifo" ]] || return 1
  printf '%s\n' "$reason" > "$fifo"
}

_president_loop() {
  set +e
  local president_dir fifo cycle_count wake_reason
  president_dir="$(_president_runtime_dir)"
  fifo="$(_president_fifo)"
  mkdir -p "$president_dir"
  [[ -p "$fifo" ]] || mkfifo "$fifo"
  trap 'rc=$?; _president_exit_receipt "$rc" "EXIT"' EXIT
  trap '_president_exit_receipt 143 "TERM"; exit 143' TERM
  trap '_president_exit_receipt 130 "INT"; exit 130' INT
  exec 3<>"$fifo"
  _president_exit_state_clear || true
  cycle_count=0
  _president_heartbeat_write "startup" "startup" "$cycle_count" || true
  log_event "PRESIDENT_START"
  echo "[president] started — supervising per-rig mayors"

  while true; do
    read -t "$SGT_PRESIDENT_INTERVAL" -u 3 wake_reason 2>/dev/null || true
    if [[ -z "$wake_reason" ]]; then
      wake_reason="periodic"
      echo "[president] periodic check at $(date -Iseconds)"
    else
      echo "[president] woken by event: $wake_reason"
    fi
    cycle_count=$((cycle_count + 1))
    _president_heartbeat_write "cycle-begin" "$wake_reason" "$cycle_count" || true
    local interventions=0 rig
    for rig in $(_mayor_all_rigs); do
      if _president_supervise_rig_mayor "$rig" "$wake_reason"; then
        interventions=$((interventions + 1))
      fi
    done
    if [[ "$interventions" -eq 0 ]]; then
      echo "[president] all rig mayors healthy"
    else
      echo "[president] completed ${interventions} intervention(s)"
    fi
    log_event "PRESIDENT_CYCLE completed (trigger: $wake_reason interventions=${interventions})"
    _president_heartbeat_write "cycle-complete" "$wake_reason" "$cycle_count" || true
  done
}

cmd_president_start() {
  local session president_dir president_log sgt_exec spawn_cmd
  ensure_init
  _president_enabled || {
    info "president is disabled in shared-mayor mode"
    return 0
  }
  session="$(_president_session_name)"
  if tmux has-session -t "$session" 2>/dev/null; then
    info "president already running"
    return 0
  fi
  president_dir="$(_president_runtime_dir)"
  president_log="$(_president_start_log_file)"
  sgt_exec="$(_sgt_exec_path)"
  mkdir -p "$president_dir"
  printf -v spawn_cmd 'SGT_ROOT=%q SGT_MAYOR_ARCHITECTURE=%q exec %q _president >> %q 2>&1' \
    "$SGT_ROOT" \
    "$SGT_MAYOR_ARCHITECTURE" \
    "$sgt_exec" \
    "$president_log"
  tmux new-session -d -s "$session" "$spawn_cmd"
  log_event "PRESIDENT_SPAWN"
  info "president started (session: $session)"
}

cmd_president_stop() {
  local session fifo
  session="$(_president_session_name)"
  fifo="$(_president_fifo)"
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
    log_event "PRESIDENT_STOP_REQUEST"
    info "president stopped"
  else
    info "president not running"
  fi
  [[ -p "$fifo" ]] && rm -f "$fifo"
}

cmd_president_refresh() {
  cmd_president_stop >/dev/null 2>&1 || true
  cmd_president_start
  _wake_president "manual-refresh" >/dev/null 2>&1 || true
}

cmd_wake_president() {
  local reason="${1:-manual}"
  if !_president_enabled; then
    info "president is disabled in shared-mayor mode"
    return 0
  fi
  if ! tmux has-session -t "$(_president_session_name)" 2>/dev/null; then
    warn "president is not running — starting it"
    cmd_president_start >/dev/null
  fi
  _wake_president "$reason" >/dev/null 2>&1 || true
  info "president woken: $reason"
}

# ─── Deacon (health monitor) ──────────────────────────────────────────
#
# The Deacon patrols the entire sgt system:
# - Checks that Witnesses are running for each rig
# - Checks that Refineries are running for each rig
# - Restarts dead agents
# - Writes heartbeat for Boot to check
# - Runs as a bash loop (no AI needed)

_deacon_supervise_mayor() {
  local scope_rig="${1:-}"
  _mayor_scope_apply "$scope_rig"
  local mayor_name mayor_session_name
  mayor_name="$(_mayor_scope_agent_name "$scope_rig")"
  mayor_session_name="$(_mayor_scope_session_name "$scope_rig")"
  local mayor_session="off"
  local hb_age hb_ts hb_state hb_pid hb_phase hb_cycle hb_trigger hb_stale_secs hb_health
  local exit_ts exit_reason exit_code exit_signal exit_unexpected exit_pid exit_trigger exit_cycle_at exit_cycle_status
  local restart_reason restart_line

  tmux has-session -t "$mayor_session_name" 2>/dev/null && mayor_session="on"
  hb_stale_secs="$(_mayor_heartbeat_stale_secs)"
  IFS='|' read -r hb_age hb_ts hb_state hb_pid hb_phase hb_cycle hb_trigger <<< "$(_mayor_heartbeat_snapshot)"
  hb_health="$(_mayor_heartbeat_health "$hb_age" "$hb_stale_secs")"
  IFS='|' read -r exit_ts exit_reason exit_code exit_signal exit_unexpected exit_pid exit_trigger exit_cycle_at exit_cycle_status <<< "$(_mayor_exit_state_read)"

  restart_reason=""
  restart_line=""
  if [[ "$mayor_session" != "on" ]]; then
    restart_reason="session-missing"
    restart_line="[deacon] mayor is down — restarting"
  elif [[ "$hb_state" == "missing" ]]; then
    restart_reason="heartbeat-missing"
    restart_line="[deacon] mayor heartbeat missing — restarting"
  elif [[ "$hb_state" != "ok" ]]; then
    restart_reason="heartbeat-invalid"
    restart_line="[deacon] mayor heartbeat invalid — restarting"
  elif [[ "$hb_age" =~ ^[0-9]+$ && "$hb_age" -gt "$hb_stale_secs" ]]; then
    restart_reason="heartbeat-stale"
    restart_line="[deacon] mayor heartbeat stale (${hb_age}s > ${hb_stale_secs}s) — restarting"
  fi

  [[ -n "$restart_reason" ]] || return 1

  if [[ "$restart_reason" == heartbeat-* ]]; then
    tmux kill-session -t "$mayor_session_name" 2>/dev/null || true
  fi

  if [[ -n "$exit_reason" || -n "$exit_trigger" ]]; then
    restart_line+=" (last_exit=${exit_reason:-unknown} signal=${exit_signal:-unknown} code=${exit_code:-unknown} last_cycle_trigger=${exit_trigger:-unknown} last_cycle_status=${exit_cycle_status:-unknown})"
  fi
  if [[ -n "$scope_rig" ]]; then
    restart_line="[deacon] ${mayor_name} is down — restarting"
    if [[ "$restart_reason" == heartbeat-missing ]]; then
      restart_line="[deacon] ${mayor_name} heartbeat missing — restarting"
    elif [[ "$restart_reason" == heartbeat-invalid ]]; then
      restart_line="[deacon] ${mayor_name} heartbeat invalid — restarting"
    elif [[ "$restart_reason" == "heartbeat-stale" ]]; then
      restart_line="[deacon] ${mayor_name} heartbeat stale (${hb_age}s > ${hb_stale_secs}s) — restarting"
    fi
    if [[ -n "$exit_reason" || -n "$exit_trigger" ]]; then
      restart_line+=" (last_exit=${exit_reason:-unknown} signal=${exit_signal:-unknown} code=${exit_code:-unknown} last_cycle_trigger=${exit_trigger:-unknown} last_cycle_status=${exit_cycle_status:-unknown})"
    fi
  fi
  echo "$restart_line"
  log_event "DEACON_RESTART_MAYOR reason=$restart_reason rig=${scope_rig:-shared} session=$mayor_session heartbeat_state=${hb_state:-unknown} heartbeat_health=${hb_health:-unknown} heartbeat_age=${hb_age:-unknown}s heartbeat_phase=${hb_phase:-unknown} heartbeat_cycle=${hb_cycle:-unknown} trigger=\"$(_escape_quotes "${hb_trigger:-unknown}")\" last_exit_reason=${exit_reason:-none} last_exit_signal=${exit_signal:-none} last_exit_code=${exit_code:-unknown} last_exit_unexpected=${exit_unexpected:-unknown} last_exit_pid=${exit_pid:-unknown} last_cycle_trigger=\"$(_escape_quotes "${exit_trigger:-unknown}")\" last_cycle_status=${exit_cycle_status:-unknown} last_cycle_at=\"$(_escape_quotes "${exit_cycle_at:-unknown}")\""
  cmd_mayor_start "$scope_rig"
  return 0
}

_deacon_supervise_president() {
  local president_session hb_age hb_ts hb_state hb_pid hb_phase hb_cycle hb_trigger hb_stale_secs hb_health
  local exit_ts exit_reason exit_code exit_signal exit_unexpected
  local restart_reason restart_line

  president_session="off"
  tmux has-session -t "$(_president_session_name)" 2>/dev/null && president_session="on"
  hb_stale_secs="$(_president_heartbeat_stale_secs)"
  IFS='|' read -r hb_age hb_ts hb_state hb_pid hb_phase hb_cycle hb_trigger <<< "$(_president_heartbeat_snapshot)"
  hb_health="$(_president_heartbeat_health "$hb_age" "$hb_stale_secs")"
  IFS='|' read -r exit_ts exit_reason exit_code exit_signal exit_unexpected <<< "$(_president_exit_state_read)"

  restart_reason=""
  restart_line=""
  if [[ "$president_session" != "on" ]]; then
    restart_reason="session-missing"
    restart_line="[deacon] president is down — restarting"
  elif [[ "$hb_state" == "missing" ]]; then
    restart_reason="heartbeat-missing"
    restart_line="[deacon] president heartbeat missing — restarting"
  elif [[ "$hb_state" != "ok" ]]; then
    restart_reason="heartbeat-invalid"
    restart_line="[deacon] president heartbeat invalid — restarting"
  elif [[ "$hb_age" =~ ^[0-9]+$ && "$hb_age" -gt "$hb_stale_secs" ]]; then
    restart_reason="heartbeat-stale"
    restart_line="[deacon] president heartbeat stale (${hb_age}s > ${hb_stale_secs}s) — restarting"
  fi

  [[ -n "$restart_reason" ]] || return 1
  if [[ "$restart_reason" == heartbeat-* ]]; then
    tmux kill-session -t "$(_president_session_name)" 2>/dev/null || true
  fi
  if [[ -n "$exit_reason" ]]; then
    restart_line+=" (last_exit=${exit_reason:-unknown} signal=${exit_signal:-unknown} code=${exit_code:-unknown})"
  fi
  echo "$restart_line"
  log_event "DEACON_RESTART_PRESIDENT reason=$restart_reason session=$president_session heartbeat_state=${hb_state:-unknown} heartbeat_health=${hb_health:-unknown} heartbeat_age=${hb_age:-unknown}s heartbeat_phase=${hb_phase:-unknown} heartbeat_cycle=${hb_cycle:-unknown} trigger=\"$(_escape_quotes "${hb_trigger:-unknown}")\" last_exit_reason=${exit_reason:-none} last_exit_signal=${exit_signal:-none} last_exit_code=${exit_code:-unknown} last_exit_unexpected=${exit_unexpected:-unknown}"
  cmd_president_start
  return 0
}

_deacon_loop() {
  log_event "DEACON_START"
  echo "[deacon] started — patrolling sgt system"
  local cycle=0

  while true; do
    cycle=$((cycle + 1))
    local now
    now=$(date -Iseconds)
    local actions=0

    # Write heartbeat
    cat > "$SGT_DEACON_HEARTBEAT" <<HEARTBEAT
{
  "timestamp": "$now",
  "cycle": $cycle,
  "pid": $$
}
HEARTBEAT

    echo "[deacon] patrol cycle $cycle at $now"

    # Ensure witnesses for all rigs
    for rig_file in "$SGT_RIGS"/*; do
      [[ -f "$rig_file" ]] || continue
      local rig_name
      rig_name="$(basename "$rig_file")"

      if _mayor_rig_hibernated "$rig_name"; then
        local witness_session refinery_session
        witness_session="sgt-witness-${rig_name}"
        refinery_session="sgt-refinery-${rig_name}"
        if tmux has-session -t "$witness_session" 2>/dev/null || tmux has-session -t "$refinery_session" 2>/dev/null; then
          echo "[deacon] $rig_name is hibernated — stopping witness/refinery"
          log_event "DEACON_ENFORCE_HIBERNATION rig=$rig_name"
          _rig_hibernation_sync_agents "$rig_name" "hibernate" "deacon enforced hibernation" || true
          actions=$((actions + 1))
        fi
        continue
      fi

      # Check witness
      if ! tmux has-session -t "sgt-witness-${rig_name}" 2>/dev/null; then
        echo "[deacon] witness/$rig_name is down — restarting"
        log_event "DEACON_RESTART_WITNESS rig=$rig_name"
        cmd_witness_start "$rig_name"
        actions=$((actions + 1))
      fi

      # Check refinery
      if ! tmux has-session -t "sgt-refinery-${rig_name}" 2>/dev/null; then
        echo "[deacon] refinery/$rig_name is down — restarting"
        log_event "DEACON_RESTART_REFINERY rig=$rig_name"
        cmd_refinery_start "$rig_name"
        actions=$((actions + 1))
      else
        local refinery_watch_action refinery_watch_reason refinery_queue_count refinery_oldest_age refinery_hb_age refinery_hb_ts refinery_hb_state refinery_hb_stale_secs
        IFS='|' read -r refinery_watch_action refinery_watch_reason refinery_queue_count refinery_oldest_age refinery_hb_age refinery_hb_ts refinery_hb_state refinery_hb_stale_secs <<< "$(_deacon_refinery_watchdog_state "$rig_name")"
        if [[ "$refinery_watch_action" == "restart" ]]; then
          echo "[deacon] refinery/$rig_name watchdog restart — reason=$refinery_watch_reason queue_count=$refinery_queue_count oldest_queue_age=${refinery_oldest_age}s heartbeat_state=${refinery_hb_state:-missing} heartbeat_age=${refinery_hb_age}s"
          log_event "DEACON_RESTART_REFINERY rig=$rig_name reason=$refinery_watch_reason queue_count=$refinery_queue_count oldest_queue_age=${refinery_oldest_age}s heartbeat_state=${refinery_hb_state:-missing} heartbeat_age=${refinery_hb_age}s heartbeat_threshold=${refinery_hb_stale_secs}s last_heartbeat=\"$(_escape_quotes "${refinery_hb_ts:-}")\""
          cmd_refinery_stop "$rig_name" 2>/dev/null || true
          cmd_refinery_start "$rig_name"
          actions=$((actions + 1))
        fi
      fi
    done

    if _president_enabled; then
      if _deacon_supervise_president; then
        actions=$((actions + 1))
      fi
    elif _mayor_architecture_per_rig; then
      for rig_file in "$SGT_RIGS"/*; do
        [[ -f "$rig_file" ]] || continue
        rig_name="$(basename "$rig_file")"
        if _deacon_supervise_mayor "$rig_name"; then
          actions=$((actions + 1))
        fi
      done
      _mayor_scope_apply ""
    else
      if _deacon_supervise_mayor; then
        actions=$((actions + 1))
      fi
    fi

    # Check for orphaned polecats (no matching rig)
    for f in "$SGT_POLECATS"/*; do
      [[ -f "$f" ]] || continue
      local pname
      pname="$(basename "$f")"
      local p_rig
      p_rig=$(grep '^RIG=' "$f" | cut -d= -f2)
      if [[ ! -f "$SGT_RIGS/$p_rig" ]]; then
        echo "[deacon] orphaned polecat $pname (rig '$p_rig' no longer exists)"
        log_event "DEACON_ORPHAN $pname rig=$p_rig"
      fi
    done

    if [[ "$actions" -eq 0 ]]; then
      echo "[deacon] all agents healthy"
    else
      echo "[deacon] restarted $actions agent(s)"
    fi

    sleep 60
  done
}

cmd_deacon_start() {
  ensure_init

  local session="sgt-deacon"
  if tmux has-session -t "$session" 2>/dev/null; then
    info "deacon already running"
    return
  fi

  tmux new-session -d -s "$session" \
    "SGT_ROOT='$SGT_ROOT' sgt _deacon"

  log_event "DEACON_SPAWN"
  info "deacon started (session: $session)"
}

cmd_deacon_stop() {
  local session="sgt-deacon"
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
    log_event "DEACON_STOP"
    info "deacon stopped"
  else
    info "deacon not running"
  fi
}

# ─── Boot (ephemeral deacon triage) ──────────────────────────────────
#
# Boot is a quick check: is the Deacon alive?
# If deacon heartbeat is stale (>5 min), restart it.
# Runs once and exits — called by the Daemon every tick.

_boot_check() {
  local stale_threshold
  stale_threshold="$(_deacon_heartbeat_stale_secs)"

  if ! tmux has-session -t "sgt-deacon" 2>/dev/null; then
    echo "[boot] deacon session missing — restarting"
    log_event "BOOT_RESTART_DEACON reason=session_missing"
    cmd_deacon_start
    return
  fi

  local hb_age hb_ts hb_state
  IFS='|' read -r hb_age hb_ts hb_state <<< "$(_deacon_heartbeat_snapshot)"

  if [[ "$hb_state" == "missing" ]]; then
    echo "[boot] no deacon heartbeat file — restarting"
    log_event "BOOT_RESTART_DEACON reason=no_heartbeat"
    tmux kill-session -t "sgt-deacon" 2>/dev/null || true
    cmd_deacon_start
    return
  fi

  if [[ "$hb_state" != "ok" || ! "$hb_age" =~ ^[0-9]+$ ]]; then
    echo "[boot] invalid deacon heartbeat data — restarting"
    log_event "BOOT_RESTART_DEACON reason=invalid_heartbeat timestamp=$(_escape_quotes "$hb_ts")"
    tmux kill-session -t "sgt-deacon" 2>/dev/null || true
    cmd_deacon_start
    return
  fi

  if [[ "$hb_age" -gt "$stale_threshold" ]]; then
    echo "[boot] deacon heartbeat stale (${hb_age}s > ${stale_threshold}s) — restarting"
    log_event "BOOT_RESTART_DEACON reason=stale_heartbeat age=${hb_age}s threshold=${stale_threshold}s"
    tmux kill-session -t "sgt-deacon" 2>/dev/null || true
    cmd_deacon_start
  else
    echo "[boot] deacon healthy (heartbeat ${hb_age}s ago, threshold ${stale_threshold}s)"
  fi
}

# ─── Daemon (mechanical watchdog) ─────────────────────────────────────
#
# The Daemon is the outermost loop — pure bash, no AI:
# - Runs every SGT_DAEMON_INTERVAL seconds (default 3 min)
# - Calls Boot to check Deacon
# - Writes its own PID for management
# - Can be stopped with: sgt daemon stop

_daemon_loop() {
  local pid=$$
  echo "$pid" > "$SGT_DAEMON_PID"
  log_event "DAEMON_START pid=$pid interval=${SGT_DAEMON_INTERVAL}s"
  echo "[daemon] started (pid $pid, interval ${SGT_DAEMON_INTERVAL}s)"

  # Acquire lock
  exec 200>"$SGT_DAEMON_LOCK"
  if ! flock -n 200; then
    die "another daemon is already running"
  fi

  trap '_daemon_cleanup' EXIT INT TERM

  while true; do
    echo "[daemon] tick at $(date -Iseconds)"

    # Run Boot check
    _boot_check

    sleep "$SGT_DAEMON_INTERVAL"
  done
}

_daemon_cleanup() {
  rm -f "$SGT_DAEMON_PID"
  log_event "DAEMON_STOP"
  echo "[daemon] stopped"
}

cmd_daemon_start() {
  ensure_init

  if [[ -f "$SGT_DAEMON_PID" ]] && kill -0 "$(cat "$SGT_DAEMON_PID")" 2>/dev/null; then
    info "daemon already running (pid $(cat "$SGT_DAEMON_PID"))"
    return
  fi

  # Start in background tmux session
  tmux new-session -d -s "sgt-daemon" \
    "SGT_ROOT='$SGT_ROOT' SGT_DAEMON_INTERVAL='$SGT_DAEMON_INTERVAL' sgt _daemon"

  info "daemon started in tmux session sgt-daemon"
}

cmd_daemon_stop() {
  if [[ -f "$SGT_DAEMON_PID" ]]; then
    local pid
    pid=$(cat "$SGT_DAEMON_PID")
    if kill -0 "$pid" 2>/dev/null; then
      # Kill the tmux session which will trigger cleanup
      tmux kill-session -t "sgt-daemon" 2>/dev/null || kill "$pid" 2>/dev/null || true
      rm -f "$SGT_DAEMON_PID"
      info "daemon stopped"
    else
      rm -f "$SGT_DAEMON_PID"
      info "daemon was not running (stale pid)"
    fi
  else
    # Try killing tmux session directly
    if tmux has-session -t "sgt-daemon" 2>/dev/null; then
      tmux kill-session -t "sgt-daemon"
      info "daemon stopped"
    else
      info "daemon not running"
    fi
  fi
}

cmd_daemon_status() {
  if [[ -f "$SGT_DAEMON_PID" ]] && kill -0 "$(cat "$SGT_DAEMON_PID")" 2>/dev/null; then
    info "daemon running (pid $(cat "$SGT_DAEMON_PID"))"
  else
    info "daemon not running"
  fi
}

# ═══════════════════════════════════════════════════════════════════════
# MAYOR — AI-powered global coordinator
# ═══════════════════════════════════════════════════════════════════════
#
# The Mayor is the brain of SGT. Unlike other agents (pure bash loops),
# the Mayor runs Claude Code periodically to make strategic decisions:
# - Cross-rig coordination (dependencies between issues)
# - Re-prioritize stalled work
# - Dispatch new tasks from a backlog
# - Escalation decisions
# - System health analysis
#
# Runs in tmux, wakes every SGT_MAYOR_INTERVAL seconds.

_mayor_build_briefing() {
  local briefing="$(_mayor_scope_dir)/mayor-briefing.md"
  local briefing_tmp now_iso now_epoch
  now_iso="$(date -Iseconds)"
  now_epoch="$(date +%s)"
  mkdir -p "$(_mayor_scope_dir)"
  briefing_tmp="$(mktemp "$(_mayor_scope_dir)/mayor-briefing.tmp.XXXXXX")"

  cat > "$briefing_tmp" <<HEADER
# SGT System Briefing

You are the Mayor for $(_mayor_scope_display_text) in SGT (Simple GitHub Gastown).
Review this briefing and take action.

generated_at: $now_iso
generated_at_epoch: $now_epoch

HEADER

  # System status
  echo "## System Status" >> "$briefing_tmp"
  echo '```' >> "$briefing_tmp"
  cmd_status 2>&1 >> "$briefing_tmp"
  echo '```' >> "$briefing_tmp"
  echo "" >> "$briefing_tmp"

  # Recent log
  echo "## Recent Activity (last 30 events)" >> "$briefing_tmp"
  echo '```' >> "$briefing_tmp"
  tail -30 "$SGT_LOG" 2>/dev/null >> "$briefing_tmp" || echo "no log" >> "$briefing_tmp"
  echo '```' >> "$briefing_tmp"
  echo "" >> "$briefing_tmp"

  # Merge queue (refinery handles review + merge)
  echo "## Merge Queue (pending refinery review + merge)" >> "$briefing_tmp"
  local mq_count=0
  if [[ -d "$SGT_CONFIG/merge-queue" ]]; then
    for mqf in "$SGT_CONFIG/merge-queue"/*; do
      [[ -f "$mqf" ]] || continue
      mq_count=$((mq_count + 1))
      echo "- $(basename "$mqf"): $(grep '^PR=' "$mqf" | cut -d= -f2)" >> "$briefing_tmp"
    done
  fi
  [[ "$mq_count" -eq 0 ]] && echo "Empty" >> "$briefing_tmp"
  echo "" >> "$briefing_tmp"

  # Open issues across all rigs (sgt-authorized only)
  echo "## Open Issues (scope: $(_mayor_scope_display_text), sgt-authorized)" >> "$briefing_tmp"
  for rig_file in "$SGT_RIGS"/*; do
    [[ -f "$rig_file" ]] || continue
    local rname repo
    rname="$(basename "$rig_file")"
    if _mayor_scope_skip_rig "$rname"; then
      continue
    fi
    repo="$(cat "$rig_file")"
    echo "### $rname ($repo)" >> "$briefing_tmp"
    gh issue list --repo "$repo" --state open --label "sgt-authorized" --json number,title,labels,milestone \
      --jq '.[] | "- #\(.number): \(.title) [\(.labels | map(.name) | join(","))] \(if .milestone then "(" + .milestone.title + ")" else "" end)"' \
      2>/dev/null >> "$briefing_tmp" || echo "  (couldn't fetch)" >> "$briefing_tmp"
    echo "" >> "$briefing_tmp"
  done

  # Open PRs across all rigs
  echo "## Open PRs (scope: $(_mayor_scope_display_text))" >> "$briefing_tmp"
  for rig_file in "$SGT_RIGS"/*; do
    [[ -f "$rig_file" ]] || continue
    local rname repo
    rname="$(basename "$rig_file")"
    if _mayor_scope_skip_rig "$rname"; then
      continue
    fi
    repo="$(cat "$rig_file")"
    echo "### $rname" >> "$briefing_tmp"
    gh pr list --repo "$repo" --state open --json number,title,headRefName,mergeable \
      --jq '.[] | "- PR #\(.number): \(.title) [\(.headRefName)] mergeable=\(.mergeable)"' \
      2>/dev/null >> "$briefing_tmp" || echo "  (couldn't fetch)" >> "$briefing_tmp"
    echo "" >> "$briefing_tmp"
  done

  echo "## Pending Plan Requests" >> "$briefing_tmp"
  local pending_plan_count=0 request_line request_id request_rig request_status request_requested_at request_requester request_prompt_file
  while IFS='|' read -r request_id request_rig request_status request_requested_at request_requester request_prompt_file; do
    [[ -n "$request_id" ]] || continue
    pending_plan_count=$((pending_plan_count + 1))
    echo "### $request_id ($request_rig)" >> "$briefing_tmp"
    echo "- status: $request_status" >> "$briefing_tmp"
    echo "- requested_at: $request_requested_at" >> "$briefing_tmp"
    echo "- requesting_agent: $request_requester" >> "$briefing_tmp"
    echo "- plan_path: $(_plan_file_path "$request_rig")" >> "$briefing_tmp"
    echo "- prompt_excerpt:" >> "$briefing_tmp"
    head -n 12 "$request_prompt_file" 2>/dev/null | sed 's/^/    /' >> "$briefing_tmp" || true
    echo "" >> "$briefing_tmp"
  done < <(_plan_request_list_pending)
  [[ "$pending_plan_count" -eq 0 ]] && echo "None" >> "$briefing_tmp"
  echo "" >> "$briefing_tmp"

  echo "## Repo Plans" >> "$briefing_tmp"
  local plan_count=0 rig_file rname repo plan_path
  for rig_file in "$SGT_RIGS"/*; do
    [[ -f "$rig_file" ]] || continue
    rname="$(basename "$rig_file")"
    if _mayor_scope_skip_rig "$rname"; then
      continue
    fi
    repo="$(cat "$rig_file")"
    plan_path="$(_plan_file_path "$rname")"
    if [[ -f "$plan_path" ]]; then
      plan_count=$((plan_count + 1))
      echo "- $rname: $plan_path" >> "$briefing_tmp"
    fi
  done
  [[ "$plan_count" -eq 0 ]] && echo "None" >> "$briefing_tmp"
  echo "" >> "$briefing_tmp"

  # Escalation config
  if [[ -f "$SGT_ESCALATION" ]]; then
    echo "## Escalation Rules" >> "$briefing_tmp"
    echo '```json' >> "$briefing_tmp"
    cat "$SGT_ESCALATION" >> "$briefing_tmp"
    echo '```' >> "$briefing_tmp"
    echo "" >> "$briefing_tmp"
  fi

  # Mayor history (last decisions)
  if [[ -f "$(_mayor_scope_dir)/mayor-decisions.log" ]]; then
    echo "## Recent Mayor Decisions" >> "$briefing_tmp"
    echo '```' >> "$briefing_tmp"
    tail -20 "$(_mayor_scope_dir)/mayor-decisions.log" >> "$briefing_tmp"
    echo '```' >> "$briefing_tmp"
    echo "" >> "$briefing_tmp"
  fi

  mv -f "$briefing_tmp" "$briefing"
  echo "$briefing"
}

_mayor_briefing_stale_secs() {
  local secs="${SGT_MAYOR_BRIEFING_STALE_SECS:-5}"
  [[ "$secs" =~ ^[0-9]+$ ]] || secs=5
  echo "$secs"
}

_mayor_briefing_snapshot() {
  local briefing="${1:-$(_mayor_scope_dir)/mayor-briefing.md}"
  local stale_secs="${2:-$(_mayor_briefing_stale_secs)}"
  local now_epoch generated_epoch generated_at age status
  now_epoch="$(date +%s)"

  if [[ ! -f "$briefing" ]]; then
    echo "missing|unknown|-1|$stale_secs"
    return 1
  fi

  generated_at="$(awk -F': ' '/^generated_at: / {print $2; exit}' "$briefing" 2>/dev/null || true)"
  generated_epoch="$(awk -F': ' '/^generated_at_epoch: / {print $2; exit}' "$briefing" 2>/dev/null || true)"
  if [[ -z "$generated_at" || -z "$generated_epoch" || ! "$generated_epoch" =~ ^[0-9]+$ ]]; then
    echo "invalid|${generated_at:-unknown}|-1|$stale_secs"
    return 1
  fi

  age=$((now_epoch - generated_epoch))
  (( age < 0 )) && age=0
  if [[ "$age" -gt "$stale_secs" ]]; then
    status="stale"
  else
    status="fresh"
  fi
  echo "${status}|${generated_at}|${age}|${stale_secs}"
  [[ "$status" == "fresh" ]]
}

_mayor_prepare_briefing_for_cycle() {
  local briefing="$(_mayor_scope_dir)/mayor-briefing.md"
  local stale_secs pre_snapshot pre_status pre_generated_at pre_age pre_threshold stale_detected
  local snapshot status generated_at age threshold refresh_attempted path
  stale_secs="$(_mayor_briefing_stale_secs)"
  pre_snapshot="$(_mayor_briefing_snapshot "$briefing" "$stale_secs" || true)"
  IFS='|' read -r pre_status pre_generated_at pre_age pre_threshold <<< "${pre_snapshot:-missing|unknown|-1|$stale_secs}"

  stale_detected="false"
  if [[ "$pre_status" != "fresh" ]]; then
    stale_detected="true"
  fi

  _mayor_build_briefing >/dev/null || return 1
  snapshot="$(_mayor_briefing_snapshot "$briefing" "$stale_secs" || true)"
  IFS='|' read -r status generated_at age threshold <<< "${snapshot:-invalid|unknown|-1|$stale_secs}"

  refresh_attempted="false"
  path="fresh"
  if [[ "$status" != "fresh" ]]; then
    refresh_attempted="true"
    _mayor_build_briefing >/dev/null || return 1
    snapshot="$(_mayor_briefing_snapshot "$briefing" "$stale_secs" || true)"
    IFS='|' read -r status generated_at age threshold <<< "${snapshot:-invalid|unknown|-1|$stale_secs}"
    path="refreshed"
  elif [[ "$stale_detected" == "true" ]]; then
    path="refreshed"
  fi

  if [[ "$status" != "fresh" ]]; then
    path="aborted"
    log_event "MAYOR_BRIEFING_GATE stale_detected=$stale_detected path=$path status=$status generated_at=\"$(_escape_quotes "${generated_at:-unknown}")\" age=${age:-unknown}s threshold=${stale_secs}s refresh_attempted=$refresh_attempted pre_status=$pre_status pre_generated_at=\"$(_escape_quotes "${pre_generated_at:-unknown}")\" pre_age=${pre_age:-unknown}s"
    echo "${briefing}|${status}|${generated_at:-unknown}|${age:-1}|${stale_secs}|${stale_detected}|${path}"
    return 1
  fi

  log_event "MAYOR_BRIEFING_GATE stale_detected=$stale_detected path=$path status=$status generated_at=\"$(_escape_quotes "${generated_at:-unknown}")\" age=${age:-unknown}s threshold=${stale_secs}s refresh_attempted=$refresh_attempted pre_status=$pre_status pre_generated_at=\"$(_escape_quotes "${pre_generated_at:-unknown}")\" pre_age=${pre_age:-unknown}s"
  echo "${briefing}|${status}|${generated_at:-unknown}|${age:-1}|${stale_secs}|${stale_detected}|${path}"
}

_mayor_live_status_briefing_fallback() {
  local briefing_path="${1:-$(_mayor_scope_dir)/mayor-briefing.md}"
  local now_iso now_epoch deacon_session hb_age hb_ts hb_state hb_stale_secs hb_health deacon_badge
  local merge_queue_depth active_polecats

  now_iso="$(date -Iseconds)"
  now_epoch="$(date +%s)"

  deacon_session="off"
  tmux has-session -t "sgt-deacon" 2>/dev/null && deacon_session="on"
  hb_stale_secs="$(_deacon_heartbeat_stale_secs)"
  IFS='|' read -r hb_age hb_ts hb_state <<< "$(_deacon_heartbeat_snapshot)"
  hb_health="$(_deacon_heartbeat_health "$hb_age" "$hb_stale_secs")"
  deacon_badge="$deacon_session"
  if [[ "$deacon_session" == "on" && "$hb_health" != "healthy" ]]; then
    deacon_badge="degraded"
  fi

  merge_queue_depth="$(_mayor_merge_queue_count_for_rig)"
  [[ "$merge_queue_depth" =~ ^[0-9]+$ ]] || merge_queue_depth=0
  active_polecats="$(_active_polecat_count)"
  [[ "$active_polecats" =~ ^[0-9]+$ ]] || active_polecats=0

  cat <<EOF
# SGT System Briefing (fallback)

You are the Mayor for $(_mayor_scope_display_text) in SGT (Simple GitHub Gastown).
Primary briefing file was unavailable; use this live fallback summary for the current cycle.

generated_at: $now_iso
generated_at_epoch: $now_epoch
fallback_reason: briefing-unavailable
fallback_path: $briefing_path

## Live Status Summary
- deacon_status: $deacon_badge (session=$deacon_session heartbeat_state=${hb_state:-unknown} heartbeat_health=${hb_health:-unknown} heartbeat_age_seconds=${hb_age:-unknown} stale_after_seconds=${hb_stale_secs:-unknown})
- merge_queue_depth: $merge_queue_depth
- active_polecats: $active_polecats

## System Status (live)
\`\`\`
$(cmd_status 2>&1 || true)
\`\`\`
EOF
}

_mayor_briefing_content_for_prompt() {
  local briefing_path="${1:-$(_mayor_scope_dir)/mayor-briefing.md}"
  local content
  if content="$(cat "$briefing_path" 2>/dev/null)"; then
    printf '%s\n' "$content"
    return 0
  fi
  log_event "MAYOR_BRIEFING_FALLBACK reason=briefing-unavailable path=\"$(_escape_quotes "$briefing_path")\""
  _mayor_live_status_briefing_fallback "$briefing_path"
}

_mayor_ai_cycle_timeout_secs() {
  local raw="${SGT_MAYOR_AI_CYCLE_TIMEOUT_SECS:-300}"
  if [[ ! "$raw" =~ ^[0-9]+$ || "$raw" -eq 0 ]]; then
    raw=300
  fi
  echo "$raw"
}

_mayor_ai_cycle_reason_code_for_exit() {
  local rc="${1:-1}"
  if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
    echo "decision-timebox-exceeded"
  else
    echo "decision-run-error"
  fi
}

_mayor_ai_cycle_observability_state_read() {
  local state_file="${SGT_MAYOR_AI_OBSERVABILITY_STATE:-$SGT_CONFIG/mayor-ai-observability.state}"
  local total_invocations="" total_success="" total_fail="" total_timeout="" total_error=""
  local consecutive_timeout="" consecutive_error="" consecutive_fail="" last_reason_code="" last_outcome=""
  if [[ -f "$state_file" ]]; then
    total_invocations="$(awk -F= '$1=="totalInvocations"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    total_success="$(awk -F= '$1=="totalSuccess"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    total_fail="$(awk -F= '$1=="totalFail"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    total_timeout="$(awk -F= '$1=="totalTimeout"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    total_error="$(awk -F= '$1=="totalError"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    consecutive_timeout="$(awk -F= '$1=="consecutiveTimeout"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    consecutive_error="$(awk -F= '$1=="consecutiveError"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    consecutive_fail="$(awk -F= '$1=="consecutiveFail"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    last_reason_code="$(awk -F= '$1=="lastReasonCode"{print $2; exit}' "$state_file" 2>/dev/null || true)"
    last_outcome="$(awk -F= '$1=="lastOutcome"{print $2; exit}' "$state_file" 2>/dev/null || true)"
  fi
  [[ "$total_invocations" =~ ^[0-9]+$ ]] || total_invocations=0
  [[ "$total_success" =~ ^[0-9]+$ ]] || total_success=0
  [[ "$total_fail" =~ ^[0-9]+$ ]] || total_fail=0
  [[ "$total_timeout" =~ ^[0-9]+$ ]] || total_timeout=0
  [[ "$total_error" =~ ^[0-9]+$ ]] || total_error=0
  [[ "$consecutive_timeout" =~ ^[0-9]+$ ]] || consecutive_timeout=0
  [[ "$consecutive_error" =~ ^[0-9]+$ ]] || consecutive_error=0
  [[ "$consecutive_fail" =~ ^[0-9]+$ ]] || consecutive_fail=0
  [[ -n "$last_reason_code" ]] || last_reason_code="none"
  [[ -n "$last_outcome" ]] || last_outcome="none"

  echo "${total_invocations}|${total_success}|${total_fail}|${total_timeout}|${total_error}|${consecutive_timeout}|${consecutive_error}|${consecutive_fail}|${last_reason_code}|${last_outcome}"
}

_mayor_ai_cycle_observability_state_write() {
  local total_invocations="${1:-0}" total_success="${2:-0}" total_fail="${3:-0}" total_timeout="${4:-0}" total_error="${5:-0}"
  local consecutive_timeout="${6:-0}" consecutive_error="${7:-0}" consecutive_fail="${8:-0}" last_reason_code="${9:-none}" last_outcome="${10:-none}"
  local state_file="${SGT_MAYOR_AI_OBSERVABILITY_STATE:-$SGT_CONFIG/mayor-ai-observability.state}"
  local state_tmp="${state_file}.tmp.$$"

  cat > "$state_tmp" <<EOF
totalInvocations=$total_invocations
totalSuccess=$total_success
totalFail=$total_fail
totalTimeout=$total_timeout
totalError=$total_error
consecutiveTimeout=$consecutive_timeout
consecutiveError=$consecutive_error
consecutiveFail=$consecutive_fail
lastReasonCode=$last_reason_code
lastOutcome=$last_outcome
EOF
  mv "$state_tmp" "$state_file"
}

_mayor_ai_cycle_observability_record() {
  local outcome="${1:-error}" reason_code="${2:-none}"
  local total_invocations total_success total_fail total_timeout total_error
  local consecutive_timeout consecutive_error consecutive_fail last_reason_code last_outcome
  IFS='|' read -r total_invocations total_success total_fail total_timeout total_error consecutive_timeout consecutive_error consecutive_fail last_reason_code last_outcome <<< "$(_mayor_ai_cycle_observability_state_read)"

  total_invocations=$((total_invocations + 1))
  if [[ "$outcome" == "success" ]]; then
    total_success=$((total_success + 1))
    consecutive_timeout=0
    consecutive_error=0
    consecutive_fail=0
    reason_code="none"
  else
    total_fail=$((total_fail + 1))
    consecutive_fail=$((consecutive_fail + 1))
    case "$reason_code" in
      decision-timebox-exceeded)
        total_timeout=$((total_timeout + 1))
        consecutive_timeout=$((consecutive_timeout + 1))
        consecutive_error=0
        ;;
      decision-run-error)
        total_error=$((total_error + 1))
        consecutive_error=$((consecutive_error + 1))
        consecutive_timeout=0
        ;;
      *)
        consecutive_timeout=0
        consecutive_error=0
        ;;
    esac
  fi

  _mayor_ai_cycle_observability_state_write \
    "$total_invocations" \
    "$total_success" \
    "$total_fail" \
    "$total_timeout" \
    "$total_error" \
    "$consecutive_timeout" \
    "$consecutive_error" \
    "$consecutive_fail" \
    "$reason_code" \
    "$outcome" || true

  printf 'outcome=%s reason_code=%s totals{i=%s,ok=%s,fail=%s,timeout=%s,error=%s} streak{fail=%s,timeout=%s,error=%s}' \
    "$outcome" \
    "$reason_code" \
    "$total_invocations" \
    "$total_success" \
    "$total_fail" \
    "$total_timeout" \
    "$total_error" \
    "$consecutive_fail" \
    "$consecutive_timeout" \
    "$consecutive_error"
}

_mayor_ai_cycle_state_write() {
  local status="${1:-running}"
  local started_at="${2:-unknown}"
  local timeout_secs="${3:-$(_mayor_ai_cycle_timeout_secs)}"
  local backend="${4:-unknown}"
  local workspace="${5:-unknown}"
  local state_file="${SGT_MAYOR_AI_CYCLE_STATE:-$SGT_CONFIG/mayor-ai-cycle.state}"
  local state_tmp="${state_file}.tmp.$$"

  cat > "$state_tmp" <<EOF
status=$status
pid=$$
startedAt=$started_at
timeoutSecs=$timeout_secs
backend=$backend
workspace=$workspace
EOF
  mv "$state_tmp" "$state_file"
}

_mayor_ai_cycle_state_clear() {
  local state_file="${SGT_MAYOR_AI_CYCLE_STATE:-$SGT_CONFIG/mayor-ai-cycle.state}"
  rm -f "$state_file"
}

_mayor_run_ai_decision_cycle() {
  local backend="$1"
  local mayor_workspace="$2"
  local dispatch_snapshot_file="$3"
  local ai_dispatch_trigger_key="${4:-}"
  local ai_dispatch_trigger_reason="${5:-}"
  local timeout_secs started_at started_epoch finished_epoch duration rc
  local reason_code recovery_hint
  local digest_line

  timeout_secs="$(_mayor_ai_cycle_timeout_secs)"
  started_at="$(date -Iseconds)"
  started_epoch="$(date +%s)"
  recovery_hint="inspect AI backend health, then run: sgt wake-mayor \"manual-retry\""

  _mayor_ai_cycle_state_write "running" "$started_at" "$timeout_secs" "$backend" "$mayor_workspace" || true
  log_event "MAYOR_AI_CYCLE_START timeout=${timeout_secs}s backend=$backend workspace=\"$(_escape_quotes "$mayor_workspace")\" trigger_key=\"$(_escape_quotes "${ai_dispatch_trigger_key:-none}")\" trigger_reason=\"$(_escape_quotes "${ai_dispatch_trigger_reason:-none}")\""

  timeout "$timeout_secs" env \
    SGT_MAYOR_DISPATCH_REVALIDATE=1 \
    SGT_MAYOR_ACTION_FENCE=1 \
    SGT_MAYOR_DISPATCH_SNAPSHOT_FILE="$dispatch_snapshot_file" \
    SGT_MAYOR_DISPATCH_TRIGGER_KEY="$ai_dispatch_trigger_key" \
    SGT_MAYOR_DISPATCH_TRIGGER_REASON="$ai_dispatch_trigger_reason" \
    bash -lc "$(declare -f _ai_prompt); _ai_prompt \"\$1\" \"\$2\" \"\$3\"" _ \
      "$backend" \
      "$mayor_workspace" \
      "Read CLAUDE.md. Handle the issues described. Be decisive and fast. Log your actions." \
    </dev/null 2>&1 | tail -5
  rc=$?

  finished_epoch="$(date +%s)"
  duration=$((finished_epoch - started_epoch))
  if (( duration < 0 )); then
    duration=0
  fi

  if [[ "$rc" -eq 0 ]]; then
    digest_line="$(_mayor_ai_cycle_observability_record "success" "none")"
    _mayor_ai_cycle_state_clear || true
    log_event "MAYOR_AI_CYCLE completed duration=${duration}s timeout=${timeout_secs}s"
    log_event "MAYOR_AI_CYCLE_DIGEST $digest_line"
    _mayor_record_decision "MAYOR AI CYCLE DIGEST $digest_line" "ai-cycle-digest" "$SGT_ROOT" || true
    echo "[mayor] AI decision cycle complete"
    return 0
  fi

  reason_code="$(_mayor_ai_cycle_reason_code_for_exit "$rc")"
  digest_line="$(_mayor_ai_cycle_observability_record "fail" "$reason_code")"
  _mayor_record_decision "MAYOR AI CYCLE FAIL_CLOSED reason_code=$reason_code exit_code=$rc timeout=${timeout_secs}s duration=${duration}s recovery_hint=\"$(_escape_quotes "$recovery_hint")\"" "ai-cycle-fail-closed" "$SGT_ROOT" || true
  _mayor_record_decision "MAYOR AI CYCLE DIGEST $digest_line" "ai-cycle-digest" "$SGT_ROOT" || true
  log_event "MAYOR_AI_CYCLE_FAIL_CLOSED reason_code=$reason_code exit_code=$rc timeout=${timeout_secs}s duration=${duration}s recovery_hint=\"$(_escape_quotes "$recovery_hint")\" action=release-lock-and-reset-cycle-state"
  log_event "MAYOR_AI_CYCLE_DIGEST $digest_line"
  _mayor_ai_cycle_state_clear || true
  _mayor_lock_release "$$" || true
  echo "[mayor] AI cycle failed closed (reason_code=$reason_code exit_code=$rc timeout=${timeout_secs}s) — $recovery_hint"
  return 1
}

_mayor_wake_summary() {
  local reason="$1"
  local summary=""

  if [[ -z "$reason" || "$reason" == "periodic" ]]; then
    echo ""
    return 0
  fi

  if [[ "$reason" =~ ^merged:pr#([0-9]+):#([0-9]+):([^|]+)\| ]]; then
    local pr issue rig repo title pr_url issue_url
    pr="${BASH_REMATCH[1]}"
    issue="${BASH_REMATCH[2]}"
    rig="${BASH_REMATCH[3]}"
    repo="$(_wake_field "$reason" "repo")"
    title="$(_escape_quotes "$(_wake_field "$reason" "title")")"
    pr_url="$(_wake_field "$reason" "pr_url")"
    issue_url="$(_wake_field "$reason" "issue_url")"
    summary="merged PR #$pr (issue #$issue, rig $rig) | rig=$rig repo=${repo:-unknown} pr=#$pr title=\"${title:-unknown}\" issue=#$issue pr_url=${pr_url:-unknown} issue_url=${issue_url:-unknown}"
  elif [[ "$reason" =~ ^merged:pr#([0-9]+):#([0-9]+):(.+)$ ]]; then
    summary="merged PR #${BASH_REMATCH[1]} (issue #${BASH_REMATCH[2]}, rig ${BASH_REMATCH[3]})"
  elif [[ "$reason" =~ ^merged:pr#([0-9]+):#([0-9]+)\| ]]; then
    local pr issue rig repo title pr_url issue_url
    pr="${BASH_REMATCH[1]}"
    issue="${BASH_REMATCH[2]}"
    rig="$(_wake_field "$reason" "rig")"
    repo="$(_wake_field "$reason" "repo")"
    title="$(_escape_quotes "$(_wake_field "$reason" "title")")"
    pr_url="$(_wake_field "$reason" "pr_url")"
    issue_url="$(_wake_field "$reason" "issue_url")"
    summary="merged PR #$pr (issue #$issue, rig ${rig:-unknown}) | rig=${rig:-unknown} repo=${repo:-unknown} pr=#$pr title=\"${title:-unknown}\" issue=#$issue pr_url=${pr_url:-unknown} issue_url=${issue_url:-unknown}"
  elif [[ "$reason" =~ ^merged:pr#([0-9]+):#([0-9]+)$ ]]; then
    summary="merged PR #${BASH_REMATCH[1]} (issue #${BASH_REMATCH[2]})"
  elif [[ "$reason" =~ ^dog-approved:([^:]+):#([0-9]+):([^|]+)\| ]]; then
    local dname issue rig repo title issue_url
    dname="${BASH_REMATCH[1]}"
    issue="${BASH_REMATCH[2]}"
    rig="${BASH_REMATCH[3]}"
    repo="$(_wake_field "$reason" "repo")"
    title="$(_escape_quotes "$(_wake_field "$reason" "title")")"
    issue_url="$(_wake_field "$reason" "issue_url")"
    summary="dog approved $dname (issue #$issue, rig $rig) | rig=$rig repo=${repo:-unknown} title=\"${title:-unknown}\" issue=#$issue issue_url=${issue_url:-unknown}"
  elif [[ "$reason" =~ ^dog-approved:([^:]+):#([0-9]+):(.+)$ ]]; then
    summary="dog approved ${BASH_REMATCH[1]} (issue #${BASH_REMATCH[2]}, rig ${BASH_REMATCH[3]})"
  elif [[ "$reason" =~ ^dog-approved:([^:]+):#([0-9]+)$ ]]; then
    summary="dog approved ${BASH_REMATCH[1]} (issue #${BASH_REMATCH[2]})"
  elif [[ "$reason" =~ ^orphan-pr:#([0-9]+):(.+)$ ]]; then
    summary="orphan PR #${BASH_REMATCH[1]} queued (rig ${BASH_REMATCH[2]})"
  elif [[ "$reason" =~ ^orphan-pr:#([0-9]+)$ ]]; then
    summary="orphan PR #${BASH_REMATCH[1]} queued"
  else
    summary="wake: $reason"
  fi

  echo "$summary"
}

_mayor_cleanup() {
  _mayor_ai_cycle_state_clear || true
  _mayor_lock_release "$$" || true
}

_mayor_exit_receipt() {
  local exit_code="${1:-0}" signal="${2:-EXIT}"
  local reason_code="clean-exit" unexpected="false" decision_context="mayor-stop"
  local last_cycle_ts last_cycle_at last_cycle_trigger last_cycle_status

  if [[ "${_MAYOR_EXIT_RECEIPT_LOGGED:-0}" == "1" ]]; then
    return 0
  fi
  _MAYOR_EXIT_RECEIPT_LOGGED=1

  case "$signal" in
    TERM)
      reason_code="signal-term"
      ;;
    INT)
      reason_code="signal-int"
      ;;
    EXIT)
      if [[ "$exit_code" -ne 0 ]]; then
        reason_code="nonzero-exit"
      fi
      ;;
    *)
      reason_code="signal-${signal,,}"
      ;;
  esac

  if [[ "$reason_code" == "nonzero-exit" ]]; then
    unexpected="true"
    decision_context="mayor-stop-unexpected"
  fi

  if [[ -n "${_MAYOR_EXIT_REASON_OVERRIDE:-}" ]]; then
    reason_code="${_MAYOR_EXIT_REASON_OVERRIDE}"
    decision_context="${_MAYOR_EXIT_DECISION_CONTEXT_OVERRIDE:-mayor-stop}"
    if [[ -n "${_MAYOR_EXIT_UNEXPECTED_OVERRIDE:-}" ]]; then
      unexpected="${_MAYOR_EXIT_UNEXPECTED_OVERRIDE}"
    elif [[ "$exit_code" -eq 0 ]]; then
      unexpected="false"
    fi
  fi

  IFS='|' read -r last_cycle_ts last_cycle_at last_cycle_trigger last_cycle_status <<< "$(_mayor_last_cycle_state_read)"
  _mayor_exit_state_write "$reason_code" "$exit_code" "$signal" "$unexpected" "$$" "$last_cycle_trigger" "$last_cycle_at" "$last_cycle_status"
  log_event "MAYOR_STOP reason_code=$reason_code exit_code=$exit_code signal=$signal unexpected=$unexpected last_cycle_trigger=\"$(_escape_quotes "${last_cycle_trigger:-unknown}")\" last_cycle_status=${last_cycle_status:-unknown} last_cycle_at=\"$(_escape_quotes "${last_cycle_at:-unknown}")\""
  _mayor_record_decision "MAYOR STOP reason_code=$reason_code exit_code=$exit_code signal=$signal unexpected=$unexpected last_cycle_trigger=${last_cycle_trigger:-unknown} last_cycle_status=${last_cycle_status:-unknown} last_cycle_at=\"${last_cycle_at:-unknown}\"" "$decision_context" "$SGT_ROOT" || true
}

_witness_record_stalled_followup() {
  local rig="${1:-}" repo="${2:-}" issue_number="${3:-}" issue_title="${4:-}" polecat_name="${5:-}" reason_code="${6:-witness-stalled-resling-failed}"
  local requester title evidence blocker_id owner_repo issue_url comment_body

  [[ -n "$rig" && -n "$repo" && -n "$issue_number" && -n "$polecat_name" ]] || return 1

  requester="witness"
  owner_repo="$(_repo_owner_repo "$repo")"
  issue_url="$(_repo_issue_url "$repo" "$issue_number")"
  title="Replacement work required after stalled polecat for issue #$issue_number"
  printf -v evidence '%s\n\nStalled polecat recovery did not produce replacement work.\n\n- Rig: %s\n- Repo: %s\n- Issue: #%s\n- Issue URL: %s\n- Issue title: %s\n- Polecat: %s\n- Failure reason: %s\n\nRequired follow-up:\n- create replacement work (new PR or re-dispatched polecat) before closing the incident\n- re-investigate why the worker exited without producing a PR\n' \
    "$title" \
    "$rig" \
    "${owner_repo:-$repo}" \
    "$issue_number" \
    "${issue_url:-unknown}" \
    "${issue_title:-unknown}" \
    "$polecat_name" \
    "$reason_code"

  blocker_id="$(_acceptance_blocker_write "$rig" "$evidence" "$requester" "$reason_code" 2>/dev/null || true)"
  if [[ -n "$blocker_id" ]]; then
    _context_append_acceptance_blocker "$rig" "$blocker_id" "$requester" "$title" "$evidence" || true
    if [[ -n "${OPENAI_API_KEY:-}" ]] && [[ -n "$(_context_python_bin)" ]]; then
      _context_index_build "$rig" >/dev/null 2>&1 || true
    fi
    _wake_mayor "acceptance-blocker:${rig}:${blocker_id}"
    comment_body="[sgt-witness] Polecat \`$polecat_name\` stalled and automatic re-dispatch failed. Recorded acceptance blocker \`$blocker_id\` and notified mayor. Do not close this incident without replacement work item/PR."
    log_event "WITNESS_STALLED_FOLLOWUP_REQUIRED polecat=$polecat_name rig=$rig issue=#$issue_number blocker_id=$blocker_id reason_code=$reason_code repo=$(_escape_quotes "${owner_repo:-$repo}")"
  else
    comment_body="[sgt-witness] Polecat \`$polecat_name\` stalled and automatic re-dispatch failed. Mayor has been notified for manual replacement work. Do not close this incident without replacement work item/PR."
    _wake_mayor "stalled-unreplaced:${rig}:#${issue_number}"
    log_event "WITNESS_STALLED_FOLLOWUP_REQUIRED polecat=$polecat_name rig=$rig issue=#$issue_number blocker_id=unavailable reason_code=$reason_code repo=$(_escape_quotes "${owner_repo:-$repo}")"
  fi

  gh issue comment "$issue_number" --repo "$repo" --body "$comment_body" 2>/dev/null || true
  return 0
}

_witness_record_backend_limit_followup() {
  local rig="${1:-}" repo="${2:-}" issue_number="${3:-}" issue_title="${4:-}" polecat_name="${5:-}" backend="${6:-unknown}" reason_code="${7:-backend_usage_limit}" matched_text="${8:-}"
  local requester title evidence blocker_id owner_repo issue_url comment_body

  [[ -n "$rig" && -n "$repo" && -n "$issue_number" && -n "$polecat_name" ]] || return 1

  requester="witness"
  owner_repo="$(_repo_owner_repo "$repo")"
  issue_url="$(_repo_issue_url "$repo" "$issue_number")"
  title="Polecat blocked by backend usage limit for issue #$issue_number"
  printf -v evidence '%s\n\nA polecat hit a known backend/quota limit before opening a PR.\n\n- Rig: %s\n- Repo: %s\n- Issue: #%s\n- Issue URL: %s\n- Issue title: %s\n- Polecat: %s\n- Backend: %s\n- Reason code: %s\n- Matched first output: %s\n\nRequired follow-up:\n- leave this issue blocked until backend quota resets or an operator explicitly changes backend policy\n- do not auto-resling while the issue is marked backend-limited\n' \
    "$title" \
    "$rig" \
    "${owner_repo:-$repo}" \
    "$issue_number" \
    "${issue_url:-unknown}" \
    "${issue_title:-unknown}" \
    "$polecat_name" \
    "$backend" \
    "$reason_code" \
    "${matched_text:-unknown}"

  _ensure_labels_exist "$repo" "backend-limited" "${backend}-usage-limit" >/dev/null 2>&1 || true
  gh issue edit "$issue_number" --repo "$repo" --add-label "backend-limited" --add-label "${backend}-usage-limit" >/dev/null 2>&1 || true

  blocker_id="$(_acceptance_blocker_write "$rig" "$evidence" "$requester" "$reason_code" 2>/dev/null || true)"
  if [[ -n "$blocker_id" ]]; then
    _context_append_acceptance_blocker "$rig" "$blocker_id" "$requester" "$title" "$evidence" || true
    if [[ -n "${OPENAI_API_KEY:-}" ]] && [[ -n "$(_context_python_bin)" ]]; then
      _context_index_build "$rig" >/dev/null 2>&1 || true
    fi
    _wake_mayor "acceptance-blocker:${rig}:${blocker_id}"
    comment_body="[sgt-witness] Polecat \`$polecat_name\` hit a known backend limit before opening a PR. Marked the issue backend-limited with reason_code=\`$reason_code\` on backend \`$backend\` after matching first output \`$matched_text\`. Recorded acceptance blocker \`$blocker_id\` and notified mayor. Do not auto-resling until quota resets or backend policy changes."
    log_event "WITNESS_BACKEND_LIMIT_BLOCKED polecat=$polecat_name rig=$rig issue=#$issue_number blocker_id=$blocker_id backend=$backend reason_code=$reason_code repo=$(_escape_quotes "${owner_repo:-$repo}") match=\"$(_escape_quotes "${matched_text:-}")\""
  else
    comment_body="[sgt-witness] Polecat \`$polecat_name\` hit a known backend limit before opening a PR. Marked the issue backend-limited with reason_code=\`$reason_code\` on backend \`$backend\` after matching first output \`$matched_text\`. Mayor has been notified. Do not auto-resling until quota resets or backend policy changes."
    _wake_mayor "backend-limit:${rig}:#${issue_number}"
    log_event "WITNESS_BACKEND_LIMIT_BLOCKED polecat=$polecat_name rig=$rig issue=#$issue_number blocker_id=unavailable backend=$backend reason_code=$reason_code repo=$(_escape_quotes "${owner_repo:-$repo}") match=\"$(_escape_quotes "${matched_text:-}")\""
  fi

  gh issue comment "$issue_number" --repo "$repo" --body "$comment_body" 2>/dev/null || true
  return 0
}

_mayor_loop() {
  set +e  # Mayor loop must never exit on errors
  _mayor_scope_apply "${SGT_MAYOR_SCOPE_RIG:-}"
  local lock_claim lock_rc lock_decision lock_owner lock_started lock_until lock_reason
  lock_claim="$(_mayor_lock_claim)"
  lock_rc=$?
  IFS='|' read -r lock_decision lock_owner lock_started lock_until lock_reason <<< "$lock_claim"
  if [[ "$lock_rc" -ne 0 ]]; then
    echo "[mayor] lock decision: ${lock_decision} (ownerPid=${lock_owner:-unknown} startedAt=${lock_started:-unknown} leaseUntil=${lock_until:-unknown} reason=${lock_reason:-unknown})"
    log_event "MAYOR_LOCK_DECISION decision=${lock_decision} ownerPid=${lock_owner:-unknown} startedAt=${lock_started:-unknown} leaseUntil=${lock_until:-unknown} reason=${lock_reason:-unknown}"
    return 0
  fi
  echo "[mayor] lock decision: ${lock_decision} (ownerPid=${lock_owner} startedAt=${lock_started} leaseUntil=${lock_until} reason=${lock_reason})"
  log_event "MAYOR_LOCK_DECISION decision=${lock_decision} ownerPid=${lock_owner} startedAt=${lock_started} leaseUntil=${lock_until} reason=${lock_reason}"
  _MAYOR_EXIT_RECEIPT_LOGGED=0
  trap 'rc=$?; _mayor_cleanup; _mayor_exit_receipt "$rc" "EXIT"' EXIT
  trap '_mayor_cleanup; _mayor_exit_receipt 143 "TERM"; exit 143' TERM
  trap '_mayor_cleanup; _mayor_exit_receipt 130 "INT"; exit 130' INT

  local wake_dedupe_ttl
  wake_dedupe_ttl="$(_mayor_wake_dedupe_ttl_secs)"
  local -A wake_seen_at=()
  local cycle_count=0

  # Set up FIFO for event-driven wake
  [[ -p "$SGT_MAYOR_FIFO" ]] || mkfifo "$SGT_MAYOR_FIFO"
  # Open FIFO read-write on fd 3 to prevent blocking on open()
  exec 3<>"$SGT_MAYOR_FIFO"
  _mayor_start_receipt_write "${SGT_MAYOR_START_TOKEN:-unknown}" "$$" || true
  _mayor_start_failure_state_clear || true
  _mayor_exit_state_clear || true
  _mayor_heartbeat_write "startup" "startup" "$cycle_count" || true
  log_event "MAYOR_START"
  echo "[mayor] started — event-driven (fallback every ${SGT_MAYOR_INTERVAL}s)"

  while true; do
    lock_claim="$(_mayor_lock_claim)"
    lock_rc=$?
    IFS='|' read -r lock_decision lock_owner lock_started lock_until lock_reason <<< "$lock_claim"
    if [[ "$lock_rc" -ne 0 ]]; then
      echo "[mayor] lock decision: ${lock_decision} (ownerPid=${lock_owner:-unknown} startedAt=${lock_started:-unknown} leaseUntil=${lock_until:-unknown} reason=${lock_reason:-unknown})"
      log_event "MAYOR_LOCK_DECISION decision=${lock_decision} ownerPid=${lock_owner:-unknown} startedAt=${lock_started:-unknown} leaseUntil=${lock_until:-unknown} reason=${lock_reason:-unknown}"
      break
    fi
    if [[ "$lock_decision" == "reused" || "$lock_decision" == "stolen" || "$lock_decision" == "acquired" ]]; then
      echo "[mayor] lock decision: ${lock_decision} (ownerPid=${lock_owner} startedAt=${lock_started} leaseUntil=${lock_until} reason=${lock_reason})"
      log_event "MAYOR_LOCK_DECISION decision=${lock_decision} ownerPid=${lock_owner} startedAt=${lock_started} leaseUntil=${lock_until} reason=${lock_reason}"
    fi

    # Block on fd 3 with timeout — wakes on event OR periodic check
    local wake_reason=""
    local wake_events=()
    local cycle_events=()
    local -A cycle_target_rigs=()
    read -t "$SGT_MAYOR_INTERVAL" -u 3 wake_reason 2>/dev/null || true
    if [[ -n "$wake_reason" ]]; then
      echo "[mayor] woken by event: $wake_reason"
      wake_events+=("$wake_reason")
      # Drain any queued events (coalesce rapid-fire wakes)
      local extra=""
      while read -t 0.1 -u 3 extra 2>/dev/null; do
        echo "[mayor] coalescing event: $extra"
        wake_events+=("$extra")
      done
      local deduped_event=""
      while IFS= read -r deduped_event; do
        [[ -n "$deduped_event" ]] || continue
        cycle_events+=("$deduped_event")
      done < <(_dedupe_wake_reasons "${wake_events[@]+"${wake_events[@]}"}")
      wake_reason="${cycle_events[0]}"
    else
      echo "[mayor] periodic check at $(date -Iseconds)"
      wake_reason="periodic"
    fi
    cycle_count=$((cycle_count + 1))
    _mayor_heartbeat_write "cycle-begin" "$wake_reason" "$cycle_count" || true

    local needs_ai=false
    local ai_dispatch_trigger_key=""
    local ai_dispatch_trigger_reason=""
    local issues_found=""
    local actions_taken=""
    local notify_rigger=""
    local snapshot_freshness=""
    local review_watchdog_notes=""

    if [[ "$wake_reason" != "periodic" ]]; then
      local event_reason wake_summary event_key now_ts last_seen age skip_reason claim_rc duplicate_key target_rig
      for event_reason in "${cycle_events[@]+"${cycle_events[@]}"}"; do
        target_rig="$(_mayor_wake_reason_rig "$event_reason")"
        if [[ -n "$target_rig" ]]; then
          if _mayor_rig_manually_hibernated "$target_rig"; then
            actions_taken+="  - kept manually hibernated rig $target_rig asleep (event=$event_reason)\n"
          else
            cycle_target_rigs["$target_rig"]=1
            if _mayor_rig_maybe_unhibernate_for_event "$target_rig" "$event_reason"; then
              actions_taken+="  - auto-woke hibernated rig $target_rig (event=$event_reason)\n"
            fi
          fi
        fi
        event_key="$(_wake_trigger_key "$event_reason")"
        now_ts="$(date +%s)"
        if [[ -n "$event_key" ]]; then
          last_seen="${wake_seen_at[$event_key]:-}"
        else
          last_seen=""
        fi
        if [[ -n "$event_key" && "$wake_dedupe_ttl" -gt 0 ]] && _wake_trigger_should_suppress "$last_seen" "$now_ts" "$wake_dedupe_ttl"; then
          local ttl_remaining prior_decision_ts
          age=$((now_ts - last_seen))
          ttl_remaining=$((wake_dedupe_ttl - age))
          if [[ "$ttl_remaining" -lt 0 ]]; then
            ttl_remaining=0
          fi
          prior_decision_ts="$last_seen"
          skip_reason="dispatch cooldown active (reason=dispatch_cooldown trigger_key=$event_key age=${age}s ttl=${wake_dedupe_ttl}s ttl_remaining=${ttl_remaining}s prior_decision_ts=${prior_decision_ts})"
          echo "[mayor] wake skipped - $skip_reason"
          log_event "MAYOR_DISPATCH_COOLDOWN_SUPPRESSED reason=dispatch_cooldown trigger_key=\"$(_escape_quotes "$event_key")\" ttl_remaining=${ttl_remaining}s prior_decision_ts=${prior_decision_ts} wake=\"$(_escape_quotes "$event_reason")\""
          _mayor_notify_rigger "mayor skip: $skip_reason"
          _mayor_record_decision "MAYOR WAKE SKIP reason=dispatch_cooldown trigger_key=$event_key ttl_remaining=${ttl_remaining}s prior_decision_ts=${prior_decision_ts} wake=$event_reason" "dispatch-cooldown-skip" "$SGT_ROOT" || true
          continue
        fi
        if [[ -n "$event_key" ]]; then
          wake_seen_at["$event_key"]="$now_ts"
        fi
        local suppress_wake_summary="false"
        # Trigger at most one AI dispatch decision per cycle, even if
        # merged/dog-approved wake events are replayed within that cycle.
        if _wake_requires_dispatch_decision "$event_reason"; then
          if [[ "$event_reason" == merged:* ]]; then
            if _mayor_dispatch_trigger_claim "$event_reason"; then
              needs_ai=true
              if [[ -z "$ai_dispatch_trigger_key" ]]; then
                ai_dispatch_trigger_key="$(_wake_trigger_key "$event_reason")"
                ai_dispatch_trigger_reason="$(_wake_trigger_key "$event_reason")"
              fi
            else
              claim_rc=$?
              if [[ "$claim_rc" -eq 1 ]]; then
                local duplicate_key duplicate_reason_code duplicate_reason duplicate_event_key duplicate_repo duplicate_pr duplicate_issue duplicate_rig duplicate_merged_head
                duplicate_key="${_MAYOR_DISPATCH_TRIGGER_KEY:-unknown}"
                duplicate_reason_code="duplicate-dispatch-trigger-key"
                duplicate_reason="duplicate merged dispatch trigger key (repo+pr+merged_head) already claimed"
                duplicate_event_key="$(_wake_trigger_key "$event_reason")"
                duplicate_repo="$(_wake_field "$event_reason" "repo")"
                duplicate_merged_head="$(_wake_field "$event_reason" "merged_head")"
                duplicate_pr=""
                duplicate_issue=""
                duplicate_rig=""
                if [[ "$event_reason" =~ ^merged:pr#([0-9]+):#([0-9]+):([^|]+) ]]; then
                  duplicate_pr="${BASH_REMATCH[1]}"
                  duplicate_issue="${BASH_REMATCH[2]}"
                  duplicate_rig="${BASH_REMATCH[3]}"
                fi
                echo "[mayor] dispatch skipped duplicate merged trigger key=$duplicate_key reason_code=$duplicate_reason_code trigger_event_key=$duplicate_event_key"
                log_event "MAYOR_DISPATCH_SKIPPED_DUPLICATE reason_code=$duplicate_reason_code skip_reason=\"$(_escape_quotes "$duplicate_reason")\" trigger_event_key=\"$(_escape_quotes "$duplicate_event_key")\" rig=$duplicate_rig repo=\"$(_escape_quotes "$duplicate_repo")\" pr=#${duplicate_pr:-unknown} issue=#${duplicate_issue:-unknown} merged_head=\"$(_escape_quotes "$duplicate_merged_head")\" key=\"$(_escape_quotes "$duplicate_key")\" wake=\"$(_escape_quotes "$event_reason")\""
                _mayor_record_decision "MAYOR WAKE SKIP (duplicate-merged-trigger) reason_code=$duplicate_reason_code trigger_key=$duplicate_key trigger_event_key=$duplicate_event_key wake=$event_reason" "dispatch-trigger-duplicate" "$SGT_ROOT" || true
                suppress_wake_summary="true"
              else
                needs_ai=true
                if [[ -z "$ai_dispatch_trigger_key" ]]; then
                  ai_dispatch_trigger_key="$(_wake_trigger_key "$event_reason")"
                  ai_dispatch_trigger_reason="$(_wake_trigger_key "$event_reason")"
                fi
              fi
            fi
          else
            needs_ai=true
            if [[ -z "$ai_dispatch_trigger_key" ]]; then
              ai_dispatch_trigger_key="$(_wake_trigger_key "$event_reason")"
              ai_dispatch_trigger_reason="$(_wake_trigger_key "$event_reason")"
            fi
          fi
        fi
        wake_summary=$(_mayor_wake_summary "$event_reason")
        if [[ -n "$wake_summary" && "$suppress_wake_summary" != "true" ]]; then
          _mayor_notify_rigger "$wake_summary"
        fi
      done
    fi

    # === 1. Check agent health ===
    local deacon_restarted="false"
    for agent in daemon deacon; do
      if ! tmux has-session -t "sgt-$agent" 2>/dev/null; then
        issues_found+="  - $agent is DOWN\n"
        echo "[mayor] restarting $agent..."
        sgt "$agent" start 2>/dev/null
        actions_taken+="  - restarted $agent\n"
        if [[ "$agent" == "deacon" ]]; then
          deacon_restarted="true"
        fi
      fi
    done

    if [[ "$deacon_restarted" != "true" ]]; then
      local hb_age hb_ts hb_state hb_stale_secs
      hb_stale_secs="$(_deacon_heartbeat_stale_secs)"
      IFS='|' read -r hb_age hb_ts hb_state <<< "$(_deacon_heartbeat_snapshot)"
      if [[ "$hb_state" == "missing" ]]; then
        issues_found+="  - deacon heartbeat missing\n"
        echo "[mayor] deacon heartbeat missing — restarting deacon..."
        sgt deacon stop 2>/dev/null || true
        sgt deacon start 2>/dev/null
        actions_taken+="  - restarted deacon (missing heartbeat)\n"
      elif [[ "$hb_state" != "ok" || ! "$hb_age" =~ ^[0-9]+$ ]]; then
        issues_found+="  - deacon heartbeat invalid\n"
        echo "[mayor] deacon heartbeat invalid — restarting deacon..."
        sgt deacon stop 2>/dev/null || true
        sgt deacon start 2>/dev/null
        actions_taken+="  - restarted deacon (invalid heartbeat)\n"
      elif [[ "$hb_age" -gt "$hb_stale_secs" ]]; then
        issues_found+="  - deacon heartbeat stale (${hb_age}s > ${hb_stale_secs}s)\n"
        echo "[mayor] deacon heartbeat stale (${hb_age}s > ${hb_stale_secs}s) — restarting deacon..."
        sgt deacon stop 2>/dev/null || true
        sgt deacon start 2>/dev/null
        actions_taken+="  - restarted deacon (stale heartbeat ${hb_age}s)\n"
      fi
    fi

    # Check witnesses and refineries
    local agent_hb_stale_secs
    agent_hb_stale_secs="$(_agent_heartbeat_stale_secs)"
    for rig_file in "$SGT_RIGS"/*; do
      [[ -f "$rig_file" ]] || continue
      local rname
      rname="$(basename "$rig_file")"
      if _mayor_scope_skip_rig "$rname"; then
        continue
      fi
      if _mayor_rig_hibernated "$rname" && [[ -z "${cycle_target_rigs[$rname]+x}" ]]; then
        continue
      fi
      for agent in witness refinery; do
        local agent_session
        agent_session="sgt-${agent}-${rname}"
        if ! tmux has-session -t "$agent_session" 2>/dev/null; then
          issues_found+="  - ${agent}/$rname is DOWN\n"
          sgt "$agent" start "$rname" 2>/dev/null
          actions_taken+="  - restarted ${agent}/$rname\n"
          _mayor_reset_agent_heartbeat_watchdog "$agent" "$rname"
          continue
        fi

        local agent_hb_age agent_hb_ts agent_hb_state
        IFS='|' read -r agent_hb_age agent_hb_ts agent_hb_state <<< "$(_agent_heartbeat_snapshot "$agent" "$rname")"
        if [[ "$agent_hb_state" == "ok" && "$agent_hb_age" =~ ^[0-9]+$ ]]; then
          if [[ "$agent_hb_age" -gt "$agent_hb_stale_secs" ]]; then
            issues_found+="  - ${agent}/$rname heartbeat stale (stale_seconds=${agent_hb_age}s threshold>${agent_hb_stale_secs}s last_heartbeat=${agent_hb_ts})\n"
            if _mayor_should_notify_agent_heartbeat_watchdog "$agent" "$rname"; then
              _mayor_notify_rigger "mayor escalated: ${agent}/$rname heartbeat stale stale_seconds=${agent_hb_age} threshold=${agent_hb_stale_secs} last_heartbeat=${agent_hb_ts} runbook_action=notify" "0" "$rname"
              actions_taken+="  - escalated stale ${agent}/$rname heartbeat (stale_seconds=${agent_hb_age}s)\n"
              log_event "MAYOR_AGENT_HEARTBEAT_NOTIFY agent=$agent rig=$rname stale_seconds=${agent_hb_age} threshold=${agent_hb_stale_secs} last_heartbeat=$(_escape_quotes "$agent_hb_ts") dedupe_window=$(_mayor_agent_heartbeat_dedupe_secs)"
            else
              log_event "MAYOR_AGENT_HEARTBEAT_SUPPRESS agent=$agent rig=$rname stale_seconds=${agent_hb_age} threshold=${agent_hb_stale_secs} last_heartbeat=$(_escape_quotes "$agent_hb_ts") dedupe_window=$(_mayor_agent_heartbeat_dedupe_secs)"
            fi
          else
            _mayor_reset_agent_heartbeat_watchdog "$agent" "$rname"
          fi
        fi
      done
    done

    # === 2. Check merge queue (refinery handles review + merge) ===
    local mq_snapshot_count mq_live_count mq_count mq_source mq_status mq_selection_reason mq_resolution mq_guard_line mq_issue_line
    mq_snapshot_count="$(_mayor_merge_queue_count)"
    mq_resolution="$(_mayor_merge_queue_revalidate_once "$mq_snapshot_count")"
    IFS='|' read -r mq_snapshot_count mq_live_count mq_count mq_source mq_status mq_selection_reason <<< "$mq_resolution"
    mq_guard_line="merge_queue_count snapshot=$mq_snapshot_count live=$mq_live_count chosen=$mq_count source=$mq_source status=$mq_status reason=$mq_selection_reason"
    echo "[mayor] snapshot guard $mq_guard_line"
    log_event "MAYOR_SNAPSHOT_GUARD $mq_guard_line"
    if [[ "$mq_status" == "stale-snapshot" ]]; then
      snapshot_freshness+="  - stale snapshot: $mq_guard_line\n"
    fi
    mq_issue_line="$(_mayor_merge_queue_issue_line "$mq_count" "$mq_guard_line")"
    if [[ -n "$mq_issue_line" ]]; then
      issues_found+="$mq_issue_line\n"
    fi

    # === 2b. Watchdog: stalled REVIEW_UNCLEAR refinery queue items ===
    local review_watch_line
    while IFS= read -r review_watch_line; do
      [[ -n "$review_watch_line" ]] || continue
      local rw_queue rw_rig rw_pr rw_repo rw_issue rw_state rw_since rw_age rw_head rw_threshold
      IFS='|' read -r rw_queue rw_rig rw_pr rw_repo rw_issue rw_state rw_since rw_age rw_head rw_threshold <<< "$review_watch_line"
      local rw_owner_repo rw_pr_url rw_issue_url
      rw_owner_repo="$(_repo_owner_repo "$rw_repo")"
      rw_pr_url="$(_repo_pr_url "$rw_repo" "$rw_pr")"
      rw_issue_url="$(_repo_issue_url "$rw_repo" "$rw_issue")"
      issues_found+="  - refinery review unclear PR #$rw_pr on ${rw_owner_repo} (rig=${rw_rig} age=${rw_age}s threshold>=${rw_threshold}s queue=${rw_queue})\n"
      review_watchdog_notes+="  - queue=${rw_queue} rig=${rw_rig} pr=#${rw_pr} state=${rw_state} age=${rw_age}s threshold>=${rw_threshold}s since=${rw_since}\n"
      needs_ai=true
      if _mayor_should_notify_review_watchdog "$rw_rig" "$rw_repo" "$rw_pr" "$rw_state" "$rw_since" "$rw_head"; then
        _mayor_notify_rigger "mayor escalated: refinery review stalled rig=$rw_rig repo=$rw_owner_repo pr=#$rw_pr issue=#$rw_issue state=$rw_state age=${rw_age}s threshold=${rw_threshold}s pr_url=$rw_pr_url issue_url=$rw_issue_url" "0" "$rw_rig"
        actions_taken+="  - escalated stalled refinery review for PR #$rw_pr ($rw_owner_repo, age=${rw_age}s)\n"
        log_event "MAYOR_REVIEW_WATCHDOG_NOTIFY rig=$rw_rig repo=$rw_owner_repo pr=#$rw_pr issue=#$rw_issue state=$rw_state age=${rw_age}s threshold=${rw_threshold}s"
      else
        log_event "MAYOR_REVIEW_WATCHDOG_SUPPRESS rig=$rw_rig repo=$rw_owner_repo pr=#$rw_pr issue=#$rw_issue state=$rw_state age=${rw_age}s"
      fi
    done < <(_mayor_review_watchdog_collect_stale)

    # === 2c. Watchdog: stale required CI checks on open PRs ===
    local ci_watch_line ci_watch_dedupe
    ci_watch_dedupe="$(_mayor_ci_check_dedupe_secs)"
    while IFS= read -r ci_watch_line; do
      [[ -n "$ci_watch_line" ]] || continue
      local cw_rig cw_repo cw_pr cw_check cw_state cw_since cw_age cw_threshold cw_check_url cw_key
      IFS='|' read -r cw_rig cw_repo cw_pr cw_check cw_state cw_since cw_age cw_threshold cw_check_url cw_key <<< "$ci_watch_line"
      local cw_owner_repo cw_pr_url
      cw_owner_repo="$(_repo_owner_repo "$cw_repo")"
      cw_pr_url="$(_repo_pr_url "$cw_repo" "$cw_pr")"
      if [[ -z "$cw_check_url" ]]; then
        cw_check_url="$cw_pr_url"
      fi
      issues_found+="  - required CI check stale on PR #$cw_pr (${cw_owner_repo}) check=${cw_check} state=${cw_state} stale_seconds=${cw_age}s threshold>=${cw_threshold}s check_url=${cw_check_url}\n"
      needs_ai=true
      if _mayor_should_notify_ci_check_watchdog "$cw_key"; then
        _mayor_notify_rigger "mayor escalated: required check stale rig=$cw_rig repo=$cw_owner_repo pr=#$cw_pr check=$cw_check state=$cw_state stale_seconds=${cw_age} threshold=${cw_threshold} check_url=${cw_check_url} pr_url=${cw_pr_url} runbook_action=retry" "0" "$cw_rig"
        actions_taken+="  - escalated stale required check for PR #$cw_pr ($cw_owner_repo, check=${cw_check}, stale_seconds=${cw_age})\n"
        log_event "MAYOR_CI_CHECK_WATCHDOG_NOTIFY rig=$cw_rig repo=$cw_owner_repo pr=#$cw_pr check=\"$(_escape_quotes "$cw_check")\" state=$cw_state stale_seconds=${cw_age} threshold=${cw_threshold} check_url=\"$(_escape_quotes "$cw_check_url")\" dedupe_window=${ci_watch_dedupe}"
      else
        log_event "MAYOR_CI_CHECK_WATCHDOG_SUPPRESS rig=$cw_rig repo=$cw_owner_repo pr=#$cw_pr check=\"$(_escape_quotes "$cw_check")\" state=$cw_state stale_seconds=${cw_age} threshold=${cw_threshold} check_url=\"$(_escape_quotes "$cw_check_url")\" dedupe_window=${ci_watch_dedupe}"
      fi
    done < <(_mayor_ci_check_watchdog_collect_stale)

    # === 2d. Reconcile stale in-flight polecats after merge/close transitions ===
    if _mayor_reconcile_triggered_by_transition "$wake_reason" "${cycle_events[@]+"${cycle_events[@]}"}"; then
      local stale_cleanup_line
      while IFS= read -r stale_cleanup_line; do
        [[ -n "$stale_cleanup_line" ]] || continue
        local cleanup_status cleanup_polecat cleanup_reason cleanup_action cleanup_issue cleanup_pr
        IFS='|' read -r cleanup_status cleanup_polecat cleanup_reason cleanup_action cleanup_issue cleanup_pr <<< "$stale_cleanup_line"
        if [[ "$cleanup_status" == "CLEANED" ]]; then
          issues_found+="  - stale polecat $cleanup_polecat detected ($cleanup_reason)\n"
          actions_taken+="  - cleaned stale polecat $cleanup_polecat (action=$cleanup_action issue=#${cleanup_issue:-unknown} pr=#${cleanup_pr:-unknown})\n"
        fi
      done < <(_mayor_reconcile_stale_polecats)
    fi

    # === 3. Check for stale polecats (running > 30min) ===
    for pf in "$SGT_CONFIG/polecats"/*; do
      [[ -f "$pf" ]] || continue
      local pname started_at now_epoch started_epoch age_min
      pname="$(basename "$pf")"
      if [[ -n "${SGT_MAYOR_SCOPE_RIG:-}" && "$pname" != "${SGT_MAYOR_SCOPE_RIG}-"* ]]; then
        continue
      fi
      started_at="$(grep '^STARTED=' "$pf" 2>/dev/null | cut -d= -f2 || true)"
      if [[ -n "$started_at" ]]; then
        now_epoch=$(date +%s)
        started_epoch=$(date -d "$started_at" +%s 2>/dev/null || echo 0)
        if [[ "$started_epoch" -gt 0 ]]; then
          age_min=$(( (now_epoch - started_epoch) / 60 ))
          if [[ "$age_min" -gt 30 ]]; then
            issues_found+="  - polecat $pname running for ${age_min}m (stale?)\n"
            needs_ai=true
          fi
        fi
      fi
    done

    # === 4. Check for open issues with critical/high labels ===
    for rig_file in "$SGT_RIGS"/*; do
      [[ -f "$rig_file" ]] || continue
      local rname repo critical_issues
      rname="$(basename "$rig_file")"
      if _mayor_scope_skip_rig "$rname"; then
        continue
      fi
      if _mayor_rig_hibernated "$rname" && [[ -z "${cycle_target_rigs[$rname]+x}" ]]; then
        continue
      fi
      repo="$(cat "$rig_file")"
      critical_issues=$(
        {
          gh issue list --repo "$repo" --state open --label "sgt-authorized,critical" \
            --json number,title --jq '.[] | "#\(.number) \(.title)"' 2>/dev/null
          gh issue list --repo "$repo" --state open --label "sgt-authorized,high" \
            --json number,title --jq '.[] | "#\(.number) \(.title)"' 2>/dev/null
        } | sort -u | head -5
      )
      if [[ -n "$critical_issues" ]]; then
        issues_found+="  - critical/high issues on $rname:\n"
        while IFS= read -r line; do
          issues_found+="    - $line\n"
        done <<< "$critical_issues"
        if _mayor_should_notify_critical_alert "$rname" "$repo" "$critical_issues"; then
          local critical_alert
          critical_alert="$(_mayor_critical_alert_message "$rname" "$repo" "$critical_issues")"
          _mayor_notify_rigger "$critical_alert" "0" "$rname"
        else
          local critical_cooldown
          critical_cooldown="$(_critical_alert_cooldown_secs)"
          echo "[mayor] critical alert suppressed by cooldown (${critical_cooldown}s) for $rname"
          log_event "MAYOR_CRITICAL_NOTIFY_SUPPRESS rig=$rname cooldown=${critical_cooldown}s"
        fi
        needs_ai=true
      fi
    done

    # === 5b. Auto-tick repo-local plans ===
    for rig_file in "$SGT_RIGS"/*; do
      [[ -f "$rig_file" ]] || continue
      local rname plan_path plan_tick_summary plan_total plan_completed plan_inflight plan_dispatched plan_completion_rollup plan_completion_status plan_completion_condition plan_completion_details plan_completion_blocked_reason plan_dispatch_failures plan_pending_ready plan_pending_blocked plan_last_failure_reason
      rname="$(basename "$rig_file")"
      if _mayor_scope_skip_rig "$rname"; then
        continue
      fi
      if _mayor_rig_hibernated "$rname" && [[ -z "${cycle_target_rigs[$rname]+x}" ]]; then
        continue
      fi
      plan_path="$(_plan_file_path "$rname")"
      [[ -f "$plan_path" ]] || continue
      if plan_tick_summary="$(_plan_tick_run "$rname" "mayor" 2>/dev/null | grep '^PLAN_TICK|' | tail -n 1)"; then
        IFS='|' read -r _ _ plan_total plan_completed plan_inflight plan_dispatched _ plan_completion_rollup plan_completion_status plan_completion_condition plan_completion_details plan_completion_blocked_reason plan_dispatch_failures plan_pending_ready plan_pending_blocked plan_last_failure_reason <<< "$plan_tick_summary"
        if [[ "${plan_dispatched:-0}" =~ ^[0-9]+$ ]] && (( plan_dispatched > 0 )); then
          actions_taken+="  - auto-ticked plan for $rname (dispatched_now=${plan_dispatched} completed=${plan_completed}/${plan_total})\n"
        fi
        if [[ "${plan_dispatch_failures:-0}" =~ ^[0-9]+$ ]] && (( plan_dispatch_failures > 0 )); then
          issues_found+="  - plan movement blocked on $rname (dispatch_failures=${plan_dispatch_failures} ready_pending=${plan_pending_ready:-0} reason_code=${plan_last_failure_reason:-dispatch-failed})\n"
          needs_ai=true
        elif [[ "${plan_pending_ready:-0}" =~ ^[0-9]+$ && "${plan_inflight:-0}" =~ ^[0-9]+$ ]] && (( plan_pending_ready > 0 )) && (( plan_inflight == 0 )); then
          issues_found+="  - plan movement stalled on $rname (ready_pending=${plan_pending_ready} blocked_pending=${plan_pending_blocked:-0} inflight=0)\n"
          needs_ai=true
        fi
        case "${plan_completion_rollup:-not_declared}" in
          tasks-exhausted-awaiting-acceptance)
            issues_found+="  - plan completion condition unmet on $rname after tasks exhausted (status=${plan_completion_status:-pending}"
            [[ -n "${plan_completion_condition:-}" ]] && issues_found+=" condition=\"${plan_completion_condition}\""
            [[ -n "${plan_completion_details:-}" ]] && issues_found+=" details=\"${plan_completion_details}\""
            issues_found+=")\n"
            needs_ai=true
            ;;
          blocked-pending-external)
            issues_found+="  - plan completion blocked pending external condition on $rname"
            [[ -n "${plan_completion_condition:-}" ]] && issues_found+=" (condition=\"${plan_completion_condition}\""
            [[ -n "${plan_completion_blocked_reason:-}" ]] && issues_found+=" blocked_reason=\"${plan_completion_blocked_reason}\""
            [[ -n "${plan_completion_condition:-}" ]] && issues_found+=")"
            [[ -z "${plan_completion_condition:-}" && -n "${plan_completion_blocked_reason:-}" ]] && issues_found+=" (blocked_reason=\"${plan_completion_blocked_reason}\")"
            issues_found+="\n"
            ;;
        esac
      else
        issues_found+="  - repo plan tick failed for $rname\n"
      fi
    done

    # === 5c. Pending AI-authored plan requests ===
    local pending_plan_line pending_plan_count=0
    while IFS='|' read -r request_id request_rig request_status request_requested_at request_requester request_prompt_file; do
      [[ -n "$request_id" ]] || continue
      if _mayor_scope_skip_rig "$request_rig"; then
        continue
      fi
      pending_plan_count=$((pending_plan_count + 1))
      issues_found+="  - pending plan request $request_id for $request_rig (status=$request_status requester=$request_requester requested_at=$request_requested_at)\n"
    done < <(_plan_request_list_pending)
    if (( pending_plan_count > 0 )); then
      needs_ai=true
    fi

    # === 5d. Unresolved acceptance blockers ===
    local acceptance_blocker_line acceptance_blocker_count=0 acceptance_blockers_prompt=""
    local blocker_id blocker_rig blocker_title blocker_requester blocker_created blocker_disposition blocker_evidence_file
    local blocker_open_prs blocker_open_authorized blocker_open_polecats blocker_pending_plan_requests
    while IFS='|' read -r blocker_id blocker_rig blocker_title blocker_requester blocker_created blocker_disposition blocker_evidence_file blocker_open_prs blocker_open_authorized blocker_open_polecats blocker_pending_plan_requests; do
      [[ -n "$blocker_id" ]] || continue
      if _mayor_scope_skip_rig "$blocker_rig"; then
        continue
      fi
      acceptance_blocker_count=$((acceptance_blocker_count + 1))
      issues_found+="  - acceptance blocker $blocker_id on $blocker_rig: $blocker_title (reporter=$blocker_requester created_at=$blocker_created"
      if [[ "$blocker_disposition" == "needs-ai-followup" ]]; then
        issues_found+="; no actionable work remains, recreate follow-up work)\n"
        needs_ai=true
      else
        issues_found+="; active_work open_issues=${blocker_open_authorized} open_prs=${blocker_open_prs} open_polecats=${blocker_open_polecats} pending_plan_requests=${blocker_pending_plan_requests})\n"
      fi
      if [[ -f "$blocker_evidence_file" ]]; then
        acceptance_blockers_prompt+="### Acceptance Blocker $blocker_id ($blocker_rig)\n"
        acceptance_blockers_prompt+="- Title: $blocker_title\n"
        acceptance_blockers_prompt+="- Reported by: $blocker_requester\n"
        acceptance_blockers_prompt+="- Created at: $blocker_created\n"
        acceptance_blockers_prompt+="- Rig state: open_prs=${blocker_open_prs} open_authorized_issues=${blocker_open_authorized} open_polecats=${blocker_open_polecats} pending_plan_requests=${blocker_pending_plan_requests} disposition=${blocker_disposition}\n\n"
        acceptance_blockers_prompt+="$(cat "$blocker_evidence_file" 2>/dev/null)\n\n"
      fi
    done < <(_mayor_acceptance_blocker_scan)

    # === 5. Check for orphaned PRs (open PRs on sgt/* branches with no polecat) ===
    for rig_file in "$SGT_RIGS"/*; do
      [[ -f "$rig_file" ]] || continue
      local rname repo
      rname="$(basename "$rig_file")"
      if _mayor_scope_skip_rig "$rname"; then
        continue
      fi
      if _mayor_rig_hibernated "$rname" && [[ -z "${cycle_target_rigs[$rname]+x}" ]]; then
        continue
      fi
      repo="$(cat "$rig_file")"
      local orphan_prs
      orphan_prs=$(gh pr list --repo "$repo" --state open \
        --json number,headRefName --jq '.[] | select(.headRefName | startswith("sgt/")) | "#\(.number) [\(.headRefName)]"' 2>/dev/null)
      if [[ -n "$orphan_prs" ]]; then
        while IFS= read -r pr_info; do
          local pr_branch
          pr_branch=$(echo "$pr_info" | grep -oP '\[.*?\]' | tr -d '[]')
          local has_polecat=false
          for pf in "$SGT_CONFIG/polecats"/*; do
            [[ -f "$pf" ]] || continue
            if grep -q "BRANCH=$pr_branch" "$pf" 2>/dev/null; then
              has_polecat=true
              break
            fi
          done
          if [[ "$has_polecat" == "false" ]]; then
            local pr_num
            pr_num=$(echo "$pr_info" | grep -oP '#\d+' | tr -d '#')

            # Live-revalidate state before queueing so stale list snapshots
            # (e.g., PR merged after list) cannot enqueue orphan work.
            local live_pr_state
            live_pr_state=$(gh pr view "$pr_num" --repo "$repo" --json state --jq '.state' 2>/dev/null || true)
            if [[ -z "$live_pr_state" ]]; then
              echo "[mayor] orphaned PR #$pr_num state revalidation failed — skipping"
              log_event "MAYOR_ORPHAN_SKIP_REVALIDATE pr=#$pr_num rig=$rname branch=$pr_branch snapshot_state=OPEN reason=\"unable to query live PR state\""
              continue
            fi
            if [[ "$live_pr_state" != "OPEN" ]]; then
              echo "[mayor] orphaned PR #$pr_num stale snapshot (listed open, live state=$live_pr_state) — skipping"
              log_event "MAYOR_ORPHAN_SKIP_STALE pr=#$pr_num rig=$rname branch=$pr_branch snapshot_state=OPEN live_state=$live_pr_state reason=\"live PR state no longer open\""
              continue
            fi

            # Security gate: check linked issue has sgt-authorized label
            local linked_issue
            linked_issue=$(gh pr view "$pr_num" --repo "$repo" --json body --jq '.body' 2>/dev/null | grep -oP 'Closes #\K[0-9]+' || true)
            if [[ -z "$linked_issue" || "$linked_issue" == "0" ]]; then
              echo "[mayor] orphaned PR #$pr_num has no linked issue — skipping (unauthorized)"
              log_event "MAYOR_ORPHAN_SKIP_NO_ISSUE pr=#$pr_num"
              continue
            fi
            if ! _has_sgt_authorized "$repo" "$linked_issue"; then
              echo "[mayor] orphaned PR #$pr_num linked issue #$linked_issue lacks sgt-authorized — skipping"
              log_event "MAYOR_ORPHAN_SKIP_UNAUTHORIZED pr=#$pr_num issue=#$linked_issue"
              continue
            fi

            local mergeable
            mergeable=$(gh pr view "$pr_num" --repo "$repo" --json mergeable --jq '.mergeable' 2>/dev/null)
            if [[ "$mergeable" == "MERGEABLE" ]]; then
              local orphan_head_sha orphan_polecat
              orphan_head_sha="$(_pr_head_sha "$repo" "$pr_num")"
              orphan_polecat="${pr_branch#sgt/}"
              if _merge_queue_enqueue_polecat "$rname" "$repo" "$pr_branch" "${linked_issue}" "$pr_num" "$orphan_head_sha" "true" "$(_ai_backend_default)" "$orphan_polecat" "mayor-orphan-pr"; then
                actions_taken+="  - queued orphaned PR #$pr_num ($rname) for refinery\n"
                _wake_refinery "$rname" "orphan-pr:#$pr_num"
              fi
            fi
          fi
        done <<< "$orphan_prs"
      fi
    done

    # === 5e. Recover actionable rigs stranded with zero workers ===
    for rig_file in "$SGT_RIGS"/*; do
      [[ -f "$rig_file" ]] || continue
      local rname repo
      rname="$(basename "$rig_file")"
      if _mayor_scope_skip_rig "$rname"; then
        continue
      fi
      if _mayor_rig_hibernated "$rname" && [[ -z "${cycle_target_rigs[$rname]+x}" ]]; then
        continue
      fi
      repo="$(cat "$rig_file")"
      _mayor_recover_stranded_actionable_rig "$rname" "$repo"
      if [[ "${_MAYOR_STRANDED_RECOVERY_DISPATCHED:-0}" =~ ^[0-9]+$ ]] && (( _MAYOR_STRANDED_RECOVERY_DISPATCHED > 0 )); then
        actions_taken+="  - recovered stranded rig $rname (dispatches=${_MAYOR_STRANDED_RECOVERY_DISPATCHED})\n"
      fi
      if [[ "${_MAYOR_STRANDED_RECOVERY_BLOCKED:-0}" =~ ^[0-9]+$ ]] && (( _MAYOR_STRANDED_RECOVERY_BLOCKED > 0 )); then
        issues_found+="  - stranded actionable rig $rname remained blocked with zero workers (blocked_issues=${_MAYOR_STRANDED_RECOVERY_BLOCKED}; see MAYOR_STRANDED_RIG_RECOVERY_BLOCKED telemetry)\n"
        needs_ai=true
      fi
    done

    _mayor_dispatch_verify_replay || true

    # Refresh operator-visible per-rig mayor activity state after this cycle.
    if _mayor_rig_activity_enabled; then
      for rig_file in "$SGT_RIGS"/*; do
        [[ -f "$rig_file" ]] || continue
        local activity_rig
        activity_rig="$(basename "$rig_file")"
        if _mayor_scope_skip_rig "$activity_rig"; then
          continue
        fi
        if [[ -n "${cycle_target_rigs[$activity_rig]+x}" ]]; then
          _mayor_rig_activity_refresh "$activity_rig" "$wake_reason" "1" || true
        else
          _mayor_rig_activity_refresh "$activity_rig" "$wake_reason" "0" || true
        fi
      done
    fi

    # === Decision & Log ===
    if [[ -z "$issues_found" && -z "$actions_taken" ]]; then
      # Only log periodic all-clears, not event-triggered ones
      if [[ "$wake_reason" == "periodic" ]]; then
        _mayor_record_decision "all clear" "periodic-all-clear" "$SGT_ROOT" || true
      fi
      echo "[mayor] all clear"
    else
      local cycle_entry
      cycle_entry="$(printf 'MAYOR CYCLE (trigger: %s)\n' "$wake_reason")"
      if [[ -n "$issues_found" ]]; then
        cycle_entry+="$(printf '  Issues:\n%b' "$issues_found")"
      fi
      if [[ -n "$actions_taken" ]]; then
        cycle_entry+="$(printf '  Actions:\n%b' "$actions_taken")"
      fi
      if [[ -n "$snapshot_freshness" ]]; then
        cycle_entry+="$(printf '  Snapshot Freshness:\n%b' "$snapshot_freshness")"
      fi
      if [[ -n "$review_watchdog_notes" ]]; then
        cycle_entry+="$(printf '  Review Watchdog:\n%b' "$review_watchdog_notes")"
      fi
      if _mayor_record_decision "$cycle_entry" "cycle-summary" "$SGT_ROOT"; then
        echo "[mayor] logged issues/actions"
      fi

      # Notify Rigger of significant actions via OpenClaw
      if [[ -n "$notify_rigger" ]]; then
        _mayor_notify_rigger "$notify_rigger"
      fi
    fi

    # === AI escalation (only when needed) ===
    if [[ "$needs_ai" == "true" ]]; then
      echo "[mayor] complex issues detected — invoking AI decision..."
      local mayor_workspace="$(_mayor_scope_dir)/mayor-workspace"
      local dispatch_snapshot_file="$(_mayor_scope_dir)/mayor-dispatch-snapshot.tsv"
      mkdir -p "$mayor_workspace"
      _mayor_dispatch_snapshot_file "$dispatch_snapshot_file"

      local briefing_gate briefing briefing_status briefing_generated_at briefing_age briefing_threshold briefing_stale_detected briefing_path briefing_content
      if ! briefing_gate="$(_mayor_prepare_briefing_for_cycle)"; then
        IFS='|' read -r briefing briefing_status briefing_generated_at briefing_age briefing_threshold briefing_stale_detected briefing_path <<< "${briefing_gate:-$(_mayor_scope_dir)/mayor-briefing.md|invalid|unknown|-1|$(_mayor_briefing_stale_secs)|true|aborted}"
        echo "[mayor] AI cycle aborted — briefing freshness gate failed (status=${briefing_status:-invalid} age=${briefing_age:-unknown}s threshold=${briefing_threshold:-unknown}s path=${briefing_path:-aborted})"
        _mayor_record_decision "MAYOR AI CYCLE ABORT reason_code=stale-briefing path=${briefing_path:-aborted} status=${briefing_status:-invalid} stale_detected=${briefing_stale_detected:-true} generated_at=\"${briefing_generated_at:-unknown}\" age=${briefing_age:-unknown}s threshold=${briefing_threshold:-unknown}s" "briefing-freshness-gate" "$SGT_ROOT" || true
        log_event "MAYOR_AI_CYCLE aborted reason=stale-briefing path=${briefing_path:-aborted} status=${briefing_status:-invalid} stale_detected=${briefing_stale_detected:-true} generated_at=\"$(_escape_quotes "${briefing_generated_at:-unknown}")\" age=${briefing_age:-unknown}s threshold=${briefing_threshold:-unknown}s"
        _mayor_last_cycle_state_write "$wake_reason" "briefing-aborted" || true
        _mayor_heartbeat_write "cycle-complete" "$wake_reason" "$cycle_count" || true
        continue
      fi
      IFS='|' read -r briefing briefing_status briefing_generated_at briefing_age briefing_threshold briefing_stale_detected briefing_path <<< "$briefing_gate"
      echo "[mayor] briefing freshness gate path=${briefing_path} stale_detected=${briefing_stale_detected} age=${briefing_age}s threshold=${briefing_threshold}s generated_at=${briefing_generated_at}"
      log_event "MAYOR_BRIEFING_GATE_STATUS path=${briefing_path} stale_detected=${briefing_stale_detected} status=${briefing_status} generated_at=\"$(_escape_quotes "${briefing_generated_at}")\" age=${briefing_age}s threshold=${briefing_threshold}s"
      briefing_content="$(_mayor_briefing_content_for_prompt "$briefing")"

      cat > "$mayor_workspace/CLAUDE.md" <<MAYORMD
# Mayor — Emergency Decision

Issues requiring your judgment:
$(echo -e "$issues_found")

Recent actions already taken:
$(echo -e "$actions_taken")

Snapshot freshness notes:
$(echo -e "${snapshot_freshness:-  - none}")

Known unresolved acceptance blockers:
$(echo -e "${acceptance_blockers_prompt:-  - none}")

## System State
$briefing_content

## Commands
- \`sgt sling <rig> "<task>"\` — Dispatch work
- \`sgt plan tick <rig>\` — Deterministically dispatch ready plan tasks from repo-local \`SGT_PLAN.json\`
- \`sgt nuke <polecat>\` — Kill stuck worker
- \`sgt sweep\` — Clean finished workers
- \`sgt mayor merge <pr#> --repo <repo>\` — Merge PR with post-action live receipt fence
- \`sgt mayor request list\` — Show pending plan requests
- \`sgt mayor request ask <request-id> "<question>"\` — Ask the requesting OpenClaw agent for clarification
- \`sgt mayor request complete <request-id>\` — Mark a plan request complete after writing \`SGT_PLAN.json\`

Decide what to do. Log decisions to $(_mayor_scope_dir)/mayor-decisions.log. Be fast.

For each pending plan request, turn the request into a repo-local \`SGT_PLAN.json\` inside the rig repo when the request is clear enough.
For any rig-specific question, ambiguity, or missing decision, search shared rig context first with \`sgt context search <rig> "<query>"\` before guessing or escalating.
If you still need clarification after checking context, ask the requesting OpenClaw agent via \`sgt mayor request ask ...\`.
After creating or updating \`SGT_PLAN.json\`, call \`sgt mayor request complete <request-id>\`.
If a repo-local plan declares \`completion_condition\` / \`acceptance\`, treat closed issues and merged PRs as insufficient until acceptance is \`verified\`, \`waived\`, or explicitly \`blocked\` by a human.

If an issue/PR just merged, you should proactively:
- queue the next 1–3 highest-leverage issues (write crisp acceptance criteria)
- prefer keeping each issue small enough for an overnight polecat

An unresolved acceptance blocker means verified user-facing acceptance is still red.
Do not treat an empty board as success while any blocker remains open.
If a blocker has no active work left, recreate actionable follow-up work or a plan before standing down.

After deciding, report your actions: sgt mayor notify "<summary of what you did>"
MAYORMD

      local budget_guard budget_state budget_tokens budget_chars budget_threshold budget_extra budget_handoff
      budget_guard="$(_mayor_prompt_budget_guard "$mayor_workspace/CLAUDE.md" "ai-cycle-prompt")"
      IFS='|' read -r budget_state budget_tokens budget_chars budget_threshold budget_extra budget_handoff <<< "${budget_guard:-unknown|0|0|$(_mayor_auto_refresh_threshold_tokens)|0|}"
      case "${budget_state:-unknown}" in
        ok)
          ;;
        refresh)
          echo "[mayor] AI cycle aborted — auto-refresh scheduled (estimated_tokens=${budget_tokens:-0} threshold=${budget_threshold:-0} handoff=${budget_handoff:-unknown})"
          _mayor_record_decision "MAYOR AI CYCLE ABORT reason_code=auto-refresh-threshold estimated_tokens=${budget_tokens:-0} threshold=${budget_threshold:-0} char_count=${budget_chars:-0} handoff=\"${budget_handoff:-unknown}\"" "auto-refresh-threshold" "$SGT_ROOT" || true
          log_event "MAYOR_AI_CYCLE aborted reason=auto-refresh-threshold estimated_tokens=${budget_tokens:-0} threshold=${budget_threshold:-0} char_count=${budget_chars:-0} handoff=\"$(_escape_quotes "${budget_handoff:-unknown}")\""
          _mayor_last_cycle_state_write "$wake_reason" "auto-refresh-scheduled" || true
          _mayor_heartbeat_write "cycle-complete" "$wake_reason" "$cycle_count" || true
          _MAYOR_EXIT_REASON_OVERRIDE="auto-refresh-threshold"
          _MAYOR_EXIT_DECISION_CONTEXT_OVERRIDE="auto-refresh-threshold"
          _MAYOR_EXIT_UNEXPECTED_OVERRIDE="false"
          exit 0
          ;;
        cooldown)
          echo "[mayor] AI cycle aborted — auto-refresh cooldown active (estimated_tokens=${budget_tokens:-0} threshold=${budget_threshold:-0} retry_in=${budget_extra:-0}s)"
          _mayor_record_decision "MAYOR AI CYCLE ABORT reason_code=auto-refresh-cooldown estimated_tokens=${budget_tokens:-0} threshold=${budget_threshold:-0} char_count=${budget_chars:-0} cooldown_remaining=${budget_extra:-0}s" "auto-refresh-cooldown" "$SGT_ROOT" || true
          log_event "MAYOR_AI_CYCLE aborted reason=auto-refresh-cooldown estimated_tokens=${budget_tokens:-0} threshold=${budget_threshold:-0} char_count=${budget_chars:-0} cooldown_remaining=${budget_extra:-0}s"
          _mayor_last_cycle_state_write "$wake_reason" "auto-refresh-cooldown" || true
          _mayor_heartbeat_write "cycle-complete" "$wake_reason" "$cycle_count" || true
          continue
          ;;
        *)
          echo "[mayor] AI cycle aborted — prompt budget guard failed"
          _mayor_record_decision "MAYOR AI CYCLE ABORT reason_code=prompt-budget-guard-failed" "prompt-budget-guard" "$SGT_ROOT" || true
          log_event "MAYOR_AI_CYCLE aborted reason=prompt-budget-guard-failed"
          _mayor_last_cycle_state_write "$wake_reason" "budget-guard-aborted" || true
          _mayor_heartbeat_write "cycle-complete" "$wake_reason" "$cycle_count" || true
          continue
          ;;
      esac

      local backend="$(_ai_backend_default)"

      if ! _mayor_run_ai_decision_cycle "$backend" "$mayor_workspace" "$dispatch_snapshot_file" "$ai_dispatch_trigger_key" "$ai_dispatch_trigger_reason"; then
        log_event "MAYOR_CYCLE completed (trigger: $wake_reason status=ai-fail-closed)"
        _mayor_last_cycle_state_write "$wake_reason" "ai-fail-closed" || true
        _mayor_heartbeat_write "cycle-complete" "$wake_reason" "$cycle_count" || true
        continue
      fi
    fi

    log_event "MAYOR_CYCLE completed (trigger: $wake_reason)"
    _mayor_last_cycle_state_write "$wake_reason" "completed" || true
    _mayor_heartbeat_write "cycle-complete" "$wake_reason" "$cycle_count" || true
  done
}

# Public command: sgt mayor notify "<message>" — lets AI mayor report to Rigger
cmd_mayor_notify() {
  local message="${1:?usage: sgt mayor notify \"<message>\"}"
  local rc now_epoch
  if _mayor_notify_rigger "$message"; then
    _mayor_notify_alert_state_clear || true
    return 0
  fi
  rc=$?

  now_epoch="$(date +%s)"
  _mayor_notify_alert_state_write \
    "$now_epoch" \
    "${_MAYOR_NOTIFY_RESULT_CHANNEL:-rigger}" \
    "${_MAYOR_NOTIFY_RESULT_TARGET:-rigger}" \
    "${_MAYOR_NOTIFY_RESULT_MESSAGE_KEY:-unknown}" \
    "${_MAYOR_NOTIFY_RESULT_ATTEMPT:-0}" \
    "${_MAYOR_NOTIFY_RESULT_OUTCOME:-failed}" \
    "${_MAYOR_NOTIFY_RESULT_REASON:-unknown}" \
    "${_MAYOR_NOTIFY_RESULT_MATCHER:-unknown}" \
    "true" || true
  log_event "MAYOR_NOTIFY_FAIL_OPEN channel=${_MAYOR_NOTIFY_RESULT_CHANNEL:-rigger} target=\"$(_escape_quotes "${_MAYOR_NOTIFY_RESULT_TARGET:-rigger}")\" message_key=${_MAYOR_NOTIFY_RESULT_MESSAGE_KEY:-unknown} attempt=${_MAYOR_NOTIFY_RESULT_ATTEMPT:-0} outcome=${_MAYOR_NOTIFY_RESULT_OUTCOME:-failed} reason=${_MAYOR_NOTIFY_RESULT_REASON:-unknown} matcher=${_MAYOR_NOTIFY_RESULT_MATCHER:-unknown} escalated=${_MAYOR_NOTIFY_RESULT_ESCALATED:-0} action=retain-warning-continue"
  echo "[mayor] notify warning retained without failing command (outcome=${_MAYOR_NOTIFY_RESULT_OUTCOME:-failed} reason=${_MAYOR_NOTIFY_RESULT_REASON:-unknown} matcher=${_MAYOR_NOTIFY_RESULT_MATCHER:-unknown})"
  return 0
}

cmd_mayor_request_list() {
  ensure_init
  local line request_id rig status requested_at requester prompt_file prompt_preview
  local count=0
  while IFS='|' read -r request_id rig status requested_at requester prompt_file; do
    [[ -n "$request_id" ]] || continue
    count=$((count + 1))
    prompt_preview="$(head -n 3 "$prompt_file" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
    echo "$request_id [$status] rig=$rig requester=$requester requested_at=$requested_at"
    [[ -n "$prompt_preview" ]] && echo "  prompt: ${prompt_preview:0:160}"
  done < <(_plan_request_list_pending)
  if [[ "$count" -eq 0 ]]; then
    info "no pending plan requests"
  fi
}

cmd_mayor_request_ask() {
  local request_id="${1:-}" question="${2:-}"
  [[ -n "$request_id" ]] || die "usage: sgt mayor request ask <request-id> <question>"
  [[ -n "$question" ]] || die "usage: sgt mayor request ask <request-id> <question>"
  ensure_init
  local meta_path="$(_plan_request_meta_path "$request_id")"
  [[ -f "$meta_path" ]] || die "plan request '$request_id' not found"
  local rig requester prompt_file question_count
  eval "$(grep -E '^(RIG|REQUESTING_AGENT_ID|PROMPT_FILE|QUESTION_COUNT)=' "$meta_path" 2>/dev/null || true)"
  rig="${RIG:-}"
  requester="${REQUESTING_AGENT_ID:-}"
  prompt_file="${PROMPT_FILE:-}"
  question_count="${QUESTION_COUNT:-0}"
  [[ -n "$requester" ]] || die "plan request '$request_id' has no requesting OpenClaw agent id"
  _openclaw_notify_target "$requester" "plan_request=$request_id rig=$rig clarification_needed: $question" "[SGT Mayor]" || die "failed to send OpenClaw clarification"
  question_count=$((question_count + 1))
  _plan_request_update_field "$request_id" "STATUS" "needs-clarification"
  _plan_request_update_field "$request_id" "QUESTION_COUNT" "$question_count"
  _plan_request_update_field "$request_id" "LAST_QUESTION_AT" "$(date -Iseconds)"
  _plan_request_update_field "$request_id" "LAST_UPDATED_AT" "$(date -Iseconds)"
  log_event "MAYOR_PLAN_REQUEST_ASK request_id=$request_id rig=$rig requester=$requester question=\"$(_escape_quotes "$question")\""
  info "asked $requester about plan request $request_id"
}

cmd_mayor_request_complete() {
  local request_id="${1:-}"
  [[ -n "$request_id" ]] || die "usage: sgt mayor request complete <request-id>"
  ensure_init
  local meta_path="$(_plan_request_meta_path "$request_id")"
  [[ -f "$meta_path" ]] || die "plan request '$request_id' not found"
  local rig plan_file repo sync_reason sync_blocker_id
  eval "$(grep -E '^(RIG|REQUESTING_AGENT_ID)=' "$meta_path" 2>/dev/null || true)"
  rig="${RIG:-}"
  plan_file="$(_plan_file_path "$rig")"
  repo="$(rig_repo "$rig" 2>/dev/null || true)"
  if [[ -n "$rig" && -n "$repo" && -f "$plan_file" ]]; then
    if ! _plan_sync_state_and_labels "$rig" "$plan_file" "$repo"; then
      sync_reason="failed to sync plan labels/state on repo $repo while completing request $request_id"
      sync_blocker_id="$(_plan_blocker_record "$rig" "__plan__" "Plan sync" "plan-sync-failed" "$sync_reason" "mayor-request-complete" 2>/dev/null || true)"
      log_event "PLAN_MOVEMENT_BLOCKER rig=$rig task=__plan__ blocker_id=${sync_blocker_id:-unavailable} reason_code=plan-sync-failed source=mayor-request-complete reason=\"$(_escape_quotes "$sync_reason")\""
      warn "$sync_reason"
    else
      _plan_blocker_resolve "$rig" "__plan__" || true
    fi
  fi
  _plan_request_update_field "$request_id" "STATUS" "planned"
  _plan_request_update_field "$request_id" "COMPLETED_AT" "$(date -Iseconds)"
  _plan_request_update_field "$request_id" "LAST_UPDATED_AT" "$(date -Iseconds)"
  log_event "MAYOR_PLAN_REQUEST_COMPLETE request_id=$request_id"
  info "plan request completed: $request_id"
}

