    warning_text=""
    local canonical_repo resolve_meta resolve_code resolve_reason
    if canonical_repo="$(_resolve_rig_repo_canonical "status-open-pr-check" "$rig" "$repo" "1")"; then
      local pr_meta
      pr_meta="$(gh pr list --repo "$canonical_repo" --head "$branch" --state all --json number,state,title --jq 'if length == 0 then "" else "\(.[0].number)\t\(.[0].state // "")\t\(.[0].title // "")" end' 2>/dev/null || true)"
      if [[ -n "$pr_meta" ]]; then
        IFS=$'\t' read -r pr_number pr_state pr_title <<< "$pr_meta"
      fi
    else
      resolve_meta="$(_rig_repo_resolve_error_unpack "$canonical_repo")"
      IFS='|' read -r resolve_code resolve_reason <<< "$resolve_meta"
      warning_text="PR metadata skipped: ${resolve_reason:-unable to resolve rig repo} (reason_code=${resolve_code:-unknown})"
    fi

    if [[ "$alive" == "dead" && -n "$pr_number" && ( "$pr_state" == "MERGED" || "$pr_state" == "CLOSED" ) ]]; then
      local cleanup_reason cleanup_line
      cleanup_reason="stale-pr-merged"
      if [[ "$pr_state" == "CLOSED" ]]; then
        cleanup_reason="stale-pr-closed"
      fi
      cleanup_line="$(_mayor_cleanup_stale_polecat "$f" "$pname" "$rig" "$repo" "$issue" "$branch" "$session" "${WORKTREE:-}" "$cleanup_reason" "" "$pr_number" "$pr_state" 2>/dev/null || true)"
      if [[ "$cleanup_line" == CLEANED\|* ]]; then
        log_event "POLECAT_AUTO_PRUNE source=status polecat=$pname pr=#${pr_number:-unknown} state=${pr_state:-unknown} reason_code=$cleanup_reason"
        continue
      fi
    fi

    if [[ "$alive" == "dead" && -z "$pr_number" && -z "$warning_text" ]]; then
      warning_text="PR metadata unavailable (possible race)"
    fi
    if [[ "$alive" == "alive" && -n "$runtime_summary" && "$runtime_classification" != "active-output" ]]; then
      warning_text="$runtime_summary"
    fi

    polecats+=("{\"name\":$(_json_quote "$pname"),\"status\":$(_json_quote "$alive"),\"issue\":$(_json_quote "$issue"),\"rig\":$(_json_quote "$rig"),\"repo\":$(_json_quote "$repo"),\"branch\":$(_json_quote "$branch"),\"session\":$(_json_quote "$session"),\"pr\":{\"number\":$(_json_quote "$pr_number"),\"state\":$(_json_quote "$pr_state"),\"title\":$(_json_quote "$pr_title")},\"runtime\":{\"classification\":$(_json_quote "$runtime_classification"),\"reason_code\":$(_json_quote "$runtime_reason"),\"summary\":$(_json_quote "$runtime_summary"),\"output_age_seconds\":$(_json_quote "$runtime_output_age"),\"busy_pid\":$(_json_quote "$runtime_busy_pid"),\"busy_comm\":$(_json_quote "$runtime_busy_comm"),\"busy_args\":$(_json_quote "$runtime_busy_args")},\"warning\":$(_json_quote "$warning_text")}")
  done

  printf '{\n'
  printf '  "agents": '
  _json_print_array "${agents[@]}"
  printf ',\n'
  printf '  "dogs": '
  _json_print_array "${dogs[@]}"
  printf ',\n'
  printf '  "crew": '
  _json_print_array "${crew[@]}"
  printf ',\n'
  printf '  "merge_queue": '
  _json_print_array "${merge_queue[@]}"
  printf ',\n'
  printf '  "mayor_rigs": '
  _json_print_array "${mayor_rigs[@]}"
  printf ',\n'
  printf '  "polecats": '
  _json_print_array "${polecats[@]}"
  printf ',\n'
  printf '  "summary": {"polecat_count": %s}\n' "${#polecats[@]}"
  printf '}\n'
}

_cmd_status_human() {
  ensure_init
  local status_term_cols status_pr_title_cols
